{
  "name": "agrosystem-residencias",
  "version": "1.0.0",
  "type": "module",
  "description": "La idea principal del proyecto es pasar del papel, a un sistema automatizado, actualmente el INIFAP hace sus registros en papel, llevando a mano, la lista de plagas, cultivos, terrenos, productos validados por el inifap, entre otras cosas.",
  "main": "app.js",
  "scripts": {
    "dev": "concurrently -n css,server -c cyan,green \"pnpm dev:css\" \"pnpm dev:server\"",
    "dev:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/style.css --watch",
    "dev:server": "nodemon app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:coverage": "jest --coverage",
    "test:bdd": "cucumber-js",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlUNA78/Agrosystem-Residencias.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dlUNA78/Agrosystem-Residencias/issues"
  },
  "homepage": "https://github.com/dlUNA78/Agrosystem-Residencias#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-hbs": "^2.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@tailwindcss/cli": "^4.2.2",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.4"
  }
