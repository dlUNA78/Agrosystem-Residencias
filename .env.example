# Crea un archivo con la extensión .env, y dentro de este
# pegaras todas las variables de entorno que usaremos
# por ejemplo:

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrosystem_db
DB_USER=postgres
DB_PASS=tu_contraseña
DB_DIALECT=postgres
SESSION_SECRET=tu_secreto_de_sesion_super_seguro
ADMIN_EMAIL=tu_admin@empresa.com
ADMIN_PASSWORD=TuContraseñaSegura123
FARMER_EMAIL=tu_demo@empresa.com
FARMER_PASSWORD=OtraContraseña456

# Proxy inverso (opcional, sin valor por defecto):
# Si la app corre detrás de Nginx, un balanceador o un servicio en la nube, define TRUST_PROXY=1;
# si recibe tráfico directo, déjala sin definir.
# TRUST_PROXY=1

# Opcionales únicamente para entorno controlado de pruebas de carga HTTP (sin TLS):
# LOADTEST_DB_NAME=agrosystem_load
# COOKIE_SECURE=false
# LOADTEST_MODE=true
# DISABLE_RATE_LIMIT=true
