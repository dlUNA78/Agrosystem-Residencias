<div id="expiring-products-modal" class="no-print fixed inset-0 z-50 hidden items-center justify-center p-4 font-['Geist']" role="dialog" aria-modal="true" aria-labelledby="expiring-title">
  <button type="button" id="expiring-products-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-xs" aria-label="Cerrar seguimiento"></button>

  <div class="relative z-10 flex max-h-[85vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-2xl">
    <header class="flex items-start justify-between gap-4 border-b border-border bg-amber-50/60 px-6 py-4">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-amber-800">
          <i data-lucide="calendar-clock" class="w-3 h-3"></i>
          Vigilancia Sanitaria COFEPRIS
        </span>
        <h2 id="expiring-title" class="mt-1.5 text-lg font-headline font-black text-foreground">Registros próximos a vencer</h2>
        <p class="mt-0.5 text-xs text-muted-foreground">Productos cuya vigencia sanitaria concluye dentro de los siguientes 60 días naturales.</p>
      </div>
      <button type="button" id="close-expiring-modal" class="inline-flex h-8 w-8 items-center justify-center rounded-xl text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer" aria-label="Cerrar">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </header>

    <div class="max-h-120 overflow-auto">
      <table class="w-full min-w-175 text-left text-xs">
        <thead class="sticky top-0 border-b border-border bg-muted/85 backdrop-blur-xs">
          <tr>
            <th class="px-5 py-3 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Producto</th>
            <th class="px-5 py-3 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Registro RSCO</th>
            <th class="px-5 py-3 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Fabricante</th>
            <th class="px-5 py-3 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Vencimiento</th>
            <th class="px-5 py-3 text-right font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Acción</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/70">
          {{#each expiringProducts}}
            <tr class="hover:bg-muted/30 transition-colors">
              <td class="px-5 py-3.5">
                <a href="/private/products/{{id}}" class="font-bold text-foreground hover:text-[#1b4332]">{{name}}</a>
                <p class="mt-0.5 text-[11px] text-muted-foreground">{{active_ingredient}}</p>
              </td>
              <td class="px-5 py-3.5 font-mono text-xs font-semibold">{{registration_code}}</td>
              <td class="px-5 py-3.5">{{manufacturer}}</td>
              <td class="px-5 py-3.5">
                <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 font-mono text-[11px] font-bold text-amber-800">
                  {{expiration_date_formatted}}
                </span>
              </td>
              <td class="px-5 py-3.5 text-right">
                <div class="inline-flex items-center gap-1">
                  <a href="/private/products/{{id}}" class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-[#1b4332] hover:bg-[#e6f0e6]/70" title="Ver ficha" aria-label="Ver {{name}}">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                  </a>
                  {{#if canEditRecord}}
                    <button type="button" class="btn-edit-product inline-flex h-8 w-8 items-center justify-center rounded-lg text-[#1b4332] hover:bg-[#e6f0e6]/70 cursor-pointer" data-id="{{id}}" title="Actualizar vigencia" aria-label="Editar {{name}}">
                      <i data-lucide="pencil" class="w-4 h-4"></i>
                    </button>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-xs text-muted-foreground">
                No existen registros sanitarios próximos a vencer en los siguientes 60 días.
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <footer class="flex justify-end border-t border-border bg-muted/30 px-6 py-3.5">
      <button type="button" id="cancel-expiring-modal" class="rounded-xl border border-border bg-card px-5 py-2 text-xs font-bold text-foreground hover:bg-muted transition-colors cursor-pointer">
        Cerrar ventana
      </button>
    </footer>
  </div>
</div>
