<div id="expiring-products-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="expiring-title">
  <div class="max-h-[85vh] w-full max-w-4xl overflow-hidden rounded-2xl border border-border bg-card shadow-2xl">
    <header class="flex items-start justify-between gap-4 border-b border-border p-5"><div><span class="font-mono text-[10px] font-bold uppercase tracking-wider text-amber-700">Seguimiento de registros</span><h2 id="expiring-title" class="mt-1 text-xl font-black">Próximos a vencer</h2><p class="mt-1 text-xs text-muted-foreground">Registros con vencimiento durante los siguientes 60 días.</p></div><button type="button" id="close-expiring-modal" class="rounded-lg p-2 text-muted-foreground hover:bg-muted" aria-label="Cerrar"><span class="material-symbols-outlined">close</span></button></header>
    <div class="max-h-125 overflow-auto"><table class="w-full min-w-175 text-left"><thead class="sticky top-0 border-b border-border bg-muted"><tr><th class="px-5 py-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Producto</th><th class="px-5 py-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Registro</th><th class="px-5 py-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Fabricante</th><th class="px-5 py-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Vencimiento</th><th class="px-5 py-3"></th></tr></thead><tbody class="divide-y divide-border">{{#each expiringProducts}}<tr><td class="px-5 py-4 text-sm font-bold">{{name}}</td><td class="px-5 py-4 font-mono text-xs">{{registration_code}}</td><td class="px-5 py-4 text-xs">{{manufacturer}}</td><td class="px-5 py-4 text-xs font-bold text-amber-800">{{expiration_date_formatted}}</td><td class="px-5 py-4 text-right">{{#if canEditRecord}}<button type="button" class="btn-edit-product rounded-lg p-2 text-primary hover:bg-primary/10" data-id="{{id}}" aria-label="Editar {{name}}"><span class="material-symbols-outlined text-lg">edit</span></button>{{else}}<a href="/private/products/{{id}}" class="rounded-lg p-2 text-primary hover:bg-primary/10"><span class="material-symbols-outlined text-lg">visibility</span></a>{{/if}}</td></tr>{{else}}<tr><td colspan="5" class="px-6 py-12 text-center text-sm text-muted-foreground">No hay registros próximos a vencer.</td></tr>{{/each}}</tbody></table></div>
    <footer class="flex justify-end border-t border-border bg-muted/30 p-4"><button type="button" id="cancel-expiring-modal" class="rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-bold hover:bg-muted">Cerrar</button></footer>
  </div>
</div>
