    <form id="product-delete-form" method="POST" class="mt-6 flex justify-end gap-3"><button type="button" id="cancel-delete" class="rounded-xl border border-border px-4 py-2.5 text-sm font-bold hover:bg-muted">Cancelar</button><button type="button" id="confirm-delete" class="rounded-xl bg-red-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-red-800">Eliminar definitivamente</button></form>
