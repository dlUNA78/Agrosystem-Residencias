<div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="delete-product-title">
  <div class="w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-50 text-red-700"><span class="material-symbols-outlined">delete_forever</span></div>
    <h2 id="delete-product-title" class="mt-4 text-xl font-black">Eliminar producto</h2>
