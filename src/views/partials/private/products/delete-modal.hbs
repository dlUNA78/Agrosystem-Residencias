<div id="delete-modal" class="no-print fixed inset-0 z-50 hidden items-center justify-center p-4 font-['Geist']" role="dialog" aria-modal="true" aria-labelledby="delete-product-title">
  <button type="button" id="delete-modal-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-xs" aria-label="Cancelar eliminación"></button>

  <div class="relative z-10 w-full max-w-md overflow-hidden rounded-2xl border border-border bg-card shadow-2xl">
    <div class="p-6">
      <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-rose-100 text-rose-700">
        <i data-lucide="trash-2" class="w-5 h-5"></i>
      </div>
      <h2 id="delete-product-title" class="mt-4 text-lg font-headline font-black text-foreground">Dar de baja / Archivar producto</h2>
      <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
        Política de preservación INIFAP: <strong id="delete-product-name" class="text-foreground"></strong> será retirado del catálogo público y pasará a estado <strong>Archivado</strong> conservando su historial sanitario y vinculaciones fitosanitarias.
      </p>
    </div>

    <form id="product-delete-form" method="POST" class="flex items-center justify-end gap-2.5 border-t border-border bg-muted/30 px-6 py-3.5">
      <input type="hidden" name="mode" value="archive" />
      <button type="button" id="cancel-delete" class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer">
        Cancelar
      </button>
      <button type="submit" id="confirm-delete" class="inline-flex items-center gap-1.5 rounded-xl bg-amber-600 px-4 py-2 text-xs font-bold text-white shadow-2xs hover:bg-amber-700 transition-colors cursor-pointer">
        <i data-lucide="archive" class="w-3.5 h-3.5"></i>
        <span>Archivar ficha</span>
      </button>
    </form>
  </div>
</div>
