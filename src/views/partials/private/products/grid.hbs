<section id="products-grid-view" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" aria-label="Productos en tarjetas">
  {{#each products}}
    <article class="group flex min-h-105 flex-col overflow-hidden rounded-2xl border border-border/80 bg-card shadow-2xs transition hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md">
      <a href="/private/products/{{id}}" class="relative flex h-48 items-center justify-center overflow-hidden bg-muted/50 p-5">
        <img src="{{image_url}}" alt="{{name}}" class="h-full w-full object-contain transition duration-300 group-hover:scale-105" data-fallback-src="/images/test/default.png">
        <span class="absolute left-3 top-3">{{> private/products/workflow-badge}}</span>
        <span class="absolute bottom-3 right-3 rounded-lg border border-white/60 bg-white/90 px-2 py-1 font-mono text-[9px] font-bold text-primary shadow-2xs">{{registration_code}}</span>
      </a>
      <div class="flex flex-1 flex-col p-5">
        <div class="mb-3 flex items-center justify-between gap-3">
          <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-primary">{{category}}</span>
          {{#if expirationDateFormatted}}<span class="text-[10px] text-muted-foreground">Vence {{expirationDateFormatted}}</span>{{/if}}
        </div>
        <h2 class="text-lg font-black leading-tight text-foreground"><a href="/private/products/{{id}}" class="hover:text-primary">{{name}}</a></h2>
        <p class="mt-1 text-xs font-semibold text-primary/80">{{active_ingredient}}</p>
        <p class="mt-3 line-clamp-3 text-xs leading-relaxed text-muted-foreground">{{#if description}}{{description}}{{else}}Sin descripción técnica registrada.{{/if}}</p>
        <div class="mt-auto flex items-center justify-between gap-3 border-t border-border/70 pt-4">
          <div class="min-w-0"><p class="truncate text-[10px] uppercase tracking-wide text-muted-foreground">Fabricante</p><p class="truncate text-xs font-bold">{{manufacturer}}</p></div>
          <div class="flex shrink-0 items-center gap-1">
            <a href="/private/products/{{id}}" aria-label="Ver {{name}}" class="rounded-lg p-2 text-primary hover:bg-primary/10"><span class="material-symbols-outlined text-lg">visibility</span></a>
            {{#if canEditRecord}}<button type="button" class="btn-edit-product rounded-lg p-2 text-primary hover:bg-primary/10" data-id="{{id}}" aria-label="Editar {{name}}"><span class="material-symbols-outlined text-lg">edit</span></button>{{/if}}
            {{#if canDeleteRecord}}<button type="button" data-delete-btn data-id="{{id}}" data-name="{{name}}" class="rounded-lg p-2 text-red-700 hover:bg-red-50" aria-label="Eliminar {{name}}"><span class="material-symbols-outlined text-lg">delete</span></button>{{/if}}
          </div>
        </div>
      </div>
    </article>
  {{else}}
    <div class="col-span-full rounded-2xl border border-dashed border-border bg-card px-6 py-16 text-center"><span class="material-symbols-outlined text-5xl text-muted-foreground/40">science_off</span><h2 class="mt-3 text-lg font-bold">No encontramos productos</h2><p class="mt-1 text-sm text-muted-foreground">Ajusta los filtros o registra una nueva ficha.</p></div>
  {{/each}}
  {{#if permissions.canCreate}}
    <button type="button" id="btn-add-product-card" class="flex min-h-105 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-primary/20 bg-primary/3 p-6 text-center transition hover:border-primary/40 hover:bg-primary/5"><span class="material-symbols-outlined text-4xl text-primary/50">add_circle</span><span class="mt-3 text-sm font-bold text-primary">Añadir producto</span><span class="mt-1 text-xs text-muted-foreground">Crear una nueva ficha técnica</span></button>
  {{/if}}
</section>
