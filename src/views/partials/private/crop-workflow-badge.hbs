{{#if (eq workflow_status 'published')}}
  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-200/60 shadow-2xs">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
    Publicado
  </span>
{{else if (eq workflow_status 'in_review')}}
  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-[10px] font-bold border border-amber-200/60 shadow-2xs">
    <i data-lucide="clock" class="w-3 h-3"></i>
    En revisión
  </span>
{{else if (eq workflow_status 'changes_requested')}}
  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-orange-50 text-orange-700 text-[10px] font-bold border border-orange-200/60 shadow-2xs">
    <i data-lucide="alert-circle" class="w-3 h-3"></i>
    Con cambios
  </span>
{{else if (eq workflow_status 'verified')}}
  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-[10px] font-bold border border-blue-200/60 shadow-2xs">
    <i data-lucide="shield-check" class="w-3 h-3"></i>
    Verificado
  </span>
{{else if (eq workflow_status 'archived')}}
  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold border border-slate-200/60 shadow-2xs">
    <i data-lucide="archive" class="w-3 h-3"></i>
    Archivado
  </span>
{{else}}
  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold border border-slate-200/60 shadow-2xs">
    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
    Borrador
  </span>
{{/if}}
