<section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-lg font-extrabold text-foreground">Bitácora de aplicaciones</h2>
            <p class="mt-1 text-sm text-muted-foreground">{{applicationsCount}} aplicación(es) registradas.</p>
        </div>
        {{#if permissions.canEdit}}
        <button type="button" data-land-modal-open="application" class="rounded-xl border border-primary/30 px-4 py-2.5 text-sm font-bold text-primary hover:bg-primary/5">Registrar aplicación</button>
        {{/if}}
    </div>

    {{#if applications}}
    <div class="mt-5 overflow-x-auto">
        <table class="w-full min-w-[680px] text-left text-sm">
            <thead class="border-b border-border text-xs uppercase text-muted-foreground">
                <tr>
                    <th class="px-3 py-3">Fecha</th>
                    <th class="px-3 py-3">Lote / Sección</th>
                    <th class="px-3 py-3">Producto</th>
                    <th class="px-3 py-3">Ingrediente activo</th>
                    <th class="px-3 py-3">Dosis</th>
                    <th class="px-3 py-3">Notas</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {{#each applications}}
                <tr data-application-lot="{{this.lotName}}">
                    <td class="px-3 py-3 text-muted-foreground whitespace-nowrap">{{this.appliedDate}}</td>
                    <td class="px-3 py-3 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1 rounded bg-muted px-2 py-0.5 text-xs font-semibold text-foreground">
                            📍 {{this.lotName}}{{#if this.cropName}} · {{this.cropName}}{{/if}}
                        </span>
                    </td>
                    <td class="px-3 py-3">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="font-bold text-foreground">{{this.product_name}}</span>
                            {{#if this.product_id}}
                            <a href="/private/products/{{this.product_id}}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded bg-blue-100/70 px-1.5 py-0.5 text-[10px] font-bold text-blue-700 hover:bg-blue-200 transition-colors" title="Ver ficha técnica oficial del agroquímico">
                                🧪 Ficha ↗
                            </a>
                            {{/if}}
                        </div>
                    </td>
                    <td class="px-3 py-3 text-muted-foreground">{{#if this.active_ingredient}}{{this.active_ingredient}}{{else}}No especificado{{/if}}</td>
                    <td class="px-3 py-3 font-semibold text-foreground whitespace-nowrap">{{this.dose_value}} {{this.dose_unit}}</td>
                    <td class="max-w-xs px-3 py-3 text-muted-foreground">{{#if this.notes}}{{this.notes}}{{else}}Sin notas{{/if}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <p class="mt-5 rounded-xl border border-dashed border-border p-6 text-center text-sm text-muted-foreground">No hay aplicaciones registradas.</p>
    {{/if}}
</section>
