<section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-lg font-extrabold text-foreground">Ciclos de cultivo</h2>
            <p class="mt-1 text-sm text-muted-foreground">
                {{#if nonArchivedFarmCropsCount}}
                {{nonArchivedFarmCropsCount}} ciclo(s) en seguimiento{{#if archivedFarmCropsCount}} · {{archivedFarmCropsCount}} archivado(s){{/if}}.
                {{else}}
                {{farmCropsCount}} ciclo(s) registrado(s) en este terreno.
                {{/if}}
            </p>
        </div>
        {{#if permissions.canEdit}}
        <button type="button" data-land-modal-open="cycle" class="rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-white hover:bg-primary/90 transition-colors shadow-sm">
            🌱 Registrar ciclo
        </button>
        {{/if}}
    </div>

    {{#if nonArchivedFarmCrops}}
    <div class="mt-5 grid gap-4 lg:grid-cols-2">
        {{#each nonArchivedFarmCrops}}
        <article class="rounded-xl border border-border bg-card p-5 shadow-sm flex flex-col justify-between" data-cycle-lot="{{#if this.area_section}}{{this.area_section}}{{else}}General{{/if}}">
            <div>
                <!-- Encabezado del cultivo -->
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="font-extrabold text-foreground text-base">{{this.crop.name}}</p>
                            {{#if this.crop.id}}
                            <a href="/private/crops/{{this.crop.id}}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary hover:bg-primary/20 transition-colors" title="Ver ficha agronómica del INIFAP">
                                📄 Ficha técnica ↗
                            </a>
                            {{/if}}
                        </div>
                        <p class="text-xs italic text-muted-foreground">{{this.crop.scientific_name}}</p>
                        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                            <span>🌱 Siembra: <strong class="text-foreground">{{this.plantingDate}}</strong></span>
                            {{#if this.estimatedHarvestDate}}
                            <span>🌾 Cosecha estimada: <strong class="text-foreground">{{this.estimatedHarvestDate}}</strong></span>
                            {{/if}}
                            {{#if this.harvestDays}}
                            <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-bold text-foreground">~{{this.harvestDays}} días</span>
                            {{/if}}
                            {{#if this.area_section}}
                            <span>📍 {{this.area_section}}</span>
                            {{/if}}
                        </div>
                    </div>
                    <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider {{#if this.is_active}}bg-emerald-50 text-emerald-700 border border-emerald-200{{else}}bg-slate-100 text-slate-700 border border-slate-200{{/if}}">
                        {{this.statusLabel}}
                    </span>
                </div>

                <!-- Barra y métricas de progreso fenológico -->
                <div class="mt-4 rounded-xl border border-border/60 bg-muted/30 p-3.5">
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-1 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="font-extrabold text-foreground">Progreso fenológico</span>
                            {{#if this.currentStage}}
                            <span class="rounded-md bg-primary/10 px-2 py-0.5 text-[11px] font-bold text-primary">
                                Etapa: {{this.currentStage.stage_name}}
                            </span>
                            {{/if}}
                        </div>
                        <span class="font-black text-primary text-sm">{{this.progressPercent}}%</span>
                    </div>

                    <div class="h-2.5 w-full overflow-hidden rounded-full bg-muted border border-border/40">
                        <div class="h-full rounded-full bg-primary transition-all duration-500" style="width: {{this.progressPercent}}%"></div>
                    </div>

                    <div class="mt-2 flex items-center justify-between text-[11px] text-muted-foreground">
                        {{#if this.elapsedDays}}
                        <span>Día {{this.elapsedDays}} de {{this.harvestDays}}</span>
                        {{else}}
                        <span>Inicio del ciclo</span>
                        {{/if}}
                        {{#if this.isCompleted}}
                        <span class="font-bold text-emerald-700">✓ Ciclo cosechado / completado</span>
                        {{else if this.estimatedHarvestDate}}
                        <span>Cosecha proyectada: <strong class="text-foreground">{{this.estimatedHarvestDate}}</strong></span>
                        {{/if}}
                    </div>
                </div>

                <!-- Línea de tiempo de etapas fenológicas -->
                <ol class="mt-4 space-y-2">
                    {{#each this.stages}}
                    <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl p-2.5 text-xs transition-colors {{#if this.isCompleted}}bg-emerald-500/10 border border-emerald-500/20{{else if this.isInProgress}}bg-primary/10 border border-primary/30{{else}}bg-muted/40 border border-transparent{{/if}}">
                        <div class="flex items-center gap-2">
                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[10px] font-black {{#if this.isCompleted}}bg-emerald-600 text-white{{else if this.isInProgress}}bg-primary text-white{{else}}bg-muted text-muted-foreground border border-border{{/if}}">
                                {{#if this.isCompleted}}✓{{else}}{{this.stage_order}}{{/if}}
                            </span>
                            <div>
                                <span class="font-bold text-foreground">{{this.stage_name}}</span>
                                <span class="ml-1 text-[11px] text-muted-foreground">({{this.estimated_date}})</span>
                            </div>
                        </div>

                        {{#if this.isCompleted}}
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-emerald-700 flex items-center gap-1 text-[11px]">✓ Completada</span>
                            {{#if @root.permissions.canEdit}}
                            <form action="/private/lands/{{@root.land.id}}/cycles/revert-stage" method="POST" class="inline">
                                <input type="hidden" name="farm_crop_id" value="{{../id}}" />
                                <input type="hidden" name="target_stage_order" value="{{this.stage_order}}" />
                                <button type="submit" class="rounded px-2 py-0.5 text-[10px] font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200/60 transition-colors flex items-center gap-0.5" title="Revertir a esta etapa si el cálculo de días o avance en campo fue erróneo">
                                    ↺ Volver aquí
                                </button>
                            </form>
                            {{/if}}
                        </div>
                        {{/if}}
                        {{#if this.isPending}}
                        <span class="font-medium text-muted-foreground text-[11px]">Pendiente</span>
                        {{/if}}
                        {{#if this.isInProgress}}
                        {{#if @root.permissions.canEdit}}
                        <form action="/private/lands/{{@root.land.id}}/cycles/advance" method="POST" class="flex items-center gap-2">
                            <input type="hidden" name="farm_crop_id" value="{{../id}}" />
                            <input type="hidden" name="stage_order" value="{{this.stage_order}}" />
                            <button type="submit" class="rounded-lg border border-primary/40 bg-card px-2.5 py-1 text-xs font-bold text-primary hover:bg-primary hover:text-white transition-colors shadow-sm">
                                Confirmar etapa
                            </button>
                        </form>
                        {{else}}
                        <span class="font-bold text-primary text-[11px]">En curso</span>
                        {{/if}}
                        {{/if}}
                    </li>
                    {{/each}}
                </ol>
            </div>

            <!-- Acciones al pie de la tarjeta: Finalizar o Archivar -->
            <div class="mt-5 flex flex-wrap items-center justify-end gap-3 pt-3 border-t border-border">
                {{#if this.is_active}}
                    {{#if @root.permissions.canEdit}}
                    <form action="/private/lands/{{@root.land.id}}/cycles/finish" method="POST">
                        <input type="hidden" name="farm_crop_id" value="{{this.id}}" />
                        <button type="submit" class="text-xs font-bold text-amber-700 hover:text-amber-800 hover:underline">
                            Finalizar / Cosechar ciclo
                        </button>
                    </form>
                    {{/if}}
                {{else}}
                    {{#if @root.permissions.canEdit}}
                    <form action="/private/lands/{{@root.land.id}}/cycles/archive" method="POST">
                        <input type="hidden" name="farm_crop_id" value="{{this.id}}" />
                        <button type="submit" class="rounded-lg border border-border bg-muted/60 px-3 py-1.5 text-xs font-bold text-muted-foreground hover:bg-muted hover:text-foreground transition-colors flex items-center gap-1.5 shadow-sm">
                            <span>📦</span>
                            <span>Archivar cultivo cosechado</span>
                        </button>
                    </form>
                    {{/if}}
                {{/if}}
            </div>
        </article>
        {{/each}}
    </div>
    {{else}}
        {{#if archivedFarmCropsCount}}
        <p class="mt-5 rounded-xl border border-dashed border-border p-6 text-center text-sm text-muted-foreground">
            No hay ciclos activos en seguimiento. Tienes {{archivedFarmCropsCount}} cultivo(s) cosechado(s) y archivado(s) abajo.
        </p>
        {{else}}
        <p class="mt-5 rounded-xl border border-dashed border-border p-6 text-center text-sm text-muted-foreground">
            Todavía no hay ciclos de cultivo registrados en este terreno.
        </p>
        {{/if}}
    {{/if}}

    <!-- Sección colapsable de cultivos archivados -->
    {{#if archivedFarmCropsCount}}
    <details class="mt-6 rounded-2xl border border-dashed border-border bg-muted/20 p-5 group">
        <summary class="cursor-pointer text-sm font-extrabold text-muted-foreground hover:text-foreground flex items-center justify-between select-none">
            <div class="flex items-center gap-2">
                <span>📁 Cultivos archivados</span>
                <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-bold text-foreground">{{archivedFarmCropsCount}}</span>
            </div>
            <span class="text-xs font-semibold text-primary group-open:hidden">Mostrar archivados ↓</span>
            <span class="text-xs font-semibold text-primary hidden group-open:inline">Ocultar archivados ↑</span>
        </summary>

        <div class="mt-4 grid gap-4 lg:grid-cols-2 pt-2 border-t border-border/50">
            {{#each archivedFarmCrops}}
            <article class="rounded-xl border border-border/80 bg-card/60 p-4 shadow-sm opacity-90 hover:opacity-100 transition-opacity" data-cycle-lot="{{#if this.area_section}}{{this.area_section}}{{else}}General{{/if}}">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="font-extrabold text-foreground">{{this.crop.name}}</p>
                            {{#if this.crop.id}}
                            <a href="/private/crops/{{this.crop.id}}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded bg-primary/10 px-1.5 py-0.5 text-[9px] font-bold text-primary hover:bg-primary/20 transition-colors" title="Ver ficha técnica agronómica">
                                📄 Ficha ↗
                            </a>
                            {{/if}}
                            <span class="rounded bg-muted px-1.5 py-0.5 text-[9px] font-bold text-muted-foreground">Archivado</span>
                        </div>
                        <p class="text-xs italic text-muted-foreground">{{this.crop.scientific_name}}</p>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Siembra: {{this.plantingDate}}{{#if this.estimatedHarvestDate}} · Cosecha: {{this.estimatedHarvestDate}}{{/if}}{{#if this.area_section}} · {{this.area_section}}{{/if}}
                        </p>
                    </div>
                    {{#if @root.permissions.canEdit}}
                    <form action="/private/lands/{{@root.land.id}}/cycles/restore" method="POST">
                        <input type="hidden" name="farm_crop_id" value="{{this.id}}" />
                        <button type="submit" class="rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-bold text-muted-foreground hover:bg-muted hover:text-foreground transition-colors shadow-sm" title="Restaurar cultivo">
                            Desarchivar
                        </button>
                    </form>
                    {{/if}}
                </div>
            </article>
            {{/each}}
        </div>
    </details>
    {{/if}}
</section>
