<section id="ciclos-predio" class="scroll-mt-32 rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-lg font-extrabold text-slate-900 flex items-center gap-2">
                <i data-lucide="sprout" class="h-4 w-4 text-[#1b4332]"></i>
                <span>Ciclos de cultivo</span>
            </h2>
            <p class="mt-1 text-xs text-slate-500">
                {{#if nonArchivedFarmCropsCount}}
                {{nonArchivedFarmCropsCount}} ciclo(s) en seguimiento{{#if archivedFarmCropsCount}} · {{archivedFarmCropsCount}} archivado(s){{/if}}.
                {{else}}
                {{farmCropsCount}} ciclo(s) registrado(s) en este terreno.
                {{/if}}
            </p>
        </div>
        {{#if permissions.canEdit}}
        <button type="button" data-land-modal-open="cycle" class="inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#143325] transition-colors shadow-xs">
            <i data-lucide="plus" class="h-3.5 w-3.5"></i>
            <span>Registrar ciclo</span>
        </button>
        {{/if}}
    </div>

    {{#if nonArchivedFarmCrops}}
    <div class="mt-5 grid gap-4 lg:grid-cols-2">
        {{#each nonArchivedFarmCrops}}
        <article class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs flex flex-col justify-between transition-colors hover:border-[#1b4332]/30" data-cycle-lot="{{#if this.area_section}}{{this.area_section}}{{else}}General{{/if}}">
            <div>
                <!-- Encabezado del cultivo -->
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="font-extrabold text-slate-900 text-base">{{this.crop.name}}</p>
                            {{#if this.crop.id}}
                            <a href="/private/crops/{{this.crop.id}}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-md border border-emerald-200 bg-emerald-50/70 px-2 py-0.5 text-[10px] font-bold text-[#1b4332] hover:bg-emerald-100 transition-colors" title="Ver ficha agronómica del INIFAP">
                                <i data-lucide="external-link" class="h-2.5 w-2.5"></i>
                                <span>Ficha técnica</span>
                            </a>
                            {{/if}}
                        </div>
                        <p class="text-xs italic text-slate-500">{{this.crop.scientific_name}}</p>
                        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                            <span>Siembra: <strong class="font-['Geist_Mono'] text-slate-800">{{this.plantingDate}}</strong></span>
                            {{#if this.estimatedHarvestDate}}
                            <span>Cosecha est.: <strong class="font-['Geist_Mono'] text-slate-800">{{this.estimatedHarvestDate}}</strong></span>
                            {{/if}}
                            {{#if this.harvestDays}}
                            <span class="rounded bg-slate-100 px-1.5 py-0.5 font-['Geist_Mono'] text-[10px] font-bold text-slate-700">~{{this.harvestDays}}d</span>
                            {{/if}}
                            {{#if this.area_section}}
                            <span class="inline-flex items-center gap-1 font-semibold text-[#1b4332]">
                                <i data-lucide="map-pin" class="h-3 w-3"></i>
                                {{this.area_section}}
                            </span>
                            {{/if}}
                        </div>
                    </div>
                    <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider {{#if this.is_active}}bg-emerald-50 text-emerald-800 border border-emerald-200{{else}}bg-slate-100 text-slate-700 border border-slate-200{{/if}}">
                        {{this.statusLabel}}
                    </span>
                </div>

                <!-- Barra y métricas de progreso fenológico -->
                <div class="mt-4 rounded-xl border border-slate-200/80 bg-slate-50/70 p-3.5">
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-1 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="font-extrabold text-slate-800">Progreso fenológico</span>
                            {{#if this.currentStage}}
                            <span class="rounded-md bg-emerald-100/80 px-2 py-0.5 text-[11px] font-bold text-[#1b4332]">
                                Etapa: {{this.currentStage.stage_name}}
                            </span>
                            {{/if}}
                        </div>
                        <span class="font-['Geist_Mono'] font-black text-[#1b4332] text-sm">{{this.progressPercent}}%</span>
                    </div>

                    <progress
                        value="{{this.progressPercent}}"
                        max="100"
                        aria-label="Progreso fenológico de {{this.crop.name}}"
                        class="block h-2.5 w-full overflow-hidden rounded-full accent-[#1b4332] [&::-webkit-progress-bar]:rounded-full [&::-webkit-progress-bar]:bg-slate-200 [&::-webkit-progress-value]:rounded-full [&::-webkit-progress-value]:bg-[#1b4332] [&::-moz-progress-bar]:bg-[#1b4332]"
                    >{{this.progressPercent}}%</progress>

                    <div class="mt-2 flex items-center justify-between text-[11px] text-slate-500">
                        {{#if this.elapsedDays}}
                        <span class="font-['Geist_Mono']">Día {{this.elapsedDays}} de {{this.harvestDays}}</span>
                        {{else}}
                        <span>Inicio del ciclo</span>
                        {{/if}}
                        {{#if this.isCompleted}}
                        <span class="font-bold text-emerald-700">Ciclo cosechado / completado</span>
                        {{else if this.estimatedHarvestDate}}
                        <span>Proyección: <strong class="font-['Geist_Mono'] text-slate-800">{{this.estimatedHarvestDate}}</strong></span>
                        {{/if}}
                    </div>
                </div>

                <!-- Línea de tiempo de etapas fenológicas -->
                <ol class="mt-4 space-y-2">
                    {{#each this.stages}}
                    <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl p-2.5 text-xs transition-colors {{#if this.isCompleted}}bg-emerald-50/70 border border-emerald-200/80{{else if this.isInProgress}}bg-[#1b4332]/5 border border-[#1b4332]/25{{else}}bg-slate-50 border border-transparent{{/if}}">
                        <div class="flex items-center gap-2">
                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full font-['Geist_Mono'] text-[10px] font-black {{#if this.isCompleted}}bg-emerald-600 text-white{{else if this.isInProgress}}bg-[#1b4332] text-white{{else}}bg-white text-slate-500 border border-slate-200{{/if}}">
                                {{#if this.isCompleted}}✓{{else}}{{this.stage_order}}{{/if}}
                            </span>
                            <div>
                                <span class="font-bold text-slate-900">{{this.stage_name}}</span>
                                <span class="ml-1 font-['Geist_Mono'] text-[11px] text-slate-500">({{this.estimated_date}})</span>
                            </div>
                        </div>

                        {{#if this.isCompleted}}
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-emerald-700 text-[11px]">Completada</span>
                            {{#if @root.permissions.canEdit}}
                            <form
                                action="/private/lands/{{@root.land.id}}/cycles/revert-stage"
                                method="POST"
                                class="inline"
                                data-confirm-form="cycle-revert"
                                data-confirm-name="{{this.stage_name}}"
                            >
                                <input type="hidden" name="farm_crop_id" value="{{../id}}" />
                                <input type="hidden" name="target_stage_order" value="{{this.stage_order}}" />
                                <button type="submit" class="rounded-md px-2 py-0.5 text-[10px] font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-200 transition-colors" title="Revertir a esta etapa si el avance en campo fue erróneo">
                                    ↺ Volver aquí
                                </button>
                            </form>
                            {{/if}}
                        </div>
                        {{/if}}
                        {{#if this.isPending}}
                        <span class="font-medium text-slate-400 text-[11px]">Pendiente</span>
                        {{/if}}
                        {{#if this.isInProgress}}
                        {{#if @root.permissions.canEdit}}
                        <form action="/private/lands/{{@root.land.id}}/cycles/advance" method="POST" class="flex items-center gap-2">
                            <input type="hidden" name="farm_crop_id" value="{{../id}}" />
                            <input type="hidden" name="stage_order" value="{{this.stage_order}}" />
                            <button type="submit" class="rounded-lg border border-[#1b4332]/40 bg-white px-2.5 py-1 text-xs font-bold text-[#1b4332] hover:bg-[#1b4332] hover:text-white transition-colors shadow-xs">
                                Confirmar etapa
                            </button>
                        </form>
                        {{else}}
                        <span class="font-bold text-[#1b4332] text-[11px]">En curso</span>
                        {{/if}}
                        {{/if}}
                    </li>
                    {{/each}}
                </ol>
            </div>

            <!-- Acciones al pie de la tarjeta: Finalizar o Archivar -->
            <div class="mt-5 flex flex-wrap items-center justify-end gap-3 pt-3 border-t border-slate-200/80">
                {{#if this.is_active}}
                    {{#if @root.permissions.canEdit}}
                    <form
                        action="/private/lands/{{@root.land.id}}/cycles/finish"
                        method="POST"
                        data-confirm-form="cycle-finish"
                        data-confirm-name="{{this.crop.name}}"
                    >
                        <input type="hidden" name="farm_crop_id" value="{{this.id}}" />
                        <button type="submit" class="inline-flex items-center gap-1 text-xs font-bold text-amber-800 hover:text-amber-900 hover:underline">
                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                            <span>Finalizar / Cosechar ciclo</span>
                        </button>
                    </form>
                    {{/if}}
                {{else}}
                    {{#if @root.permissions.canEdit}}
                    <form
                        action="/private/lands/{{@root.land.id}}/cycles/archive"
                        method="POST"
                        data-confirm-form="cycle-archive"
                        data-confirm-name="{{this.crop.name}}"
                    >
                        <input type="hidden" name="farm_crop_id" value="{{this.id}}" />
                        <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-xs">
                            <i data-lucide="archive" class="h-3.5 w-3.5"></i>
                            <span>Archivar cultivo cosechado</span>
                        </button>
                    </form>
                    {{/if}}
                {{/if}}
            </div>
        </article>
        {{/each}}
    </div>
    {{else}}
        {{#if archivedFarmCropsCount}}
        <p class="mt-5 rounded-xl border border-dashed border-slate-200 p-6 text-center text-sm text-slate-500">
            No hay ciclos activos en seguimiento. Tienes {{archivedFarmCropsCount}} cultivo(s) cosechado(s) y archivado(s) abajo.
        </p>
        {{else}}
        <p class="mt-5 rounded-xl border border-dashed border-slate-200 p-6 text-center text-sm text-slate-500">
            Todavía no hay ciclos de cultivo registrados en este terreno.
        </p>
        {{/if}}
    {{/if}}

    <!-- Sección colapsable de cultivos archivados -->
    {{#if archivedFarmCropsCount}}
    <details class="mt-6 rounded-2xl border border-dashed border-slate-200 bg-slate-50/60 p-5 group">
        <summary class="cursor-pointer text-sm font-extrabold text-slate-600 hover:text-slate-900 flex items-center justify-between select-none">
            <div class="flex items-center gap-2">
                <i data-lucide="folder-archive" class="h-4 w-4 text-slate-500"></i>
                <span>Cultivos archivados</span>
                <span class="rounded-full bg-white border border-slate-200 px-2 py-0.5 font-['Geist_Mono'] text-xs font-bold text-slate-800">{{archivedFarmCropsCount}}</span>
            </div>
            <span class="text-xs font-bold text-[#1b4332] group-open:hidden">Mostrar archivados ↓</span>
            <span class="text-xs font-bold text-[#1b4332] hidden group-open:inline">Ocultar archivados ↑</span>
        </summary>

        <div class="mt-4 grid gap-4 lg:grid-cols-2 pt-3 border-t border-slate-200/80">
            {{#each archivedFarmCrops}}
            <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-xs opacity-90 hover:opacity-100 transition-opacity" data-cycle-lot="{{#if this.area_section}}{{this.area_section}}{{else}}General{{/if}}">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="font-extrabold text-slate-900">{{this.crop.name}}</p>
                            {{#if this.crop.id}}
                            <a href="/private/crops/{{this.crop.id}}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded bg-emerald-50 px-1.5 py-0.5 text-[10px] font-bold text-[#1b4332] hover:bg-emerald-100 transition-colors" title="Ver ficha técnica agronómica">
                                Ficha ↗
                            </a>
                            {{/if}}
                            <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold text-slate-600">Archivado</span>
                        </div>
                        <p class="text-xs italic text-slate-500">{{this.crop.scientific_name}}</p>
                        <p class="mt-1 font-['Geist_Mono'] text-xs text-slate-500">
                            Siembra: {{this.plantingDate}}{{#if this.estimatedHarvestDate}} · Cosecha: {{this.estimatedHarvestDate}}{{/if}}{{#if this.area_section}} · {{this.area_section}}{{/if}}
                        </p>
                    </div>
                    {{#if @root.permissions.canEdit}}
                    <form action="/private/lands/{{@root.land.id}}/cycles/restore" method="POST">
                        <input type="hidden" name="farm_crop_id" value="{{this.id}}" />
                        <button type="submit" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-xs" title="Restaurar cultivo">
                            Desarchivar
                        </button>
                    </form>
                    {{/if}}
                </div>
            </article>
            {{/each}}
        </div>
    </details>
    {{/if}}
</section>
