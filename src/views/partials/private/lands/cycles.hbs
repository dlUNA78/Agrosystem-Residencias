<section class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-lg font-extrabold text-foreground">Ciclos de cultivo</h2>
            <p class="mt-1 text-sm text-muted-foreground">{{farmCropsCount}} ciclo(s) registrado(s) en este terreno.</p>
        </div>
        {{#if permissions.canEdit}}
        <button type="button" data-land-modal-open="cycle" class="rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-white hover:bg-primary/90">Registrar ciclo</button>
        {{/if}}
    </div>

    {{#if farmCrops}}
    <div class="mt-5 grid gap-4 lg:grid-cols-2">
        {{#each farmCrops}}
        <article class="rounded-xl border border-border p-5">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <p class="font-extrabold text-foreground">{{this.crop.name}}</p>
                    <p class="text-xs italic text-muted-foreground">{{this.crop.scientific_name}}</p>
                    <p class="mt-2 text-xs text-muted-foreground">Siembra: {{this.plantingDate}}{{#if this.area_section}} · {{this.area_section}}{{/if}}</p>
                </div>
                <span class="rounded-full px-2.5 py-1 text-[10px] font-black uppercase {{#if this.is_active}}bg-emerald-50 text-emerald-700{{else}}bg-slate-100 text-slate-600{{/if}}">{{this.statusLabel}}</span>
            </div>

            <div class="mt-4">
                <div class="mb-1 flex justify-between text-xs font-semibold text-muted-foreground">
                    <span>Progreso fenológico</span>
                    <span>{{this.progressPercent}}%</span>
                </div>
                <progress class="h-2 w-full accent-primary" value="{{this.progressPercent}}" max="100">{{this.progressPercent}}%</progress>
            </div>

            <ol class="mt-4 space-y-2">
                {{#each this.stages}}
                <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-muted px-3 py-2 text-xs">
                    <div>
                        <span class="font-bold text-foreground">{{this.stage_order}}. {{this.stage_name}}</span>
                        <span class="ml-1 text-muted-foreground">{{this.estimated_date}}</span>
                    </div>
                    {{#if this.isCompleted}}
                    <span class="font-bold text-emerald-700">Completada</span>
                    {{/if}}
                    {{#if this.isPending}}
                    <span class="font-bold text-slate-500">Pendiente</span>
                    {{/if}}
                    {{#if this.isInProgress}}
                    <form action="/private/lands/{{@root.land.id}}/cycles/advance" method="POST" class="flex items-center gap-2">
                        <input type="hidden" name="farm_crop_id" value="{{../id}}" />
                        <input type="hidden" name="stage_order" value="{{this.stage_order}}" />
                        <button type="submit" class="rounded-lg border border-primary/30 bg-card px-3 py-1.5 font-bold text-primary hover:bg-primary/5">Confirmar etapa</button>
                    </form>
                    {{/if}}
                </li>
                {{/each}}
            </ol>

            {{#if this.is_active}}
            {{#if @root.permissions.canEdit}}
            <form action="/private/lands/{{@root.land.id}}/cycles/finish" method="POST" class="mt-4 flex justify-end">
                <input type="hidden" name="farm_crop_id" value="{{this.id}}" />
                <button type="submit" class="text-xs font-bold text-amber-700 hover:underline">Finalizar ciclo</button>
            </form>
            {{/if}}
            {{/if}}
        </article>
        {{/each}}
    </div>
    {{else}}
    <p class="mt-5 rounded-xl border border-dashed border-border p-6 text-center text-sm text-muted-foreground">Todavía no hay ciclos de cultivo registrados.</p>
    {{/if}}
</section>
