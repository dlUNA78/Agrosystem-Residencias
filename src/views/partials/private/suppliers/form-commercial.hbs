<!-- ================================================= -->
<!-- 📦 INFORMACIÓN DEL SUMINISTRO -->
<!-- ================================================= -->
<section>
    <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-primary">
            inventory_2
        </span>
        <h3 class="text-sm font-extrabold text-on-surface">
            Información del suministro
        </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Productos que suministra -->
        <div class="md:col-span-2">
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Productos que suministra
            </label>
            <textarea id="supplier-supplied-products" name="supplied_products" rows="3"
                placeholder="Ej. Fertilizantes, insecticidas, semillas..." required
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none resize-none focus:ring-2 focus:ring-primary/20"></textarea>
        </div>

        <!-- Marcas -->
        <div class="md:col-span-2">
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Marcas que maneja
            </label>
            <input type="text" id="supplier-brands" name="brands"
                placeholder="Ej. Bayer, Syngenta, Corteva..."
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>

        <!-- Tiempo de entrega -->
        <div>
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Tiempo de entrega
            </label>
            <input type="text" id="supplier-delivery-time" name="delivery_time" placeholder="Ej. 3 a 5 días"
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>

        <!-- Compra mínima -->
        <div>
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Compra mínima
            </label>
            <input type="number" id="supplier-minimum-order" name="minimum_order" placeholder="0.00" min="0"
                step="0.01"
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>
    </div>
</section>

<!-- ================================================= -->
<!-- 💳 INFORMACIÓN COMERCIAL -->
<!-- ================================================= -->
<section>
    <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-primary">
            payments
        </span>
        <h3 class="text-sm font-extrabold text-on-surface">
            Información comercial
        </h3>
    </div>

    <div>
        <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
            Forma de pago
        </label>
        <select id="supplier-payment-method" name="payment_method"
            class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
            <option value="">
                Seleccionar forma de pago...
            </option>
            <option value="efectivo">
                Efectivo
            </option>
            <option value="transferencia">
                Transferencia bancaria
            </option>
            <option value="tarjeta">
                Tarjeta
            </option>
            <option value="credito">
                Crédito
            </option>
            <option value="contado">
                Contado
            </option>
        </select>
    </div>
</section>

<!-- ================================================= -->
<!-- ⚙️ CONTROL -->
<!-- ================================================= -->
<section>
    <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-primary">
            settings
        </span>
        <h3 class="text-sm font-extrabold text-on-surface">
            Control del proveedor
        </h3>
    </div>

    <div>
        <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
            Estatus
        </label>
        <select id="supplier-status" name="status" required
            class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
            <option value="pendiente">
                Pendiente
            </option>
            <option value="activo">
                Activo
            </option>
            <option value="inactivo">
                Inactivo
            </option>
        </select>
    </div>
</section>
