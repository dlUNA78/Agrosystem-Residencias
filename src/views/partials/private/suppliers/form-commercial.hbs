<section class="space-y-3.5">
  <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
    <i data-lucide="package" class="h-4 w-4 text-[#1b4332]"></i>
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
      Información del suministro y condiciones
    </h3>
  </div>

  <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2">
    <div class="md:col-span-2">
      <label
        for="supplier-supplied-products"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Productos que suministra *
      </label>
      <textarea
        id="supplier-supplied-products"
        name="supplied_products"
        rows="3"
        placeholder="Ej. Fertilizantes nitrogenados, insecticidas biorracionales, semillas certificadas..."
        required
        class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      ></textarea>
    </div>

    <div class="md:col-span-2">
      <label
        for="supplier-brands"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Marcas representadas
      </label>
      <input
        type="text"
        id="supplier-brands"
        name="brands"
        placeholder="Ej. Bayer, Syngenta, Corteva, FMC..."
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-delivery-time"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Tiempo de entrega
      </label>
      <input
        type="text"
        id="supplier-delivery-time"
        name="delivery_time"
        placeholder="Ej. 3 a 5 días hábiles"
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-minimum-order"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Compra mínima (MXN)
      </label>
      <input
        type="number"
        id="supplier-minimum-order"
        name="minimum_order"
        placeholder="0.00"
        min="0"
        step="0.01"
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 font-['Geist_Mono'] text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-payment-method"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Forma de pago
      </label>
      <select
        id="supplier-payment-method"
        name="payment_method"
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      >
        <option value="">Seleccionar forma de pago...</option>
        <option value="efectivo">Efectivo</option>
        <option value="transferencia">Transferencia bancaria</option>
        <option value="tarjeta">Tarjeta</option>
        <option value="credito">Crédito</option>
        <option value="contado">Contado</option>
      </select>
    </div>

    <div>
      <label
        for="supplier-status"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Estatus operativo *
      </label>
      <select
        id="supplier-status"
        name="status"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      >
        <option value="pendiente">Pendiente</option>
        <option value="activo">Activo</option>
        <option value="inactivo">Inactivo</option>
      </select>
    </div>
  </div>
</section>
