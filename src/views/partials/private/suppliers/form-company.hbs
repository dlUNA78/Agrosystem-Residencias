<section class="space-y-3.5">
  <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
    <i data-lucide="building-2" class="h-4 w-4 text-[#1b4332]"></i>
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
      Datos de la empresa
    </h3>
  </div>

  <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2">
    <div class="md:col-span-2">
      <label
        for="supplier-name"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Nombre o razón social *
      </label>
      <input
        type="text"
        id="supplier-name"
        name="name"
        placeholder="Razón social de la empresa"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-commercial-name"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Nombre comercial
      </label>
      <input
        type="text"
        id="supplier-commercial-name"
        name="commercial_name"
        placeholder="Nombre comercial"
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-rfc"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        RFC *
      </label>
      <input
        type="text"
        id="supplier-rfc"
        name="rfc"
        placeholder="ABC123456XYZ"
        maxlength="13"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 font-['Geist_Mono'] text-xs uppercase text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div class="md:col-span-2">
      <label
        for="supplier-supply-type"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Tipo de suministro *
      </label>
      <select
        id="supplier-supply-type"
        name="supply_type"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      >
        <option value="">Seleccionar tipo de suministro...</option>
        <option value="agroquimicos">Agroquímicos</option>
        <option value="semillas">Semillas</option>
        <option value="equipo">Equipo agrícola</option>
        <option value="fertilizantes">Fertilizantes</option>
        <option value="herramientas">Herramientas</option>
        <option value="servicios">Servicios</option>
        <option value="otros">Otros</option>
      </select>
    </div>
  </div>
</section>
