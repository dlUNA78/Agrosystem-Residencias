<div
  id="suppliers-grid-view"
  class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
>
  {{#each suppliers}}
  <article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
    <div>
      <div class="border-b border-slate-100 p-4">
        <div class="flex items-start justify-between gap-2.5">
          <div class="flex min-w-0 items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-[#1b4332]">
              <i data-lucide="building-2" class="h-5 w-5"></i>
            </div>
            <div class="min-w-0">
              <h3 class="truncate text-sm font-bold text-slate-900" title="{{name}}">
                {{name}}
              </h3>
              {{#if commercial_name}}
              <p class="truncate text-xs text-slate-500" title="{{commercial_name}}">
                {{commercial_name}}
              </p>
              {{/if}}
            </div>
          </div>

          {{#if (eq status "activo")}}
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold uppercase text-emerald-700">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
            Activo
          </span>
          {{else if (eq status "pendiente")}}
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase text-amber-700">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
            Pendiente
          </span>
          {{else}}
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-semibold uppercase text-rose-700">
            <span class="h-1.5 w-1.5 rounded-full bg-rose-600"></span>
            Inactivo
          </span>
          {{/if}}
        </div>
      </div>

      <div class="space-y-3 p-4 text-xs">
        <div class="flex items-center justify-between gap-2">
          <span class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-400">
            RFC
          </span>
          <span class="rounded-md bg-slate-100 px-2 py-0.5 font-['Geist_Mono'] text-[11px] font-semibold text-slate-700">
            {{rfc}}
          </span>
        </div>

        <div class="rounded-xl bg-slate-50/80 p-2.5">
          <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-400">
            Contacto comercial
          </p>
          <p class="mt-0.5 font-semibold text-slate-800">{{contact_name}}</p>
          <p class="truncate text-[11px] text-slate-500">{{email}}</p>
          <p class="font-['Geist_Mono'] text-[11px] text-slate-500">{{phone}}</p>
        </div>

        <div class="flex items-start gap-2 text-slate-600">
          <i data-lucide="map-pin" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-slate-400"></i>
          <div class="min-w-0">
            <p class="truncate font-medium text-slate-800">{{city}}, {{state}}</p>
            <p class="font-['Geist_Mono'] text-[11px] text-slate-500">C.P. {{postal_code}}</p>
          </div>
        </div>

        <div>
          <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wide text-[#1b4332]">
            {{supply_type}}
          </span>
          <p class="mt-1.5 line-clamp-2 text-[11px] leading-relaxed text-slate-600">
            {{supplied_products}}
          </p>
        </div>

        {{#if brands}}
        <p class="truncate border-t border-slate-100 pt-2.5 text-[11px] text-slate-500">
          <strong class="font-semibold text-slate-700">Marcas:</strong> {{brands}}
        </p>
        {{/if}}
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50/60 px-4 py-2.5">
      <span class="font-['Geist_Mono'] text-[11px] text-slate-400">
        {{#if delivery_time}}{{delivery_time}}{{else}}Entrega estándar{{/if}}
      </span>
      <div class="flex items-center gap-1">
        <button
          type="button"
          class="btn-edit-supplier rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-white hover:text-[#1b4332] cursor-pointer"
          title="Editar proveedor"
          aria-label="Editar proveedor {{name}}"
          data-id="{{id}}"
          data-name="{{name}}"
          data-commercial-name="{{commercial_name}}"
          data-rfc="{{rfc}}"
          data-supply-type="{{supply_type}}"
          data-contact-name="{{contact_name}}"
          data-contact-position="{{contact_position}}"
          data-email="{{email}}"
          data-alternative-email="{{alternative_email}}"
          data-phone="{{phone}}"
          data-alternative-phone="{{alternative_phone}}"
          data-address="{{address}}"
          data-city="{{city}}"
          data-state="{{state}}"
          data-postal-code="{{postal_code}}"
          data-country="{{country}}"
          data-supplied-products="{{supplied_products}}"
          data-brands="{{brands}}"
          data-delivery-time="{{delivery_time}}"
          data-minimum-order="{{minimum_order}}"
          data-payment-method="{{payment_method}}"
          data-status="{{status}}"
        >
          <i data-lucide="pencil" class="h-4 w-4"></i>
        </button>
        <button
          type="button"
          class="btn-delete-supplier rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-rose-50 hover:text-rose-600 cursor-pointer"
          title="Eliminar proveedor"
          aria-label="Eliminar proveedor {{name}}"
          data-id="{{id}}"
          data-name="{{name}}"
        >
          <i data-lucide="trash-2" class="h-4 w-4"></i>
        </button>
      </div>
    </div>
  </article>
  {{else}}
  <div class="col-span-full rounded-2xl border border-slate-200/90 bg-white py-14 text-center shadow-2xs">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
      <i data-lucide="building-2" class="h-6 w-6"></i>
    </div>
    <p class="mt-3 text-sm font-semibold text-slate-700">
      No hay proveedores registrados con estos criterios
    </p>
    <p class="mt-1 text-xs text-slate-500">
      Usa el botón superior o la tarjeta inferior para dar de alta un nuevo proveedor.
    </p>
  </div>
  {{/each}}

  <button
    type="button"
    id="btn-add-supplier-card"
    class="group flex min-h-[210px] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-white/70 p-6 text-center transition-all hover:border-[#1b4332]/40 hover:bg-emerald-50/30 cursor-pointer"
  >
    <span class="mb-2.5 flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-slate-500 transition-colors group-hover:bg-[#1b4332] group-hover:text-white">
      <i data-lucide="plus" class="h-5 w-5"></i>
    </span>
    <span class="text-xs font-bold text-slate-700 group-hover:text-[#1b4332]">
      Añadir proveedor
    </span>
    <span class="mt-0.5 text-[11px] text-slate-400">
      Registrar empresa o distribuidor
    </span>
  </button>
</div>
