<!-- MODAL CONFIRMAR ELIMINACIÓN -->
<div id="modal-delete-supplier"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4">

    <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md">

        <!-- Header -->

        <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/10">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center">

                    <span class="material-symbols-outlined text-red-600">
                        delete
                    </span>

                </div>

                <div>

                    <h2 class="text-base font-extrabold text-on-surface">
                        Eliminar proveedor
                    </h2>

                    <p class="text-xs text-on-surface-variant">
                        Esta acción no se puede deshacer
                    </p>

                </div>

            </div>

            <button id="btn-close-delete-supplier" type="button"
                class="p-2 rounded-lg text-on-surface-variant hover:bg-surface-container-low">

                <span class="material-symbols-outlined">
                    close
                </span>

            </button>

        </div>


        <!-- Body -->

        <div class="px-6 py-6">

            <p class="text-sm text-on-surface-variant">
                ¿Estás seguro de que quieres eliminar este proveedor?
            </p>

            <div class="mt-4 p-4 rounded-xl bg-surface-container-low">

                <p class="text-xs uppercase tracking-widest font-black text-on-surface-variant">
                    Proveedor
                </p>

                <p id="delete-supplier-name" class="mt-1 text-base font-bold text-on-surface">

                </p>

            </div>

        </div>


        <!-- Footer -->

        <div class="px-6 py-5 bg-surface-container-low/50 border-t border-outline-variant/10 flex justify-end gap-3">

            <button id="btn-cancel-delete-supplier" type="button"
                class="px-5 py-2.5 rounded-lg text-sm font-bold text-on-surface-variant hover:bg-surface-container-low">

                Cancelar

            </button>


            <form id="form-delete-supplier" method="POST">

                <button type="submit"
                    class="px-5 py-2.5 rounded-lg bg-red-600 text-white text-sm font-bold hover:bg-red-700 transition-colors flex items-center gap-2">

                    <span class="material-symbols-outlined text-base">
                        delete
                    </span>

                    Sí, eliminar

                </button>

            </form>

        </div>

    </div>

</div>
