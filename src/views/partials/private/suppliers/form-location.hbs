<section class="space-y-3.5">
  <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
    <i data-lucide="map-pin" class="h-4 w-4 text-[#1b4332]"></i>
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
      Ubicación fiscal y logística
    </h3>
  </div>

  <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2">
    <div class="md:col-span-2">
      <label
        for="supplier-address"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Dirección *
      </label>
      <input
        type="text"
        id="supplier-address"
        name="address"
        placeholder="Calle, número y colonia"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-city"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Ciudad / Municipio *
      </label>
      <input
        type="text"
        id="supplier-city"
        name="city"
        placeholder="Ciudad"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-state"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Estado *
      </label>
      <input
        type="text"
        id="supplier-state"
        name="state"
        placeholder="Estado"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-postal-code"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Código postal *
      </label>
      <input
        type="text"
        id="supplier-postal-code"
        name="postal_code"
        placeholder="00000"
        maxlength="5"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 font-['Geist_Mono'] text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-country"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        País *
      </label>
      <input
        type="text"
        id="supplier-country"
        name="country"
        value="México"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>
  </div>
</section>
