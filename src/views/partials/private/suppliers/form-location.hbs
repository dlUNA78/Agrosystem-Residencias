<!-- 📍 UBICACIÓN -->
<!-- ================================================= -->
<section>
    <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-primary">
            location_on
        </span>
        <h3 class="text-sm font-extrabold text-on-surface">
            Ubicación
        </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Dirección -->
        <div class="md:col-span-2">
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Dirección
            </label>
            <input type="text" id="supplier-address" name="address" placeholder="Calle, número y colonia"
                required
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>

        <!-- Ciudad -->
        <div>
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Ciudad
            </label>
            <input type="text" id="supplier-city" name="city" placeholder="Ciudad" required
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>

        <!-- Estado -->
        <div>
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Estado
            </label>
            <input type="text" id="supplier-state" name="state" placeholder="Estado" required
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>

        <!-- Código postal -->
        <div>
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                Código postal
            </label>
            <input type="text" id="supplier-postal-code" name="postal_code" placeholder="00000"
                maxlength="5" required
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>

        <!-- País -->
        <div>
            <label class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant block mb-1.5">
                País
            </label>
            <input type="text" id="supplier-country" name="country" value="México" required
                class="w-full px-4 py-3 bg-surface-container-low rounded-lg text-sm border-none focus:ring-2 focus:ring-primary/20">
        </div>
    </div>
</section>
