<section class="space-y-3.5">
  <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
    <i data-lucide="phone-call" class="h-4 w-4 text-[#1b4332]"></i>
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
      Datos de contacto
    </h3>
  </div>

  <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2">
    <div>
      <label
        for="supplier-contact-name"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Nombre del contacto *
      </label>
      <input
        type="text"
        id="supplier-contact-name"
        name="contact_name"
        placeholder="Nombre completo"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-contact-position"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Puesto del contacto
      </label>
      <input
        type="text"
        id="supplier-contact-position"
        name="contact_position"
        placeholder="Ej. Gerente de cuentas institucionales"
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-email"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Correo electrónico *
      </label>
      <input
        type="email"
        id="supplier-email"
        name="email"
        placeholder="contacto@empresa.com"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-alternative-email"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Correo alternativo
      </label>
      <input
        type="email"
        id="supplier-alternative-email"
        name="alternative_email"
        placeholder="ventas@empresa.com"
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-phone"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Teléfono principal *
      </label>
      <input
        type="tel"
        id="supplier-phone"
        name="phone"
        placeholder="Número principal"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 font-['Geist_Mono'] text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>

    <div>
      <label
        for="supplier-alternative-phone"
        class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600"
      >
        Teléfono alternativo
      </label>
      <input
        type="tel"
        id="supplier-alternative-phone"
        name="alternative_phone"
        placeholder="Número alternativo"
        class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 font-['Geist_Mono'] text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
      />
    </div>
  </div>
</section>
