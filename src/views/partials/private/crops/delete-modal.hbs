<!-- ========================================================= -->
<!-- MODAL ELIMINAR CULTIVO (CONFIRMACIÓN INIFAP)              -->
<!-- ========================================================= -->
{{#if permissions.canDelete}}
<div id="modal-delete-crop" role="dialog" aria-modal="true" aria-labelledby="delete-crop-title" class="fixed inset-0 z-100 hidden items-center justify-center p-4 font-['Geist']">
  <div id="modal-delete-crop-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-xs"></div>
  <div class="relative z-10 w-full max-w-md bg-card border border-border/80 rounded-2xl shadow-xl overflow-hidden">
    <div class="p-6 border-b border-border/60">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
          <i data-lucide="alert-triangle" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 id="delete-crop-title" class="text-base font-bold text-foreground">¿Dar de baja / Archivar cultivo?</h3>
          <p class="mt-0.5 text-xs text-muted-foreground">
            Política de preservación INIFAP: La ficha se retirará del portal público y pasará a la bandeja de Archivados sin destruir sus vínculos históricos.
          </p>
        </div>
      </div>
    </div>
    <div class="p-6 text-xs text-muted-foreground">
      ¿Confirmas la baja lógica y archivado del cultivo <strong id="delete-crop-name" class="text-foreground"></strong>?
    </div>
    <div class="px-6 py-4 bg-muted/40 border-t border-border/60 flex justify-end gap-2">
      <button type="button" id="modal-delete-crop-cancel"
        class="px-4 py-2 rounded-xl border border-border/80 text-xs font-bold text-muted-foreground hover:bg-muted transition-colors cursor-pointer">
        Cancelar
      </button>
      <form id="delete-crop-form" method="POST">
        <input type="hidden" name="mode" value="archive" />
        <button type="submit"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-600 text-white text-xs font-bold hover:bg-amber-700 transition-colors shadow-2xs cursor-pointer">
          <i data-lucide="archive" class="w-3.5 h-3.5"></i>
          <span>Archivar cultivo</span>
        </button>
      </form>
    </div>
  </div>
</div>
{{/if}}
