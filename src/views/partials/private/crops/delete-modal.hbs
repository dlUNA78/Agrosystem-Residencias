{{#if permissions.canDelete}}
<div id="modal-delete-crop" role="dialog" aria-modal="true" aria-labelledby="delete-crop-title" class="fixed inset-0 z-100 hidden items-center justify-center p-4">
  <div id="modal-delete-crop-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative w-full max-w-md overflow-hidden rounded-2xl border border-border bg-card text-foreground shadow-2xl">
    <div class="p-6">
      <span class="inline-flex shrink-0 rounded-xl bg-rose-50 p-3 text-rose-700" aria-hidden="true">{{> private/crops/icon name="delete_forever"}}</span>
      <h2 id="delete-crop-title" class="mt-4 text-xl font-bold">Eliminar cultivo</h2>
      <p class="mt-2 break-words text-sm text-muted-foreground">Se eliminará <strong id="delete-crop-name" class="text-foreground"></strong>. Esta acción no se puede deshacer.</p>
    </div>
    <div class="flex justify-end gap-2 border-t border-border bg-muted/30 px-6 py-4">
      <button type="button" id="modal-delete-crop-cancel" class="rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-bold hover:bg-muted">Cancelar</button>
      <form id="delete-crop-form" method="POST">
        <button type="submit" class="rounded-xl bg-destructive px-4 py-2.5 text-xs font-bold text-white hover:bg-destructive/90">Eliminar cultivo</button>
      </form>
    </div>
  </div>
</div>
{{/if}}
