<!-- ========================================================= -->
<!-- MODAL CAPTURA / EDICIÓN DE CULTIVO (EXPEDIENTE TÉCNICO)   -->
<!-- ========================================================= -->
{{#if permissions.canEdit}}
<div id="modal-crop" role="dialog" aria-modal="true" aria-labelledby="modal-crop-title" class="fixed inset-0 z-100 hidden items-center justify-center p-2 sm:p-4 font-['Geist']">
  <div id="modal-crop-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-xs"></div>
  <div class="relative z-10 flex max-h-[94dvh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-border/80 bg-card text-foreground shadow-2xl">
    <header class="flex shrink-0 items-start justify-between gap-4 border-b border-border/80 px-5 py-4 sm:px-6 bg-card">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#2d6a4f] bg-[#e6f0e6] px-2 py-0.5 rounded-md">Catálogo Agronómico · INIFAP</span>
          <span class="px-2 py-0.5 rounded-full bg-muted text-[10px] font-mono text-muted-foreground">Ficha técnica</span>
        </div>
        <h2 id="modal-crop-title" class="text-lg font-headline font-black text-foreground mt-1">Nuevo Cultivo</h2>
        <p class="mt-0.5 text-xs text-muted-foreground">Completa la ficha técnica. Los campos con * son obligatorios para guardar.</p>
      </div>
      <button id="modal-crop-close" type="button" aria-label="Cerrar formulario" class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </header>
    <form id="crop-form" method="POST" action="/private/crops/create" enctype="multipart/form-data" novalidate class="flex min-h-0 flex-1 flex-col">
      <div class="min-h-0 overflow-y-auto overscroll-contain bg-background p-4 sm:p-6">
        <div id="crop-form-validation-summary" role="alert" aria-live="assertive" tabindex="-1" class="hidden rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-destructive mb-5">
          <p class="text-sm font-bold">Revisa la información capturada</p>
          <p class="mt-1 text-xs">Corrige los campos marcados antes de guardar el cultivo.</p>
          <ul id="crop-form-validation-errors" class="mt-2 list-disc space-y-1 pl-5 text-xs"></ul>
        </div>
        <div class="space-y-5">
          {{> private/crops/form-identity}}
          {{> private/crops/form-region}}
          {{> private/crops/form-climate}}
          {{> private/crops/form-soil}}
          {{> private/crops/form-production}}
          {{> private/crops/form-requirements}}
          {{> private/crops/form-management}}
          {{> private/crops/form-notes}}
          {{> private/crops/form-images}}
        </div>
      </div>
      <footer class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-t border-border/80 bg-card px-5 py-4 sm:px-6">
        <p class="text-xs text-muted-foreground">Se guarda como ficha de trabajo antes del dictamen editorial.</p>
        <div class="flex items-center gap-2">
          <button id="modal-crop-cancel" type="button" class="px-4 py-2.5 rounded-xl border border-border/80 text-xs font-bold text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer">Cancelar</button>
          <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-[#1b4332] px-5 py-2.5 text-xs font-bold text-white hover:bg-[#2d6a4f] transition-all shadow-md active:scale-95 cursor-pointer">
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>Guardar cultivo</span>
          </button>
        </div>
      </footer>
    </form>
  </div>
</div>
{{/if}}
