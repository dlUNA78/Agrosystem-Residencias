{{#if permissions.canEdit}}
<div id="modal-crop" role="dialog" aria-modal="true" aria-labelledby="modal-crop-title" class="fixed inset-0 z-100 hidden items-center justify-center p-2 sm:p-4">
  <div id="modal-crop-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative flex max-h-[94dvh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-border bg-card text-foreground shadow-2xl">
    <header class="flex shrink-0 items-start justify-between gap-4 border-b border-border px-4 py-5 sm:px-6">
      <div>
        <p class="mb-1 font-mono text-[10px] font-bold uppercase tracking-widest text-primary">Catálogo agronómico · INIFAP</p>
        <h2 id="modal-crop-title" class="text-xl font-bold tracking-tight">Nuevo cultivo</h2>
        <p class="mt-1 text-xs text-muted-foreground">Completa la ficha técnica. Los campos con * son obligatorios para guardar.</p>
      </div>
      <button id="modal-crop-close" type="button" aria-label="Cerrar formulario" class="rounded-lg p-2 text-muted-foreground hover:bg-muted"><span class="inline-flex shrink-0" aria-hidden="true">{{> private/crops/icon name="close"}}</span></button>
    </header>
    <form id="crop-form" method="POST" action="/private/crops/create" enctype="multipart/form-data" novalidate class="flex min-h-0 flex-1 flex-col">
      <div class="min-h-0 overflow-y-auto overscroll-contain bg-background p-4 sm:p-6">
        <div id="crop-form-validation-summary" role="alert" aria-live="assertive" tabindex="-1" class="hidden rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-destructive">
          <p class="text-sm font-bold">Revisa la información capturada</p>
          <p class="mt-1 text-xs">Corrige los campos marcados antes de guardar el cultivo.</p>
          <ul id="crop-form-validation-errors" class="mt-2 list-disc space-y-1 pl-5 text-xs"></ul>
        </div>
        <div class="space-y-5">
          {{> private/crops/form-identity}}
          {{> private/crops/form-region}}
          {{> private/crops/form-climate}}
          {{> private/crops/form-soil}}
          {{> private/crops/form-production}}
          {{> private/crops/form-requirements}}
          {{> private/crops/form-management}}
          {{> private/crops/form-notes}}
          {{> private/crops/form-images}}
        </div>
      </div>
      <footer class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-t border-border bg-card px-4 py-4 sm:px-6">
        <p class="text-xs text-muted-foreground">Se guarda como ficha de trabajo antes de la revisión.</p>
        <div class="flex items-center gap-2">
          <button id="modal-crop-cancel" type="button" class="rounded-xl border border-border px-4 py-2.5 text-xs font-bold hover:bg-muted">Cancelar</button>
          <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-primary-foreground hover:bg-primary/90">
            <span class="inline-flex shrink-0 text-base" aria-hidden="true">{{> private/crops/icon name="save"}}</span>Guardar cultivo
          </button>
        </div>
      </footer>
    </form>
  </div>
</div>
{{/if}}
