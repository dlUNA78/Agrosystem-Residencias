<!-- ========================================================= -->
<!-- MODAL CAPTURA / EDICIÓN DE CULTIVO (EXPEDIENTE TÉCNICO)   -->
<!-- ========================================================= -->
{{#if permissions.canEdit}}
<div id="modal-crop" role="dialog" aria-modal="true" aria-labelledby="modal-crop-title" class="fixed inset-0 z-100 hidden items-center justify-center p-2 sm:p-4 font-['Geist']">
  <div id="modal-crop-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-xs"></div>
  <div class="relative z-10 flex max-h-[94dvh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-border/80 bg-card text-foreground shadow-2xl">
    <header class="flex shrink-0 items-start justify-between gap-4 border-b border-border/80 px-5 py-4 sm:px-6 bg-card">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#2d6a4f] bg-[#e6f0e6] px-2 py-0.5 rounded-md">Catálogo Agronómico · INIFAP</span>
          <span class="px-2 py-0.5 rounded-full bg-muted text-[10px] font-mono text-muted-foreground">Ficha técnica</span>
        </div>
        <h2 id="modal-crop-title" class="text-lg font-headline font-black text-foreground mt-1">Nuevo Cultivo</h2>
        <p class="mt-0.5 text-xs text-muted-foreground">Completa la ficha técnica. Los campos con * son obligatorios para guardar.</p>
      </div>
      <button id="modal-crop-close" type="button" aria-label="Cerrar formulario" class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </header>
    <form id="crop-form" method="POST" action="/private/crops/create" enctype="multipart/form-data" novalidate class="flex min-h-0 flex-1 flex-col">
      <input type="hidden" id="crop-controlled-edit" name="controlled_edit" value="0" />
      <input type="hidden" name="relations_submitted" value="1" />
      <div class="min-h-0 overflow-y-auto overscroll-contain bg-background p-4 sm:p-6">
        <div id="crop-form-validation-summary" role="alert" aria-live="assertive" tabindex="-1" class="hidden rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-destructive mb-5">
          <p class="text-sm font-bold">Revisa la información capturada</p>
          <p class="mt-1 text-xs">Corrige los campos marcados antes de guardar el cultivo.</p>
          <ul id="crop-form-validation-errors" class="mt-2 list-disc space-y-1 pl-5 text-xs"></ul>
        </div>
        <section id="crop-edit-control-banner" class="hidden rounded-2xl border border-amber-300 bg-amber-50/90 p-4 text-xs text-amber-950 space-y-3 mb-5">
          <div class="flex items-start gap-2.5">
            <i data-lucide="shield-alert" class="w-4 h-4 text-amber-700 shrink-0 mt-0.5"></i>
            <div>
              <p class="font-bold text-amber-950">Modo de Edición Controlada · Protección Botánica</p>
              <p class="mt-0.5 text-[11px] leading-relaxed text-amber-900">
                Los campos de identidad botánica (<strong class="font-semibold">Nombre común, Nombre científico y Categoría</strong>) están protegidos contra edición directa. Al guardar cambios sobre un cultivo verificado o publicado, el expediente pasará automáticamente a <strong class="font-semibold">Revisión Técnica</strong> para dictamen antes de publicarse.
              </p>
            </div>
          </div>
          <div>
            <label for="crop-edit-reason" class="mb-1.5 block text-xs font-bold text-amber-950">
              Justificación técnica de la modificación *
            </label>
            <textarea
              id="crop-edit-reason"
              name="edit_reason"
              rows="2"
              minlength="10"
              maxlength="500"
              disabled
              placeholder="Describe el sustento agronómico del cambio (mínimo 10 caracteres, ej. Ajuste de requerimientos hídricos y fenología regional)…"
              class="w-full rounded-xl border border-amber-300 bg-white px-3.5 py-2 text-xs text-foreground focus:border-[#1b4332] focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20"
            ></textarea>
          </div>
        </section>
        <div class="space-y-5">
          {{> private/crops/form-identity}}
          {{> private/crops/form-region}}
          {{> private/crops/form-climate}}
          {{> private/crops/form-soil}}
          {{> private/crops/form-production}}
          {{> private/crops/form-requirements}}
          {{> private/crops/form-management}}
          {{> private/crops/form-notes}}
          <section id="crop-section-relations" class="scroll-mt-4 rounded-2xl border border-border/80 bg-card p-4 sm:p-6 shadow-2xs space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-border/60">
              <div class="w-8 h-8 rounded-lg bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center shrink-0">
                <i data-lucide="network" class="w-4 h-4"></i>
              </div>
              <div>
                <h4 class="font-bold text-foreground">Vinculación con Catálogos Publicados</h4>
                <p class="text-xs text-muted-foreground">Relaciona las plagas o patógenos que afectan a este cultivo y los productos autorizados para su protección</p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="rounded-xl border border-border bg-muted/20 p-3.5 space-y-2.5">
                <div class="flex items-center justify-between gap-2">
                  <label class="text-xs font-bold text-foreground">Plagas y patógenos asociados</label>
                  <span id="crop-plague-selected-count" class="rounded-full bg-[#e6f0e6] px-2 py-0.5 font-mono text-[10px] font-bold text-[#1b4332]">0 seleccionados</span>
                </div>
                <input
                  type="search"
                  data-crop-relation-search="crop-plague-options"
                  placeholder="Filtrar plagas publicadas…"
                  class="w-full rounded-lg border border-input bg-card px-3 py-1.5 text-xs focus:border-[#1b4332] focus:outline-hidden"
                />
                <div id="crop-plague-options" data-counter-target="crop-plague-selected-count" class="max-h-44 space-y-1 overflow-y-auto pr-1">
                  {{#each relationOptions.plagues}}
                    <label class="relation-option flex cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-xs hover:bg-muted/60" data-search-text="{{this.name}} {{this.scientific_name}} {{this.category}}">
                      <input type="checkbox" name="plague_ids" value="{{this.id}}" class="rounded border-input text-[#1b4332] focus:ring-[#1b4332]/20" />
                      <span class="font-semibold text-foreground">{{this.name}}</span>
                      {{#if this.scientific_name}}
                        <span class="text-[11px] italic text-muted-foreground">({{this.scientific_name}})</span>
                      {{/if}}
                    </label>
                  {{else}}
                    <p class="py-4 text-center text-xs text-muted-foreground">No hay plagas publicadas disponibles.</p>
                  {{/each}}
                </div>
              </div>

              <div class="rounded-xl border border-border bg-muted/20 p-3.5 space-y-2.5">
                <div class="flex items-center justify-between gap-2">
                  <label class="text-xs font-bold text-foreground">Productos e insumos autorizados</label>
                  <span id="crop-product-selected-count" class="rounded-full bg-[#e6f0e6] px-2 py-0.5 font-mono text-[10px] font-bold text-[#1b4332]">0 seleccionados</span>
                </div>
                <input
                  type="search"
                  data-crop-relation-search="crop-product-options"
                  placeholder="Filtrar productos publicados…"
                  class="w-full rounded-lg border border-input bg-card px-3 py-1.5 text-xs focus:border-[#1b4332] focus:outline-hidden"
                />
                <div id="crop-product-options" data-counter-target="crop-product-selected-count" class="max-h-44 space-y-1 overflow-y-auto pr-1">
                  {{#each relationOptions.products}}
                    <label class="relation-option flex cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-xs hover:bg-muted/60" data-search-text="{{this.name}} {{this.active_ingredient}} {{this.category}}">
                      <input type="checkbox" name="product_ids" value="{{this.id}}" class="rounded border-input text-[#1b4332] focus:ring-[#1b4332]/20" />
                      <span class="font-semibold text-foreground">{{this.name}}</span>
                      {{#if this.active_ingredient}}
                        <span class="text-[11px] text-muted-foreground">({{this.active_ingredient}})</span>
                      {{/if}}
                    </label>
                  {{else}}
                    <p class="py-4 text-center text-xs text-muted-foreground">No hay productos publicados disponibles.</p>
                  {{/each}}
                </div>
              </div>
            </div>
          </section>
          {{> private/crops/form-images}}
        </div>
      </div>
      <footer class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-t border-border/80 bg-card px-5 py-4 sm:px-6">
        <p class="text-xs text-muted-foreground">Se guarda como ficha de trabajo antes del dictamen editorial.</p>
        <div class="flex items-center gap-2">
          <button id="modal-crop-cancel" type="button" class="px-4 py-2.5 rounded-xl border border-border/80 text-xs font-bold text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer">Cancelar</button>
          <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-[#1b4332] px-5 py-2.5 text-xs font-bold text-white hover:bg-[#2d6a4f] transition-all shadow-md active:scale-95 cursor-pointer">
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>Guardar cultivo</span>
          </button>
        </div>
      </footer>
    </form>
  </div>
</div>
{{/if}}
