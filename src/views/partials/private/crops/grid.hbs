<!-- ===================================================== -->
<!-- VISTA DE TARJETAS TÉCNICAS (GRID VIEW EN GEIST)       -->
<!-- ===================================================== -->
<section id="crops-grid-view" aria-label="Cultivos en tarjetas" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">

  {{#each crops}}
  <article class="group bg-card border border-border/80 rounded-2xl overflow-hidden shadow-2xs flex flex-col hover:border-[#1b4332]/50 hover:shadow-md transition-all duration-300">

    <!-- Imagen con Badges y Enlace a Detalle -->
    <a href="/private/crops/{{id}}" class="relative h-44 overflow-hidden bg-muted/50 block">
      {{#if image_url}}
      <img class="crop-list-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        src="{{image_url}}" alt="{{name}}" loading="lazy" data-fallback-src="/images/test/default.png">
      <div class="crop-image-fallback hidden w-full h-full flex-col items-center justify-center text-muted-foreground/40 gap-2">
        <i data-lucide="sprout" class="w-10 h-10 stroke-[1.5]"></i>
        <span class="text-[10px] font-mono uppercase tracking-widest">Imagen no disponible</span>
      </div>
      {{else}}
      <div class="w-full h-full flex flex-col items-center justify-center text-muted-foreground/40 gap-2">
        <i data-lucide="sprout" class="w-10 h-10 stroke-[1.5]"></i>
        <span class="text-[10px] font-mono uppercase tracking-widest">Sin imagen</span>
      </div>
      {{/if}}

      <!-- Workflow Status Badge -->
      <div class="absolute top-3 right-3">
        {{> private/crop-workflow-badge}}
      </div>

      <!-- ID Chip -->
      <span class="absolute bottom-2.5 left-3 px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-xs text-[10px] font-mono text-white/90">
        #{{id}}
      </span>
    </a>

    <!-- Detalles del Cultivo -->
    <div class="p-4 sm:p-5 flex-1 flex flex-col">
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#2d6a4f] bg-[#e6f0e6] px-2 py-0.5 rounded-md truncate max-w-36">
          {{#if category}}{{category}}{{else}}General{{/if}}
        </span>
        {{#if region}}
        <span class="flex items-center gap-1 text-[10px] text-muted-foreground font-mono truncate max-w-28" title="Región: {{region}}">
          <i data-lucide="map-pin" class="w-3 h-3 text-[#2d6a4f]"></i>
          <span>{{region}}</span>
        </span>
        {{/if}}
      </div>

      <a href="/private/crops/{{id}}" class="text-base font-headline font-bold text-foreground group-hover:text-[#1b4332] transition-colors leading-snug line-clamp-1">
        {{name}}
      </a>

      <p class="text-xs italic text-muted-foreground mb-3 font-serif line-clamp-1">
        {{#if scientific_name}}{{scientific_name}}{{else}}Especie no especificada{{/if}}
      </p>

      <!-- Indicadores Técnicos Clave (Cosecha, Temporada y Fotos) -->
      <div class="grid grid-cols-2 gap-2 my-2.5 p-2.5 rounded-xl bg-muted/30 border border-border/50 text-[11px]">
        <div class="flex items-center gap-1.5 text-muted-foreground min-w-0" title="Días a la cosecha">
          <i data-lucide="calendar" class="w-3.5 h-3.5 shrink-0 text-[#2d6a4f]"></i>
          <span class="truncate font-medium">{{#if harvest_days}}{{harvest_days}} días{{else}}Ciclo s/e{{/if}}</span>
        </div>
        <div class="flex items-center gap-1.5 text-muted-foreground min-w-0" title="Temporada de siembra">
          <i data-lucide="sun" class="w-3.5 h-3.5 shrink-0 text-amber-600"></i>
          <span class="truncate font-medium">{{#if season}}{{season}}{{else}}Temporada s/e{{/if}}</span>
        </div>
      </div>

      <!-- Pie de Tarjeta con Enlace y Acciones -->
      <div class="mt-auto flex items-center justify-between gap-2 border-t border-border/80 pt-3">
        <a href="/private/crops/{{id}}" class="inline-flex items-center gap-1 text-xs font-bold text-[#1b4332] hover:text-[#2d6a4f] hover:underline">
          <span>Ver expediente</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
        {{> private/crops/actions}}
      </div>
    </div>

  </article>
  {{else}}
  <div class="col-span-full rounded-2xl border border-dashed border-border/80 bg-card px-6 py-16 text-center shadow-2xs">
    <div class="w-14 h-14 mx-auto rounded-2xl bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center mb-4">
      <i data-lucide="sprout" class="w-7 h-7"></i>
    </div>
    <h2 class="text-lg font-headline font-bold text-foreground">No se encontraron cultivos</h2>
    <p class="mt-1 text-xs sm:text-sm text-muted-foreground max-w-sm mx-auto">Revisa los filtros aplicados o registra una nueva ficha agronómica en el padrón.</p>
    {{#if permissions.canCreate}}
      <button type="button" id="btn-add-crop-card" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-[#1b4332] px-5 py-2.5 text-xs font-bold text-white hover:bg-[#2d6a4f] transition-all shadow-md active:scale-95 cursor-pointer">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Nuevo cultivo
      </button>
    {{/if}}
  </div>
  {{/each}}

</section>
