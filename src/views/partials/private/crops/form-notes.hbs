<section id="crop-section-notes" class="scroll-mt-4 rounded-2xl border border-border/80 bg-card p-4 sm:p-6 shadow-2xs">
  <div class="flex items-center gap-3 mb-5 pb-3 border-b border-border/60">
    <div class="w-8 h-8 rounded-lg bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center shrink-0">
      <i data-lucide="file-text" class="w-4 h-4"></i>
    </div>
    <div>
      <h4 class="font-bold text-foreground">Información adicional</h4>
      <p class="text-xs text-muted-foreground">Descripción y consideraciones técnicas del cultivo</p>
    </div>
  </div>
  <div class="space-y-5">
    <div>
      <label for="crop-description" class="block text-xs font-bold text-muted-foreground mb-2">Descripción general</label>
      <textarea id="crop-description" name="description" rows="4" maxlength="5000"
        data-character-counter
        placeholder="Describe las características principales del cultivo..."
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all resize-y"></textarea>
    </div>
    <div>
      <label for="crop-observations" class="block text-xs font-bold text-muted-foreground mb-2">Observaciones técnicas</label>
      <textarea id="crop-observations" name="observations" rows="4" maxlength="3000"
        data-character-counter
        placeholder="Agrega recomendaciones, observaciones o información importante..."
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all resize-y"></textarea>
    </div>
  </div>
</section>
