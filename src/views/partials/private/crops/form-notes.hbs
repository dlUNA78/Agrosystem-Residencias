<section id="crop-section-notes" class="scroll-mt-4 rounded-2xl border border-border bg-card p-4 sm:p-6">
<div class="flex items-center gap-2 mb-5">
<span class="inline-flex shrink-0 text-primary">{{> private/crops/icon name="description"}}</span>
<h4 class="font-bold text-foreground">Información adicional</h4>
</div>
<div class="space-y-5">
<div>
<label for="crop-description" class="block text-xs font-bold text-muted-foreground mb-2">Descripción general</label>
<textarea id="crop-description" name="description" rows="4" maxlength="5000"
data-character-counter
placeholder="Describe las características principales del cultivo..."
class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-input bg-background resize-y"></textarea>
</div>
<div>
<label for="crop-observations" class="block text-xs font-bold text-muted-foreground mb-2">Observaciones técnicas</label>
<textarea id="crop-observations" name="observations" rows="4" maxlength="3000"
data-character-counter
placeholder="Agrega recomendaciones, observaciones o información importante..."
class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-input bg-background resize-y"></textarea>
</div>
</div>
</section>
