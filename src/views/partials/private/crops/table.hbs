<!-- ===================================================== -->
<!-- VISTA EN TABLA ADMINISTRATIVA (TABLE VIEW EN GEIST)   -->
<!-- ===================================================== -->
<section id="crops-table-view" aria-label="Cultivos en tabla" class="hidden bg-card border border-border/80 rounded-2xl overflow-hidden shadow-2xs">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse font-['Geist'] text-xs">
      <caption class="sr-only">Catálogo privado de cultivos y acciones disponibles</caption>
      <thead>
        <tr class="bg-muted/50 border-b border-border/80">
          <th scope="col" class="px-5 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Muestra</th>
          <th scope="col" class="px-5 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Cultivo / Especie</th>
          <th scope="col" class="px-5 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Categoría</th>
          <th scope="col" class="px-5 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Región</th>
          <th scope="col" class="px-5 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Cosecha</th>
          <th scope="col" class="px-5 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground text-center">Flujo Editorial</th>
          <th scope="col" class="px-5 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        {{#each crops}}
        <tr class="hover:bg-muted/30 transition-colors">
          <td class="px-5 py-3.5">
            <a href="/private/crops/{{id}}" class="block w-10 h-10 shrink-0">
              <img src="{{#if image_url}}{{image_url}}{{else}}/images/test/default.png{{/if}}" alt="{{name}}" width="40" height="40" loading="lazy" class="w-10 h-10 rounded-xl object-cover border border-border/80" data-fallback-src="/images/test/default.png">
            </a>
          </td>
          <td class="px-5 py-3.5">
            <a href="/private/crops/{{id}}" class="font-bold text-foreground hover:text-[#1b4332] transition-colors block">
              {{name}} <span class="font-mono text-[10px] text-muted-foreground font-normal">#{{id}}</span>
            </a>
            {{#if scientific_name}}
            <p class="text-[11px] italic font-serif text-muted-foreground">{{scientific_name}}</p>
            {{/if}}
          </td>
          <td class="px-5 py-3.5">
            <span class="px-2 py-0.5 rounded-md bg-[#e6f0e6] text-[#1b4332] text-[10px] font-mono font-bold uppercase">
              {{#if category}}{{category}}{{else}}General{{/if}}
            </span>
          </td>
          <td class="px-5 py-3.5 text-muted-foreground">
            {{#if region}}{{region}}{{else}}<span class="text-muted-foreground/60">Sin especificar</span>{{/if}}
          </td>
          <td class="whitespace-nowrap px-5 py-3.5 tabular-nums text-foreground font-medium">
            {{#if harvest_days}}{{harvest_days}} días{{else}}<span class="text-muted-foreground/60">—</span>{{/if}}
          </td>
          <td class="px-5 py-3.5 text-center">
            {{> private/crop-workflow-badge}}
          </td>
          <td class="px-5 py-3.5 text-right">
            <div class="flex items-center justify-end gap-1">
              <a href="/private/crops/{{id}}" class="p-2 rounded-lg text-muted-foreground hover:bg-muted hover:text-[#1b4332] transition-colors" aria-label="Ver ficha de {{name}}" title="Ver expediente">
                <i data-lucide="eye" class="w-4 h-4"></i>
              </a>
              {{> private/crops/actions}}
            </div>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="7" class="px-5 py-12 text-center text-muted-foreground">
            No se encontraron cultivos con los filtros seleccionados.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
