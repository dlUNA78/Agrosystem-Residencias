<div class="flex shrink-0 items-center gap-1">
  {{#if canEditRecord}}
    <button type="button" class="edit-crop-btn p-2 rounded-lg text-muted-foreground hover:bg-muted hover:text-[#1b4332] transition-colors cursor-pointer" data-id="{{id}}" title="Editar cultivo" aria-label="Editar {{name}}">
      <i data-lucide="pencil" class="w-4 h-4"></i>
    </button>
  {{/if}}
  {{#if canDeleteRecord}}
    <button type="button" class="delete-crop-btn p-2 rounded-lg text-muted-foreground hover:bg-rose-50 hover:text-rose-700 transition-colors cursor-pointer" data-id="{{id}}" data-name="{{name}}" title="Eliminar cultivo" aria-label="Eliminar {{name}}">
      <i data-lucide="trash-2" class="w-4 h-4"></i>
    </button>
  {{/if}}
</div>
