<section id="crop-section-production" class="scroll-mt-4 rounded-2xl border border-border/80 bg-card p-4 sm:p-6 shadow-2xs">
  <div class="flex items-center gap-3 mb-5 pb-3 border-b border-border/60">
    <div class="w-8 h-8 rounded-lg bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center shrink-0">
      <i data-lucide="calendar" class="w-4 h-4"></i>
    </div>
    <div>
      <h4 class="font-bold text-foreground">Ciclo y producción</h4>
      <p class="text-xs text-muted-foreground">Información relacionada con el desarrollo y rendimiento</p>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <div>
      <label for="crop-season" class="block text-xs font-bold text-muted-foreground mb-2">Temporada de cultivo</label>
      <select id="crop-season" name="season"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all cursor-pointer">
        <option value="">Seleccionar temporada</option>
        <option value="primavera">Primavera</option>
        <option value="verano">Verano</option>
        <option value="otoño">Otoño</option>
        <option value="invierno">Invierno</option>
        <option value="primavera-verano">Primavera-Verano</option>
        <option value="otoño-invierno">Otoño-Invierno</option>
        <option value="todo-el-año">Todo el año</option>
      </select>
    </div>
    <div>
      <label for="crop-cycle" class="block text-xs font-bold text-muted-foreground mb-2">Ciclo del cultivo</label>
      <select id="crop-cycle" name="cycle"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all cursor-pointer">
        <option value="">Seleccionar ciclo</option>
        <option value="corto">Ciclo corto</option>
        <option value="medio">Ciclo medio</option>
        <option value="largo">Ciclo largo</option>
        <option value="perenne">Perenne</option>
      </select>
    </div>
    <div>
      <label for="crop-harvest-days" class="block text-xs font-bold text-muted-foreground mb-2">Días para cosecha</label>
      <input type="number" id="crop-harvest-days" name="harvest_days" min="1" max="3650" step="1"
        placeholder="Ej. 120"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
      <p class="mt-1 text-[10px] text-muted-foreground">Ingresa un valor entre 1 y 3650 días.</p>
    </div>
    <div>
      <label for="crop-yield" class="block text-xs font-bold text-muted-foreground mb-2">Rendimiento promedio</label>
      <input type="text" id="crop-yield" name="average_yield" maxlength="100"
        data-crop-format="quantity" placeholder="Ej. 8 toneladas/ha"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-density" class="block text-xs font-bold text-muted-foreground mb-2">Densidad de siembra</label>
      <input type="text" id="crop-density" name="planting_density" maxlength="100"
        data-crop-format="quantity"
        placeholder="Ej. 60,000 plantas/ha"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-depth" class="block text-xs font-bold text-muted-foreground mb-2">Profundidad de siembra</label>
      <input type="text" id="crop-depth" name="planting_depth" maxlength="100"
        data-crop-format="quantity" placeholder="Ej. 5 cm"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
  </div>

  <!-- Regla de Negocio INIFAP: Ciclo Fenológico Obligatorio (Mínimo 3 Etapas) -->
  <div class="mt-6 pt-5 border-t border-border/60">
    <input type="hidden" name="require_min_stages" value="1" />
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div>
        <h5 class="text-xs font-bold text-foreground flex items-center gap-1.5">
          <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-[#1b4332]"></i>
          Etapas Fenológicas del Ciclo de Vida (Mínimo 3 fases obligatorias) <span class="text-rose-600">*</span>
        </h5>
        <p class="text-[11px] text-muted-foreground">Documenta las 3 fases principales del desarrollo del cultivo desde emergencia hasta cosecha.</p>
      </div>
      <span class="px-2.5 py-0.5 rounded-full bg-[#e6f0e6] text-[#1b4332] font-mono text-[10px] font-bold">Mín. 3 fases INIFAP</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-xl border border-border/80 bg-muted/20 p-3">
        <label for="crop-stage-1" class="block text-[11px] font-bold text-[#1b4332] mb-1">1. Fase Inicial / Emergencia *</label>
        <input type="text" id="crop-stage-1" name="phenological_stage_1" required maxlength="180"
          value="Germinación, emergencia radicular y establecimiento vegetativo (V0–V2)"
          placeholder="Ej. Germinación y emergencia (0–15 DDS)"
          class="w-full px-3 py-2 text-xs rounded-lg border border-input bg-card focus:outline-hidden focus:border-[#1b4332]">
      </div>
      <div class="rounded-xl border border-border/80 bg-muted/20 p-3">
        <label for="crop-stage-2" class="block text-[11px] font-bold text-[#1b4332] mb-1">2. Desarrollo Vegetativo / Floración *</label>
        <input type="text" id="crop-stage-2" name="phenological_stage_2" required maxlength="180"
          value="Elongación de tallo, expansión foliar y diferenciación floral (V3–R1)"
          placeholder="Ej. Crecimiento activo y floración (16–65 DDS)"
          class="w-full px-3 py-2 text-xs rounded-lg border border-input bg-card focus:outline-hidden focus:border-[#1b4332]">
      </div>
      <div class="rounded-xl border border-border/80 bg-muted/20 p-3">
        <label for="crop-stage-3" class="block text-[11px] font-bold text-[#1b4332] mb-1">3. Llenado y Madurez Fisiológica *</label>
        <input type="text" id="crop-stage-3" name="phenological_stage_3" required maxlength="180"
          value="Llenado de grano/fruto, madurez fisiológica y cosecha comercial (R2–R6)"
          placeholder="Ej. Fructificación y madurez a cosecha"
          class="w-full px-3 py-2 text-xs rounded-lg border border-input bg-card focus:outline-hidden focus:border-[#1b4332]">
      </div>
    </div>
  </div>
</section>
