<section id="crop-section-identity" class="scroll-mt-4 rounded-2xl border border-border/80 bg-card p-4 sm:p-6 shadow-2xs">
  <div class="flex items-center justify-between gap-3 mb-5 pb-3 border-b border-border/60">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center shrink-0">
        <i data-lucide="tag" class="w-4 h-4"></i>
      </div>
      <div>
        <h4 class="font-bold text-foreground">Identificación y clasificación</h4>
        <p class="text-xs text-muted-foreground">Información taxonómica y clasificación del cultivo</p>
      </div>
    </div>
    <span data-crop-identity-lock-badge class="hidden items-center gap-1 rounded-md bg-amber-100 px-2.5 py-1 font-mono text-[10px] font-bold text-amber-900">
      <i data-lucide="lock" class="w-3 h-3"></i> Identidad protegida
    </span>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <label for="crop-name" class="block text-xs font-bold text-muted-foreground mb-2">Nombre común *</label>
      <input type="text" id="crop-name" name="name" required maxlength="150"
        placeholder="Ej. Maíz Blanco"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-scientific-name" class="block text-xs font-bold text-muted-foreground mb-2">Nombre científico *</label>
      <input type="text" id="crop-scientific-name" name="scientific_name" required
        maxlength="150" data-crop-format="scientific-name"
        placeholder="Ej. Zea mays"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-category" class="block text-xs font-bold text-muted-foreground mb-2">Categoría del cultivo *</label>
      <select id="crop-category" name="category" required
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all cursor-pointer">
        <option value="">Seleccionar categoría</option>
        <option value="Granos y Cereales">Granos y Cereales</option>
        <option value="Frutales">Frutales</option>
        <option value="Hortalizas">Hortalizas</option>
        <option value="Leguminosas">Leguminosas</option>
        <option value="Oleaginosas">Oleaginosas</option>
        <option value="Tubérculos">Tubérculos</option>
        <option value="Forrajeras">Forrajeras</option>
        <option value="Ornamentales">Ornamentales</option>
        <option value="Industriales">Industriales</option>
        <option value="Otro">Otro</option>
      </select>
    </div>
    <div>
      <label for="crop-family" class="block text-xs font-bold text-muted-foreground mb-2">Familia botánica</label>
      <input type="text" id="crop-family" name="family" maxlength="100" placeholder="Ej. Poaceae"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-genus" class="block text-xs font-bold text-muted-foreground mb-2">Género</label>
      <input type="text" id="crop-genus" name="genus" maxlength="100" placeholder="Ej. Zea"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-variety" class="block text-xs font-bold text-muted-foreground mb-2">Variedad o cultivar</label>
      <input type="text" id="crop-variety" name="variety" maxlength="150"
        placeholder="Ej. Maíz Blanco Criollo"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
  </div>
</section>
