<section id="crop-section-images" class="scroll-mt-4 rounded-2xl border border-border/80 bg-card p-4 sm:p-6 shadow-2xs space-y-4">
  <div class="flex items-center justify-between gap-2 border-b border-border/60 pb-3">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center shrink-0">
        <i data-lucide="image" class="w-4 h-4"></i>
      </div>
      <div>
        <h4 class="font-bold text-foreground">Imágenes del cultivo</h4>
        <p class="text-xs text-muted-foreground">Agrega hasta 10 imágenes para documentar las características del cultivo</p>
      </div>
    </div>
    <span id="crop-image-counter" class="px-2.5 py-0.5 rounded-full bg-muted border border-border font-mono text-[10px] font-bold text-foreground">
      0 / 10 fotos
    </span>
  </div>

  <label for="crop-images"
    class="group flex flex-col items-center justify-center w-full min-h-36 border-2 border-dashed border-[#1b4332]/30 rounded-2xl bg-[#1b4332]/5 hover:bg-[#1b4332]/10 hover:border-[#1b4332]/60 transition-all cursor-pointer p-5 text-center">
    <i data-lucide="cloud-upload" class="w-8 h-8 text-[#2d6a4f]/70 group-hover:text-[#1b4332] transition-colors"></i>
    <p class="mt-2 text-xs sm:text-sm font-bold text-foreground">Seleccionar imágenes del cultivo</p>
    <p class="text-[11px] text-muted-foreground mt-0.5">o arrastra archivos aquí</p>
    <p class="text-[10px] text-muted-foreground mt-1">JPG, JPEG, PNG o WEBP • Máximo 5 MB por imagen</p>
    <input type="file" id="crop-images" name="images" data-max-files="10" data-max-file-size="5242880"
      accept="image/jpeg,image/jpg,image/png,image/webp" multiple class="hidden">
  </label>

  <input type="hidden" id="crop-removed-image-ids" name="removed_image_ids" value="">
  <input type="hidden" id="crop-primary-image-id" name="primary_image_id" value="">
  <p id="crop-image-error" class="hidden text-xs font-bold text-destructive" role="alert"></p>
  <p id="crop-existing-images-note" class="hidden text-xs text-emerald-800 font-medium">
    Las fotos marcadas como «Actual» se conservarán; haz clic en «Quitar» si deseas eliminar alguna antes de guardar.
  </p>

  <div id="crop-images-preview"
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 pt-2">
  </div>
</section>
