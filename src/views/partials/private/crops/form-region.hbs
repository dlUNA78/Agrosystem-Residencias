<section id="crop-section-region" class="scroll-mt-4 rounded-2xl border border-border/80 bg-card p-4 sm:p-6 shadow-2xs">
  <div class="flex items-center gap-3 mb-5 pb-3 border-b border-border/60">
    <div class="w-8 h-8 rounded-lg bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center shrink-0">
      <i data-lucide="map-pin" class="w-4 h-4"></i>
    </div>
    <div>
      <h4 class="font-bold text-foreground">Región y distribución</h4>
      <p class="text-xs text-muted-foreground">Zonas donde se cultiva y desarrolla la especie</p>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <label for="crop-region" class="block text-xs font-bold text-muted-foreground mb-2">Región principal *</label>
      <select id="crop-region" name="region" required
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all cursor-pointer">
        <option value="">Seleccionar región</option>
        <option value="norte">Norte de México</option>
        <option value="centro">Centro de México</option>
        <option value="occidente">Occidente de México</option>
        <option value="sur">Sur de México</option>
        <option value="sureste">Sureste de México</option>
        <option value="todo-mexico">Todo México</option>
        <option value="internacional">Internacional</option>
      </select>
    </div>
    <div>
      <label for="crop-state" class="block text-xs font-bold text-muted-foreground mb-2">Estado o zona productora</label>
      <input type="text" id="crop-state" name="state" maxlength="150"
        placeholder="Ej. Colima, Jalisco, Michoacán"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-min-altitude" class="block text-xs font-bold text-muted-foreground mb-2">Altitud mínima (msnm)</label>
      <input type="number" id="crop-min-altitude" name="min_altitude" min="0" max="5000"
        step="1" placeholder="Ej. 0"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
    <div>
      <label for="crop-max-altitude" class="block text-xs font-bold text-muted-foreground mb-2">Altitud máxima (msnm)</label>
      <input type="number" id="crop-max-altitude" name="max_altitude" min="0" max="5000" step="1"
        placeholder="Ej. 1800"
        class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-input bg-background focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
    </div>
  </div>
</section>
