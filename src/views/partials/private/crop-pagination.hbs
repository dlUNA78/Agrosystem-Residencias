{{#if pagination.hasMultiplePages}}
  <nav class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-border bg-card px-6 py-4" aria-label="Paginación de cultivos">
    <p class="text-xs font-medium text-muted-foreground">
      Mostrando {{pagination.fromItem}}–{{pagination.toItem}} de
      <span class="font-bold text-foreground">{{pagination.totalItems}}</span>
    </p>
    <div class="flex items-center gap-2">
      {{#if pagination.hasPrevPage}}
        <a href="{{pagination.prevUrl}}" class="rounded-lg bg-muted px-3 py-2 text-xs font-bold text-foreground hover:bg-muted/70">Anterior</a>
      {{/if}}
      {{#each pagination.pages}}
        <a href="{{this.url}}" class="rounded-lg px-3 py-2 text-xs font-bold {{#if this.isCurrent}}bg-primary text-white{{else}}bg-muted text-foreground hover:bg-muted/70{{/if}}" {{#if this.isCurrent}}aria-current="page"{{/if}}>
          {{this.number}}
        </a>
      {{/each}}
      {{#if pagination.hasNextPage}}
        <a href="{{pagination.nextUrl}}" class="rounded-lg bg-muted px-3 py-2 text-xs font-bold text-foreground hover:bg-muted/70">Siguiente</a>
      {{/if}}
    </div>
  </nav>
{{/if}}
