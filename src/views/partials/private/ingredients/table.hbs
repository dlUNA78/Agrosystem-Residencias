<div id="ingredients-table-view" class="hidden overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-xs">
    {{#if ingredients.length}}
    <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] border-collapse text-left text-sm">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50/80 font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-slate-500">
                    <th class="px-5 py-3.5">Código</th>
                    <th class="px-5 py-3.5">Ingrediente Activo</th>
                    <th class="px-5 py-3.5">Grupo Químico</th>
                    <th class="px-5 py-3.5">Tipo de Acción</th>
                    <th class="px-5 py-3.5">Toxicidad OMS</th>
                    <th class="px-5 py-3.5">Estatus</th>
                    <th class="px-5 py-3.5 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
                {{#each ingredients}}
                <tr class="transition-colors hover:bg-slate-50/70">
                    <td class="px-5 py-3.5 font-['Geist_Mono'] text-xs font-semibold text-slate-500 whitespace-nowrap">
                        {{this.code}}
                    </td>
                    <td class="px-5 py-3.5">
                        <div class="flex items-center gap-3">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-[#1b4332]">
                                <i data-lucide="flask-conical" class="h-4 w-4"></i>
                            </span>
                            <span class="font-bold text-slate-900">{{this.name}}</span>
                        </div>
                    </td>
                    <td class="px-5 py-3.5 text-xs font-medium text-slate-700">
                        {{this.chemical_group}}
                    </td>
                    <td class="px-5 py-3.5 whitespace-nowrap">
                        <span class="rounded-md border border-emerald-200 bg-emerald-50/70 px-2.5 py-0.5 text-[11px] font-bold text-[#1b4332]">
                            {{this.actionLabel}}
                        </span>
                    </td>
                    <td class="px-5 py-3.5 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-['Geist_Mono'] text-[11px] font-bold {{this.toxicityBadgeClass}}">
                            {{this.toxicityShortLabel}}
                        </span>
                    </td>
                    <td class="px-5 py-3.5 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-bold {{this.regulatoryBadgeClass}}">
                            <span class="h-1.5 w-1.5 rounded-full {{this.toxicityDotClass}}"></span>
                            {{this.regulatoryLabel}}
                        </span>
                    </td>
                    <td class="px-5 py-3.5 text-right whitespace-nowrap">
                        <div class="inline-flex items-center justify-end gap-1">
                            <button
                                type="button"
                                data-view-ingredient
                                data-code="{{this.code}}"
                                data-name="{{this.name}}"
                                data-group="{{this.chemical_group}}"
                                data-action="{{this.actionLabel}}"
                                data-toxicity="{{this.toxicityLabel}}"
                                data-regulatory="{{this.regulatoryLabel}}"
                                class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors"
                                title="Ver ficha química"
                                aria-label="Ver ficha de {{this.name}}"
                            >
                                <i data-lucide="eye" class="h-4 w-4"></i>
                            </button>

                            {{#if @root.canManage}}
                            <button
                                type="button"
                                data-edit-ingredient
                                data-id="{{this.id}}"
                                data-name="{{this.name}}"
                                data-group="{{this.rawChemicalGroup}}"
                                data-action="{{this.rawActionType}}"
                                data-toxicity="{{this.rawToxicity}}"
                                class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-emerald-50 hover:text-[#1b4332] transition-colors"
                                title="Editar ingrediente"
                                aria-label="Editar {{this.name}}"
                            >
                                <i data-lucide="pencil" class="h-4 w-4"></i>
                            </button>

                            <form
                                action="/private/ingredients/delete/{{this.id}}"
                                method="POST"
                                data-delete-ingredient-form
                                data-ingredient-name="{{this.name}}"
                                class="inline"
                            >
                                <button
                                    type="submit"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-rose-50 hover:text-rose-700 transition-colors"
                                    title="Eliminar ingrediente"
                                    aria-label="Eliminar {{this.name}}"
                                >
                                    <i data-lucide="trash-2" class="h-4 w-4"></i>
                                </button>
                            </form>
                            {{/if}}
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="p-10 text-center">
        <p class="text-sm font-bold text-slate-800">Sin registros coincidentes en vista tabular</p>
        <p class="mt-1 text-xs text-slate-500">Ajusta los criterios de búsqueda en la barra superior.</p>
    </div>
    {{/if}}
</div>
