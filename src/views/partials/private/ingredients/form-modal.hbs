<!-- Modal CRUD: Añadir / Editar Ingrediente Activo -->
<div
    id="modal-ingredient"
    class="fixed inset-0 z-[200] hidden items-center justify-center bg-slate-950/45 p-4 backdrop-blur-xs font-['Geist']"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-ingredient-title"
>
    <div class="w-full max-w-lg overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
        <header class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-[#1b4332]">
                    <i data-lucide="flask-conical" class="h-4 w-4"></i>
                </span>
                <div>
                    <h2 id="modal-ingredient-title" class="text-base font-extrabold tracking-tight text-slate-900">Nuevo Ingrediente Activo</h2>
                    <p class="text-xs text-slate-500">Especificación técnica OMS / COFEPRIS</p>
                </div>
            </div>
            <button
                id="btn-close-modal-ingredient"
                type="button"
                aria-label="Cerrar modal"
                class="rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"
            >
                <i data-lucide="x" class="h-4 w-4"></i>
            </button>
        </header>

        <form id="form-ingredient" action="/private/ingredients/create" method="POST" class="space-y-4 px-6 py-5">
            <div id="ingredient-form-error" role="alert" class="hidden rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2.5 text-xs font-semibold text-rose-800"></div>

            <div>
                <label for="ingredient-nombre" class="mb-1.5 block text-xs font-bold text-slate-700">
                    Nombre común / molécula activa *
                </label>
                <input
                    type="text"
                    id="ingredient-nombre"
                    name="name"
                    required
                    minlength="2"
                    maxlength="150"
                    placeholder="Ej. Glifosato, Azoxistrobina, Flubendiamida"
                    class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 outline-none transition-all focus:border-[#1b4332] focus:ring-2 focus:ring-[#1b4332]/15"
                />
            </div>

            <div>
                <label for="ingredient-grupo" class="mb-1.5 block text-xs font-bold text-slate-700">
                    Grupo o familia química
                </label>
                <input
                    type="text"
                    id="ingredient-grupo"
                    name="chemical_group"
                    maxlength="150"
                    placeholder="Ej. Estrobilurinas, Diamidas, Organofosforados..."
                    class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 outline-none transition-all focus:border-[#1b4332] focus:ring-2 focus:ring-[#1b4332]/15"
                />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="ingredient-tipo" class="mb-1.5 block text-xs font-bold text-slate-700">
                        Tipo de acción biológica *
                    </label>
                    <select
                        id="ingredient-tipo"
                        name="action_type"
                        required
                        class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 outline-none transition-all focus:border-[#1b4332] focus:ring-2 focus:ring-[#1b4332]/15"
                    >
                        <option value="">Seleccionar...</option>
                        <option value="herbicida">Herbicida</option>
                        <option value="insecticida">Insecticida</option>
                        <option value="fungicida">Fungicida</option>
                        <option value="acaricida">Acaricida</option>
                        <option value="nematicida">Nematicida</option>
                        <option value="bactericida">Bactericida</option>
                    </select>
                </div>

                <div>
                    <label for="ingredient-toxicidad" class="mb-1.5 block text-xs font-bold text-slate-700">
                        Clasificación toxicológica OMS
                    </label>
                    <select
                        id="ingredient-toxicidad"
                        name="toxicological_category"
                        class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 outline-none transition-all focus:border-[#1b4332] focus:ring-2 focus:ring-[#1b4332]/15"
                    >
                        <option value="">Sin clasificar (Pendiente)</option>
                        <option value="clase-i">Clase I — Extremadamente tóxico</option>
                        <option value="clase-ii">Clase II — Altamente tóxico</option>
                        <option value="clase-iii">Clase III — Moderadamente tóxico</option>
                        <option value="clase-iv">Clase IV — Ligeramente tóxico</option>
                        <option value="u">U — Poco probable de presentar peligro</option>
                    </select>
                </div>
            </div>

            <footer class="flex justify-end gap-2.5 border-t border-slate-200 pt-4">
                <button
                    id="btn-cancel-modal-ingredient"
                    type="button"
                    class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 transition-colors hover:bg-slate-100"
                >
                    Cancelar
                </button>
                <button
                    id="btn-submit-ingredient"
                    type="submit"
                    class="inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-5 py-2 text-xs font-bold text-white shadow-xs transition-colors hover:bg-[#143325]"
                >
                    <i data-lucide="save" class="h-3.5 w-3.5"></i>
                    <span id="btn-submit-ingredient-label">Guardar Ingrediente</span>
                </button>
            </footer>
        </form>
    </div>
</div>

<!-- Modal de Inspección Rápida (Lectura técnica) -->
<div
    id="modal-ingredient-detail"
    class="fixed inset-0 z-[200] hidden items-center justify-center bg-slate-950/45 p-4 backdrop-blur-xs font-['Geist']"
    role="dialog"
    aria-modal="true"
    aria-labelledby="detail-ingredient-title"
>
    <div class="w-full max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
        <header class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <div>
                <p id="detail-ingredient-code" class="font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-[#1b4332]">IA-0000</p>
                <h2 id="detail-ingredient-title" class="text-lg font-extrabold text-slate-900">Ingrediente Activo</h2>
            </div>
            <button
                type="button"
                data-close-ingredient-detail
                aria-label="Cerrar ficha"
                class="rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900"
            >
                <i data-lucide="x" class="h-4 w-4"></i>
            </button>
        </header>
        <dl class="divide-y divide-slate-100 px-6 py-4 text-xs">
            <div class="flex justify-between gap-4 py-2.5">
                <dt class="font-semibold text-slate-500">Tipo de acción</dt>
                <dd id="detail-ingredient-action" class="font-bold text-slate-900">--</dd>
            </div>
            <div class="flex justify-between gap-4 py-2.5">
                <dt class="font-semibold text-slate-500">Grupo químico</dt>
                <dd id="detail-ingredient-group" class="font-bold text-slate-900 text-right">--</dd>
            </div>
            <div class="flex justify-between gap-4 py-2.5">
                <dt class="font-semibold text-slate-500">Clasificación OMS</dt>
                <dd id="detail-ingredient-toxicity" class="font-bold text-slate-900 text-right">--</dd>
            </div>
            <div class="flex justify-between gap-4 py-2.5">
                <dt class="font-semibold text-slate-500">Estatus regulatorio</dt>
                <dd id="detail-ingredient-regulatory" class="font-bold text-[#1b4332]">--</dd>
            </div>
        </dl>
        <footer class="flex justify-end border-t border-slate-200 bg-slate-50 px-6 py-3.5">
            <button
                type="button"
                data-close-ingredient-detail
                class="rounded-xl bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#143325]"
            >
                Entendido
            </button>
        </footer>
    </div>
</div>
