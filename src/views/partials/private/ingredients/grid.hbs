<div id="ingredients-grid-view" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {{#if ingredients.length}}
        {{#each ingredients}}
        <article class="group flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition-all hover:border-[#1b4332]/40 hover:shadow-md">
            <div>
                <div class="flex items-start justify-between gap-2">
                    <span class="rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-['Geist_Mono'] text-[10px] font-bold text-slate-600">
                        {{this.code}}
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[10px] font-bold {{this.regulatoryBadgeClass}}">
                        <span class="h-1.5 w-1.5 rounded-full {{this.toxicityDotClass}}"></span>
                        {{this.regulatoryLabel}}
                    </span>
                </div>

                <div class="mt-3.5">
                    <span class="font-['Geist_Mono'] text-[10px] font-bold uppercase tracking-wider text-[#1b4332]">
                        {{this.actionLabel}}
                    </span>
                    <h2 class="mt-0.5 text-base font-extrabold tracking-tight text-slate-900">
                        {{this.name}}
                    </h2>
                    <p class="mt-1 text-xs font-medium text-slate-600 line-clamp-2">
                        Grupo químico: <span class="text-slate-800">{{this.chemical_group}}</span>
                    </p>
                </div>
            </div>

            <div class="mt-4 flex items-center justify-between gap-2 border-t border-slate-100 pt-3.5">
                <span class="inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 font-['Geist_Mono'] text-[10px] font-bold {{this.toxicityBadgeClass}}">
                    {{this.toxicityShortLabel}}
                </span>

                <div class="flex items-center gap-1">
                    <button
                        type="button"
                        data-view-ingredient
                        data-code="{{this.code}}"
                        data-name="{{this.name}}"
                        data-group="{{this.chemical_group}}"
                        data-action="{{this.actionLabel}}"
                        data-toxicity="{{this.toxicityLabel}}"
                        data-regulatory="{{this.regulatoryLabel}}"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors"
                        title="Inspeccionar ficha química"
                        aria-label="Inspeccionar {{this.name}}"
                    >
                        <i data-lucide="eye" class="h-4 w-4"></i>
                    </button>

                    {{#if @root.canManage}}
                    <button
                        type="button"
                        data-edit-ingredient
                        data-id="{{this.id}}"
                        data-name="{{this.name}}"
                        data-group="{{this.rawChemicalGroup}}"
                        data-action="{{this.rawActionType}}"
                        data-toxicity="{{this.rawToxicity}}"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-emerald-50 hover:text-[#1b4332] transition-colors"
                        title="Editar ingrediente"
                        aria-label="Editar {{this.name}}"
                    >
                        <i data-lucide="pencil" class="h-4 w-4"></i>
                    </button>

                    <form
                        action="/private/ingredients/delete/{{this.id}}"
                        method="POST"
                        data-delete-ingredient-form
                        data-ingredient-name="{{this.name}}"
                        class="inline"
                    >
                        <button
                            type="submit"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 hover:bg-rose-50 hover:text-rose-700 transition-colors"
                            title="Eliminar ingrediente"
                            aria-label="Eliminar {{this.name}}"
                        >
                            <i data-lucide="trash-2" class="h-4 w-4"></i>
                        </button>
                    </form>
                    {{/if}}
                </div>
            </div>
        </article>
        {{/each}}

        {{#if canManage}}
        <button
            id="btn-add-ingredient-card"
            type="button"
            class="group flex min-h-[195px] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/40 p-6 text-center transition-all hover:border-[#1b4332]/40 hover:bg-emerald-50/30"
        >
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-500 shadow-xs group-hover:border-[#1b4332]/30 group-hover:text-[#1b4332] transition-colors">
                <i data-lucide="plus" class="h-5 w-5"></i>
            </span>
            <span class="mt-3 text-xs font-extrabold text-slate-800 group-hover:text-[#1b4332]">Añadir ingrediente activo</span>
            <span class="mt-1 text-[11px] text-slate-500">Registrar nueva molécula oficial</span>
        </button>
        {{/if}}
    {{else}}
        <div class="col-span-full rounded-2xl border border-dashed border-slate-200 bg-white p-10 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                <i data-lucide="flask-conical" class="h-6 w-6"></i>
            </div>
            <h2 class="mt-3 text-sm font-extrabold text-slate-900">No se encontraron ingredientes activos</h2>
            <p class="mt-1 text-xs text-slate-500">Prueba ajustando los términos de búsqueda o limpia los filtros activos.</p>
            {{#if canManage}}
            <button id="btn-add-ingredient-card" type="button" class="mt-4 inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#143325] transition-colors">
                <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                <span>Registrar primer ingrediente</span>
            </button>
            {{/if}}
        </div>
    {{/if}}
</div>
