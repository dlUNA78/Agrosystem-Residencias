<!-- Sidebar Lateral Institucional (INIFAP Geist Design System) -->
<aside
  id="sidebar"
  aria-label="Menú lateral de administración"
  class="fixed top-0 left-0 z-50 flex h-screen w-64 flex-col overflow-y-auto overscroll-contain border-r border-neutral-200/80 bg-white p-5 font-['Geist',sans-serif] text-[#0a0a0a] antialiased shadow-2xs transition-transform duration-300 ease-in-out"
>
  <!-- Encabezado Institucional con botón para retraer -->
  <div class="mb-6 flex items-center justify-between border-b border-neutral-200/70 pb-4">
    <a href="/dashboard" class="flex min-w-0 items-center gap-3">
      <img
        src="/images/inifap-Logo.png"
        alt="Logotipo INIFAP"
        data-hide-on-error="true"
        class="h-9 w-auto shrink-0 object-contain"
      />
      <div class="min-w-0 flex-1">
        <span class="block text-base leading-tight font-bold tracking-tight text-[#1b4332]">INIFAP</span>
        <span class="block font-['Geist_Mono',monospace] text-[10px] font-semibold uppercase tracking-widest text-neutral-500">
          ROL · {{#if user.role}}{{user.role}}{{else}}USUARIO{{/if}}
        </span>
      </div>
    </a>
    <button
      id="sidebar-close-btn"
      type="button"
      aria-label="Retraer menú lateral"
      title="Retraer menú"
      class="shrink-0 cursor-pointer rounded-lg p-1.5 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-[#0a0a0a]"
    >
      <i data-lucide="panel-left-close" class="h-4 w-4" aria-hidden="true"></i>
    </button>
  </div>

  <!-- Navegación Categorizada -->
  <nav aria-label="Navegación principal del panel" class="flex flex-1 flex-col gap-5 text-xs font-medium">
    <!-- SECCIÓN 1: OPERACIÓN -->
    <div>
      <span class="mb-2 block px-3 font-['Geist_Mono',monospace] text-[10px] font-semibold uppercase tracking-widest text-neutral-500">
        OPERACIÓN
      </span>
      <div class="space-y-1">
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'dashboard')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/dashboard"
        >
          <i data-lucide="layout-dashboard" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Dashboard</span>
        </a>
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'plagues')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/catalog/plagues"
        >
          <i data-lucide="bug" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Plagas</span>
        </a>
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'crops')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/crops"
        >
          <i data-lucide="sprout" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Cultivos</span>
        </a>
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'lands')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/lands"
        >
          <i data-lucide="map-pin" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Terrenos</span>
        </a>
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'products')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/products"
        >
          <i data-lucide="package" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Productos</span>
        </a>
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'ingredients')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/ingredients"
        >
          <i data-lucide="flask-conical" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Ingredientes Activos</span>
        </a>
      </div>
    </div>

    <!-- SECCIÓN 2: COMUNIDAD -->
    <div>
      <span class="mb-2 block px-3 font-['Geist_Mono',monospace] text-[10px] font-semibold uppercase tracking-widest text-neutral-500">
        COMUNIDAD
      </span>
      <div class="space-y-1">
        {{#if (hasRole user 'admin')}}
          <a
            class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'users')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
            href="/private/users"
          >
            <i data-lucide="users" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
            <span>Usuarios</span>
          </a>
        {{/if}}
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'suppliers')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/suppliers"
        >
          <i data-lucide="truck" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Proveedores</span>
        </a>
      </div>
    </div>

    <!-- SECCIÓN 3: SISTEMA -->
    <div>
      <span class="mb-2 block px-3 font-['Geist_Mono',monospace] text-[10px] font-semibold uppercase tracking-widest text-neutral-500">
        SISTEMA
      </span>
      <div class="space-y-1">
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'reports')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/reports"
        >
          <i data-lucide="bar-chart-3" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Reportes y Estadísticas</span>
        </a>
        {{#if (hasRole user 'admin')}}
          <a
            class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'audit')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
            href="/private/audit"
          >
            <i data-lucide="shield-check" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
            <span>Auditoría</span>
          </a>
        {{/if}}
        <a
          class="flex items-center gap-3 rounded-xl px-3 py-2 font-semibold transition-colors {{#if (eq activePage 'profile')}}bg-[#e2f1e8] text-[#1b4332]{{else}}text-neutral-600 hover:bg-neutral-100 hover:text-[#0a0a0a]{{/if}}"
          href="/private/profile"
        >
          <i data-lucide="settings" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
          <span>Mi Perfil y Ajustes</span>
        </a>
      </div>
    </div>

    <!-- Enlace de retorno al portal público -->
    <div class="mt-auto border-t border-neutral-200/70 pt-4">
      <a
        href="/"
        class="flex items-center justify-between rounded-xl border border-neutral-200 bg-neutral-50 px-3 py-2.5 text-xs font-semibold text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-[#0a0a0a]"
      >
        <span>Volver al sitio público</span>
        <i data-lucide="external-link" class="h-3.5 w-3.5 shrink-0" aria-hidden="true"></i>
      </a>
    </div>
  </nav>
</aside>
