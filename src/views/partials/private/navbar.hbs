<header
  id="topnav"
  class="fixed top-0 right-0 z-40 flex h-16 w-[calc(100%-16rem)] items-center justify-between border-b border-neutral-200/80 bg-white/90 px-4 font-['Geist',sans-serif] text-[#0a0a0a] backdrop-blur-md transition-all duration-300 ease-in-out sidebar-open:w-[calc(100%-16rem)] sm:px-8"
>
  <!-- Buscador Rápido y Toggle Sidebar -->
  <div class="flex items-center gap-3">
    <button
      id="sidebar-toggle-btn"
      type="button"
      aria-label="Alternar menú lateral"
      title="Alternar menú lateral"
      class="shrink-0 cursor-pointer rounded-lg p-2 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-[#0a0a0a] active:scale-95"
    >
      <i data-lucide="panel-left" class="h-5 w-5" aria-hidden="true"></i>
    </button>

    <form
      id="private-global-search-form"
      action="/private/products"
      method="GET"
      role="search"
      class="m-0 flex w-48 items-center gap-2 rounded-lg border border-neutral-200/90 bg-neutral-100/70 px-3 py-1.5 transition-colors focus-within:border-[#1b4332]/50 focus-within:bg-white sm:w-80 md:w-96"
    >
      <label for="private-global-search" class="sr-only">Buscar insumos, plagas o registros en el panel</label>
      <i data-lucide="search" class="h-4 w-4 shrink-0 text-neutral-400" aria-hidden="true"></i>
      <input
        id="private-global-search"
        name="search"
        type="search"
        autocomplete="off"
        placeholder="Buscar insumos, plagas o registros..."
        class="w-full border-none bg-transparent text-xs text-[#0a0a0a] placeholder:text-neutral-500 focus:outline-hidden"
      />
    </form>
  </div>

  <!-- Accesos Rápidos y Perfil de Usuario -->
  <div class="flex items-center gap-4">
    <a
      href="/private/reports"
      aria-label="Ir a reportes y alertas operativas"
      title="Reportes y alertas operativas"
      class="relative rounded-full p-2 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-[#1b4332]"
    >
      <i data-lucide="bar-chart-2" class="h-4.5 w-4.5" aria-hidden="true"></i>
    </a>

    <!-- Menú de Cuenta Accesible (Click, Teclado y Hover) -->
    <div id="user-menu-container" class="group relative py-1">
      <button
        id="user-menu-trigger"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="user-menu-dropdown"
        aria-label="Abrir menú de cuenta de usuario"
        class="flex cursor-pointer items-center gap-3 rounded-lg px-1.5 py-1 text-left transition-colors hover:bg-neutral-100/80 focus:outline-2 focus:outline-[#1b4332]"
      >
        <div class="hidden text-right sm:block">
          <p class="text-xs leading-tight font-bold text-[#0a0a0a]">
            {{#if user.full_name}}{{user.full_name}}{{else}}Usuario autenticado{{/if}}
          </p>
          <p class="font-['Geist_Mono',monospace] text-[10px] leading-tight text-neutral-500">
            {{#if user.email}}{{user.email}}{{else}}Correo no disponible{{/if}}
          </p>
        </div>

        {{#if user.photo_url}}
          <img
            alt="{{#if user.full_name}}Foto de {{user.full_name}}{{else}}Foto de perfil{{/if}}"
            src="{{user.photo_url}}"
            data-hide-on-error="true"
            class="h-8 w-8 rounded-full border border-neutral-200 object-cover shadow-2xs"
          />
        {{else}}
          <span
            aria-hidden="true"
            class="flex h-8 w-8 items-center justify-center rounded-full bg-[#1b4332] font-['Geist_Mono',monospace] text-xs font-bold text-white shadow-2xs"
          >
            {{#if user}}{{userInitial user}}{{else}}U{{/if}}
          </span>
        {{/if}}
      </button>

      <div
        id="user-menu-dropdown"
        class=" absolute top-12 right-0 z-50 hidden w-56 rounded-xl border border-neutral-200 bg-white py-2 shadow-lg group-hover:block"
      >
        <div class="border-b border-neutral-100 px-4 py-2 sm:hidden">
          <p class="truncate text-xs font-bold text-[#0a0a0a]">
            {{#if user.full_name}}{{user.full_name}}{{else}}Usuario autenticado{{/if}}
          </p>
          <p class="truncate font-['Geist_Mono',monospace] text-[10px] text-neutral-500">
            {{#if user.email}}{{user.email}}{{else}}Correo no disponible{{/if}}
          </p>
        </div>
        <a
          href="/private/profile"
          class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-neutral-800 transition-colors hover:bg-neutral-50"
        >
          <i data-lucide="user" class="h-4 w-4 text-[#1b4332]" aria-hidden="true"></i>
          <span>Mi Perfil</span>
        </a>
        <a
          href="/dashboard"
          class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-neutral-800 transition-colors hover:bg-neutral-50"
        >
          <i data-lucide="layout-dashboard" class="h-4 w-4 text-[#1b4332]" aria-hidden="true"></i>
          <span>Panel Principal</span>
        </a>
        <div class="my-1 border-t border-neutral-100"></div>
        <form action="/auth/logout" method="POST" class="m-0">
          <button
            type="submit"
            class="flex w-full cursor-pointer items-center gap-2.5 px-4 py-2 text-left text-xs font-semibold text-rose-600 transition-colors hover:bg-rose-50"
          >
            <i data-lucide="log-out" class="h-4 w-4" aria-hidden="true"></i>
            <span>Cerrar Sesión</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</header>
