<header id="topnav"
    class="fixed top-0 right-0 h-16 z-40 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md flex items-center justify-between px-4 sm:px-8 font-manrope font-medium text-sm border-b border-surface-container-low transition-all duration-300 ease-in-out sidebar-open:w-[calc(100%-16rem)] w-[calc(100%-16rem)]">

    <div class="flex items-center gap-3">
        <button id="sidebar-toggle-btn" aria-label="Alternar menú lateral"
            class="p-2 rounded-lg text-on-surface-variant hover:bg-surface-container-low dark:hover:bg-zinc-800 transition-colors active:scale-90 shrink-0">
            <span class="material-symbols-outlined text-xl leading-none" data-icon="menu">menu</span>
        </button>
        <div class="flex items-center gap-4 bg-surface-container-low px-4 py-2 rounded-full w-56 sm:w-80 md:w-96">
            <span class="material-symbols-outlined text-on-surface-variant" data-icon="search">search</span>
            <input class="bg-transparent border-none focus:ring-0 text-sm w-full placeholder:text-on-surface-variant"
                placeholder="Buscar reportes, usuarios o registros..." type="text">
        </div>
    </div>

    <div class="flex items-center gap-6">
        <div class="flex items-center gap-4 pr-6 border-r border-surface-container">
            <button
                class="relative text-on-surface-variant hover:text-primary transition-colors cursor-pointer active:scale-95">
                <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
                <span class="absolute top-0 right-0 w-2 h-2 bg-error rounded-full"></span>
            </button>
        </div>

        <div class="flex items-center gap-3 cursor-pointer hover:opacity-80 transition-opacity relative group py-2">
            <div class="text-right hidden sm:block">
                <p class="text-xs font-bold text-on-surface leading-tight">{{#if user.full_name}}{{user.full_name}}{{else}}Usuario{{/if}}</p>
                <p class="text-[10px] text-on-surface-variant leading-tight">{{#if user.email}}{{user.email}}{{else}}Sin correo{{/if}}</p>
            </div>

            {{#if user.photo_url}}
            <img alt="{{user.full_name}}" class="w-9 h-9 rounded-full object-cover ring-2 ring-primary/10 shadow-sm"
                src="{{user.photo_url}}">
            {{else}}
            <div
                class="w-9 h-9 rounded-full bg-[#43655c] text-white flex items-center justify-center font-extrabold text-sm shadow-sm">
                {{userInitial user}}
            </div>
            {{/if}}

            <!-- Dropdown Menu -->
            <div
                class="absolute right-0 top-12 mt-1 w-52 bg-white dark:bg-zinc-900 rounded-xl shadow-xl py-2 border border-zinc-200 dark:border-zinc-800 hidden group-hover:block transition-all z-50">
                <div class="px-4 py-2 border-b border-zinc-100 dark:border-zinc-800 sm:hidden">
                    <p class="text-xs font-bold text-on-surface truncate">{{user.full_name}}</p>
                    <p class="text-[10px] text-on-surface-variant truncate">{{user.email}}</p>
                </div>
                <a href="/private/profile"
                    class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                    <span class="material-symbols-outlined text-base text-primary">person</span>
                    <span>Mi Perfil</span>
                </a>
                <a href="/auth/logout"
                    class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-bold text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors">
                    <span class="material-symbols-outlined text-base">logout</span>
                    <span>Cerrar Sesión</span>
                </a>
            </div>
        </div>

    </div>
</header>