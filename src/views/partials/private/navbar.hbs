<header id="topnav"
    class="fixed top-0 right-0 h-16 z-40 bg-background/90 backdrop-blur-md flex items-center justify-between px-4 sm:px-8 font-sans text-foreground border-b border-border transition-all duration-300 ease-in-out sidebar-open:w-[calc(100%-16rem)] w-[calc(100%-16rem)]">

    <!-- Buscador Principal y Toggle Sidebar -->
    <div class="flex items-center gap-3">
        <button id="sidebar-toggle-btn" aria-label="Alternar menú lateral" title="Alternar menú lateral"
            class="p-2 rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground transition-colors active:scale-90 shrink-0 cursor-pointer">
            <i data-lucide="panel-left" class="w-5 h-5"></i>
        </button>
        <div class="flex items-center gap-2 bg-muted/60 border border-border/80 px-3.5 py-1.5 rounded-lg w-64 sm:w-96">
            <i data-lucide="search" class="w-4 h-4 text-muted-foreground shrink-0"></i>
            <input class="bg-transparent border-none focus:outline-hidden text-xs w-full placeholder:text-muted-foreground"
                placeholder="Buscar reportes, usuarios o registros..." type="text">
        </div>
    </div>

    <!-- Iconos y Perfil de Usuario -->
    <div class="flex items-center gap-5">
        <!-- Notificaciones -->
        <button class="relative text-muted-foreground hover:text-foreground transition-colors cursor-pointer p-1.5 rounded-full hover:bg-muted">
            <i data-lucide="bell" class="w-4.5 h-4.5"></i>
            <span class="absolute top-1 right-1 w-2 h-2 bg-rose-600 rounded-full"></span>
        </button>

        <!-- Dropdown Usuario -->
        <div class="flex items-center gap-3 cursor-pointer relative group py-1">
            <div class="text-right hidden sm:block">
                <p class="text-xs font-bold leading-tight text-foreground">{{#if user.full_name}}{{user.full_name}}{{else}}Usuario autenticado{{/if}}</p>
                <p class="text-[10px] text-muted-foreground font-mono leading-tight">{{#if user.email}}{{user.email}}{{else}}Correo no disponible{{/if}}</p>
            </div>

            {{#if user.photo_url}}
                <img alt="{{user.full_name}}" class="w-8 h-8 rounded-full object-cover border border-border shadow-2xs" src="{{user.photo_url}}">
            {{else}}
                <div class="w-8 h-8 rounded-full bg-[#a3b18a] text-white flex items-center justify-center font-mono font-bold text-xs shadow-2xs">
                    {{#if user}}{{userInitial user}}{{else}}U{{/if}}
                </div>
            {{/if}}

            <!-- Menu desplegable -->
            <div class="absolute right-0 top-11 w-52 bg-card rounded-xl shadow-lg py-2 border border-border hidden group-hover:block transition-all z-50">
                <div class="px-4 py-2 border-b border-border sm:hidden">
                    <p class="text-xs font-bold truncate">{{#if user.full_name}}{{user.full_name}}{{else}}Usuario autenticado{{/if}}</p>
                    <p class="text-[10px] text-muted-foreground truncate">{{#if user.email}}{{user.email}}{{else}}Correo no disponible{{/if}}</p>
                </div>
                <a href="/private/profile" class="flex items-center gap-2.5 px-4 py-2 text-xs font-bold text-foreground hover:bg-muted transition-colors">
                    <i data-lucide="user" class="w-4 h-4 text-[#1b4332]"></i>
                    <span>Mi Perfil</span>
                </a>
                <a href="/auth/logout" class="flex items-center gap-2.5 px-4 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50 transition-colors">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    <span>Cerrar Sesión</span>
                </a>
            </div>
        </div>
    </div>
</header>
