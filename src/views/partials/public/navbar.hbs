<nav class="bg-white/80 backdrop-blur-md fixed top-0 w-full z-50 shadow-[0_20px_40px_rgba(45,52,53,0.06)]">
    <div
        class="flex justify-between items-center px-6 md:px-10 py-4 max-w-[1440px] mx-auto font-['Manrope'] tracking-tight antialiased">
        <div class="flex items-center gap-12">
            <span class="text-xl font-bold text-[#43655c] tracking-tighter">Agrosystem INIFAP</span>

            <div class="hidden md:flex items-center gap-8">
                <a class="font-['Inter'] text-xs uppercase tracking-widest font-bold transition-all duration-200 pb-1 {{#if (eq activePage 'home')}}text-[#43655c] border-b-2 border-[#43655c]{{else}}text-on-surface-variant hover:text-[#43655c] border-b-2 border-transparent hover:border-[#43655c]/40{{/if}}"
                    href="/">Inicio</a>
                <a class="font-['Inter'] text-xs uppercase tracking-widest font-bold transition-all duration-200 pb-1 {{#if (eq activePage 'plagues')}}text-[#43655c] border-b-2 border-[#43655c]{{else}}text-on-surface-variant hover:text-[#43655c] border-b-2 border-transparent hover:border-[#43655c]/40{{/if}}"
                    href="/plagues">Plagas</a>
                <a class="font-['Inter'] text-xs uppercase tracking-widest font-bold transition-all duration-200 pb-1 {{#if (eq activePage 'crops')}}text-[#43655c] border-b-2 border-[#43655c]{{else}}text-on-surface-variant hover:text-[#43655c] border-b-2 border-transparent hover:border-[#43655c]/40{{/if}}"
                    href="/crops">Cultivos</a>
                <a class="font-['Inter'] text-xs uppercase tracking-widest font-bold transition-all duration-200 pb-1 {{#if (eq activePage 'products')}}text-[#43655c] border-b-2 border-[#43655c]{{else}}text-on-surface-variant hover:text-[#43655c] border-b-2 border-transparent hover:border-[#43655c]/40{{/if}}"
                    href="/products">Productos</a>
                <a class="font-['Inter'] text-xs uppercase tracking-widest font-bold transition-all duration-200 pb-1 {{#if (eq activePage 'forum')}}text-[#43655c] border-b-2 border-[#43655c]{{else}}text-on-surface-variant hover:text-[#43655c] border-b-2 border-transparent hover:border-[#43655c]/40{{/if}}"
                    href="/forum">Foro</a>

                {{#if (canAccessPanel user)}}
                <a class="font-['Inter'] text-xs uppercase tracking-widest font-bold transition-all duration-200 pb-1 text-[#43655c] hover:text-[#2d443e]"
                    href="/dashboard">Ir al Panel INIFAP</a>
                {{/if}}
            </div>
        </div>

        <div class="flex items-center gap-2 md:gap-4">
            {{#if user}}
            <button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all">
                <span class="material-symbols-outlined">notifications</span>
            </button>
          

            <!-- Menú Desplegable de Usuario (Profile Dropdown) -->
            <div class="relative hidden sm:block">
                <button id="user-menu-button" type="button"
                    class="flex items-center gap-3 pl-2 py-1 px-2 rounded-xl hover:bg-surface-container-low transition-all cursor-pointer focus:outline-none"
                    aria-expanded="false" aria-haspopup="true">
                    <div class="text-right hidden sm:block">
                        <p class="text-xs font-bold text-on-surface leading-none">{{user.full_name}}</p>
                        <p class="text-[10px] text-on-surface-variant capitalize mt-0.5">{{user.role}}</p>
                    </div>
                    {{#if user.photo_url}}
                    <img alt="{{user.full_name}}" class="w-10 h-10 rounded-full object-cover ring-2 ring-[#43655c]/30"
                        src="{{user.photo_url}}" />
                    {{else}}
                    <div class="w-10 h-10 rounded-full bg-[#43655c] text-white flex items-center justify-center font-bold text-sm shadow-sm ring-2 ring-[#43655c]/30">
                        {{userInitial user}}
                    </div>
                    {{/if}}
                    <span class="material-symbols-outlined text-sm text-on-surface-variant transition-transform duration-200" id="user-menu-arrow">expand_more</span>
                </button>

                <!-- Menú Desplegable (Dropdown Content) -->
                <div id="user-menu-dropdown" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150">
                    <div class="px-4 py-2.5 border-b border-slate-100">
                        <p class="text-xs font-bold text-slate-800 truncate">{{user.full_name}}</p>
                        <p class="text-[11px] text-slate-500 truncate">{{user.email}}</p>
                        <span class="inline-block mt-1 px-2 py-0.5 text-[9px] font-extrabold uppercase tracking-wider rounded-md bg-[#43655c]/10 text-[#43655c]">{{user.role}}</span>
                    </div>

                    <div class="py-1">
                        {{#if (canAccessPanel user)}}
                        <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-[#43655c]/10 hover:text-[#43655c] transition-colors">
                            <span class="material-symbols-outlined text-base">dashboard</span>
                            Panel INIFAP
                        </a>
                        {{/if}}

                        {{#if (eq user.role 'agricultor')}}
                        <a href="/auth/inifap-upgrade" class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-amber-700 hover:bg-amber-50 transition-colors">
                            <span class="material-symbols-outlined text-base">workspace_premium</span>
                            Ascender a Personal INIFAP
                        </a>
                        {{/if}}
                    </div>

                    <div class="border-t border-slate-100 pt-1 mt-1">
                        <a href="/auth/logout" class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition-colors">
                            <span class="material-symbols-outlined text-base">logout</span>
                            Cerrar Sesión
                        </a>
                    </div>
                </div>
            </div>

            {{else}}
            <div class="hidden sm:flex gap-3">
                <a href="/auth/login"
                    class="text-sm font-bold text-on-surface-variant hover:text-[#43655c] transition-colors px-3 py-2">Ingresar</a>
                <a href="/auth/register"
                    class="text-sm font-bold text-white bg-[#43655c] hover:bg-[#2d443e] rounded-lg px-4 py-2 transition-all shadow-sm">Registrarse</a>
            </div>
            {{/if}}

            <button id="public-nav-toggle"
                class="md:hidden p-2 text-[#43655c] hover:bg-[#43655c]/10 rounded-lg transition-all duration-200"
                aria-label="Abrir menú de navegación" aria-expanded="false">
                <span class="material-symbols-outlined" id="public-nav-icon">menu</span>
            </button>
        </div>
    </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const userBtn = document.getElementById('user-menu-button');
    const userDropdown = document.getElementById('user-menu-dropdown');
    const userArrow = document.getElementById('user-menu-arrow');

    if (userBtn && userDropdown) {
        userBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = userDropdown.classList.contains('hidden');
            if (isHidden) {
                userDropdown.classList.remove('hidden');
                if (userArrow) userArrow.style.transform = 'rotate(180deg)';
            } else {
                userDropdown.classList.add('hidden');
                if (userArrow) userArrow.style.transform = 'rotate(0deg)';
            }
        });

        document.addEventListener('click', (e) => {
            if (!userDropdown.contains(e.target) && !userBtn.contains(e.target)) {
                userDropdown.classList.add('hidden');
                if (userArrow) userArrow.style.transform = 'rotate(0deg)';
            }
        });
    }
});
</script>