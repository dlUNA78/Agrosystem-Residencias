<header class="hidden md:block sticky top-0 z-50 w-full bg-card/95 backdrop-blur-md border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 py-3 flex justify-between items-center font-['Geist'] antialiased">

    <!-- Logo Institucional Limpio y Estructurado -->
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/inifap-Logo.png" alt="INIFAP Logo" class="h-9 w-auto object-contain transition-transform group-hover:scale-105" />
        <div class="flex flex-col">
          <span class="text-[#1b4332] font-extrabold tracking-tight text-sm">INIFAP</span>
          <span class="text-mono-label text-[9px] text-muted-foreground tracking-wider -mt-0.5">
            SISTEMA NACIONAL DE CONSULTA
          </span>
        </div>
      </a>

      <!-- Enlaces de Navegación Principal (Rectos con Borde Inferior Activo) -->
      <nav class="hidden md:flex items-center gap-6">
        <a class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'home')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/">
          Inicio
        </a>
        <a class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'plagues')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/plagues">
          Plagas
        </a>
        <a class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'crops')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/crops">
          Cultivos
        </a>
        <a class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'products')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/products">
          Productos
        </a>
        <a class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'lands')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/lands">
          Regiones
        </a>

        {{#if (canAccessPanel user)}}
        <a class="text-sm font-semibold text-[#1b4332] hover:text-[#133426] transition-colors py-1.5 border-b-2 border-transparent"
          href="/dashboard">
          Panel INIFAP
        </a>
        {{else}}
        <a class="text-sm font-semibold text-emerald-700 hover:text-emerald-900 transition-colors py-1.5 border-b-2 border-transparent flex items-center gap-1.5"
          href="/auth/inifap-upgrade" title="Acceso al Panel Técnico (Validar Código)">
          <span class="material-symbols-outlined text-base">verified_user</span>
          Ascenso INIFAP
        </a>
        {{/if}}
      </nav>
    </div>

    <!-- Área de Controles de Usuario -->
    <div class="flex items-center gap-3">
      {{#if user}}
      <button
        class="p-2 text-muted-foreground hover:text-foreground hover:bg-secondary rounded-md transition-all cursor-pointer"
        title="Notificaciones">
        <span class="material-symbols-outlined text-xl">notifications</span>
      </button>

      <!-- Menú Desplegable de Usuario (Profile Dropdown) -->
      <div class="relative hidden sm:block">
        <button id="user-menu-button" type="button"
          class="flex items-center gap-2.5 px-3 py-1.5 rounded-md hover:bg-secondary transition-all cursor-pointer border border-border"
          aria-expanded="false" aria-haspopup="true">
          <div class="text-right hidden sm:block">
            <p class="text-xs font-semibold text-foreground leading-none">{{user.full_name}}</p>
            <p class="text-[10px] text-muted-foreground capitalize mt-0.5">{{user.role}}</p>
          </div>

          {{#if user.photo_url}}
          <img alt="{{user.full_name}}" class="w-7 h-7 rounded-md object-cover ring-1 ring-border"
            src="{{user.photo_url}}" />
          {{else}}
          <div
            class="w-7 h-7 rounded-md bg-[#1b4332] text-white flex items-center justify-center font-mono font-bold text-xs shadow-2xs">
            {{userInitial user}}
          </div>
          {{/if}}
          <span class="material-symbols-outlined text-sm text-muted-foreground transition-transform duration-200"
            id="user-menu-arrow">expand_more</span>
        </button>

        <!-- Menú Desplegable (Dropdown Content) -->
        <div id="user-menu-dropdown"
          class="hidden absolute right-0 mt-2 w-56 bg-card rounded-md shadow-lg border border-border py-1.5 z-50 animate-in fade-in slide-in-from-top-2 duration-150">
          <div class="px-4 py-2 border-b border-border">
            <p class="text-xs font-semibold text-foreground truncate">{{user.full_name}}</p>
            <p class="text-[11px] text-muted-foreground truncate">{{user.email}}</p>
            <span
              class="inline-block mt-1 px-2 py-0.5 text-[9px] font-mono uppercase tracking-wider rounded bg-secondary text-[#1b4332] font-semibold">{{user.role}}</span>
          </div>

          <div class="py-1">
            <a href="/profile"
              class="flex items-center gap-2.5 px-4 py-1.5 text-xs font-medium text-foreground hover:bg-secondary hover:text-[#1b4332] transition-colors">
              <span class="material-symbols-outlined text-base">person</span>
              Mi Perfil
            </a>

            {{#if (canAccessPanel user)}}
            <a href="/dashboard"
              class="flex items-center gap-2.5 px-4 py-1.5 text-xs font-medium text-foreground hover:bg-secondary hover:text-[#1b4332] transition-colors">
              <span class="material-symbols-outlined text-base">dashboard</span>
              Panel INIFAP
            </a>
            {{else}}
            <a href="/auth/inifap-upgrade"
              class="flex items-center gap-2.5 px-4 py-1.5 text-xs font-medium text-emerald-700 hover:bg-emerald-50 hover:text-emerald-900 transition-colors">
              <span class="material-symbols-outlined text-base">verified_user</span>
              Ascenso a Personal INIFAP
            </a>
            {{/if}}
          </div>

          <div class="border-t border-border pt-1 mt-1">
            <form action="/auth/logout" method="POST" class="m-0">
              <button type="submit"
                class="w-full flex items-center gap-2.5 px-4 py-1.5 text-xs font-medium text-rose-600 hover:bg-rose-50 transition-colors text-left cursor-pointer">
                <span class="material-symbols-outlined text-base">logout</span>
                Cerrar Sesión
              </button>
            </form>
          </div>
        </div>
      </div>

      {{else}}
      <div class="hidden sm:flex items-center gap-3">
        <a href="/auth/login"
          class="text-xs font-medium text-muted-foreground hover:text-foreground px-3 py-1.5 transition-colors">
          Ingresar
        </a>
        <a href="/auth/register"
          class="text-xs font-semibold text-white bg-[#1b4332] hover:bg-[#133426] rounded-md px-4 py-2 transition-all shadow-2xs">
          Registrarse
        </a>
      </div>
      {{/if}}

      <!-- Botón de Menú Móvil -->
      <button id="public-nav-toggle"
        class="md:hidden p-2 text-foreground hover:bg-secondary rounded-md transition-all cursor-pointer active:scale-95"
        aria-label="Abrir menú de navegación" aria-expanded="false">
        <span class="material-symbols-outlined text-2xl" id="public-nav-icon">menu</span>
      </button>
    </div>

  </div>
</header>

<!-- ─── Backdrop y Drawer Móvil Off-Canvas ───────────────────────────────── -->
<div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden opacity-0 transition-opacity duration-300 md:hidden" aria-hidden="true"></div>

  <div id="mobile-drawer" class="fixed top-0 right-0 bottom-0 w-[85%] max-w-sm bg-card z-50 shadow-2xl border-l border-border flex flex-col justify-between translate-x-full invisible pointer-events-none transition-transform duration-300 md:hidden pb-safe">
    <!-- Header del Drawer -->
    <div class="p-5 border-b border-border flex items-center justify-between bg-secondary/30">
      <div class="flex items-center gap-2.5">
        <img src="/images/inifap-Logo.png" alt="INIFAP Logo" class="h-8 w-auto object-contain" />
        <div>
          <p class="font-headline font-bold text-sm text-[#1b4332]">INIFAP</p>
          <p class="text-[9px] font-mono text-muted-foreground uppercase">Sanidad Vegetal</p>
        </div>
      </div>
      <button id="mobile-drawer-close" type="button" class="p-2 text-muted-foreground hover:text-foreground hover:bg-secondary rounded-full transition-all cursor-pointer active:scale-90" aria-label="Cerrar menú">
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>

    <!-- Contenido y Enlaces -->
    <div class="p-5 space-y-2 overflow-y-auto flex-1">
      <div class="text-mono-label text-muted-foreground font-semibold px-2 pb-1">CATÁLOGOS TÉCNICOS</div>
      <a href="/" class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm font-semibold transition-all {{#if (eq activePage 'home')}}bg-[#1b4332] text-white shadow-2xs{{else}}text-foreground hover:bg-secondary{{/if}}">
        <span class="material-symbols-outlined text-lg">home</span>
        <span>Inicio</span>
      </a>
      <a href="/plagues" class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm font-semibold transition-all {{#if (eq activePage 'plagues')}}bg-[#1b4332] text-white shadow-2xs{{else}}text-foreground hover:bg-secondary{{/if}}">
        <span class="material-symbols-outlined text-lg">pest_control</span>
        <span>Catálogo de Plagas</span>
      </a>
      <a href="/crops" class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm font-semibold transition-all {{#if (eq activePage 'crops')}}bg-[#1b4332] text-white shadow-2xs{{else}}text-foreground hover:bg-secondary{{/if}}">
        <span class="material-symbols-outlined text-lg">psychiatry</span>
        <span>Catálogo de Cultivos</span>
      </a>
      <a href="/products" class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm font-semibold transition-all {{#if (eq activePage 'products')}}bg-[#1b4332] text-white shadow-2xs{{else}}text-foreground hover:bg-secondary{{/if}}">
        <span class="material-symbols-outlined text-lg">science</span>
        <span>Insumos y Agroquímicos</span>
      </a>
      <a href="/lands" class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm font-semibold transition-all {{#if (eq activePage 'lands')}}bg-[#1b4332] text-white shadow-2xs{{else}}text-foreground hover:bg-secondary{{/if}}">
        <span class="material-symbols-outlined text-lg">travel_explore</span>
        <span>Regiones y Cobertura</span>
      </a>

      <div class="pt-4 border-t border-border mt-4">
        <div class="text-mono-label text-muted-foreground font-semibold px-2 pb-1">ACCESO INSTITUCIONAL</div>
        {{#if (canAccessPanel user)}}
        <a href="/dashboard" class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm font-semibold text-[#1b4332] bg-emerald-50 border border-emerald-200">
          <span class="material-symbols-outlined text-lg">dashboard</span>
          <span>Panel INIFAP</span>
        </a>
        {{else}}
        <a href="/auth/inifap-upgrade" class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200">
          <span class="material-symbols-outlined text-lg">verified_user</span>
          <span>Ascenso a Personal INIFAP</span>
        </a>
        {{/if}}
      </div>
    </div>

    <!-- Footer del Drawer (Sesión o Ingreso) -->
    <div class="p-5 border-t border-border bg-secondary/30">
      {{#if user}}
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2.5">
          {{#if user.photo_url}}
          <img alt="{{user.full_name}}" class="w-8 h-8 rounded-full object-cover ring-1 ring-border" src="{{user.photo_url}}" />
          {{else}}
          <div class="w-8 h-8 rounded-full bg-[#1b4332] text-white flex items-center justify-center font-mono font-bold text-xs">
            {{userInitial user}}
          </div>
          {{/if}}
          <div class="truncate max-w-35">
            <p class="text-xs font-bold text-foreground truncate">{{user.full_name}}</p>
            <p class="text-[10px] text-muted-foreground capitalize">{{user.role}}</p>
          </div>
        </div>
        <a href="/profile" class="text-xs font-medium text-[#1b4332] hover:underline">Perfil</a>
      </div>
      <form action="/auth/logout" method="POST" class="m-0">
        <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 px-3 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-lg transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-base">logout</span>
          <span>Cerrar Sesión</span>
        </button>
      </form>
      {{else}}
      <div class="grid grid-cols-2 gap-2">
        <a href="/auth/login" class="text-center py-2.5 text-xs font-semibold text-foreground bg-secondary hover:bg-border rounded-lg transition-all">Ingresar</a>
        <a href="/auth/register" class="text-center py-2.5 text-xs font-semibold text-white bg-[#1b4332] hover:bg-[#133426] rounded-lg shadow-2xs transition-all">Registrarse</a>
      </div>
      {{/if}}
    </div>
  </div>
