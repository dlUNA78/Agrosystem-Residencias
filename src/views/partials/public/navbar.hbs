<header class="sticky top-0 z-50 w-full bg-card/95 backdrop-blur-md border-b border-border">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-3 flex justify-between items-center font-['Geist'] antialiased">
    
    <!-- Logo Institucional Limpio y Estructurado -->
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-md bg-[#1b4332] text-white flex items-center justify-center font-mono font-bold text-xs shadow-2xs">
          AS
        </div>
        <div class="flex flex-col">
          <span class="text-base font-semibold text-foreground tracking-tight group-hover:text-[#1b4332] transition-colors">
            Agrosystem <span class="text-[#1b4332] font-bold">INIFAP</span>
          </span>
          <span class="text-mono-label text-[10px] text-muted-foreground tracking-wider -mt-0.5">
            SISTEMA NACIONAL DE CONSULTA
          </span>
        </div>
      </a>

      <!-- Enlaces de Navegación Principal (Rectos con Borde Inferior Activo) -->
      <nav class="hidden md:flex items-center gap-6">
        <a
          class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'home')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/"
        >
          Inicio
        </a>
        <a
          class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'plagues')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/plagues"
        >
          Plagas
        </a>
        <a
          class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'crops')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/crops"
        >
          Cultivos
        </a>
        <a
          class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'products')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/products"
        >
          Productos
        </a>
        <a
          class="text-sm font-medium transition-colors py-1.5 border-b-2 {{#if (eq activePage 'forum')}}text-[#1b4332] border-[#1b4332] font-semibold{{else}}text-muted-foreground hover:text-foreground border-transparent{{/if}}"
          href="/forum"
        >
          Foro
        </a>

        {{#if (canAccessPanel user)}}
          <a
            class="text-sm font-semibold text-[#1b4332] hover:text-[#133426] transition-colors py-1.5 border-b-2 border-transparent"
            href="/dashboard"
          >
            Panel INIFAP
          </a>
        {{/if}}
      </nav>
    </div>

    <!-- Área de Controles de Usuario -->
    <div class="flex items-center gap-3">
      {{#if user}}
        <button class="p-2 text-muted-foreground hover:text-foreground hover:bg-secondary rounded-md transition-all cursor-pointer" title="Notificaciones">
          <span class="material-symbols-outlined text-xl">notifications</span>
        </button>

        <!-- Menú Desplegable de Usuario (Profile Dropdown) -->
        <div class="relative hidden sm:block">
          <button
            id="user-menu-button"
            type="button"
            class="flex items-center gap-2.5 px-3 py-1.5 rounded-md hover:bg-secondary transition-all cursor-pointer border border-border"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <div class="text-right hidden sm:block">
              <p class="text-xs font-semibold text-foreground leading-none">{{user.full_name}}</p>
              <p class="text-[10px] text-muted-foreground capitalize mt-0.5">{{user.role}}</p>
            </div>

            {{#if user.photo_url}}
              <img alt="{{user.full_name}}" class="w-7 h-7 rounded-md object-cover ring-1 ring-border" src="{{user.photo_url}}" />
            {{else}}
              <div class="w-7 h-7 rounded-md bg-[#1b4332] text-white flex items-center justify-center font-mono font-bold text-xs shadow-2xs">
                {{userInitial user}}
              </div>
            {{/if}}
            <span class="material-symbols-outlined text-sm text-muted-foreground transition-transform duration-200" id="user-menu-arrow">expand_more</span>
          </button>

          <!-- Menú Desplegable (Dropdown Content) -->
          <div id="user-menu-dropdown" class="hidden absolute right-0 mt-2 w-56 bg-card rounded-md shadow-lg border border-border py-1.5 z-50 animate-in fade-in slide-in-from-top-2 duration-150">
            <div class="px-4 py-2 border-b border-border">
              <p class="text-xs font-semibold text-foreground truncate">{{user.full_name}}</p>
              <p class="text-[11px] text-muted-foreground truncate">{{user.email}}</p>
              <span class="inline-block mt-1 px-2 py-0.5 text-[9px] font-mono uppercase tracking-wider rounded bg-secondary text-[#1b4332] font-semibold">{{user.role}}</span>
            </div>

            <div class="py-1">
              <a href="/profile" class="flex items-center gap-2.5 px-4 py-1.5 text-xs font-medium text-foreground hover:bg-secondary hover:text-[#1b4332] transition-colors">
                <span class="material-symbols-outlined text-base">person</span>
                Mi Perfil
              </a>

              {{#if (canAccessPanel user)}}
                <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-1.5 text-xs font-medium text-foreground hover:bg-secondary hover:text-[#1b4332] transition-colors">
                  <span class="material-symbols-outlined text-base">dashboard</span>
                  Panel INIFAP
                </a>
              {{/if}}
            </div>

            <div class="border-t border-border pt-1 mt-1">
              <a href="/auth/logout" class="flex items-center gap-2.5 px-4 py-1.5 text-xs font-medium text-rose-600 hover:bg-rose-50 transition-colors">
                <span class="material-symbols-outlined text-base">logout</span>
                Cerrar Sesión
              </a>
            </div>
          </div>
        </div>

      {{else}}
        <div class="hidden sm:flex items-center gap-3">
          <a
            href="/auth/login"
            class="text-xs font-medium text-muted-foreground hover:text-foreground px-3 py-1.5 transition-colors"
          >
            Ingresar
          </a>
          <a
            href="/auth/register"
            class="text-xs font-semibold text-white bg-[#1b4332] hover:bg-[#133426] rounded-md px-4 py-2 transition-all shadow-2xs"
          >
            Registrarse
          </a>
        </div>
      {{/if}}

      <!-- Botón de Menú Móvil -->
      <button
        id="public-nav-toggle"
        class="md:hidden p-2 text-foreground hover:bg-secondary rounded-md transition-all cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined" id="public-nav-icon">menu</span>
      </button>
    </div>

  </div>

  <!-- Panel Desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden bg-card border-b border-border p-4 space-y-2">
    <a href="/" class="block px-3 py-2 rounded-md text-sm font-medium {{#if (eq activePage 'home')}}bg-secondary text-[#1b4332] font-semibold{{else}}text-muted-foreground hover:bg-secondary{{/if}}">Inicio</a>
    <a href="/plagues" class="block px-3 py-2 rounded-md text-sm font-medium {{#if (eq activePage 'plagues')}}bg-secondary text-[#1b4332] font-semibold{{else}}text-muted-foreground hover:bg-secondary{{/if}}">Plagas</a>
    <a href="/crops" class="block px-3 py-2 rounded-md text-sm font-medium {{#if (eq activePage 'crops')}}bg-secondary text-[#1b4332] font-semibold{{else}}text-muted-foreground hover:bg-secondary{{/if}}">Cultivos</a>
    <a href="/products" class="block px-3 py-2 rounded-md text-sm font-medium {{#if (eq activePage 'products')}}bg-secondary text-[#1b4332] font-semibold{{else}}text-muted-foreground hover:bg-secondary{{/if}}">Productos</a>
    <a href="/forum" class="block px-3 py-2 rounded-md text-sm font-medium {{#if (eq activePage 'forum')}}bg-secondary text-[#1b4332] font-semibold{{else}}text-muted-foreground hover:bg-secondary{{/if}}">Foro</a>
    
    {{#if (canAccessPanel user)}}
      <a href="/dashboard" class="block px-3 py-2 rounded-md text-sm font-semibold text-[#1b4332] bg-emerald-50">Ir al Panel INIFAP</a>
    {{/if}}

    {{#unless user}}
      <div class="pt-2 border-t border-border flex flex-col gap-2">
        <a href="/auth/login" class="w-full text-center py-2 text-xs font-semibold text-muted-foreground hover:bg-secondary rounded-md">Ingresar</a>
        <a href="/auth/register" class="w-full text-center py-2.5 text-xs font-semibold text-white bg-[#1b4332] hover:bg-[#133426] rounded-md shadow-2xs">Registrarse</a>
      </div>
    {{/unless}}
  </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const userBtn = document.getElementById('user-menu-button');
    const userDropdown = document.getElementById('user-menu-dropdown');
    const userArrow = document.getElementById('user-menu-arrow');

    if (userBtn && userDropdown) {
        userBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = userDropdown.classList.contains('hidden');
            if (isHidden) {
                userDropdown.classList.remove('hidden');
                if (userArrow) userArrow.style.transform = 'rotate(180deg)';
            } else {
                userDropdown.classList.add('hidden');
                if (userArrow) userArrow.style.transform = 'rotate(0deg)';
            }
        });

        document.addEventListener('click', (e) => {
            if (!userDropdown.contains(e.target) && !userBtn.contains(e.target)) {
                userDropdown.classList.add('hidden');
                if (userArrow) userArrow.style.transform = 'rotate(0deg)';
            }
        });
    }

    const navToggle = document.getElementById('public-nav-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const navIcon = document.getElementById('public-nav-icon');

    if (navToggle && mobileMenu) {
        navToggle.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
                mobileMenu.classList.remove('hidden');
                if (navIcon) navIcon.textContent = 'close';
            } else {
                mobileMenu.classList.add('hidden');
                if (navIcon) navIcon.textContent = 'menu';
            }
        });
    }
});
</script>