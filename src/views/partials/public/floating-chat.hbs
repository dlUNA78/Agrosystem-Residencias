<!-- Widget de Chat Flotante Estilo LinkedIn (Dock Inferior Derecho) -->
<aside id="linkedin-chat-dock" class="fixed bottom-0 right-6 z-50 font-['Geist'] antialiased">
  
  <!-- CONTENEDOR EXPANDIBLE DEL CHAT -->
  <div id="chat-dock-container" class="w-80 sm:w-84 bg-card border border-border rounded-t-xl shadow-2xl overflow-hidden transition-all duration-300 flex flex-col max-h-120">
    
    <!-- CABECERA DEL DOCK (Collapsible Bar idéntica a LinkedIn) -->
    <div
      id="chat-dock-header"
      class="flex items-center justify-between px-3.5 py-2.5 bg-card border-b border-border cursor-pointer select-none hover:bg-muted/30 transition-colors"
    >
      <div class="flex items-center gap-2.5">
        <div class="relative">
          <img
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80"
            alt="Usuario"
            class="size-7 rounded-full object-cover border border-border"
          />
          <span class="absolute bottom-0 right-0 size-2 rounded-full bg-emerald-500 ring-2 ring-card"></span>
        </div>
        <span class="text-sm font-headline font-bold text-foreground">Mensajes</span>
      </div>

      <div class="flex items-center gap-1 text-muted-foreground">
        <button type="button" class="p-1 hover:text-foreground rounded hover:bg-muted" title="Opciones">
          <span class="material-symbols-outlined text-base">more_horiz</span>
        </button>
        <button type="button" class="p-1 hover:text-foreground rounded hover:bg-muted" title="Nuevo Mensaje">
          <span class="material-symbols-outlined text-base">edit_square</span>
        </button>
        <button id="btn-toggle-dock" type="button" class="p-1 hover:text-foreground rounded hover:bg-muted">
          <span id="dock-chevron-icon" class="material-symbols-outlined text-base">expand_more</span>
        </button>
      </div>
    </div>

    <!-- CUERPO EXPANDIDO (Se oculta al colapsar) -->
    <div id="chat-dock-body" class="flex flex-col flex-1 bg-card overflow-hidden">
      
      <!-- CAMPO DE BÚSQUEDA Y FILTRO -->
      <div class="p-2.5 border-b border-border bg-muted/20 flex items-center gap-2">
        <div class="relative flex-1">
          <span class="material-symbols-outlined pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">search</span>
          <input
            type="search"
            placeholder="Buscar mensajes"
            class="h-8 w-full border border-input bg-card pl-8 pr-3 text-xs rounded-md outline-none focus:border-[#1b4332]"
          />
        </div>
        <button type="button" class="p-1.5 border border-input bg-card text-muted-foreground hover:text-foreground rounded-md" title="Filtros">
          <span class="material-symbols-outlined text-sm">tune</span>
        </button>
      </div>

      <!-- PESTAÑAS PRIORITARIOS / OTROS -->
      <div class="flex items-center border-b border-border text-xs font-semibold">
        <button type="button" class="flex-1 py-2 text-center text-[#1b4332] border-b-2 border-[#1b4332] font-bold">
          Prioritarios
        </button>
        <button type="button" class="flex-1 py-2 text-center text-muted-foreground hover:text-foreground border-b-2 border-transparent">
          Otros
        </button>
      </div>

      <!-- LISTA SCROLLABLE DE CONVERSACIONES -->
      <div class="flex-1 overflow-y-auto divide-y divide-border/50 max-h-85">
        
        <!-- Chat 1: INIFAP Alertas -->
        <div class="p-3 flex items-start gap-2.5 hover:bg-muted/40 transition-colors cursor-pointer">
          <div class="size-9 rounded-full bg-[#1b4332] text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
            IN
          </div>
          <div class="flex flex-col min-w-0 flex-1 gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground truncate">INIFAP Alertas</span>
              <span class="text-[10px] font-mono text-muted-foreground shrink-0">10:08</span>
            </div>
            <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-semibold truncate">Boletín Fitosanitario Sinaloa</span>
            <p class="text-[11px] text-muted-foreground truncate">Alerta preventiva de Roya en maíz...</p>
          </div>
        </div>

        <!-- Chat 2: Dr. Roberto Mendoza -->
        <div class="p-3 flex items-start gap-2.5 hover:bg-muted/40 transition-colors cursor-pointer bg-emerald-50/40 dark:bg-emerald-950/20 border-l-2 border-l-[#1b4332]">
          <div class="relative shrink-0 mt-0.5">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80"
              alt="Dr. Roberto Mendoza"
              class="size-9 rounded-full object-cover border border-border"
            />
            <span class="absolute bottom-0 right-0 size-2 rounded-full bg-emerald-500 ring-2 ring-card"></span>
          </div>
          <div class="flex flex-col min-w-0 flex-1 gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground truncate">Dr. Roberto Mendoza</span>
              <span class="text-[10px] font-mono text-muted-foreground shrink-0">10:42 AM</span>
            </div>
            <span class="text-[10px] text-muted-foreground truncate">A través del Foro Fitosanitario</span>
            <p class="text-[11px] font-semibold text-foreground truncate">Dr. Roberto: Le sugiero aplicar Amistar Top...</p>
          </div>
        </div>

        <!-- Chat 3: Ing. María Fernanda López -->
        <div class="p-3 flex items-start gap-2.5 hover:bg-muted/40 transition-colors cursor-pointer">
          <div class="relative shrink-0 mt-0.5">
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=150&q=80"
              alt="Ing. María Fernanda"
              class="size-9 rounded-full object-cover border border-border"
            />
            <span class="absolute bottom-0 right-0 size-2 rounded-full bg-emerald-500 ring-2 ring-card"></span>
          </div>
          <div class="flex flex-col min-w-0 flex-1 gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground truncate">Ing. María Fernanda</span>
              <span class="text-[10px] font-mono text-muted-foreground shrink-0">Ayer</span>
            </div>
            <span class="text-[10px] text-muted-foreground truncate">Entomología Valle del Fuerte</span>
            <p class="text-[11px] text-muted-foreground truncate">María: Adjunto la ficha del extracto botánico...</p>
          </div>
        </div>

        <!-- Chat 4: Dra. Claudia Morales -->
        <div class="p-3 flex items-start gap-2.5 hover:bg-muted/40 transition-colors cursor-pointer">
          <div class="relative shrink-0 mt-0.5">
            <img
              src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=150&q=80"
              alt="Dra. Claudia Morales"
              class="size-9 rounded-full object-cover border border-border"
            />
          </div>
          <div class="flex flex-col min-w-0 flex-1 gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground truncate">Dra. Claudia Morales</span>
              <span class="text-[10px] font-mono text-muted-foreground shrink-0">23 Ago</span>
            </div>
            <span class="text-[10px] text-muted-foreground truncate">Biotecnología Bajío</span>
            <p class="text-[11px] text-muted-foreground truncate flex items-center gap-1">
              <span class="material-symbols-outlined text-xs">attach_file</span>
              Claudia ha enviado un documento...
            </p>
          </div>
        </div>

        <!-- Chat 5: Carlos Ruiz -->
        <div class="p-3 flex items-start gap-2.5 hover:bg-muted/40 transition-colors cursor-pointer">
          <div class="relative shrink-0 mt-0.5">
            <img
              src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=150&q=80"
              alt="Carlos Ruiz"
              class="size-9 rounded-full object-cover border border-border"
            />
          </div>
          <div class="flex flex-col min-w-0 flex-1 gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground truncate">Carlos Ruiz (Productor)</span>
              <span class="text-[10px] font-mono text-muted-foreground shrink-0">20 Ago</span>
            </div>
            <span class="text-[10px] text-muted-foreground truncate">Ejido Guasave</span>
            <p class="text-[11px] text-muted-foreground truncate">Carlos: ¡Excelente cosecha este ciclo!</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</aside>
