<div data-product-gallery class="space-y-3">
  <div class="relative flex h-80 items-center justify-center overflow-hidden rounded-2xl border border-border bg-gradient-to-b from-slate-50 to-muted/40 p-6 shadow-2xs md:h-96">
    <div class="absolute inset-x-0 top-0 h-1.5 {{product.hazardTheme.barClass}}"></div>

    <img
      data-product-gallery-main
      src="{{product.image_url}}"
      alt="{{product.name}}"
      data-fallback="/images/products/default.png"
      data-fallback-src="/images/products/default.png"
      class="max-h-full max-w-full object-contain transition-transform duration-300"
    />

    <div class="absolute left-3.5 top-4">
      <span class="inline-flex items-center gap-1.5 rounded-lg border border-border/80 bg-white/95 px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#1b4332] shadow-2xs backdrop-blur-xs">
        <span class="material-symbols-outlined text-xs">verified</span>
        {{product.registration_code}}
      </span>
    </div>

    <span data-product-gallery-source class="absolute bottom-3.5 left-3.5 max-w-[75%] truncate rounded-md bg-slate-900/75 px-2.5 py-1 font-mono text-[10px] tracking-wider text-white backdrop-blur-xs">
      {{#if product.images.[0].source}}CRÉDITO: {{product.images.[0].source}}{{else}}ENVASE / ETIQUETA · INIFAP{{/if}}
    </span>

    {{#if (gt product.images.length 1)}}
      <button type="button" data-product-gallery-prev class="absolute left-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white/90 text-foreground shadow-md backdrop-blur-xs transition hover:bg-white cursor-pointer" aria-label="Imagen anterior">
        <span class="material-symbols-outlined text-base">chevron_left</span>
      </button>
      <button type="button" data-product-gallery-next class="absolute right-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white/90 text-foreground shadow-md backdrop-blur-xs transition hover:bg-white cursor-pointer" aria-label="Imagen siguiente">
        <span class="material-symbols-outlined text-base">chevron_right</span>
      </button>
      <span data-product-gallery-counter class="absolute bottom-3.5 right-3.5 rounded-full bg-slate-900/80 px-3 py-1 font-mono text-[10px] font-bold text-white">
        1 / {{product.images.length}}
      </span>
    {{/if}}
  </div>

  {{#if (gt product.images.length 1)}}
    <div class="grid grid-cols-4 sm:grid-cols-5 gap-2" aria-label="Imágenes del producto">
      {{#each product.images}}
        <button type="button" data-product-gallery-item data-index="{{@index}}" data-src="{{image_url}}" data-source="{{source}}" class="overflow-hidden rounded-xl border border-border/70 bg-slate-50 p-1.5 transition hover:border-[#1b4332]/60 cursor-pointer" aria-label="Mostrar imagen {{add @index 1}}">
          <img src="{{image_url}}" alt="Miniatura {{add @index 1}} de {{../product.name}}" data-fallback-src="/images/products/default.png" class="h-14 w-full rounded-lg object-contain" loading="lazy" />
        </button>
      {{/each}}
    </div>
  {{/if}}
</div>
