<header class="sticky top-0 md:top-16 z-30 bg-card/90 backdrop-blur-md border-b border-border shadow-2xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-10 py-2.5 flex items-center justify-between gap-4">
    <nav id="sub-nav" class="flex items-center gap-1.5 sm:gap-2 text-xs font-medium text-muted-foreground whitespace-nowrap overflow-x-auto no-scrollbar scroll-smooth py-0.5">
      <a href="#resumen" data-spy-link="resumen" class="px-3 py-1.5 rounded-lg border border-transparent text-[#1b4332] bg-emerald-50 border-emerald-200/80 font-bold transition-all flex items-center gap-1.5 shadow-2xs">
        <span class="material-symbols-outlined text-sm text-[#1b4332]">info</span> Resumen
      </a>
      <a href="#kpis" data-spy-link="kpis" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">trending_up</span> Indicadores
      </a>
      {{#if calendar.hasCalendar}}
        <a href="#calendario" data-spy-link="calendario" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">calendar_month</span> Calendario
        </a>
      {{/if}}
      <a href="#agroclima" data-spy-link="agroclima" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">thermostat</span> Agroclima
      </a>
      <a href="#suelo" data-spy-link="suelo" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">landscape</span> Suelo y Siembra
      </a>
      <a href="#manejo" data-spy-link="manejo" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">agriculture</span> Manejo
      </a>
      <a href="#plagas" data-spy-link="plagas" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">bug_report</span> Plagas
        {{#if plaguesCount}}<span class="px-1.5 py-0.5 text-[10px] font-mono bg-rose-50 text-rose-700 rounded-full font-bold">{{plaguesCount}}</span>{{/if}}
      </a>
      <a href="#insumos" data-spy-link="insumos" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">science</span> Insumos
        {{#if productsCount}}<span class="px-1.5 py-0.5 text-[10px] font-mono bg-blue-50 text-blue-700 rounded-full font-bold">{{productsCount}}</span>{{/if}}
      </a>
      <a href="#distribucion" data-spy-link="distribucion" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">map</span> Distribución
      </a>
      {{#if isPrivate}}
        {{#if farmsCount}}
          <a href="#predios" data-spy-link="predios" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">pin_drop</span> Predios
            <span class="px-1.5 py-0.5 text-[10px] font-mono bg-emerald-100 text-[#1b4332] rounded-full font-bold">{{farmsCount}}</span>
          </a>
        {{/if}}
        <a href="#relaciones-tecnicas" data-spy-link="relaciones-tecnicas" class="px-3 py-1.5 rounded-lg border border-transparent hover:text-foreground hover:bg-muted transition-all flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">hub</span> Relaciones
        </a>
      {{/if}}
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        id="btn-open-crop-pdf-modal"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 text-[#1b4332] border border-emerald-200/80 font-bold text-xs rounded-lg hover:bg-emerald-100 transition-colors shadow-2xs cursor-pointer"
        title="Ver o descargar ficha técnica institucional en PDF"
      >
        <span class="material-symbols-outlined text-sm">picture_as_pdf</span>
        <span class="hidden sm:inline">Ficha PDF</span>
      </button>

      <button
        type="button"
        id="btn-share-crop"
        data-share-title="{{crop.commonName}}"
        data-share-text="Ficha técnica de {{crop.commonName}} ({{crop.scientificName}}) - INIFAP Agrosystem"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-card border border-border text-foreground text-xs rounded-lg hover:bg-secondary transition-colors shadow-2xs cursor-pointer"
        title="Compartir o copiar enlace del expediente"
        aria-label="Compartir ficha técnica"
      >
        <span class="material-symbols-outlined text-sm">share</span>
      </button>

      {{#if isPrivate}}
        <a href="/private/crops" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-card border border-border text-foreground font-bold text-xs rounded-lg hover:bg-secondary transition-colors shadow-2xs">
          <span class="material-symbols-outlined text-xs">arrow_back</span>
          <span class="hidden sm:inline">Panel</span>
        </a>
      {{else}}
        <a href="/crops" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-card border border-border text-foreground font-bold text-xs rounded-lg hover:bg-secondary transition-colors shadow-2xs">
          <span class="material-symbols-outlined text-xs">arrow_back</span>
          <span class="hidden sm:inline">Catálogo</span>
          <span class="sm:hidden">Volver</span>
        </a>
      {{/if}}
    </div>
  </div>
</header>
