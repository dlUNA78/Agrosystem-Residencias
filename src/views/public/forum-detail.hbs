<!-- Vista Detalle de Hilo Fitosanitario e Hilo de Comentarios (/forum/:id) -->
<main class="font-['Geist'] antialiased">
  <section aria-labelledby="thread-title" class="bg-background min-h-screen pb-20">
    <div class="mx-auto max-w-5xl px-6 py-10">

      <!-- Navegación Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-muted-foreground">
        <a href="/" class="hover:underline hover:text-foreground">Inicio</a>
        <span>/</span>
        <a href="/forum" class="hover:underline hover:text-foreground">Foro Fitosanitario</a>
        <span>/</span>
        <span class="text-foreground font-semibold">Consulta #{{thread.id}}</span>
      </nav>

      <!-- ARTÍCULO PRINCIPAL: PUBLICACIÓN ORIGINAL DEL AGRICULTOR -->
      <article class="border border-border bg-card rounded-lg shadow-2xs overflow-hidden mb-8">
        
        <!-- Cabecera del Hilo -->
        <div class="flex flex-col gap-4 border-b border-border bg-muted/30 p-6">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <img
                src="{{thread.author.avatar}}"
                alt="{{thread.author.name}}"
                class="size-11 rounded-full object-cover border border-border"
              />
              <div class="flex flex-col">
                <span class="text-sm font-bold text-foreground">{{thread.author.name}}</span>
                <span class="text-xs font-mono text-muted-foreground">{{thread.author.roleLabel}} · {{thread.author.location}}</span>
              </div>
            </div>
            <span class="text-xs font-mono text-muted-foreground">{{thread.timeAgo}}</span>
          </div>

          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 bg-secondary text-[#1b4332] rounded font-mono text-xs font-bold">{{thread.category}}</span>
            <a href="{{thread.cropUrl}}" class="text-xs font-semibold text-[#1b4332] hover:underline">
              Cultivo afectado: {{thread.cropName}}
            </a>
          </div>

          <h1 id="thread-title" class="text-2xl font-headline font-extrabold leading-snug tracking-tight text-foreground md:text-3xl">
            {{thread.title}}
          </h1>
        </div>

        <!-- Contenido y Galería del Post Original -->
        <div class="p-6 flex flex-col gap-6">
          <p class="text-base leading-relaxed text-foreground/90 whitespace-pre-line">
            {{thread.content}}
          </p>

          {{#if thread.images}}
            <div class="flex flex-col gap-2">
              <h4 class="text-xs font-headline font-bold text-muted-foreground uppercase tracking-wider">Evidencia Fitosanitaria Adjunta:</h4>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {{#each thread.images}}
                  <div class="group relative overflow-hidden rounded-md border border-border bg-muted">
                    <img src="{{this.url}}" alt="{{this.caption}}" class="aspect-4/3 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                    <div class="absolute inset-x-0 bottom-0 bg-black/70 p-2 backdrop-blur-xs">
                      <p class="text-[11px] font-mono text-white/90">{{this.caption}}</p>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}

          <!-- Botones de Acción del Post -->
          <div class="flex items-center justify-between border-t border-border pt-4 text-xs font-semibold text-muted-foreground">
            <div class="flex items-center gap-4">
              <button type="button" class="flex items-center gap-1.5 hover:text-[#1b4332] cursor-pointer">
                <span class="material-symbols-outlined text-lg">thumb_up</span>
                <span>Útil (18)</span>
              </button>
              <button type="button" class="flex items-center gap-1.5 hover:text-[#1b4332] cursor-pointer">
                <span class="material-symbols-outlined text-lg">bookmark</span>
                <span>Guardar</span>
              </button>
            </div>
            <span class="text-mono-label text-muted-foreground">Vigilancia INIFAP Activa</span>
          </div>
        </div>

      </article>

      <!-- 🌟 TARJETA DESTACADA: RESPUESTA Y DIAGNÓSTICO VERIFICADO INIFAP -->
      {{#if thread.officialAnswer}}
        <section class="border-2 border-[#1b4332] bg-emerald-50/70 dark:bg-emerald-950/20 rounded-lg shadow-md overflow-hidden mb-10">
          
          <!-- Encabezado Oficial INIFAP -->
          <div class="flex items-center justify-between bg-[#1b4332] px-6 py-3.5 text-white">
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-emerald-300 text-xl">verified</span>
              <h2 class="text-sm font-headline font-bold uppercase tracking-wider">
                DIAGNÓSTICO Y TRATAMIENTO OFICIAL INIFAP
              </h2>
            </div>
            <span class="text-mono-label text-[11px] text-emerald-200 font-mono">{{thread.officialAnswer.date}}</span>
          </div>

          <!-- Perfil del Investigador INIFAP -->
          <div class="p-6 flex flex-col gap-5">
            <div class="flex items-center gap-4 border-b border-emerald-200/60 dark:border-emerald-800/60 pb-4">
              <img
                src="{{thread.officialAnswer.doctorAvatar}}"
                alt="{{thread.officialAnswer.doctorName}}"
                class="size-12 rounded-full object-cover border-2 border-[#1b4332]"
              />
              <div class="flex flex-col">
                <span class="text-base font-bold text-foreground">{{thread.officialAnswer.doctorName}}</span>
                <span class="text-xs font-semibold text-[#1b4332]">{{thread.officialAnswer.doctorRole}}</span>
              </div>
            </div>

            <!-- Dictamen de Diagnóstico -->
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-headline font-bold text-[#1b4332] uppercase tracking-wider">🔬 Dictamen del Patógeno / Diagnóstico:</h3>
              <p class="text-sm leading-relaxed text-foreground font-medium bg-card/80 p-4 rounded-md border border-emerald-200/60 dark:border-emerald-900/60">
                {{thread.officialAnswer.diagnosis}}
              </p>
            </div>

            <!-- Producto Recomendado del Catálogo -->
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-headline font-bold text-[#1b4332] uppercase tracking-wider">🧪 Producto Fitosanitario Validado en Catálogo:</h3>
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-card p-4 rounded-md border border-border shadow-2xs">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center gap-2">
                    <span class="text-base font-bold text-foreground">{{thread.officialAnswer.productRecommended.name}}</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 bg-emerald-100 text-emerald-900 rounded">EN CATÁLOGO</span>
                  </div>
                  <span class="text-xs text-muted-foreground">Ingrediente Activo: <strong>{{thread.officialAnswer.productRecommended.activeIngredient}}</strong></span>
                  <span class="text-xs font-mono text-muted-foreground">Dosis: {{thread.officialAnswer.productRecommended.dose}} · Carencia: {{thread.officialAnswer.productRecommended.safetyDays}} días</span>
                </div>
                <a
                  href="{{thread.officialAnswer.productRecommended.productUrl}}"
                  class="px-4 py-2 bg-[#1b4332] hover:bg-[#143326] text-white text-xs font-bold rounded-md shadow-2xs transition-colors shrink-0"
                >
                  Ver Ficha Técnica →
                </a>
              </div>
            </div>

            <!-- Indicaciones Fitosanitarias adicionales -->
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-headline font-bold text-[#1b4332] uppercase tracking-wider">📋 Recomendaciones de Manejo Integrado:</h3>
              <ul class="flex flex-col gap-1.5 list-disc list-inside text-xs text-foreground/90 leading-relaxed">
                {{#each thread.officialAnswer.recommendations}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            </div>

          </div>
        </section>
      {{/if}}

      <!-- SECCIÓN DE COMENTARIOS DE LA COMUNIDAD -->
      <section class="flex flex-col gap-6">
        <h3 class="text-lg font-headline font-bold text-foreground border-b border-border pb-3 flex items-center justify-between">
          <span>Respuestas de la Comunidad ({{thread.replies.length}})</span>
          <span class="text-xs font-mono text-muted-foreground">Vigilancia Abierta</span>
        </h3>

        <!-- Lista de Comentarios -->
        <div class="flex flex-col gap-4">
          {{#each thread.replies}}
            <article class="border border-border bg-card rounded-lg p-5 shadow-2xs flex flex-col gap-3">
              <div class="flex items-center justify-between border-b border-border/60 pb-3">
                <div class="flex items-center gap-3">
                  <img src="{{this.authorAvatar}}" alt="{{this.authorName}}" class="size-8 rounded-full object-cover border border-border" />
                  <div class="flex flex-col">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold text-foreground">{{this.authorName}}</span>
                      <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-muted text-muted-foreground border border-border">{{this.authorRole}}</span>
                    </div>
                    <span class="text-[11px] font-mono text-muted-foreground">{{this.timeAgo}}</span>
                  </div>
                </div>
                <button type="button" class="flex items-center gap-1 text-xs font-mono text-muted-foreground hover:text-[#1b4332] cursor-pointer">
                  <span class="material-symbols-outlined text-sm">thumb_up</span>
                  <span>{{this.upvotes}}</span>
                </button>
              </div>

              <p class="text-sm leading-relaxed text-foreground/90">
                {{this.content}}
              </p>
            </article>
          {{/each}}
        </div>

        <!-- EDITOR RICH DE COMENTARIO -->
        <div class="border border-border bg-card rounded-lg p-5 shadow-2xs mt-4">
          <h4 class="text-sm font-headline font-bold text-foreground mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-[#1b4332] text-lg">rate_review</span>
            Agregar Comentario o Recomendación
          </h4>

          <form id="form-add-reply" onsubmit="return false;" class="flex flex-col gap-3">
            <textarea
              rows="3"
              placeholder="Escribe tu aporte o consulta adicional..."
              class="w-full border border-input bg-background p-3 text-sm rounded-md outline-none focus:border-[#1b4332]"
              required
            ></textarea>
            
            <div class="flex items-center justify-between">
              <button type="button" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground cursor-pointer">
                <span class="material-symbols-outlined text-base">attach_file</span>
                Adjuntar Evidencia
              </button>
              <button type="submit" class="px-5 py-2.5 bg-[#1b4332] hover:bg-[#143326] text-white text-xs font-bold rounded-md shadow-2xs transition-colors cursor-pointer">
                Publicar Respuesta
              </button>
            </div>
          </form>
        </div>

      </section>

    </div>
  </section>
</main>
