<!-- Mensajería Privada y Chat Fitosanitario (/forum/messages) -->
<main class="font-['Geist'] antialiased">
  <section aria-labelledby="messages-title" class="bg-background min-h-screen pb-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-6 md:py-10">

      <!-- Encabezado de la Sección (Oculto en móvil cuando está en chat activo) -->
      <div class="flex flex-col gap-2 border-b border-border pb-6">
        <p class="text-mono-label text-[#1b4332] font-semibold tracking-wider uppercase">
          MENSAJERÍA PRIVADA FITOSANITARIA · AGROSYSTEM
        </p>
        <h1 id="messages-title" class="text-3xl font-headline font-extrabold leading-tight text-foreground md:text-4xl">
          Mensajes y Asesoría 1 a 1
        </h1>
        <p class="text-xs leading-relaxed text-muted-foreground">
          En el escritorio funciona como dock de mensajes tipo LinkedIn / Messenger. En dispositivos móviles se adapta a pantalla completa para facilitar la escritura en campo.
        </p>
      </div>

      <!-- PESTAÑAS DE NAVEGACIÓN SUB-FORO -->
      <div class="mt-4 flex items-center gap-2 border-b border-border text-sm font-semibold mb-6 overflow-x-auto">
        <a href="/forum" class="px-4 py-2.5 text-muted-foreground hover:text-foreground border-b-2 border-transparent transition-colors shrink-0">
          💬 Consultas Fitosanitarias
        </a>
        <a href="/forum/specialists" class="px-4 py-2.5 text-muted-foreground hover:text-foreground border-b-2 border-transparent transition-colors shrink-0">
          🔍 Descubre Contactos
        </a>
        <a href="/forum/messages" class="px-4 py-2.5 text-[#1b4332] border-b-2 border-[#1b4332] font-bold flex items-center gap-1.5 shrink-0">
          📩 Mensajes Privados
          <span class="px-1.5 py-0.5 bg-rose-100 text-rose-800 text-[10px] font-bold rounded-full">1</span>
        </a>
      </div>

      <!-- CONTENEDOR PRINCIPAL DE CHAT DE DOS PANELES (MÓVIL + ESCRITORIO) -->
      <div id="messaging-container" class="grid grid-cols-1 lg:grid-cols-12 border border-border bg-card rounded-lg overflow-hidden shadow-sm min-h-160 relative">

        <!-- PANEL IZQUIERDO: LISTA DE CONVERSACIONES (En móvil se oculta al abrir un chat) -->
        <aside id="chat-sidebar" class="lg:col-span-4 border-r border-border bg-muted/20 flex flex-col w-full">
          <div class="p-4 border-b border-border flex items-center justify-between gap-2">
            <h2 class="text-sm font-headline font-bold text-foreground">Conversaciones Activas</h2>
            <span class="text-[10px] font-mono bg-secondary text-[#1b4332] px-2 py-0.5 rounded-full font-bold">3 chats</span>
          </div>

          <div class="p-3 border-b border-border">
            <input
              type="search"
              placeholder="Buscar chats o mensajes..."
              class="w-full h-9 border border-input bg-card px-3 text-xs rounded-md outline-none focus:border-[#1b4332]"
            />
          </div>

          <!-- Lista de Contactos -->
          <div class="flex flex-col divide-y divide-border/60 overflow-y-auto max-h-135">
            {{#each conversations}}
              <div
                class="btn-select-chat p-4 flex items-start gap-3 cursor-pointer transition-colors hover:bg-card {{#if this.isActive}}bg-card border-l-4 border-l-[#1b4332]{{/if}}"
                data-chat-id="{{this.id}}"
              >
                <div class="relative shrink-0">
                  <img src="{{this.contactAvatar}}" alt="{{this.contactName}}" class="size-10 rounded-full object-cover border border-border" />
                  <span class="absolute bottom-0 right-0 size-2.5 rounded-full bg-emerald-500 ring-2 ring-card"></span>
                </div>
                
                <div class="flex flex-col min-w-0 flex-1 gap-0.5">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-foreground truncate">{{this.contactName}}</span>
                    <span class="text-[10px] font-mono text-muted-foreground shrink-0">{{this.timeAgo}}</span>
                  </div>
                  <span class="text-[10px] font-semibold text-[#1b4332] truncate">{{this.contactRole}}</span>
                  <p class="text-xs text-muted-foreground truncate">{{this.lastMessage}}</p>
                </div>

                {{#if this.unreadCount}}
                  <span class="px-1.5 py-0.5 bg-rose-600 text-white text-[10px] font-bold rounded-full shrink-0">{{this.unreadCount}}</span>
                {{/if}}
              </div>
            {{/each}}
          </div>
        </aside>

        <!-- PANEL DERECHO: ÁREA DE CHAT ACTIVO (Estilo LinkedIn / Messenger) -->
        <section id="chat-main-area" class="lg:col-span-8 flex flex-col justify-between bg-card w-full">
          
          <!-- Encabezado del Chat (Con botón 'Volver' en móvil) -->
          <div class="flex items-center justify-between border-b border-border p-3.5 bg-muted/30">
            <div class="flex items-center gap-3">
              <!-- Botón 'Volver a contactos' visible solo en dispositivos móviles -->
              <button
                id="btn-back-to-contacts"
                type="button"
                class="lg:hidden p-1.5 border border-border text-foreground rounded-md text-xs font-bold flex items-center gap-1 hover:bg-muted"
              >
                <span class="material-symbols-outlined text-base">arrow_back</span>
                <span>Contactos</span>
              </button>

              <div class="relative shrink-0">
                <img src="{{activeChat.contactAvatar}}" alt="{{activeChat.contactName}}" class="size-10 rounded-full object-cover border border-border" />
                <span class="absolute bottom-0 right-0 size-2.5 rounded-full bg-emerald-500 ring-2 ring-card"></span>
              </div>
              <div class="flex flex-col min-w-0">
                <h3 class="text-sm font-bold text-foreground truncate">{{activeChat.contactName}}</h3>
                <span class="text-[11px] font-mono text-muted-foreground truncate">{{activeChat.contactRole}}</span>
              </div>
            </div>

            <div class="hidden sm:flex items-center gap-2">
              <span class="px-2.5 py-1 bg-emerald-100 text-emerald-900 border border-emerald-300 text-[11px] font-bold rounded-md flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">verified</span>
                Diagnóstico INIFAP
              </span>
            </div>
          </div>

          <!-- Hilo de Mensajes -->
          <div class="flex-1 p-4 sm:p-6 overflow-y-auto flex flex-col gap-4 bg-background/40 max-h-115">
            
            <div class="text-center my-1">
              <span class="px-3 py-1 bg-muted text-muted-foreground text-[10px] font-mono rounded-full border border-border">
                Caso fitosanitario vinculado #102: {{activeChat.linkedThread.title}}
              </span>
            </div>

            {{#each activeChat.messages}}
              {{#if (eq this.sender 'user')}}
                <!-- Mensaje del Usuario / Agricultor (Derecha) -->
                <div class="flex items-end justify-end gap-2 max-w-[88%] sm:max-w-[75%] ml-auto">
                  <div class="flex flex-col items-end gap-1">
                    <div class="bg-[#1b4332] text-white p-3.5 rounded-2xl rounded-br-none text-xs leading-relaxed shadow-2xs">
                      {{this.text}}

                      {{#if this.attachment}}
                        <div class="mt-2 flex items-center gap-2 bg-white/10 p-2 rounded-md border border-white/20">
                          <span class="material-symbols-outlined text-base">picture_as_pdf</span>
                          <div class="flex flex-col text-[11px]">
                            <span class="font-bold">{{this.attachment.name}}</span>
                            <span class="text-white/80 font-mono">{{this.attachment.size}}</span>
                          </div>
                        </div>
                      {{/if}}
                    </div>
                    <span class="text-[10px] font-mono text-muted-foreground">{{this.time}}</span>
                  </div>
                </div>
              {{else}}
                <!-- Mensaje del Especialista INIFAP (Izquierda) -->
                <div class="flex items-start gap-3 max-w-[90%] sm:max-w-[80%]">
                  <img src="{{this.avatar}}" alt="{{this.senderName}}" class="size-8 rounded-full object-cover border border-border shrink-0 mt-1" />
                  <div class="flex flex-col gap-1">
                    <span class="text-[11px] font-bold text-[#1b4332]">{{this.senderName}}</span>
                    <div class="bg-card border border-border text-foreground p-3.5 rounded-2xl rounded-tl-none text-xs leading-relaxed shadow-2xs">
                      {{this.text}}

                      {{#if this.productRecommendation}}
                        <div class="mt-3 flex flex-col gap-2 bg-emerald-50 dark:bg-emerald-950/40 p-3 rounded-lg border border-emerald-200 dark:border-emerald-800">
                          <div class="flex items-center justify-between">
                            <span class="font-bold text-foreground text-xs">{{this.productRecommendation.name}}</span>
                            <span class="text-[9px] font-bold px-2 py-0.5 bg-emerald-100 text-emerald-900 rounded">RECOMENDADO</span>
                          </div>
                          <span class="text-[11px] text-muted-foreground">Ingrediente: {{this.productRecommendation.activeIngredient}}</span>
                          <span class="text-[11px] font-mono text-muted-foreground">Dosis: {{this.productRecommendation.dose}}</span>
                          <a href="{{this.productRecommendation.productUrl}}" class="mt-1 text-center py-1 bg-[#1b4332] text-white text-[11px] font-bold rounded">
                            Ver Producto en Catálogo →
                          </a>
                        </div>
                      {{/if}}
                    </div>
                    <span class="text-[10px] font-mono text-muted-foreground">{{this.time}}</span>
                  </div>
                </div>
              {{/if}}
            {{/each}}

          </div>

          <!-- Barra Inferior de Entrada (Composer) -->
          <div class="border-t border-border p-3 sm:p-4 bg-card">
            <form onsubmit="return false;" class="flex items-center gap-2">
              <input
                type="text"
                placeholder="Escribir mensaje a {{activeChat.contactName}}..."
                class="flex-1 h-10 border border-input bg-background px-3 text-xs rounded-md outline-none focus:border-[#1b4332]"
              />
              <button type="button" class="size-10 flex items-center justify-center text-muted-foreground hover:text-foreground border border-border rounded-md cursor-pointer shrink-0" title="Adjuntar foto o PDF">
                <span class="material-symbols-outlined text-lg">attach_file</span>
              </button>
              <button type="submit" class="h-10 px-4 bg-[#1b4332] hover:bg-[#143326] text-white text-xs font-bold rounded-md shadow-2xs transition-colors flex items-center gap-1 cursor-pointer shrink-0">
                <span class="material-symbols-outlined text-base">send</span>
                <span class="hidden sm:inline">Enviar</span>
              </button>
            </form>
          </div>

        </section>

      </div>

    </div>
  </section>
</main>
