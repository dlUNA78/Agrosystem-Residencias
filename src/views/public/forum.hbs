<!-- Área Principal del Foro de Consulta Fitosanitaria (/forum) -->
<main class="font-['Geist'] antialiased">
  <section aria-labelledby="forum-title" class="bg-background min-h-screen pb-20">
    <div class="mx-auto max-w-7xl px-6 py-10 md:py-14">

      <!-- Encabezado de la Sección -->
      <div class="flex flex-col gap-3 border-b border-border pb-8">
        <p class="text-mono-label text-[#1b4332] font-semibold tracking-wider uppercase">
          VIGILANCIA FITOSANITARIA · COMUNIDAD Y DIAGNÓSTICO
        </p>
        <h1 id="forum-title" class="text-4xl font-headline font-extrabold leading-[1.05] tracking-tight text-foreground md:text-5xl">
          Foro de Consulta Fitosanitaria
        </h1>
        <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
          Red de soporte técnico y científico entre productores agrícolas y el personal del INIFAP. Consulta sobre plagas, publica fotos de síntomas y recibe diagnósticos verificados.
        </p>
      </div>

      <!-- PESTAÑAS DE NAVEGACIÓN SUB-FORO -->
      <div class="mt-6 flex items-center gap-2 border-b border-border text-sm font-semibold">
        <a href="/forum" class="px-4 py-2.5 text-[#1b4332] border-b-2 border-[#1b4332] font-bold">
          💬 Consultas Fitosanitarias
        </a>
        <a href="/forum/specialists" class="px-4 py-2.5 text-muted-foreground hover:text-foreground border-b-2 border-transparent transition-colors">
          🔍 Descubre Contactos
        </a>
      </div>

      <!-- BARRA DE BUSCADOR Y FILTROS -->
      <div class="my-6 border-b border-border bg-background py-2">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center">

          <!-- Campo de Búsqueda -->
          <div class="relative flex-1">
            <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-lg">search</span>
            <input
              id="forum-search-input"
              type="search"
              placeholder="Buscar por síntoma, cultivo, plaga o recomendación técnica…"
              class="h-10 w-full border border-input bg-card pl-10 pr-4 text-sm rounded-md outline-none transition-all placeholder:text-muted-foreground focus-visible:border-[#1b4332] focus-visible:ring-2 focus-visible:ring-[#1b4332]/20"
            />
          </div>

          <!-- Dropdowns de Filtrado -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 lg:w-auto lg:flex">

            <!-- Filtro Categoría -->
            <div class="relative lg:w-48">
              <select id="category-filter" class="h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                <option value="Todas">Categoría · Todas</option>
                <option value="Plagas">🐛 Plagas e Insectos</option>
                <option value="Hongos">🍄 Hongos y Enfermedades</option>
                <option value="Tratamientos">🧪 Tratamientos y Químicos</option>
                <option value="Resueltas">✅ Resueltas por INIFAP</option>
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
            </div>

            <!-- Orden -->
            <div class="relative lg:w-44">
              <select id="sort-filter" class="h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                <option value="recientes">Más recientes</option>
                <option value="comentados">Más comentados</option>
                <option value="votados">Más votados</option>
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
            </div>

            <!-- CTA Crear Consulta -->
            <button
              id="btn-open-create-modal"
              type="button"
              class="h-10 px-4 bg-[#1b4332] hover:bg-[#143326] text-white font-bold text-xs rounded-md shadow-2xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer shrink-0"
            >
              <span class="material-symbols-outlined text-base">add_circle</span>
              Nueva Consulta
            </button>
          </div>
        </div>
      </div>

      <!-- LAYOUT DE 2 COLUMNAS (FEED + SIDEBAR) -->
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

        <!-- COLUMNA PRINCIPAL: FEED DE HILOS (col-span-8) -->
        <section class="lg:col-span-8 flex flex-col gap-6">

          {{#each threads}}
            <article class="group flex flex-col border border-border bg-card transition-all duration-200 hover:border-[#1b4332]/40 rounded-lg overflow-hidden shadow-2xs {{#if this.isPinned}}border-l-4 border-l-[#1b4332]{{/if}}">
              
              <!-- Cabecera de la Tarjeta del Hilo -->
              <div class="flex items-center justify-between gap-4 border-b border-border bg-muted/40 px-5 py-3">
                <div class="flex items-center gap-3">
                  <img
                    src="{{this.author.avatar}}"
                    alt="{{this.author.name}}"
                    class="size-9 rounded-full object-cover border border-border"
                  />
                  <div class="flex flex-col">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold text-foreground">{{this.author.name}}</span>
                      <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full {{#if (eq this.author.role 'inifap')}}bg-emerald-100 text-emerald-900 border border-emerald-300 dark:bg-emerald-950 dark:text-emerald-300{{else}}bg-muted text-muted-foreground border border-border{{/if}}">
                        {{this.author.roleLabel}}
                      </span>
                    </div>
                    <span class="text-[11px] font-mono text-muted-foreground">{{this.author.location}} · {{this.timeAgo}}</span>
                  </div>
                </div>

                <!-- Insignia de Estado -->
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md border {{this.badgeClass}}">
                  {{this.badgeLabel}}
                </span>
              </div>

              <!-- Contenido Principal del Hilo -->
              <div class="flex flex-col gap-3 p-5">
                <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
                  <span class="px-2 py-0.5 bg-secondary text-[#1b4332] rounded font-mono text-[11px]">{{this.category}}</span>
                  <span>·</span>
                  <a href="{{this.cropUrl}}" class="hover:underline text-[#1b4332] font-semibold">
                    Cultivo: {{this.cropName}}
                  </a>
                </div>

                <h2 class="text-lg font-headline font-bold leading-snug tracking-tight text-foreground group-hover:text-[#1b4332] transition-colors">
                  <a href="/forum/{{this.id}}">{{this.title}}</a>
                </h2>

                <p class="text-sm leading-relaxed text-muted-foreground line-clamp-3">
                  {{this.summary}}
                </p>

                {{#if this.imageUrl}}
                  <div class="mt-2 aspect-21/9 overflow-hidden rounded-md border border-border bg-muted">
                    <img
                      src="{{this.imageUrl}}"
                      alt="{{this.title}}"
                      class="size-full object-cover transition-transform duration-500 group-hover:scale-103"
                    />
                  </div>
                {{/if}}

                <!-- Pie de Tarjeta / Acciones -->
                <div class="mt-4 flex items-center justify-between border-t border-border pt-4 text-xs font-semibold text-muted-foreground">
                  <div class="flex items-center gap-4">
                    <span class="flex items-center gap-1.5 hover:text-[#1b4332] transition-colors">
                      <span class="material-symbols-outlined text-base">chat_bubble</span>
                      <span class="font-mono">{{this.repliesCount}}</span> respuestas
                    </span>
                    <span class="flex items-center gap-1.5 hover:text-[#1b4332] transition-colors">
                      <span class="material-symbols-outlined text-base">thumb_up</span>
                      <span class="font-mono">{{this.upvotesCount}}</span> útiles
                    </span>
                    <span class="hidden sm:flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-base">visibility</span>
                      <span class="font-mono">{{this.viewsCount}}</span> vistas
                    </span>
                  </div>

                  <a href="/forum/{{this.id}}" class="inline-flex items-center gap-1 text-xs font-bold text-[#1b4332] hover:underline">
                    Ver conversación →
                  </a>
                </div>
              </div>

            </article>
          {{/each}}

        </section>

        <!-- COLUMNA LATERAL: SIDEBAR FITOSANITARIO (col-span-4) -->
        <aside class="lg:col-span-4 flex flex-col gap-6">

          <!-- Card 1: CTA Nueva Consulta Fitosanitaria -->
          <div class="border border-[#1b4332]/30 rounded-lg bg-emerald-50/50 dark:bg-emerald-950/20 p-5 shadow-2xs">
            <div class="flex items-center gap-3 mb-3">
              <span class="material-symbols-outlined text-3xl text-[#1b4332]">contact_support</span>
              <div>
                <h3 class="text-base font-headline font-bold text-foreground">¿Tienes dudas en campo?</h3>
                <p class="text-xs text-muted-foreground">Diagnóstico verificado por INIFAP</p>
              </div>
            </div>
            <p class="text-xs leading-relaxed text-muted-foreground mb-4">
              Sube fotos claras de tus hojas, frutos o tallos afectados. Nuestros especialistas evalúan los síntomas y recomiendan tratamientos fitosanitarios autorizados.
            </p>
            <button
              id="btn-sidebar-create"
              type="button"
              class="w-full py-2.5 bg-[#1b4332] hover:bg-[#143326] text-white font-bold text-xs rounded-md shadow-2xs transition-colors flex items-center justify-center gap-2 cursor-pointer"
            >
              <span class="material-symbols-outlined text-base">add_a_photo</span>
              Publicar Caso de Campo
            </button>
          </div>

          <!-- Card 2: Alertas Fitosanitarias Activas en Sinaloa -->
          <div class="border border-border rounded-lg bg-card p-5 shadow-2xs">
            <div class="flex items-center justify-between mb-4 border-b border-border pb-3">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-rose-600 animate-pulse text-lg">warning</span>
                <h3 class="text-sm font-headline font-bold text-foreground">Alertas Fitosanitarias</h3>
              </div>
              <span class="text-mono-label text-[10px] text-muted-foreground">SINALOA</span>
            </div>

            <ul class="flex flex-col gap-3">
              <li class="flex flex-col gap-1 border-b border-border/60 pb-2.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-foreground">Pulgón Amarillo en Maíz</span>
                  <span class="px-2 py-0.5 bg-rose-100 text-rose-800 text-[10px] font-bold rounded">ALTO RIESGO</span>
                </div>
                <p class="text-xs text-muted-foreground">Valle del Fuerte y Guasave. Se recomienda monitoreo ninfal diario.</p>
              </li>
              <li class="flex flex-col gap-1">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-foreground">Cenicilla en Cucurbitáceas</span>
                  <span class="px-2 py-0.5 bg-amber-100 text-amber-800 text-[10px] font-bold rounded">MODERADO</span>
                </div>
                <p class="text-xs text-muted-foreground">Culiacán y Navolato. Aplicación preventiva de triazoles recomendada.</p>
              </li>
            </ul>
          </div>

          <!-- Card 3: Especialistas INIFAP Disponibles -->
          <div class="border border-border rounded-lg bg-card p-5 shadow-2xs">
            <h3 class="text-sm font-headline font-bold text-foreground mb-4 border-b border-border pb-3">
              Especialistas Fitosanitarios INIFAP
            </h3>
            <ul class="flex flex-col gap-3">
              <li class="flex items-center gap-3">
                <img
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80"
                  alt="Dr. Roberto Mendoza"
                  class="size-9 rounded-full object-cover border border-border"
                />
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-foreground">Dr. Roberto Mendoza</span>
                  <span class="text-[11px] text-muted-foreground">Micología y Hongos</span>
                </div>
                <span class="ml-auto size-2.5 rounded-full bg-emerald-500" title="En línea"></span>
              </li>
              <li class="flex items-center gap-3">
                <img
                  src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=150&q=80"
                  alt="Ing. María Fernanda López"
                  class="size-9 rounded-full object-cover border border-border"
                />
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-foreground">Ing. María Fernanda</span>
                  <span class="text-[11px] text-muted-foreground">Entomología Agrícola</span>
                </div>
                <span class="ml-auto size-2.5 rounded-full bg-emerald-500" title="En línea"></span>
              </li>
            </ul>
          </div>

        </aside>

      </div>

    </div>
  </section>
</main>

<!-- MODAL DEMO: NUEVA CONSULTA FITOSANITARIA -->
<div id="modal-create-thread" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
  <div class="w-full max-w-xl border border-border bg-card rounded-lg shadow-xl overflow-hidden">
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <h3 class="text-lg font-headline font-bold text-foreground flex items-center gap-2">
        <span class="material-symbols-outlined text-[#1b4332]">add_comment</span>
        Nueva Consulta Fitosanitaria
      </h3>
      <button id="btn-close-modal" type="button" class="text-muted-foreground hover:text-foreground text-xl cursor-pointer">✕</button>
    </div>
    
    <form id="form-create-thread" class="p-6 flex flex-col gap-4" onsubmit="return false;">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-bold text-foreground">Título descriptivo del síntoma o consulta *</label>
        <input
          type="text"
          placeholder="Ej. Manchas blancas en envés de hoja de calabacita..."
          class="h-10 w-full border border-input bg-background px-3 text-sm rounded-md outline-none focus:border-[#1b4332]"
          required
        />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-bold text-foreground">Cultivo afectado</label>
          <select class="h-10 w-full border border-input bg-background px-3 text-sm rounded-md outline-none focus:border-[#1b4332]">
            <option>Chile Jalapeño</option>
            <option>Tomate Bola</option>
            <option>Maíz Blanco</option>
            <option>Calabacita</option>
            <option>Otro cultivo</option>
          </select>
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-bold text-foreground">Categoría</label>
          <select class="h-10 w-full border border-input bg-background px-3 text-sm rounded-md outline-none focus:border-[#1b4332]">
            <option>Plagas e Insectos</option>
            <option>Hongos y Enfermedades</option>
            <option>Tratamientos</option>
            <option>General</option>
          </select>
        </div>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-bold text-foreground">Descripción detallada *</label>
        <textarea
          rows="4"
          placeholder="Describe la extensión del daño en la parcela, condiciones de clima recientes y síntomas observados..."
          class="w-full border border-input bg-background p-3 text-sm rounded-md outline-none focus:border-[#1b4332]"
          required
        ></textarea>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-bold text-foreground">Fotografía de la plaga o síntoma (Opcional)</label>
        <input
          type="file"
          accept="image/*"
          class="block w-full text-xs text-muted-foreground file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-secondary file:text-[#1b4332] hover:file:bg-emerald-100"
        />
      </div>

      <div class="mt-4 flex items-center justify-end gap-3 border-t border-border pt-4">
        <button id="btn-cancel-modal" type="button" class="px-4 py-2 text-xs font-bold text-muted-foreground hover:text-foreground cursor-pointer">
          Cancelar
        </button>
        <button id="btn-submit-thread" type="submit" class="px-5 py-2.5 bg-[#1b4332] hover:bg-[#143326] text-white text-xs font-bold rounded-md shadow-2xs cursor-pointer">
          Publicar Consulta
        </button>
      </div>
    </form>
  </div>
</div>