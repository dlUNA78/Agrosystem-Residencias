<!-- Área Principal del Catálogo de Plagas (/plagas) -->
<div class="font-['Geist'] antialiased">
  <section aria-labelledby="catalogo-title" class="bg-background min-h-screen pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-12 py-8 md:py-12">
    
      <!-- Encabezado de la Sección -->
      <div class="grid gap-8 border-b border-border pb-8 md:grid-cols-[1.7fr_1fr] md:items-end">
        <div class="flex flex-col gap-3">
          <div class="text-mono-label text-emerald-800 font-semibold tracking-wider flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            SISTEMA NACIONAL DE VIGILANCIA FITOSANITARIA · BASE CIENTÍFICA
          </div>
          <h1 id="catalogo-title" class="text-3xl sm:text-4xl md:text-5xl font-headline font-extrabold leading-[1.05] tracking-tight text-foreground">
            Catálogo de Plagas
          </h1>
          <p class="max-w-xl text-xs sm:text-sm leading-relaxed text-muted-foreground">
            Enciclopedia especializada de agentes biológicos de importancia agrícola. Información técnica validada para el monitoreo fitosanitario y el manejo integrado de plagas (MIP).
          </p>
        </div>

        <!-- Muestra de Métricas Institucionales -->
        <dl class="grid grid-cols-2 divide-x divide-border border border-border rounded-xl bg-card shadow-xs overflow-hidden">
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-2xl sm:text-3xl font-medium tabular-nums text-[#1b4332] counter-stat" data-target="{{totalCount}}" id="total-count-number-header">{{totalCount}}</dd>
            <dt class="text-mono-label text-muted-foreground font-medium text-[10px]">Especies registradas</dt>
          </div>
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-2xl sm:text-3xl font-medium tabular-nums text-[#1b4332]">100%</dd>
            <dt class="text-mono-label text-muted-foreground font-medium text-[10px]">Validación INIFAP</dt>
          </div>
        </dl>
      </div>

      <!-- BARRA PEGAJOSA DE BUSCADOR Y FILTROS CON CHIPS TÁCTILES (Ultra compacta en móvil) -->
      <div class="sticky top-0 md:top-16 z-30 -mx-4 sm:-mx-6 md:-mx-12 mb-6 border-b border-border bg-background/95 px-4 sm:px-6 md:px-12 py-2.5 sm:py-3 backdrop-blur-md shadow-2xs">
        <form action="/plagues" method="GET" id="form-filtros">
          <!-- Fila Principal: Buscador + Botón Filtros Móvil + Selectores Desktop -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-2">
            <!-- Fila Buscador Móvil / Desktop -->
            <div class="flex items-center gap-2 w-full sm:flex-1">
              <div class="relative flex-1">
                <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-lg select-none">search</span>
                <input
                  id="search-input"
                  name="search"
                  type="search"
                  value="{{filters.search}}"
                  placeholder="Buscar por plaga, nombre científico, hospedante o síntoma…"
                  class="h-9 sm:h-10 w-full border border-input bg-card pl-9 sm:pl-10 pr-9 sm:pr-10 text-xs sm:text-sm rounded-md outline-none transition-all placeholder:text-muted-foreground focus-visible:border-[#1b4332] focus-visible:ring-2 focus-visible:ring-[#1b4332]/20"
                  autocomplete="off"
                />
                <button
                  type="button"
                  id="search-clear-btn"
                  class="{{#unless filters.search}}hidden{{/unless}} absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center rounded-full text-muted-foreground hover:text-foreground hover:bg-secondary cursor-pointer transition-all active:scale-90"
                  title="Limpiar búsqueda"
                  aria-label="Limpiar búsqueda"
                >
                  <span class="material-symbols-outlined text-sm">close</span>
                </button>
              </div>

              <!-- Botón Toggle Filtros en Móvil (< sm) -->
              <button
                type="button"
                id="toggle-plagues-filters-btn"
                class="sm:hidden h-9 px-2.5 flex items-center gap-1.5 rounded-md border border-input bg-card text-foreground font-semibold text-xs hover:bg-secondary transition-colors cursor-pointer shrink-0 shadow-2xs"
                aria-expanded="false"
                aria-controls="plagues-collapsible-filters"
                title="Mostrar u ocultar filtros avanzados"
              >
                <span class="material-symbols-outlined text-base text-[#1b4332]">tune</span>
                <span class="text-xs">Filtros</span>
                <span id="plagues-active-filters-count" class="hidden px-1.5 py-0.2 rounded-full bg-[#1b4332] text-white text-[10px] font-mono font-bold leading-none">0</span>
              </button>
            </div>

            <!-- Selectores y Botón (Desktop: en línea; Móvil: colapsable) -->
            <div id="plagues-collapsible-filters" class="hidden sm:flex flex-col sm:flex-row sm:items-center gap-2 w-full sm:w-auto pt-2 sm:pt-0 border-t border-border/50 sm:border-t-0 mt-1 sm:mt-0">
              <!-- Selector de Cultivo Hospedero (Agrupado por Familia / Grupo Botánico) -->
              <div class="relative w-full sm:w-56 shrink-0">
                <select id="crop-filter" name="crop" aria-label="Filtrar por familia o cultivo hospedero" class="h-9 sm:h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-xs sm:text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                  <option value="Cultivo">Familia / Cultivo · Todos</option>
                  {{#if cropGroups.length}}
                    {{#each cropGroups}}
                      <optgroup label="Grupo: {{this.label}}">
                        <option value="{{this.groupValue}}" {{#if (eq ../filters.crop this.groupValue)}}selected{{/if}}>▸ Todo el grupo {{this.groupName}}</option>
                        {{#each this.crops}}
                          <option value="{{this}}" {{#if (eq ../../filters.crop this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </optgroup>
                    {{/each}}
                  {{else}}
                    {{#each crops}}
                      <option value="{{this}}" {{#if (eq ../filters.crop this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                  {{/if}}
                </select>
                <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
              </div>

              <!-- Selector de Región (Agrupado por Macro-región Agroecológica) -->
              <div class="relative w-full sm:w-52 shrink-0">
                <select id="region-filter" name="region" aria-label="Filtrar por macro-región o zona" class="h-9 sm:h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-xs sm:text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                  <option value="Región">Región · Todas</option>
                  {{#if regionGroups.length}}
                    {{#each regionGroups}}
                      <optgroup label="{{this.macroRegion}}">
                        {{#each this.regions}}
                          <option value="{{this}}" {{#if (eq ../../filters.region this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </optgroup>
                    {{/each}}
                  {{else}}
                    {{#each regions}}
                      <option value="{{this}}" {{#if (eq ../filters.region this)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                  {{/if}}
                </select>
                <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
              </div>

              <!-- Selects nativos sincronizados (ocultos visualmente para compatibilidad) -->
              <select id="category-filter" name="category" class="hidden">
                <option value="Categoría">Categoría · Todas</option>
                <option value="Insectos" {{#if (eq filters.category 'Insectos')}}selected{{/if}}>Insectos</option>
                <option value="Hongos" {{#if (eq filters.category 'Hongos')}}selected{{/if}}>Hongos</option>
                <option value="Bacterias" {{#if (eq filters.category 'Bacterias')}}selected{{/if}}>Bacterias</option>
                <option value="Virus" {{#if (eq filters.category 'Virus')}}selected{{/if}}>Virus</option>
                <option value="Ácaros" {{#if (eq filters.category 'Ácaros')}}selected{{/if}}>Ácaros</option>
              </select>

              <select id="risk-filter" name="risk" class="hidden">
                <option value="Riesgo">Riesgo · Todos</option>
                <option value="Crítico" {{#if (eq filters.risk 'Crítico')}}selected{{/if}}>Crítico</option>
                <option value="Moderado" {{#if (eq filters.risk 'Moderado')}}selected{{/if}}>Moderado</option>
                <option value="Bajo" {{#if (eq filters.risk 'Bajo')}}selected{{/if}}>Bajo</option>
              </select>

              <button id="filter-btn" type="button" class="hidden">Filtrar</button>
            </div>
          </div>

          <!-- Filtros Rápidos Táctiles (Chips con Touch-Scroll Móvil) -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 mt-2 pt-2 border-t border-border/40" role="tablist" aria-label="Filtrar por categoría">
            <span class="text-mono-label text-muted-foreground font-bold shrink-0 mr-1 text-[10px]">CATEGORÍA:</span>
            <button
              type="button"
              class="category-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#unless filters.category}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/unless}}"
              data-category=""
            >
              Todas
            </button>
            <button
              type="button"
              class="category-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Insectos')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-category="Insectos"
            >
              Insectos
            </button>
            <button
              type="button"
              class="category-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Hongos')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-category="Hongos"
            >
              Hongos
            </button>
            <button
              type="button"
              class="category-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Bacterias')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-category="Bacterias"
            >
              Bacterias
            </button>
            <button
              type="button"
              class="category-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Virus')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-category="Virus"
            >
              Virus
            </button>
            <button
              type="button"
              class="category-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Ácaros')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-category="Ácaros"
            >
              Ácaros
            </button>
          </div>

          <!-- Fila Nivel de Riesgo Fitosanitario (Visible en desktop; colapsable en móvil) -->
          <div id="plagues-secondary-chips" class="hidden sm:flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 pt-1.5 border-t border-border/40 mt-1" role="tablist" aria-label="Filtrar por nivel de riesgo">
            <span class="text-mono-label text-muted-foreground font-bold shrink-0 mr-1 text-[10px]">RIESGO:</span>
            <button
              type="button"
              class="risk-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#unless filters.risk}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/unless}}"
              data-risk=""
            >
              Todos
            </button>
            <button
              type="button"
              class="risk-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 flex items-center gap-1.5 {{#if (eq filters.risk 'Crítico')}}bg-rose-100 text-rose-900 border border-rose-300 font-bold shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-risk="Crítico"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span>
              Crítico
            </button>
            <button
              type="button"
              class="risk-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 flex items-center gap-1.5 {{#if (eq filters.risk 'Moderado')}}bg-amber-100 text-amber-900 border border-amber-300 font-bold shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-risk="Moderado"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Moderado
            </button>
            <button
              type="button"
              class="risk-chip px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 flex items-center gap-1.5 {{#if (eq filters.risk 'Bajo')}}bg-emerald-100 text-emerald-900 border border-emerald-300 font-bold shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              data-risk="Bajo"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              Bajo
            </button>
          </div>
        </form>
      </div>

      <!-- Barra de Estado de Filtros (Fuera de la barra pegajosa) -->
      <div id="plagues-filter-status" class="mb-4 flex items-center justify-between gap-4 px-1 text-xs">
        <p class="text-mono-label flex items-center gap-2 text-muted-foreground font-medium">
          <span id="total-count-number" class="font-mono font-bold text-foreground tabular-nums">{{totalCount}}</span> especies encontradas
        </p>
        <a href="/plagues" id="reset-all-filters-link" class="inline-flex items-center gap-1 text-xs font-semibold text-[#1b4332] hover:underline cursor-pointer">
          ✕ Limpiar filtros
        </a>
      </div>

      <!-- REJILLA DE TARJETAS DE PLAGA (PESTCARD) -->
      <div id="plagues-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {{#unless plagues.length}}
          <div id="plagues-empty-state" class="col-span-full py-16 px-4 text-center bg-card border border-border rounded-xl shadow-xs space-y-4">
            <div class="w-16 h-16 rounded-full bg-secondary flex items-center justify-center mx-auto text-muted-foreground border border-border">
              <span class="material-symbols-outlined text-3xl">pest_control</span>
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-headline font-bold text-foreground">No se encontraron plagas</h3>
              <p class="text-xs text-muted-foreground max-w-md mx-auto leading-relaxed">
                No hay registros que coincidan con los criterios seleccionados. Intenta modificar el término de búsqueda o restablecer los filtros aplicados.
              </p>
            </div>
            <a href="/plagues" class="inline-block px-4 py-2 bg-[#1b4332] text-white text-xs font-semibold rounded-md hover:bg-[#133426] transition-all cursor-pointer shadow-2xs active:scale-95">
              Restablecer todos los filtros
            </a>
          </div>
        {{/unless}}

        {{#each plagues}}
          <article class="group flex flex-col border border-border bg-card transition-all duration-200 hover:border-[#1b4332]/40 rounded-xl overflow-hidden shadow-2xs hover:shadow-md hover:-translate-y-0.5">
          
            <!-- 1. Barra de Nivel de Riesgo Superior -->
            <div class="h-1.5 w-full {{#if (eq this.riskLabel 'Crítico')}}bg-rose-600{{else if (eq this.riskLabel 'Moderado')}}bg-amber-500{{else}}bg-emerald-600{{/if}}"></div>

            <!-- 2. Marco de Imagen a Color Natural -->
            <div class="relative aspect-4/3 overflow-hidden bg-muted">
              <img
                src="{{#if this.imageUrl}}{{this.imageUrl}}{{else}}{{this.image_url}}{{/if}}"
                alt="{{this.name}}"
                data-fallback-src="/images/test/default.png"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>
            
              <!-- Badge de Riesgo (Top-Left) -->
              <div class="absolute left-3 top-3 flex items-center gap-1.5 bg-card/90 px-2.5 py-1 backdrop-blur rounded-md border border-border shadow-2xs">
                <span aria-hidden="true" class="inline-block size-1.5 rounded-full {{#if (eq this.riskLabel 'Crítico')}}bg-rose-600 animate-pulse{{else if (eq this.riskLabel 'Moderado')}}bg-amber-500{{else}}bg-emerald-600{{/if}}"></span>
                <span class="text-mono-label text-foreground capitalize font-bold text-[10px]">{{this.riskLabel}}</span>
              </div>

              <!-- Crédito de Imagen Minimalista (Bottom-Left) -->
              <span class="absolute left-3 bottom-3 text-mono-label text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
                {{#if this.imageCredit}}{{this.imageCredit}}{{else}}ACERVO FOTO · INIFAP{{/if}}
              </span>
            </div>

            <!-- 3. Contenido de la Tarjeta -->
            <div class="flex flex-1 flex-col gap-3 p-5">
            
              <!-- Taxonomía / Categoría -->
              <p class="text-mono-label text-muted-foreground font-semibold text-[10px]">
                {{this.category}} — VIGILANCIA SANITARIA
              </p>

              <!-- Nombre Común H3 + Nombre Científico -->
              <div class="flex flex-col gap-1">
                <h3 class="text-base sm:text-lg font-headline font-bold leading-tight tracking-tight text-foreground group-hover:text-[#1b4332] transition-colors">
                  {{this.name}}
                </h3>
                <p class="font-mono text-xs italic text-muted-foreground">{{this.scientificName}}</p>
              </div>

              <!-- Descripción corta -->
              <p class="line-clamp-3 text-xs sm:text-sm leading-relaxed text-muted-foreground">
                {{this.description}}
              </p>

              {{#if this.hostCrops.length}}
                <div class="flex flex-wrap items-center gap-1 pt-0.5">
                  {{#each this.hostCrops}}
                    <span class="inline-flex items-center gap-1 rounded-md border border-emerald-200/80 bg-emerald-50/70 px-2 py-0.5 text-[10px] font-semibold text-[#1b4332]">
                      {{this}}
                    </span>
                  {{/each}}
                  {{#if this.extraHostCropsCount}}
                    <span class="rounded-md bg-secondary px-1.5 py-0.5 text-[10px] font-mono font-semibold text-muted-foreground">
                      +{{this.extraHostCropsCount}}
                    </span>
                  {{/if}}
                </div>
              {{/if}}

              <!-- Pie de Tarjeta: Estatus + Enlace a Ficha Técnica -->
              <div class="mt-auto flex items-center justify-between gap-4 border-t border-border pt-4">
                <div class="flex flex-col gap-0.5">
                  <span class="text-mono-label text-muted-foreground text-[9px]">Estatus fitosanitario</span>
                  <span class="text-xs font-semibold text-emerald-800">Verificado INIFAP</span>
                </div>
                <a href="/plagues/{{this.id}}" class="inline-flex shrink-0 items-center gap-1 text-xs font-bold text-[#1b4332] hover:underline active:scale-95 transition-transform">
                  <span>Ficha técnica</span>
                  <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>

            </div>
          </article>
        {{/each}}

        {{#if plagues.length}}
          <!-- Card CTA fija al final para solicitar registro de nueva especie -->
          <article id="cta-new-species" class="group flex flex-col items-center justify-center p-8 border-2 border-dashed border-border hover:border-[#1b4332]/40 rounded-xl bg-card/60 hover:bg-card transition-all text-center">
            <span class="material-symbols-outlined text-4xl text-[#1b4332]/60 mb-3">add_circle</span>
            <h3 class="text-base font-headline font-bold text-foreground mb-1">¿Nueva especie?</h3>
            <p class="text-xs text-muted-foreground leading-relaxed mb-4 max-w-50">
              Colabora con nuestra red científica proponiendo la incorporación de una plaga o patógeno para validación del INIFAP.
            </p>
            {{#if user}}
              <button
                type="button"
                data-open-suggestion-modal
                class="px-4 py-2 bg-[#1b4332] hover:bg-[#2d6a4f] text-white text-xs font-bold rounded-md transition-colors cursor-pointer"
              >
                Sugerir nueva especie
              </button>
            {{else}}
              <a
                href="/auth/login"
                class="px-4 py-2 bg-secondary hover:bg-emerald-100 text-[#1b4332] text-xs font-bold rounded-md border border-border transition-colors"
              >
                Inicia sesión para colaborar
              </a>
            {{/if}}
          </article>
        {{/if}}
      </div>

      <!-- Banner de confirmación de sugerencia ciudadana -->
      <div id="suggestion-success-banner" class="hidden mt-6 items-center justify-between gap-3 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-950">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-700 text-base">verified</span>
          <span>¡Gracias por tu aportación científica! Tu propuesta fue enviada a la bandeja de validación técnica del INIFAP.</span>
        </div>
      </div>

      <!-- Paginación Dinámica -->
      <div class="mt-12 {{#if (eq totalPages 1)}}hidden{{else}}flex{{/if}} justify-center" id="pagination-container">
        <nav aria-label="Paginación de plagas" class="flex items-center gap-2 bg-card border border-border p-1.5 rounded-lg shadow-2xs">
          <button id="prev-page-btn" type="button" aria-label="Página anterior" title="Página anterior" {{#unless hasPrevPage}}disabled{{/unless}} class="w-9 h-9 flex items-center justify-center rounded-md hover:bg-secondary text-foreground disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
            <span class="material-symbols-outlined text-xl" aria-hidden="true">chevron_left</span>
          </button>

          <span id="current-page-display" class="px-4 text-xs font-mono font-semibold text-foreground">Página {{currentPage}} de {{totalPages}}</span>

          <button id="next-page-btn" type="button" aria-label="Página siguiente" title="Página siguiente" {{#if (eq currentPage totalPages)}}disabled{{/if}} class="w-9 h-9 flex items-center justify-center rounded-md hover:bg-secondary text-foreground disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
            <span class="material-symbols-outlined text-xl" aria-hidden="true">chevron_right</span>
          </button>
        </nav>
      </div>

    </div>
  </section>
</div>

{{#if user}}
  <!-- Modal: Sugerir Nueva Especie Fitosanitaria (Colaboración Ciudadana / Científica) -->
  <div id="modal-catalog-suggestion" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="modal-suggest-plague-title">
    <div class="w-full max-w-lg rounded-2xl border border-border bg-card shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between border-b border-border px-6 py-4 bg-muted/30">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#e6f0e6] text-[#1b4332]">
            <span class="material-symbols-outlined text-lg">pest_control</span>
          </span>
          <div>
            <h3 id="modal-suggest-plague-title" class="text-sm font-headline font-extrabold text-foreground">
              Sugerir Incorporación de Plaga o Patógeno
            </h3>
            <p class="text-[11px] text-muted-foreground">Se enviará a la bandeja de validación del comité técnico INIFAP</p>
          </div>
        </div>
        <button type="button" data-close-suggestion-modal class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted cursor-pointer" aria-label="Cerrar modal">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <form action="/suggestions/plagues" method="POST" class="p-6 space-y-4 overflow-y-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="suggest-plague-name" class="block text-xs font-bold text-foreground mb-1">Nombre común <span class="text-red-600">*</span></label>
            <input type="text" id="suggest-plague-name" name="name" required minlength="3" maxlength="140" placeholder="Ej. Picudo del chile" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]" />
          </div>
          <div>
            <label for="suggest-plague-sci" class="block text-xs font-bold text-foreground mb-1">Nombre científico <span class="text-red-600">*</span></label>
            <input type="text" id="suggest-plague-sci" name="scientific_name" required minlength="3" maxlength="160" placeholder="Ej. Anthonomus eugenii" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs italic outline-none focus:border-[#1b4332]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label for="suggest-plague-cat" class="block text-xs font-bold text-foreground mb-1">Categoría</label>
            <select id="suggest-plague-cat" name="category" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]">
              <option value="Insectos">Insectos</option>
              <option value="Hongos">Hongos</option>
              <option value="Bacterias">Bacterias</option>
              <option value="Virus">Virus</option>
              <option value="Ácaros">Ácaros</option>
            </select>
          </div>
          <div>
            <label for="suggest-plague-risk" class="block text-xs font-bold text-foreground mb-1">Nivel de riesgo</label>
            <select id="suggest-plague-risk" name="risk_level" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]">
              <option value="Moderado">Moderado</option>
              <option value="Alto">Crítico / Alto</option>
              <option value="Bajo">Bajo</option>
            </select>
          </div>
          <div>
            <label for="suggest-plague-region" class="block text-xs font-bold text-foreground mb-1">Región observada</label>
            <input type="text" id="suggest-plague-region" name="region" maxlength="100" placeholder="Ej. Bajío, Sinaloa" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]" />
          </div>
        </div>

        <div>
          <label for="suggest-plague-symptoms" class="block text-xs font-bold text-foreground mb-1">Síntomas y daños observados <span class="text-red-600">*</span></label>
          <textarea id="suggest-plague-symptoms" name="symptoms" required minlength="10" maxlength="1000" rows="2" placeholder="Describe los síntomas en hoja, tallo o fruto..." class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]"></textarea>
        </div>

        <div>
          <label for="suggest-plague-desc" class="block text-xs font-bold text-foreground mb-1">Descripción técnica y cultivos afectados <span class="text-red-600">*</span></label>
          <textarea id="suggest-plague-desc" name="description" required minlength="10" maxlength="1200" rows="3" placeholder="Contexto agronómico, hospedantes principales y observaciones de campo..." class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]"></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-border">
          <button type="button" data-close-suggestion-modal class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-foreground hover:bg-muted cursor-pointer">Cancelar</button>
          <button type="submit" data-loading-text="Enviando propuesta..." class="rounded-xl bg-[#1b4332] px-5 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f] cursor-pointer">Enviar a validación INIFAP</button>
        </div>
      </form>
    </div>
  </div>
{{/if}}
