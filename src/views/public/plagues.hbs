<!-- Área Principal del Catálogo de Plagas (/plagas) -->
<main class="font-['Geist'] antialiased">
  <section aria-labelledby="catalogo-title" class="bg-background min-h-screen pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-12 py-8 md:py-12">
    
      <!-- Encabezado de la Sección -->
      <div class="grid gap-8 border-b border-border pb-8 md:grid-cols-[1.7fr_1fr] md:items-end">
        <div class="flex flex-col gap-3">
          <div class="text-mono-label text-emerald-800 font-semibold tracking-wider flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            SISTEMA NACIONAL DE VIGILANCIA FITOSANITARIA · BASE CIENTÍFICA
          </div>
          <h1 id="catalogo-title" class="text-3xl sm:text-4xl md:text-5xl font-headline font-extrabold leading-[1.05] tracking-tight text-foreground">
            Catálogo de Plagas
          </h1>
          <p class="max-w-xl text-xs sm:text-sm leading-relaxed text-muted-foreground">
            Enciclopedia especializada de agentes biológicos de importancia agrícola. Información técnica validada para el monitoreo fitosanitario y el manejo integrado de plagas (MIP).
          </p>
        </div>

        <!-- Muestra de Métricas Institucionales -->
        <dl class="grid grid-cols-2 divide-x divide-border border border-border rounded-xl bg-card shadow-xs overflow-hidden">
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-2xl sm:text-3xl font-medium tabular-nums text-[#1b4332] counter-stat" data-target="{{totalCount}}" id="total-count-number-header">{{totalCount}}</dd>
            <dt class="text-mono-label text-muted-foreground font-medium text-[10px]">Especies registradas</dt>
          </div>
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-2xl sm:text-3xl font-medium tabular-nums text-[#1b4332]">100%</dd>
            <dt class="text-mono-label text-muted-foreground font-medium text-[10px]">Validación INIFAP</dt>
          </div>
        </dl>
      </div>

      <!-- BARRA PEGAJOSA DE BUSCADOR Y FILTROS CON CHIPS TÁCTILES (sticky top-0 md:top-16) -->
      <div class="sticky top-0 md:top-16 z-30 -mx-4 sm:-mx-6 md:-mx-12 mb-8 border-b border-border bg-background/95 px-4 sm:px-6 md:px-12 py-3.5 backdrop-blur-md shadow-2xs">
        <form action="/plagues" method="GET" id="form-filtros">
          <!-- Fila Principal: Buscador y Selector de Región -->
          <div class="flex flex-col sm:flex-row gap-2.5 w-full">
            <!-- Campo de Búsqueda -->
            <div class="relative flex-1">
              <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-lg select-none">search</span>
              <input
                id="search-input"
                name="search"
                type="search"
                value="{{filters.search}}"
                placeholder="Buscar por plaga, nombre científico, hospedante o síntoma…"
                class="h-10 w-full border border-input bg-card pl-10 pr-9 text-xs sm:text-sm rounded-md outline-none transition-all placeholder:text-muted-foreground focus-visible:border-[#1b4332] focus-visible:ring-2 focus-visible:ring-[#1b4332]/20"
                autocomplete="off"
              />
              <button
                type="button"
                id="search-clear-btn"
                class="{{#unless filters.search}}hidden{{/unless}} absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center rounded-full text-muted-foreground hover:text-foreground hover:bg-secondary cursor-pointer transition-all active:scale-90"
                title="Limpiar búsqueda"
                aria-label="Limpiar búsqueda"
              >
                <span class="material-symbols-outlined text-sm">close</span>
              </button>
            </div>

            <!-- Selector de Cultivo Hospedero -->
            <div class="relative sm:w-52 shrink-0">
              <select id="crop-filter" name="crop" aria-label="Filtrar por cultivo hospedero" class="h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-xs sm:text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                <option value="Cultivo">Cultivo · Todos</option>
                {{#each crops}}
                  <option value="{{this}}" {{#if (eq ../filters.crop this)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
            </div>

            <!-- Selector de Región -->
            <div class="relative sm:w-52 shrink-0">
              <select id="region-filter" name="region" aria-label="Filtrar por región" class="h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-xs sm:text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                <option value="Región">Región · Todas</option>
                {{#each regions}}
                  <option value="{{this}}" {{#if (eq ../filters.region this)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
            </div>

            <!-- Selects nativos sincronizados (ocultos visualmente para compatibilidad) -->
            <select id="category-filter" name="category" class="hidden">
              <option value="Categoría">Categoría · Todas</option>
              <option value="Insectos" {{#if (eq filters.category 'Insectos')}}selected{{/if}}>Insectos</option>
              <option value="Hongos" {{#if (eq filters.category 'Hongos')}}selected{{/if}}>Hongos</option>
              <option value="Bacterias" {{#if (eq filters.category 'Bacterias')}}selected{{/if}}>Bacterias</option>
              <option value="Virus" {{#if (eq filters.category 'Virus')}}selected{{/if}}>Virus</option>
              <option value="Ácaros" {{#if (eq filters.category 'Ácaros')}}selected{{/if}}>Ácaros</option>
            </select>

            <select id="risk-filter" name="risk" class="hidden">
              <option value="Riesgo">Riesgo · Todos</option>
              <option value="Crítico" {{#if (eq filters.risk 'Crítico')}}selected{{/if}}>Crítico</option>
              <option value="Moderado" {{#if (eq filters.risk 'Moderado')}}selected{{/if}}>Moderado</option>
              <option value="Bajo" {{#if (eq filters.risk 'Bajo')}}selected{{/if}}>Bajo</option>
            </select>

            <button id="filter-btn" type="button" class="hidden">Filtrar</button>
          </div>

          <!-- Filtros Rápidos Táctiles (Chips con Touch-Scroll Móvil) -->
          <div class="space-y-2 pt-2.5 border-t border-border/60 mt-3">
            <!-- Fila Categoría -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" role="tablist" aria-label="Filtrar por categoría">
              <span class="text-mono-label text-muted-foreground font-bold shrink-0 mr-1 text-[10px]">CATEGORÍA:</span>
              <button
                type="button"
                class="category-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#unless filters.category}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/unless}}"
                data-category=""
              >
                Todas
              </button>
              <button
                type="button"
                class="category-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Insectos')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-category="Insectos"
              >
                Insectos
              </button>
              <button
                type="button"
                class="category-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Hongos')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-category="Hongos"
              >
                Hongos
              </button>
              <button
                type="button"
                class="category-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Bacterias')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-category="Bacterias"
              >
                Bacterias
              </button>
              <button
                type="button"
                class="category-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Virus')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-category="Virus"
              >
                Virus
              </button>
              <button
                type="button"
                class="category-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if (eq filters.category 'Ácaros')}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-category="Ácaros"
              >
                Ácaros
              </button>
            </div>

            <!-- Fila Nivel de Riesgo Fitosanitario -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" role="tablist" aria-label="Filtrar por nivel de riesgo">
              <span class="text-mono-label text-muted-foreground font-bold shrink-0 mr-1 text-[10px]">RIESGO:</span>
              <button
                type="button"
                class="risk-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#unless filters.risk}}bg-[#1b4332] text-white shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/unless}}"
                data-risk=""
              >
                Todos
              </button>
              <button
                type="button"
                class="risk-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 flex items-center gap-1.5 {{#if (eq filters.risk 'Crítico')}}bg-rose-100 text-rose-900 border border-rose-300 font-bold shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-risk="Crítico"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span>
                Crítico
              </button>
              <button
                type="button"
                class="risk-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 flex items-center gap-1.5 {{#if (eq filters.risk 'Moderado')}}bg-amber-100 text-amber-900 border border-amber-300 font-bold shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-risk="Moderado"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                Moderado
              </button>
              <button
                type="button"
                class="risk-chip px-2.5 py-1 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 flex items-center gap-1.5 {{#if (eq filters.risk 'Bajo')}}bg-emerald-100 text-emerald-900 border border-emerald-300 font-bold shadow-2xs{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
                data-risk="Bajo"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                Bajo
              </button>
            </div>
          </div>

          <!-- Barra de Estado de Filtros -->
          <div class="mt-3 flex items-center justify-between gap-4 text-xs">
            <p class="text-mono-label flex items-center gap-2 text-muted-foreground font-medium">
              <span id="total-count-number" class="font-mono font-bold text-foreground tabular-nums">{{totalCount}}</span> especies encontradas
            </p>
            <a href="/plagues" id="reset-all-filters-link" class="inline-flex items-center gap-1 text-xs font-semibold text-[#1b4332] hover:underline cursor-pointer">
              ✕ Limpiar filtros
            </a>
          </div>
        </form>
      </div>

      <!-- REJILLA DE TARJETAS DE PLAGA (PESTCARD) -->
      <div id="plagues-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {{#unless plagues.length}}
          <div id="plagues-empty-state" class="col-span-full py-16 px-4 text-center bg-card border border-border rounded-xl shadow-xs space-y-4">
            <div class="w-16 h-16 rounded-full bg-secondary flex items-center justify-center mx-auto text-muted-foreground border border-border">
              <span class="material-symbols-outlined text-3xl">pest_control</span>
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-headline font-bold text-foreground">No se encontraron plagas</h3>
              <p class="text-xs text-muted-foreground max-w-md mx-auto leading-relaxed">
                No hay registros que coincidan con los criterios seleccionados. Intenta modificar el término de búsqueda o restablecer los filtros aplicados.
              </p>
            </div>
            <a href="/plagues" class="inline-block px-4 py-2 bg-[#1b4332] text-white text-xs font-semibold rounded-md hover:bg-[#133426] transition-all cursor-pointer shadow-2xs active:scale-95">
              Restablecer todos los filtros
            </a>
          </div>
        {{/unless}}

        {{#each plagues}}
          <article class="group flex flex-col border border-border bg-card transition-all duration-200 hover:border-[#1b4332]/40 rounded-xl overflow-hidden shadow-2xs hover:shadow-md hover:-translate-y-0.5">
          
            <!-- 1. Barra de Nivel de Riesgo Superior -->
            <div class="h-1.5 w-full {{#if (eq this.riskLabel 'Crítico')}}bg-rose-600{{else if (eq this.riskLabel 'Moderado')}}bg-amber-500{{else}}bg-emerald-600{{/if}}"></div>

            <!-- 2. Marco de Imagen a Color Natural -->
            <div class="relative aspect-4/3 overflow-hidden bg-muted">
              <img
                src="{{#if this.imageUrl}}{{this.imageUrl}}{{else}}{{this.image_url}}{{/if}}"
                alt="{{this.name}}"
                onerror="this.onerror=null; this.src='/images/test/default.png';"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>
            
              <!-- Badge de Riesgo (Top-Left) -->
              <div class="absolute left-3 top-3 flex items-center gap-1.5 bg-card/90 px-2.5 py-1 backdrop-blur rounded-md border border-border shadow-2xs">
                <span aria-hidden="true" class="inline-block size-1.5 rounded-full {{#if (eq this.riskLabel 'Crítico')}}bg-rose-600 animate-pulse{{else if (eq this.riskLabel 'Moderado')}}bg-amber-500{{else}}bg-emerald-600{{/if}}"></span>
                <span class="text-mono-label text-foreground capitalize font-bold text-[10px]">{{this.riskLabel}}</span>
              </div>

              <!-- Crédito de Imagen Minimalista (Bottom-Left) -->
              <span class="absolute left-3 bottom-3 text-mono-label text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
                {{#if this.imageCredit}}{{this.imageCredit}}{{else}}ACERVO FOTO · INIFAP{{/if}}
              </span>
            </div>

            <!-- 3. Contenido de la Tarjeta -->
            <div class="flex flex-1 flex-col gap-3 p-5">
            
              <!-- Taxonomía / Categoría -->
              <p class="text-mono-label text-muted-foreground font-semibold text-[10px]">
                {{this.category}} — VIGILANCIA SANITARIA
              </p>

              <!-- Nombre Común H3 + Nombre Científico -->
              <div class="flex flex-col gap-1">
                <h3 class="text-base sm:text-lg font-headline font-bold leading-tight tracking-tight text-foreground group-hover:text-[#1b4332] transition-colors">
                  {{this.name}}
                </h3>
                <p class="font-mono text-xs italic text-muted-foreground">{{this.scientificName}}</p>
              </div>

              <!-- Descripción corta -->
              <p class="line-clamp-3 text-xs sm:text-sm leading-relaxed text-muted-foreground">
                {{this.description}}
              </p>

              {{#if this.hostCrops.length}}
                <div class="flex flex-wrap items-center gap-1 pt-0.5">
                  {{#each this.hostCrops}}
                    <span class="inline-flex items-center gap-1 rounded-md border border-emerald-200/80 bg-emerald-50/70 px-2 py-0.5 text-[10px] font-semibold text-[#1b4332]">
                      {{this}}
                    </span>
                  {{/each}}
                  {{#if this.extraHostCropsCount}}
                    <span class="rounded-md bg-secondary px-1.5 py-0.5 text-[10px] font-mono font-semibold text-muted-foreground">
                      +{{this.extraHostCropsCount}}
                    </span>
                  {{/if}}
                </div>
              {{/if}}

              <!-- Pie de Tarjeta: Estatus + Enlace a Ficha Técnica -->
              <div class="mt-auto flex items-center justify-between gap-4 border-t border-border pt-4">
                <div class="flex flex-col gap-0.5">
                  <span class="text-mono-label text-muted-foreground text-[9px]">Estatus fitosanitario</span>
                  <span class="text-xs font-semibold text-emerald-800">Verificado INIFAP</span>
                </div>
                <a href="/plagues/{{this.id}}" class="inline-flex shrink-0 items-center gap-1 text-xs font-bold text-[#1b4332] hover:underline active:scale-95 transition-transform">
                  <span>Ficha técnica</span>
                  <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>

            </div>
          </article>
        {{/each}}

        {{#if plagues.length}}
          <!-- Card CTA fija al final para solicitar registro de nueva especie -->
          <article id="cta-new-species" class="group flex flex-col items-center justify-center p-8 border-2 border-dashed border-border hover:border-[#1b4332]/40 rounded-xl bg-card/60 hover:bg-card transition-all text-center">
            <span class="material-symbols-outlined text-4xl text-[#1b4332]/60 mb-3">add_circle</span>
            <h3 class="text-base font-headline font-bold text-foreground mb-1">¿Nueva especie?</h3>
            <p class="text-xs text-muted-foreground leading-relaxed max-w-50">
              Colabora con nuestra red científica reportando nuevas plagas a nuestro personal técnico.
            </p>
          </article>
        {{/if}}
      </div>

      <!-- Paginación Dinámica -->
      <div class="mt-12 flex justify-center" id="pagination-container" {{#if (eq totalPages 1)}}style="display:none;"{{/if}}>
        <nav class="flex items-center gap-2 bg-card border border-border p-1.5 rounded-lg shadow-2xs">
          <button id="prev-page-btn" {{#unless hasPrevPage}}disabled{{/unless}} class="w-9 h-9 flex items-center justify-center rounded-md hover:bg-secondary text-foreground disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
            <span class="material-symbols-outlined text-xl">chevron_left</span>
          </button>

          <span id="current-page-display" class="px-4 text-xs font-mono font-semibold text-foreground">Página {{currentPage}} de {{totalPages}}</span>

          <button id="next-page-btn" {{#if (eq currentPage totalPages)}}disabled{{/if}} class="w-9 h-9 flex items-center justify-center rounded-md hover:bg-secondary text-foreground disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors">
            <span class="material-symbols-outlined text-xl">chevron_right</span>
          </button>
        </nav>
      </div>

    </div>
  </section>
</main>
