<main class="pt-32 pb-24">
    <!-- Breadcrumbs & Header -->
    <div class="max-w-[1440px] mx-auto px-10 mb-8">
        <nav aria-label="Breadcrumb" class="flex mb-4">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-xs font-medium tracking-widest uppercase text-on-surface-variant">
                <li class="inline-flex items-center">
                    <a class="hover:text-primary transition-colors" href="/">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
                        <a class="hover:text-primary transition-colors" href="/crops">Cultivos</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
                        <span class="text-primary font-bold">{{crop.name}}</span>
                    </div>
                </li>
            </ol>
        </nav>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
                <span class="inline-block px-3 py-1 mb-3 rounded-full bg-primary-container text-on-primary-container font-label text-xs font-bold tracking-wider uppercase">Ficha Taxonómica</span>
                <h1 class="text-5xl md:text-6xl font-headline font-extrabold text-on-surface tracking-tighter mb-2">{{crop.name}}</h1>
                {{#if crop.scientific_name}}
                <p class="text-xl text-on-surface-variant font-medium">Nombre científico: <span class="italic text-primary font-bold">{{crop.scientific_name}}</span></p>
                {{/if}}
            </div>
            <div>
                <a href="/crops" class="inline-flex items-center gap-2 px-6 py-4 bg-primary text-on-primary font-bold text-sm rounded-xl hover:bg-primary-dim transition-all shadow-md">
                    <span class="material-symbols-outlined text-xl">arrow_back</span>
                    Volver al catálogo
                </a>
            </div>
        </div>
    </div>

    <!-- Image Hero -->
    <div class="max-w-[1440px] mx-auto px-10 mb-16">
        <div class="rounded-2xl overflow-hidden bg-surface-container-low ghost-border aspect-[21/9] flex items-center justify-center">
            {{#if primaryImage}}
            <img id="main-public-crop-image" alt="{{crop.name}}" class="w-full h-full object-cover" src="/{{primaryImage}}" onerror="this.onerror=null; this.src='/images/test/default.png';" />
            {{else}}
            <img id="main-public-crop-image" alt="Sin imagen" class="w-full h-full object-cover" src="/images/test/default.png" />
            {{/if}}
        </div>

        {{#if carouselImages.length}}
        <div class="flex gap-3 overflow-x-auto no-scrollbar py-4">
            {{#each carouselImages}}
            <button onclick="document.getElementById('main-public-crop-image').src='/\{{image_url}}'" class="w-24 h-16 rounded-xl overflow-hidden border-2 border-transparent hover:border-primary opacity-80 hover:opacity-100 transition-all">
                <img class="w-full h-full object-cover" src="/{{image_url}}" alt="Galería cultivo" />
            </button>
            {{/each}}
        </div>
        {{/if}}
    </div>

    <!-- Description & Technical Data -->
    <div class="max-w-[1440px] mx-auto px-10 grid grid-cols-1 lg:grid-cols-3 gap-12 mb-20">
        <div class="lg:col-span-2 space-y-8">
            <div class="bg-surface-container-lowest p-8 rounded-2xl ghost-border">
                <h2 class="text-2xl font-headline font-extrabold text-on-surface mb-4">Descripción General</h2>
                <p class="text-on-surface-variant text-base leading-relaxed">
                    {{#if crop.description}}{{crop.description}}{{else}}Este cultivo está registrado en la base de datos de INIFAP con especificaciones técnicas para la producción agrícola nacional.{{/if}}
                </p>
            </div>

            {{#if crop.observations}}
            <div class="bg-surface-container-lowest p-8 rounded-2xl ghost-border">
                <h2 class="text-2xl font-headline font-extrabold text-on-surface mb-4">Observaciones Agronómicas</h2>
                <p class="text-on-surface-variant text-base leading-relaxed">{{crop.observations}}</p>
            </div>
            {{/if}}
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
            <div class="bg-surface-container-lowest p-6 rounded-2xl ghost-border space-y-4">
                <h3 class="text-lg font-headline font-bold text-on-surface border-b border-surface-container pb-3">Requerimientos Cultivo</h3>

                <div class="flex justify-between items-center text-sm">
                    <span class="text-on-surface-variant">Categoría:</span>
                    <span class="font-bold text-on-surface uppercase text-xs bg-primary-container px-2.5 py-1 rounded-full text-on-primary-container">{{crop.category}}</span>
                </div>

                {{#if crop.family}}
                <div class="flex justify-between items-center text-sm">
                    <span class="text-on-surface-variant">Familia:</span>
                    <span class="font-bold text-on-surface">{{crop.family}}</span>
                </div>
                {{/if}}

                {{#if crop.variety}}
                <div class="flex justify-between items-center text-sm">
                    <span class="text-on-surface-variant">Variedad:</span>
                    <span class="font-bold text-on-surface">{{crop.variety}}</span>
                </div>
                {{/if}}

                {{#if crop.harvest_days}}
                <div class="flex justify-between items-center text-sm">
                    <span class="text-on-surface-variant">Cosecha estimada:</span>
                    <span class="font-bold text-on-surface">{{crop.harvest_days}} días</span>
                </div>
                {{/if}}

                {{#if crop.soil_type}}
                <div class="flex justify-between items-center text-sm">
                    <span class="text-on-surface-variant">Suelo recomendado:</span>
                    <span class="font-bold text-on-surface">{{crop.soil_type}}</span>
                </div>
                {{/if}}

                {{#if crop.ph_range}}
                <div class="flex justify-between items-center text-sm">
                    <span class="text-on-surface-variant">Rango de pH:</span>
                    <span class="font-bold text-on-surface">{{crop.ph_range}}</span>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</main>
