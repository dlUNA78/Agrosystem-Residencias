<main class="pt-32 pb-24">
    <!-- Header Section -->
    <header class="max-w-[1440px] mx-auto px-10 mb-16">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
            <div class="max-w-2xl">
                <span
                    class="inline-block px-3 py-1 mb-4 rounded-full bg-primary-container text-on-primary-container font-label text-xs font-bold tracking-wider uppercase">Catálogo
                    Científico</span>
                <h1 class="text-5xl md:text-6xl font-headline font-extrabold tracking-tighter text-on-surface mb-4">
                    Catálogo de Productos</h1>
                <p class="text-on-surface-variant text-lg font-medium leading-relaxed">
                    Explora nuestra biblioteca curada de soluciones agroquímicas validadas por INIFAP. Ciencia aplicada para la
                    protección de cultivos de alto rendimiento.
                </p>
            </div>
            <div
                class="bg-surface-container rounded-xl p-6 ghost-border flex flex-col items-center justify-center min-w-[200px]">
                <span class="text-4xl font-headline font-extrabold text-primary tracking-tighter">{{totalCount}}</span>
                <span
                    class="text-xs font-label uppercase tracking-widest text-on-surface-variant font-bold mt-1">productos
                    catalogados</span>
            </div>
        </div>
        <!-- Search & Filters -->
        <form action="/products" method="GET" class="mt-12 p-2 bg-surface-container-low rounded-2xl ghost-border">
            <div class="flex flex-col lg:flex-row gap-2">
                <div class="flex-1 relative flex items-center">
                    <span class="material-symbols-outlined absolute left-4 text-on-surface-variant">search</span>
                    <input
                        name="search"
                        value="{{search}}"
                        class="w-full bg-surface-container-lowest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-on-surface-variant/60 focus:ring-2 focus:ring-primary/20 transition-all font-body"
                        placeholder="Buscar por producto, principio activo o fabricante..." type="text" />
                </div>
                <div class="flex flex-wrap md:flex-nowrap gap-2">
                    <button
                        type="submit"
                        class="bg-primary text-on-primary px-8 py-4 rounded-xl font-bold text-sm hover:bg-primary-dim transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">filter_list</span>
                        Buscar Productos
                    </button>
                </div>
            </div>
        </form>
    </header>

    <!-- Catalog Grid -->
    <section class="max-w-[1440px] mx-auto px-10">
        {{#if products.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {{#each products}}
            <article
                class="group bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow ghost-border flex flex-col hover:translate-y-[-4px] transition-all duration-300">
                <a href="/products/{{id}}" class="relative h-56 overflow-hidden bg-emerald-50 block">
                    {{#if image_url}}
                    <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        alt="{{name}}"
                        src="{{image_url}}"
                        onerror="this.onerror=null; this.src='https://picsum.photos/seed/product/800/600';" />
                    {{else}}
                    <img class="w-full h-full object-cover" src="https://picsum.photos/seed/product/800/600" alt="Sin imagen" />
                    {{/if}}
                    <div class="absolute top-4 left-4">
                        <span class="px-2.5 py-1 rounded bg-primary-container text-on-primary-container text-[10px] font-bold uppercase tracking-wider">
                            {{#if category}}{{category}}{{else}}Fitosanitario{{/if}}
                        </span>
                    </div>
                </a>
                <div class="p-6 flex-1 flex flex-col">
                    <span
                        class="text-[10px] font-label font-bold uppercase tracking-widest text-primary mb-1">{{manufacturer}}</span>
                    <h3 class="text-xl font-headline font-bold text-on-surface mb-1 leading-tight">
                        <a href="/products/{{id}}" class="hover:text-primary transition-colors">
                            {{name}}
                        </a>
                    </h3>
                    {{#if active_ingredient}}
                    <p class="text-xs font-semibold text-on-surface-variant mb-3">{{active_ingredient}}</p>
                    {{/if}}
                    <p class="text-sm text-on-surface-variant line-clamp-2 leading-relaxed mb-6">
                        {{#if description}}{{description}}{{else}}Producto agroquímico registrado en el catálogo oficial.{{/if}}
                    </p>
                    <div class="mt-auto pt-4 border-t border-surface-container flex justify-between items-center">
                        <a href="/products/{{id}}" class="text-primary font-bold text-sm flex items-center gap-1 group/btn">
                            Ver detalle
                            <span
                                class="material-symbols-outlined text-sm group-hover/btn:translate-x-1 transition-transform">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </article>
            {{/each}}
        </div>
        {{else}}
        <div class="text-center py-20 bg-surface-container-lowest rounded-2xl ghost-border p-8">
            <span class="material-symbols-outlined text-6xl text-on-surface-variant/40 mb-4">science</span>
            <h3 class="text-xl font-bold text-on-surface mb-2">No se encontraron productos</h3>
            <p class="text-sm text-on-surface-variant max-w-md mx-auto mb-6">No hay registros que coincidan con la búsqueda.</p>
            <a href="/products" class="px-6 py-3 bg-primary text-on-primary font-bold text-xs rounded-xl hover:bg-primary-dim transition-colors inline-block">Ver todos los productos</a>
        </div>
        {{/if}}
    </section>
</main>