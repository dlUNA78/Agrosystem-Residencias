{{!-- ══════════════════════════════════════════
     HOME — Página principal pública
     ══════════════════════════════════════════ --}}
<main>

  {{!-- ─────────────────────────────────────────────
       HERO SECTION — Imagen full‑screen con overlay
       ───────────────────────────────────────────── --}}
  <section class="relative w-full h-screen min-h-150 flex flex-col justify-end overflow-hidden">

    {{!-- Imagen de fondo --}}
    <img
      src="/images/hero-tractor.jpg"
      alt="Vista aérea de campos de cultivo con tractor"
      class="absolute inset-0 w-full h-full object-cover object-center"
      fetchpriority="high"
    />

    {{!-- Overlay degradado: transparente arriba, oscuro abajo --}}
    <div class="absolute inset-0"
         style="background: linear-gradient(
           to bottom,
           rgba(0,0,0,0.10)  0%,
           rgba(0,0,0,0.15) 35%,
           rgba(0,0,0,0.55) 65%,
           rgba(0,0,0,0.82) 100%
         );"></div>

    {{!-- Contenido del hero --}}
    <div class="relative z-10 px-6 md:px-16 pb-16 md:pb-20 max-w-3xl">

      {{!-- Badge --}}
      <div class="inline-flex items-center gap-1.5 mb-6 px-3 py-1 rounded-full type-caption text-white"
           style="
             background: rgba(22,163,74,0.25);
             border: 1px solid rgba(74,222,128,0.35);
             backdrop-filter: blur(8px);
           ">
        <span class="w-1.5 h-1.5 rounded-full bg-inverse-primary animate-pulse shrink-0"></span>
        Protección y Sanidad Agrícola
      </div>

      {{!-- Título principal --}}
      <h1 class="font-['Plus_Jakarta_Sans'] text-white leading-[1.12] font-bold mb-5"
          style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
        Agricultura y<br>
        Sanidad del<br>
        Campo
      </h1>

      {{!-- Descripción --}}
      <p class="type-lead text-white/75 mb-8 max-w-lg leading-relaxed">
        El INIFAP genera soluciones tecnológicas y registros fitosanitarios para
        asegurar un campo productivo, rentable y sustentable a nivel nacional,
        apoyando a productores en cada etapa del cultivo.
      </p>

      {{!-- CTAs --}}
      <div class="flex flex-wrap gap-3">
        <a href="/forum"
           class="inline-flex items-center gap-2 type-medium px-6 py-3 rounded-full text-white font-semibold transition-all duration-200 active:scale-95"
           style="
             background: rgba(22,163,74,0.9);
             border: 1px solid rgba(74,222,128,0.35);
             box-shadow: 0 0 20px rgba(22,163,74,0.35), inset 0 1px 0 rgba(255,255,255,0.15);
           "
           onmouseover="this.style.background='rgba(21,128,61,1)'"
           onmouseout="this.style.background='rgba(22,163,74,0.9)'">
          Ir al Foro
        </a>

        <a href="/about"
           class="inline-flex items-center gap-2 type-medium px-6 py-3 rounded-full text-white transition-all duration-200 active:scale-95"
           style="
             background: rgba(255,255,255,0.12);
             border: 1px solid rgba(255,255,255,0.22);
             backdrop-filter: blur(10px);
           "
           onmouseover="this.style.background='rgba(255,255,255,0.20)'"
           onmouseout="this.style.background='rgba(255,255,255,0.12)'">
          Conocenos
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  {{!-- ══════════════════════════════════════════════════════════════
       BLOQUE 1 — "Conoce el Sistema": eyebrow + título + 3 feature cards
       ══════════════════════════════════════════════════════════════ --}}
  <section class="bg-surface py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-12">

      {{!-- Encabezado --}}
      <div class="text-center mb-14">
        <p class="type-caption text-primary uppercase tracking-widest font-semibold mb-3">
          Sistema de Información Agropecuaria
        </p>
        <h2 class="font-['Plus_Jakarta_Sans'] text-on-surface font-bold leading-tight mb-4"
            style="font-size: clamp(1.75rem, 3.5vw, 2.5rem);">
          Conoce el poder del<br>
          <span class="text-primary">Agrosystem INIFAP</span>
        </h2>
        <p class="type-lead text-on-surface-variant max-w-2xl mx-auto">
          Una plataforma diseñada para centralizar el conocimiento fitosanitario y agronómico
          de México, al alcance de productores, investigadores y técnicos.
        </p>
      </div>

      {{!-- 3 Feature Cards --}}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {{!-- Card 1 --}}
        <div class="bg-surface-container-lowest rounded-2xl p-8 border border-outline-variant/20
                    hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center
                      text-primary mb-6 group-hover:bg-primary group-hover:text-on-primary transition-all">
            <span class="material-symbols-outlined text-2xl">pest_control</span>
          </div>
          <h3 class="font-['Plus_Jakarta_Sans'] text-lg font-semibold text-on-surface mb-3">
            Catálogo de Plagas
          </h3>
          <p class="type-base text-on-surface-variant leading-relaxed">
            Más de 1,200 registros fitosanitarios con métodos de identificación,
            ciclos biológicos y tratamientos certificados por el SENASICA.
          </p>
          <a href="/plagues"
             class="inline-flex items-center gap-1 type-caption text-primary font-semibold mt-5
                    hover:gap-2 transition-all duration-200">
            Ver catálogo
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        {{!-- Card 2 --}}
        <div class="bg-surface-container-lowest rounded-2xl p-8 border border-outline-variant/20
                    hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center
                      text-primary mb-6 group-hover:bg-primary group-hover:text-on-primary transition-all">
            <span class="material-symbols-outlined text-2xl">potted_plant</span>
          </div>
          <h3 class="font-['Plus_Jakarta_Sans'] text-lg font-semibold text-on-surface mb-3">
            Fichas de Cultivos
          </h3>
          <p class="type-base text-on-surface-variant leading-relaxed">
            Más de 450 cultivos con guías técnicas segmentadas por zona climática,
            tipo de suelo y etapa fenológica del ciclo productivo.
          </p>
          <a href="/crops"
             class="inline-flex items-center gap-1 type-caption text-primary font-semibold mt-5
                    hover:gap-2 transition-all duration-200">
            Ver cultivos
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        {{!-- Card 3 --}}
        <div class="bg-surface-container-lowest rounded-2xl p-8 border border-outline-variant/20
                    hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center
                      text-primary mb-6 group-hover:bg-primary group-hover:text-on-primary transition-all">
            <span class="material-symbols-outlined text-2xl">inventory_2</span>
          </div>
          <h3 class="font-['Plus_Jakarta_Sans'] text-lg font-semibold text-on-surface mb-3">
            Productos Registrados
          </h3>
          <p class="type-base text-on-surface-variant leading-relaxed">
            Directorio de más de 800 insumos agrícolas con fichas de composición,
            dosis recomendadas y compatibilidad con cada cultivo.
          </p>
          <a href="/products"
             class="inline-flex items-center gap-1 type-caption text-primary font-semibold mt-5
                    hover:gap-2 transition-all duration-200">
            Ver productos
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  {{!-- ══════════════════════════════════════════════════════════════
       BLOQUE 2 — "Información al Alcance": split layout texto + imagen
       ══════════════════════════════════════════════════════════════ --}}
  <section class="bg-surface-container-low py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        {{!-- Columna izquierda: texto --}}
        <div class="space-y-6">
          <p class="type-caption text-primary uppercase tracking-widest font-semibold">
            Información Validada · INIFAP
          </p>
          <h2 class="font-['Plus_Jakarta_Sans'] text-on-surface font-bold leading-tight"
              style="font-size: clamp(1.75rem, 3.5vw, 2.5rem);">
            Información Agrícola<br>
            Hecha Fácil Con<br>
            <span class="text-primary">Agrosystem</span>
          </h2>
          <p class="type-lead text-on-surface-variant leading-relaxed max-w-lg">
            El INIFAP es la institución de investigación agropecuaria más grande de México.
            Agrosystem lleva ese conocimiento directamente a tu pantalla, estructurado
            y listo para tomar decisiones en campo.
          </p>

          {{!-- Bullets de beneficios --}}
          <ul class="space-y-3 pt-2">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-primary-container text-primary flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-sm" style="font-size:14px;">check</span>
              </span>
              <span class="type-base text-on-surface-variant">
                Datos validados por investigadores del INIFAP y SENASICA
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-primary-container text-primary flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-sm" style="font-size:14px;">check</span>
              </span>
              <span class="type-base text-on-surface-variant">
                Información segmentada por región y tipo de cultivo
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-primary-container text-primary flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-sm" style="font-size:14px;">check</span>
              </span>
              <span class="type-base text-on-surface-variant">
                Foro comunitario para resolver dudas con otros productores
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-primary-container text-primary flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-sm" style="font-size:14px;">check</span>
              </span>
              <span class="type-base text-on-surface-variant">
                Actualizaciones continuas basadas en temporadas agrícolas
              </span>
            </li>
          </ul>

          <a href="/auth/register"
             class="inline-flex items-center gap-2 type-medium px-6 py-3 rounded-xl
                    bg-primary text-on-primary hover:bg-primary-dim
                    transition-all duration-200 active:scale-95 mt-2">
            Comenzar gratis
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        {{!-- Columna derecha: imagen + badge de stat --}}
        <div class="relative">
          <div class="rounded-2xl overflow-hidden aspect-4/3 shadow-2xl">
            <img
              src="/images/hero-tractor.jpg"
              alt="Tractor trabajando en campo mexicano"
              class="w-full h-full object-cover object-center"
            />
          </div>

          {{!-- Badge de estadística flotante --}}
          <div class="absolute -bottom-5 -left-5 bg-surface rounded-2xl shadow-xl border border-outline-variant/20 px-5 py-4
                      flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-on-primary text-2xl">verified</span>
            </div>
            <div>
              <p class="font-['Plus_Jakarta_Sans'] text-2xl font-bold text-on-surface leading-none">+2,450</p>
              <p class="type-caption text-on-surface-variant mt-0.5">Registros fitosanitarios</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {{!-- ══════════════════════════════════════════════════════════════
       BLOQUE 3 — "Explora el Sistema": 3 tarjetas con imagen + título
       ══════════════════════════════════════════════════════════════ --}}
  <section class="bg-surface py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-12">

      {{!-- Encabezado --}}
      <div class="text-center mb-14">
        <p class="type-caption text-primary uppercase tracking-widest font-semibold mb-3">
          Módulos del Sistema
        </p>
        <h2 class="font-['Plus_Jakarta_Sans'] text-on-surface font-bold leading-tight"
            style="font-size: clamp(1.75rem, 3.5vw, 2.5rem);">
          Transforma tu Campo Con<br>
          el Conocimiento del INIFAP
        </h2>
      </div>

      {{!-- 3 Image Cards --}}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {{!-- Card imagen: Plagas --}}
        <a href="/plagues"
           class="group relative rounded-2xl overflow-hidden aspect-4/3 block cursor-pointer">
          <img
            src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=800&q=80"
            alt="Investigación de plagas agrícolas"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6">
            <p class="type-caption text-white/70 uppercase tracking-wider mb-1">Módulo</p>
            <h3 class="font-['Plus_Jakarta_Sans'] text-white text-xl font-bold">
              Sanidad Vegetal
            </h3>
            <p class="type-base text-white/75 mt-1">Plagas y Enfermedades</p>
          </div>
          <div class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/15 backdrop-blur-sm
                      flex items-center justify-center text-white opacity-0 group-hover:opacity-100
                      transition-all duration-300 translate-x-2 group-hover:translate-x-0">
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </div>
        </a>

        {{!-- Card imagen: Cultivos --}}
        <a href="/crops"
           class="group relative rounded-2xl overflow-hidden aspect-4/3 block cursor-pointer">
          <img
            src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?auto=format&fit=crop&w=800&q=80"
            alt="Cultivos en México"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6">
            <p class="type-caption text-white/70 uppercase tracking-wider mb-1">Módulo</p>
            <h3 class="font-['Plus_Jakarta_Sans'] text-white text-xl font-bold">
              Optimización Agrícola
            </h3>
            <p class="type-base text-white/75 mt-1">Guías técnicas de cultivo</p>
          </div>
          <div class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/15 backdrop-blur-sm
                      flex items-center justify-center text-white opacity-0 group-hover:opacity-100
                      transition-all duration-300 translate-x-2 group-hover:translate-x-0">
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </div>
        </a>

        {{!-- Card imagen: Foro --}}
        <a href="/forum"
           class="group relative rounded-2xl overflow-hidden aspect-4/3 block cursor-pointer">
          <img
            src="https://images.unsplash.com/photo-1574943320219-553eb213f72d?auto=format&fit=crop&w=800&q=80"
            alt="Productores agrícolas colaborando"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6">
            <p class="type-caption text-white/70 uppercase tracking-wider mb-1">Módulo</p>
            <h3 class="font-['Plus_Jakarta_Sans'] text-white text-xl font-bold">
              Foro del Campo
            </h3>
            <p class="type-base text-white/75 mt-1">Comunidad de productores</p>
          </div>
          <div class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/15 backdrop-blur-sm
                      flex items-center justify-center text-white opacity-0 group-hover:opacity-100
                      transition-all duration-300 translate-x-2 group-hover:translate-x-0">
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </div>
        </a>

      </div>
    </div>
  </section>

</main>