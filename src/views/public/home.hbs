<main class="">
  <!-- Hero Section (Full Screen Editorial Style) -->
  <section class="relative min-h-screen flex items-center justify-center">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img alt="Vista de campos agrícolas" class="w-full h-full object-cover"
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuDvdCkY68Hne7ag8w5eIgNDx1ZVVAsIVGdYus5VN75UuM70f-dRSS_dRG4-y1xvb5gzbpy7WAL8BeANXjm404YMtivm1-kF-xOWFo5tpLYHNyjMW9sk__nyTDpEN6YvX2ZqkOQ9xA8vctoLMYA1BlLp8Id_SSbaJrSdlkaT9lXnQ8LJQsOqjrNEibxgqfPWIa_11yumizIN2Io_AMzYzeUtfZzASv-WQlCgD9e0S1a-Aze_BUPzYvvQSxo5AbgDnFzL69hlYi1J16Jo">
      <div class="absolute inset-0 bg-black/60 mix-blend-multiply"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-10 w-full flex flex-col pt-32">
      <div class="max-w-4xl">
        <div
          class="inline-flex items-center px-4 py-1.5 border border-white/20 text-white text-xs font-bold tracking-[0.2em] uppercase mb-8 backdrop-blur-sm">
          Plataforma Oficial INIFAP
        </div>
        <h1 class="text-6xl md:text-8xl lg:text-9xl font-headline font-bold tracking-tighter text-white leading-[0.9] uppercase mb-8">
          Información<br/>Agrícola<br/><span class="text-[#43655c]">Verificada</span>
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl leading-relaxed font-body mb-12 font-light">
          Acceda a la base de datos más completa y precisa sobre sanidad vegetal, optimización de cultivos y productos especializados para el campo mexicano.
        </p>
        <div class="flex flex-wrap gap-6">
          <button
            class="px-10 py-5 bg-[#43655c] text-white font-headline font-bold uppercase tracking-widest text-sm hover:bg-[#2d443e] transition-all active:scale-95 flex items-center gap-3">
            Explorar Plataforma <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
          <button
            class="px-10 py-5 bg-white text-black font-headline font-bold uppercase tracking-widest text-sm hover:bg-gray-200 transition-all active:scale-95">
            Guía de Uso
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Statistics Row (High Contrast Minimalist) -->
  <section class="bg-black py-20 border-b border-white/10">
    <div class="max-w-[1440px] mx-auto px-6 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 divide-y md:divide-y-0 md:divide-x divide-white/20">
        <!-- Stat 1 -->
        <div class="p-8 md:p-12 flex flex-col justify-center">
          <div class="text-[#43655c] mb-4">
            <span class="material-symbols-outlined text-4xl">pest_control</span>
          </div>
          <div class="text-5xl md:text-6xl font-headline font-bold text-white mb-2">1.2k</div>
          <div class="text-xs font-body font-bold uppercase tracking-[0.2em] text-white/50">
            Plagas Registradas</div>
        </div>
        <!-- Stat 2 -->
        <div class="p-8 md:p-12 flex flex-col justify-center">
          <div class="text-[#43655c] mb-4">
            <span class="material-symbols-outlined text-4xl">potted_plant</span>
          </div>
          <div class="text-5xl md:text-6xl font-headline font-bold text-white mb-2">450</div>
          <div class="text-xs font-body font-bold uppercase tracking-[0.2em] text-white/50">
            Cultivos Optimizados</div>
        </div>
        <!-- Stat 3 -->
        <div class="p-8 md:p-12 flex flex-col justify-center">
          <div class="text-[#43655c] mb-4">
            <span class="material-symbols-outlined text-4xl">inventory_2</span>
          </div>
          <div class="text-5xl md:text-6xl font-headline font-bold text-white mb-2">800</div>
          <div class="text-xs font-body font-bold uppercase tracking-[0.2em] text-white/50">
            Productos Especializados</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search Section -->
  <section class="bg-white px-6 md:px-10 py-32">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl md:text-6xl font-headline font-bold mb-16 text-black tracking-tighter uppercase">
        ¿Qué información necesitas hoy?
      </h2>
      <div class="relative group">
        <span class="material-symbols-outlined absolute left-8 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-black transition-colors text-3xl">search</span>
        <input
          class="w-full pl-20 pr-8 py-8 bg-gray-50 border border-gray-200 rounded-none focus:ring-0 focus:border-black transition-all text-xl font-body placeholder:text-gray-400 outline-none"
          placeholder="Buscar plagas, cultivos, productos..." type="text">
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <span class="text-xs text-gray-500 font-bold uppercase tracking-[0.1em] self-center">Tendencias:</span>
        <span class="border border-gray-200 px-5 py-2 text-xs font-bold uppercase tracking-widest text-black cursor-pointer hover:bg-black hover:text-white transition-colors">Riego por goteo</span>
        <span class="border border-gray-200 px-5 py-2 text-xs font-bold uppercase tracking-widest text-black cursor-pointer hover:bg-black hover:text-white transition-colors">Control de roya</span>
        <span class="border border-gray-200 px-5 py-2 text-xs font-bold uppercase tracking-widest text-black cursor-pointer hover:bg-black hover:text-white transition-colors">Fertilizantes orgánicos</span>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="bg-[#f9f9f9] px-6 md:px-10 py-32 border-t border-gray-200">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Category 1 -->
        <div class="group bg-white p-10 transition-all duration-300 hover:shadow-2xl border border-gray-100 hover:border-black cursor-pointer">
          <div class="mb-8 text-[#43655c] group-hover:text-black transition-all">
            <span class="material-symbols-outlined text-5xl">bug_report</span>
          </div>
          <h3 class="text-2xl font-headline font-bold mb-4 uppercase tracking-tight text-black">Plagas</h3>
          <p class="text-sm text-gray-500 leading-relaxed font-body">Identificación precoz y métodos de control biológico y químico certificados.</p>
        </div>
        <!-- Category 2 -->
        <div class="group bg-white p-10 transition-all duration-300 hover:shadow-2xl border border-gray-100 hover:border-black cursor-pointer">
          <div class="mb-8 text-[#43655c] group-hover:text-black transition-all">
            <span class="material-symbols-outlined text-5xl">agriculture</span>
          </div>
          <h3 class="text-2xl font-headline font-bold mb-4 uppercase tracking-tight text-black">Cultivos</h3>
          <p class="text-sm text-gray-500 leading-relaxed font-body">Fichas técnicas de optimización por zonas climáticas y tipos de suelo.</p>
        </div>
        <!-- Category 3 -->
        <div class="group bg-white p-10 transition-all duration-300 hover:shadow-2xl border border-gray-100 hover:border-black cursor-pointer">
          <div class="mb-8 text-[#43655c] group-hover:text-black transition-all">
            <span class="material-symbols-outlined text-5xl">shopping_basket</span>
          </div>
          <h3 class="text-2xl font-headline font-bold mb-4 uppercase tracking-tight text-black">Productos</h3>
          <p class="text-sm text-gray-500 leading-relaxed font-body">Catálogo de insumos, herramientas y tecnología agrícola de vanguardia.</p>
        </div>
        <!-- Category 4 -->
        <div class="group bg-white p-10 transition-all duration-300 hover:shadow-2xl border border-gray-100 hover:border-black cursor-pointer">
          <div class="mb-8 text-[#43655c] group-hover:text-black transition-all">
            <span class="material-symbols-outlined text-5xl">forum</span>
          </div>
          <h3 class="text-2xl font-headline font-bold mb-4 uppercase tracking-tight text-black">Foro</h3>
          <p class="text-sm text-gray-500 leading-relaxed font-body">Comunidad colaborativa para compartir experiencias y resolver dudas reales.</p>
        </div>
      </div>
    </div>
  </section>
</main>