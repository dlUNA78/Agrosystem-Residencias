<div class="space-y-16 pb-20 font-sans">

  <!-- ── SECCIÓN 1: HERO & BUSCADOR ────────────────────────────────────────── -->
  <section class="pt-10 pb-12 px-6 md:px-12 max-w-7xl mx-auto border-b border-border/60">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Lado Izquierdo: Títulos, Buscador y Tendencias -->
      <div class="lg:col-span-8 space-y-6">
        <div class="text-mono-label text-emerald-800 font-semibold tracking-wider flex items-center gap-2 animate-hero-badge">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          SISTEMA NACIONAL DE VIGILANCIA FITOSANITARIA · CONSULTA PÚBLICA
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-headline font-extrabold text-foreground tracking-tight leading-[1.1] animate-hero-title">
          Consulta la sanidad vegetal de México, <span class="text-[#1b4332]">cultivo por cultivo.</span>
        </h1>

        <p class="text-base md:text-lg text-muted-foreground max-w-2xl leading-relaxed animate-hero-desc">
          Base de datos técnica de plagas, paquetes tecnológicos e insumos autorizados. Cada ficha se valida contra la investigación de los campos experimentales del INIFAP.
        </p>

        <!-- Selector de Alcance de Búsqueda (Tabs / Segmented Control) -->
        <div class="pt-2 animate-hero-tabs">
          <div class="flex flex-wrap items-center gap-1.5 p-1 bg-secondary/80 border border-border rounded-lg w-fit text-xs font-medium" role="tablist" aria-label="Ámbito de búsqueda">
            <button
              type="button"
              class="search-scope-btn px-3.5 py-1.5 rounded-md transition-all font-semibold bg-card text-[#1b4332] shadow-2xs flex items-center gap-1.5 cursor-pointer active:scale-95"
              data-scope="plagues"
              data-action="/plagues"
              data-icon="pest_control"
              data-placeholder="Nombre científico, plaga, cultivo o síntoma..."
              aria-selected="true"
            >
              <span class="material-symbols-outlined text-sm">pest_control</span>
              <span>Plagas</span>
            </button>
            <button
              type="button"
              class="search-scope-btn px-3.5 py-1.5 rounded-md transition-all font-medium text-muted-foreground hover:text-foreground flex items-center gap-1.5 cursor-pointer active:scale-95"
              data-scope="crops"
              data-action="/crops"
              data-icon="psychiatry"
              data-placeholder="Nombre común, científico, variedad o familia botánica..."
              aria-selected="false"
            >
              <span class="material-symbols-outlined text-sm">psychiatry</span>
              <span>Cultivos</span>
            </button>
            <button
              type="button"
              class="search-scope-btn px-3.5 py-1.5 rounded-md transition-all font-medium text-muted-foreground hover:text-foreground flex items-center gap-1.5 cursor-pointer active:scale-95"
              data-scope="products"
              data-action="/products"
              data-icon="science"
              data-placeholder="Nombre comercial, ingrediente activo o formulación..."
              aria-selected="false"
            >
              <span class="material-symbols-outlined text-sm">science</span>
              <span>Insumos</span>
            </button>
            <button
              type="button"
              class="search-scope-btn px-3.5 py-1.5 rounded-md transition-all font-medium text-muted-foreground hover:text-foreground flex items-center gap-1.5 cursor-pointer active:scale-95"
              data-scope="lands"
              data-action="/lands"
              data-icon="travel_explore"
              data-placeholder="Estado, región agrícola o zona de cobertura..."
              aria-selected="false"
            >
              <span class="material-symbols-outlined text-sm">travel_explore</span>
              <span>Regiones</span>
            </button>
          </div>
        </div>

        <!-- Formulario de Búsqueda Dinámico -->
        <form action="/plagues" method="GET" id="hero-search-form" class="pt-1 animate-hero-search">
          <div class="flex flex-col sm:flex-row gap-2 max-w-2xl bg-card border border-border p-1.5 rounded-lg shadow-xs focus-within:ring-2 focus-within:ring-[#1b4332]/30 focus-within:border-[#1b4332] transition-all">
            <div class="relative flex-1 flex items-center">
              <span class="material-symbols-outlined text-muted-foreground pl-3 pr-2 text-xl select-none transition-transform duration-200" id="hero-search-icon">pest_control</span>
              <input
                id="hero-search-input"
                name="search"
                type="text"
                placeholder="Nombre científico, plaga, cultivo o síntoma..."
                class="w-full bg-transparent py-2.5 text-sm md:text-base text-foreground placeholder:text-muted-foreground outline-none pr-8"
                required
                autocomplete="off"
              />
              <!-- Botón Limpiar Texto (aparece al teclear) -->
              <button
                type="button"
                id="hero-search-clear"
                class="hidden absolute right-2 text-muted-foreground hover:text-foreground p-1 rounded-full hover:bg-secondary transition-all cursor-pointer"
                title="Limpiar búsqueda"
                aria-label="Limpiar campo de búsqueda"
              >
                <span class="material-symbols-outlined text-base">close</span>
              </button>
            </div>
            <button
              type="submit"
              class="px-6 py-2.5 bg-[#1b4332] hover:bg-[#133426] text-white font-headline font-semibold text-sm rounded-md transition-all flex items-center justify-center gap-2 shadow-2xs shrink-0 cursor-pointer active:scale-95"
            >
              <span class="material-symbols-outlined text-base">search</span>
              <span id="hero-search-btn-label">Buscar</span>
            </button>
          </div>
        </form>

        <!-- Consultas Frecuentes -->
        <div class="flex flex-wrap items-center gap-2 pt-1 animate-hero-tags">
          <span class="text-mono-label text-muted-foreground font-semibold">CONSULTAS FRECUENTES:</span>
          {{#each frequentSearches}}
            <button
              type="button"
              class="frequent-tag-btn px-3 py-1 bg-secondary text-secondary-foreground text-xs font-medium rounded-md hover:bg-emerald-100 hover:text-emerald-900 border border-border transition-all cursor-pointer hover:-translate-y-0.5 active:scale-95 shadow-2xs"
              data-query="{{this}}"
            >
              {{this}}
            </button>
          {{/each}}
        </div>
      </div>

      <!-- Lado Derecho: Imagen Referencial y Tarjeta de Métricas Institucionales -->
      <div class="lg:col-span-4 space-y-4 animate-hero-card">
        
        <!-- Imagen Referencial con Badge Institucional -->
        <div class="relative w-full h-36 md:h-40 rounded-lg overflow-hidden border border-border shadow-2xs group">
          <img
            src="/images/hero-reference.webp"
            alt="Investigación y Monitoreo Agrícola INIFAP"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-black/10"></div>
          <div class="absolute bottom-3 left-3 right-3 flex justify-between items-center text-white">
            <span class="text-[10px] font-mono font-bold tracking-wider uppercase bg-[#1b4332]/90 backdrop-blur-md px-2.5 py-1 rounded-md border border-white/20 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              INVESTIGACIÓN DE CAMPO
            </span>
            <span class="text-[10px] font-mono text-white/80 font-medium">INIFAP 2026</span>
          </div>
        </div>

        <!-- Tarjeta de Métricas Institucionales -->
        <div class="bg-card border border-border rounded-lg p-5 shadow-xs space-y-4">
          <div class="flex justify-between items-center pb-3 border-b border-border">
            <span class="text-xs md:text-sm font-medium text-muted-foreground">Registros verificados</span>
            <span class="font-mono text-2xl md:text-3xl font-medium tabular-nums text-[#1b4332] counter-stat" data-target="{{heroStats.verifiedRecords}}">{{heroStats.verifiedRecords}}</span>
          </div>
          
          <div class="flex justify-between items-center pb-3 border-b border-border">
            <span class="text-xs md:text-sm font-medium text-muted-foreground">Entidades con cobertura</span>
            <span class="font-mono text-2xl md:text-3xl font-medium tabular-nums text-[#1b4332] counter-stat" data-target="{{heroStats.coverageEntities}}">{{heroStats.coverageEntities}}</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-xs md:text-sm font-medium text-muted-foreground">Campos experimentales</span>
            <span class="font-mono text-2xl md:text-3xl font-medium tabular-nums text-[#1b4332] counter-stat" data-target="{{heroStats.experimentalFields}}">{{heroStats.experimentalFields}}</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ── SECCIÓN 2: PANORAMA NACIONAL (MAPA VECTORIAL DE MÉXICO Y RANKING) ──── -->
  <section id="panorama-nacional" class="scroll-mt-24 pt-4 px-6 md:px-12 max-w-7xl mx-auto border-b border-border/60 pb-16">
    
    <!-- Encabezado del Panorama Nacional -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6 reveal-on-scroll">
      <div>
        <div class="text-mono-label text-muted-foreground font-semibold tracking-wider mb-1 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-700"></span>
          PANORAMA NACIONAL
        </div>
        <h2 class="text-3xl md:text-4xl font-headline font-bold text-foreground tracking-tight">
          Alertas fitosanitarias por entidad
        </h2>
      </div>

      <p class="text-xs md:text-sm text-muted-foreground max-w-sm leading-relaxed text-left md:text-right">
        Densidad de avisos vigentes emitidos en los últimos 30 días.<br class="hidden sm:inline" />
        Selecciona una entidad para ver la plaga con mayor incidencia.
      </p>
    </div>

    <!-- Línea divisoria superior -->
    <div class="border-b border-border/80 mb-8"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Mapa Vectorial SVG de México Flotante -->
      <div class="lg:col-span-7 flex flex-col justify-between reveal-scale stagger-1">
        
        <!-- Selector Rápido de Entidad (Accesibilidad y Móviles) -->
        <div class="block lg:hidden mb-4 bg-card border border-border rounded-lg p-3 shadow-2xs">
          <label for="state-select-control" class="block text-mono-label font-bold text-muted-foreground mb-1.5">
            SELECCIONAR ENTIDAD FEDERATIVA
          </label>
          <div class="relative">
            <select
              id="state-select-control"
              class="w-full h-11 appearance-none border border-border bg-background px-3.5 pr-10 text-sm font-semibold rounded-md outline-none transition-all focus:border-[#1b4332] focus:ring-2 focus:ring-[#1b4332]/20 text-foreground cursor-pointer"
            >
              {{#each estadosList}}
                <option value="{{this}}" {{#if (eq this ../estadoInicial.estado)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
            <span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground text-lg">expand_more</span>
          </div>
        </div>

        <div class="w-full relative">
          <!-- Tooltip flotante interactivo para desktop -->
          <div
            id="map-tooltip"
            class="pointer-events-none fixed z-50 hidden rounded-md bg-[#0b281d] px-3 py-1.5 text-xs text-white shadow-xl transition-opacity font-mono border border-emerald-500/40"
          >
            <span id="tooltip-state" class="font-bold"></span>
            <span id="tooltip-alerts" class="text-emerald-300 ml-1.5"></span>
          </div>

          <svg viewBox="0 0 {{mapWidth}} {{mapHeight}}" class="w-full h-auto select-none overflow-visible" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mapa de México">
            <g id="mexico-map-states">
              {{#each mapPaths}}
                <path
                  id="state-path-{{this.id}}"
                  d="{{this.d}}"
                  fill="{{this.fillColor}}"
                  class="state-path"
                  data-estado="{{this.estado}}"
                  data-alertas="{{this.alertas}}"
                  data-nivel="{{this.nivel}}"
                  data-principal="{{this.principal}}"
                  data-cultivo="{{this.cultivo}}"
                  tabindex="0"
                  role="button"
                  title="{{this.estado}}"
                />
              {{/each}}
            </g>
          </svg>
        </div>

        <!-- Leyenda de Avisos Vigentes -->
        <div class="pt-8 border-t border-border/60 flex flex-wrap items-center gap-6 text-xs mt-4">
          <span class="text-mono-label text-muted-foreground font-semibold">AVISOS VIGENTES</span>
          <div class="flex items-center gap-4 font-mono text-xs">
            <div class="flex items-center gap-1.5">
              <span class="w-3.5 h-3.5 rounded-xs border border-border" style="background-color: var(--level-0)"></span>
              <span class="text-muted-foreground">0</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3.5 h-3.5 rounded-xs" style="background-color: var(--level-1)"></span>
              <span class="text-muted-foreground">1-9</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3.5 h-3.5 rounded-xs" style="background-color: var(--level-2)"></span>
              <span class="text-muted-foreground">10-24</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3.5 h-3.5 rounded-xs" style="background-color: var(--level-3)"></span>
              <span class="text-muted-foreground">25+</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta del Estado Seleccionado y Mayor Incidencia Nacional -->
      <div class="lg:col-span-5 space-y-6 reveal-on-scroll stagger-2">
        
        <!-- Tarjeta de Detalle del Estado -->
        <article class="bg-card border border-border/80 rounded-xl p-6 shadow-2xs space-y-4 transition-all">
          <div class="flex items-center justify-between text-mono-label text-muted-foreground font-semibold">
            <span>ENTIDAD SELECCIONADA</span>
            <span class="text-[10px] text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">MONITOREO DEMOSTRATIVO</span>
          </div>
          
          <h3 id="card-estado" class="text-2xl md:text-3xl font-headline font-bold text-foreground">
            {{estadoInicial.estado}}
          </h3>

          <div class="space-y-3 pt-2 text-sm border-t border-border/60">
            <div class="flex justify-between items-center">
              <span class="text-muted-foreground">Avisos vigentes</span>
              <span id="card-alertas" class="font-mono text-2xl font-medium tabular-nums text-foreground">
                {{estadoInicial.alertas}}
              </span>
            </div>

            <div class="flex justify-between items-center">
              <span class="text-muted-foreground">Nivel de riesgo</span>
              <span id="card-nivel" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-mono font-bold rounded-md border uppercase bg-emerald-50 text-emerald-800 border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" id="card-nivel-dot"></span>
                <span id="card-nivel-text">{{estadoInicial.nivel}}</span>
              </span>
            </div>

            <div class="flex justify-between items-center">
              <span class="text-muted-foreground">Cultivo afectado</span>
              <span id="card-cultivo" class="font-bold text-foreground">
                {{estadoInicial.cultivo}}
              </span>
            </div>

            <div class="pt-2 border-t border-border/60 space-y-1">
              <span class="text-xs text-muted-foreground">Plaga con mayor incidencia</span>
              <div id="card-principal" class="italic text-foreground font-semibold font-mono text-sm">
                {{estadoInicial.principal}}
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-border/60 flex items-center justify-between">
            <a
              id="card-link"
              href="/plagues?search={{urlEncode estadoInicial.principal}}"
              class="text-xs font-bold text-[#1b4332] hover:underline flex items-center gap-1 transition-colors"
            >
              <span>Ver expediente completo</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </article>

        <!-- Ranking Mayor Incidencia Nacional -->
        <div class="space-y-3 pt-2">
          <div class="text-mono-label text-muted-foreground font-semibold flex items-center justify-between">
            <span>MAYOR INCIDENCIA NACIONAL</span>
            <span class="text-[10px] text-muted-foreground font-normal">Clic para enfocar</span>
          </div>

          <ul class="divide-y divide-border/40 text-sm">
            {{#each ranking}}
              <li>
                <button
                  type="button"
                  class="btn-ranking flex w-full items-center justify-between gap-3 py-2 px-2 hover:bg-secondary/70 rounded-md transition-all text-left cursor-pointer group active:scale-[0.99]"
                  data-estado="{{this.estado}}"
                >
                  <span class="font-mono text-xs font-bold text-muted-foreground w-6 group-hover:text-[#1b4332]">{{this.num}}</span>
                  <span class="flex-1 text-sm font-semibold text-foreground truncate">{{this.estado}}</span>
                  
                  <!-- Barra indicadora verde a la derecha antes del número -->
                  <div class="w-20 h-2 bg-secondary rounded-full overflow-hidden flex justify-end">
                    <div class="h-full rounded-full transition-all duration-300" style="width: {{this.barWidth}}px; background-color: {{this.fillColor}};"></div>
                  </div>
                  
                  <span class="font-mono text-xs font-bold text-foreground w-6 text-right">{{this.alertas}}</span>
                </button>
              </li>
            {{/each}}
          </ul>
        </div>

      </div>

      <!-- Nota Técnica Institucional de Transparencia -->
      <div class="lg:col-span-12 mt-4 p-3.5 rounded-xl bg-muted/40 border border-border/80 flex items-start gap-2.5 text-xs text-muted-foreground">
        <span class="material-symbols-outlined text-base text-[#1b4332] shrink-0 mt-0.5" data-icon="info">info</span>
        <span><strong class="text-foreground">Nota técnica institucional:</strong> Los indicadores epidemiológicos del mapa y ranking corresponden a un muestreo de monitoreo demostrativo para evaluación técnica. El catálogo documental del INIFAP cuenta con validación fitosanitaria experimental continua.</span>
      </div>

    </div>
  </section>

  <!-- ── SECCIÓN 3: BOLETÍN DE AVISOS PUBLICADOS ESTA SEMANA ────────────────── -->
  <section class="px-6 md:px-12 max-w-7xl mx-auto border-b border-border/60 pb-16">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-6 reveal-on-scroll">
      <div>
        <div class="text-mono-label text-emerald-800 font-semibold tracking-wider">
          BOLETÍN OFICIAL
        </div>
        <h2 class="text-2xl md:text-3xl font-headline font-bold text-foreground tracking-tight">
          Avisos publicados esta semana
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">Registros emitidos conforme a los protocolos de validación técnica y alerta temprana.</p>
      </div>
      <a href="/plagues" class="text-xs text-mono-label font-bold text-[#1b4332] hover:underline flex items-center gap-1">
        <span>Ver el archivo completo</span>
        <span class="material-symbols-outlined text-sm">north_east</span>
      </a>
    </div>

    <!-- Vista Desktop: Tabla Institucional -->
    <div class="hidden md:block bg-card border border-border rounded-xl overflow-x-auto shadow-xs reveal-on-scroll stagger-1">
      <table class="w-full text-left border-collapse min-w-175">
        <thead>
          <tr class="border-b border-border bg-secondary/50 text-mono-label text-muted-foreground">
            <th class="py-3 px-4 font-semibold">FOLIO</th>
            <th class="py-3 px-4 font-semibold">FECHA</th>
            <th class="py-3 px-4 font-semibold">ENTIDAD</th>
            <th class="py-3 px-4 font-semibold">AGENTE CAUSAL</th>
            <th class="py-3 px-4 font-semibold">CULTIVO</th>
            <th class="py-3 px-4 font-semibold text-right">NIVEL</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-xs md:text-sm">
          {{#each boletin}}
            <tr class="hover:bg-secondary/40 transition-colors group">
              <td class="py-3.5 px-4 font-mono font-medium text-muted-foreground">{{this.folio}}</td>
              <td class="py-3.5 px-4 font-mono text-muted-foreground">{{this.date}}</td>
              <td class="py-3.5 px-4 font-bold text-foreground">{{this.state}}</td>
              <td class="py-3.5 px-4">
                <a href="/plagues?search={{urlEncode this.pestScientific}}" class="group-hover:text-[#1b4332] transition-colors block">
                  <div class="italic font-medium text-foreground group-hover:text-[#1b4332]">{{this.pestScientific}}</div>
                  <div class="text-xs text-muted-foreground font-normal">{{this.pestCommon}}</div>
                </a>
              </td>
              <td class="py-3.5 px-4 text-foreground">{{this.crop}}</td>
              <td class="py-3.5 px-4 text-right">
                <span class="inline-block px-2.5 py-1 text-[10px] font-mono font-extrabold tracking-wider rounded border uppercase {{this.levelClass}}">
                  {{this.level}}
                </span>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Vista Móvil: Tarjetas Fluidas (Sin scroll horizontal) -->
    <div class="md:hidden space-y-3 reveal-on-scroll stagger-1">
      {{#each boletin}}
        <article class="bg-card border border-border rounded-xl p-4 shadow-2xs space-y-2.5 hover:border-[#1b4332]/40 transition-all">
          <div class="flex items-center justify-between text-xs">
            <span class="font-mono font-semibold text-muted-foreground">{{this.folio}}</span>
            <span class="font-mono text-muted-foreground">{{this.date}}</span>
          </div>
          <div class="flex items-baseline justify-between gap-2">
            <h4 class="font-bold text-foreground text-sm">{{this.state}}</h4>
            <span class="inline-block px-2 py-0.5 text-[10px] font-mono font-extrabold tracking-wider rounded border uppercase {{this.levelClass}}">
              {{this.level}}
            </span>
          </div>
          <div class="text-xs">
            <p class="italic font-medium text-foreground">{{this.pestScientific}}</p>
            <p class="text-muted-foreground">{{this.pestCommon}}</p>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-border/60 text-xs">
            <span class="text-muted-foreground">Cultivo: <strong class="text-foreground font-semibold">{{this.crop}}</strong></span>
            <a href="/plagues?search={{urlEncode this.pestScientific}}" class="font-bold text-[#1b4332] hover:underline flex items-center gap-0.5">
              <span>Ver ficha</span>
              <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
          </div>
        </article>
      {{/each}}
    </div>
  </section>

  <!-- ── SECCIÓN 4: CICLO AGRÍCOLA 2026 ────────────────────────────────────── -->
  <section class="px-6 md:px-12 max-w-7xl mx-auto border-b border-border/60 pb-16">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-6 reveal-on-scroll">
      <div>
        <div class="text-mono-label text-emerald-800 font-semibold tracking-wider">
          CICLO AGRÍCOLA 2026
        </div>
        <h2 class="text-2xl md:text-3xl font-headline font-bold text-foreground tracking-tight">
          Qué se siembra y qué se cosecha ahora
        </h2>
      </div>

      <!-- Controles de Filtro y Leyenda de Siembra / Cosecha -->
      <div class="flex flex-wrap items-center gap-4 text-xs font-medium">
        <!-- Filtros Rápidos -->
        <div class="flex items-center p-0.5 bg-secondary rounded-lg border border-border text-xs">
          <button type="button" class="season-filter-btn px-3 py-1 rounded-md font-semibold bg-card text-[#1b4332] shadow-2xs transition-all cursor-pointer" data-filter="all">Todos</button>
          <button type="button" class="season-filter-btn px-3 py-1 rounded-md text-muted-foreground hover:text-foreground transition-all cursor-pointer" data-filter="siembra">En Siembra</button>
          <button type="button" class="season-filter-btn px-3 py-1 rounded-md text-muted-foreground hover:text-foreground transition-all cursor-pointer" data-filter="cosecha">En Cosecha</button>
        </div>

        <!-- Leyenda -->
        <div class="flex items-center gap-4 text-mono-label text-xs">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded bg-[#73b398]"></span>
            <span>Siembra</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded bg-[#1b4332]"></span>
            <span>Cosecha</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Matriz del Calendario Agrícola -->
    <div class="bg-card border border-border rounded-xl p-4 md:p-6 overflow-x-auto shadow-xs reveal-on-scroll stagger-1">
      <ul class="flex flex-col divide-y divide-border min-w-187.5" id="cultivos-calendar-list">
        <!-- Encabezado de Meses Clarificado -->
        <li class="flex items-center gap-4 pb-3 font-mono text-xs font-bold text-muted-foreground text-center select-none">
          <div class="w-56 text-left">CULTIVO</div>
          <div class="flex flex-1 gap-1">
            <div class="flex-1 py-0.5 {{#if (eq mesActual 1)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">ENE</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 2)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">FEB</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 3)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">MAR</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 4)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">ABR</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 5)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">MAY</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 6)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">JUN</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 7)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">JUL</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 8)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">AGO</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 9)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">SEP</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 10)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">OCT</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 11)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">NOV</div>
            <div class="flex-1 py-0.5 {{#if (eq mesActual 12)}}text-[#1b4332] bg-emerald-100 font-bold rounded ring-1 ring-emerald-600/30{{/if}}">DIC</div>
          </div>
          <div class="w-16 text-right">FICHAS</div>
        </li>

        <!-- Filas de Cultivos -->
        {{#each cultivosTemporada}}
          <li
            class="crop-calendar-row flex items-center gap-4 py-3 hover:bg-secondary/30 transition-all reveal-on-scroll {{#if (eq @index 0)}}stagger-1{{else}}{{#if (eq @index 1)}}stagger-2{{else}}{{#if (eq @index 2)}}stagger-3{{else}}{{#if (eq @index 3)}}stagger-4{{else}}stagger-5{{/if}}{{/if}}{{/if}}{{/if}}"
            data-season="{{this.estadoTemporada}}"
          >
            <div class="flex w-56 shrink-0 flex-col gap-0.5">
              <div class="flex items-center gap-1.5">
                <a href="/crops?search={{urlEncode this.nombre}}" class="text-sm font-bold text-foreground hover:text-[#1b4332] hover:underline">{{this.nombre}}</a>
                {{#if this.enCosecha}}
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#1b4332]" title="En cosecha este mes"></span>
                {{else}}{{#if this.enSiembra}}
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#73b398]" title="En siembra este mes"></span>
                {{/if}}{{/if}}
              </div>
              <span class="font-mono text-xs italic text-muted-foreground">{{this.cientifico}}</span>
            </div>

            <div class="flex flex-1 gap-1">
              <div class="h-6 flex-1 rounded {{getMesBg 1 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 2 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 3 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 4 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 5 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 6 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 7 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 8 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 9 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 10 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 11 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
              <div class="h-6 flex-1 rounded {{getMesBg 12 this.siembra this.cosecha ../mesActual}} transition-colors"></div>
            </div>

            <div class="w-16 shrink-0 text-right font-mono text-sm font-medium text-muted-foreground">
              {{this.fichas}}
            </div>
          </li>
        {{/each}}
      </ul>
    </div>
  </section>

  <!-- ── SECCIÓN 5: ACERVO (ÍNDICE DE LA BASE DE DATOS) ────────────────────── -->
  <section class="px-6 md:px-12 max-w-7xl mx-auto">
    <div class="space-y-2 mb-8 reveal-on-scroll">
      <div class="text-mono-label text-emerald-800 font-semibold tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-700"></span>
        ACERVO
      </div>
      <h2 class="text-2xl md:text-3xl font-headline font-bold text-foreground tracking-tight">
        Índice de la base de datos
      </h2>
      <p class="text-xs md:text-sm text-muted-foreground">Acceso directo a los catálogos y registros técnicos publicados por el INIFAP.</p>
    </div>

    <!-- Rejilla de 4 Tarjetas con Iconografía y Elevación Suave en Cascada -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {{#each acervoStats}}
        <div class="bg-card border border-border rounded-xl p-6 shadow-xs hover:shadow-md hover:border-emerald-700/40 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group reveal-on-scroll {{#if (eq @index 0)}}stagger-1{{else}}{{#if (eq @index 1)}}stagger-2{{else}}{{#if (eq @index 2)}}stagger-3{{else}}stagger-4{{/if}}{{/if}}{{/if}}">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-3xl lg:text-4xl font-medium tabular-nums text-[#1b4332]">{{this.count}}</span>
                <span class="text-mono-label text-muted-foreground font-semibold">{{this.subtitle}}</span>
              </div>
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-[#1b4332] flex items-center justify-center border border-emerald-100 group-hover:bg-[#1b4332] group-hover:text-white transition-all">
                {{#if (eq @index 0)}}
                  <span class="material-symbols-outlined text-xl">pest_control</span>
                {{else}}{{#if (eq @index 1)}}
                  <span class="material-symbols-outlined text-xl">psychiatry</span>
                {{else}}{{#if (eq @index 2)}}
                  <span class="material-symbols-outlined text-xl">science</span>
                {{else}}
                  <span class="material-symbols-outlined text-xl">travel_explore</span>
                {{/if}}{{/if}}{{/if}}
              </div>
            </div>

            <h3 class="text-lg font-headline font-bold text-foreground group-hover:text-[#1b4332] transition-colors">
              {{this.title}}
            </h3>

            <p class="text-xs text-muted-foreground leading-relaxed">
              {{this.description}}
            </p>
          </div>

          <div class="pt-6">
            <a
              href="{{this.link}}"
              class="text-xs font-headline font-bold text-[#1b4332] hover:underline flex items-center gap-1"
            >
              <span>Consultar</span>
              <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
            </a>
          </div>
        </div>
      {{/each}}
    </div>
  </section>

</div>