<div class="min-h-screen bg-background">
  <section class="border-b border-border bg-[#f4f8f5]">
    <div class="mx-auto max-w-7xl px-6 py-14 md:px-12 md:py-20">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#43655c]">Información regional</p>
      <div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)] lg:items-end">
        <div>
          <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-[#0f2e2e] md:text-5xl">Regiones agrícolas</h1>
          <p class="mt-5 max-w-3xl text-base leading-7 text-muted-foreground md:text-lg">
            Consulta la cobertura regional del acervo fitosanitario publicado por INIFAP. Esta sección presenta información general y no identifica terrenos particulares.
          </p>
        </div>
        <aside class="rounded-2xl border border-emerald-900/10 bg-white p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-wider text-[#43655c]">Privacidad territorial</p>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Los expedientes, responsables y ubicaciones precisas sólo están disponibles para personal autorizado.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12 md:px-12">
    <div class="flex flex-col gap-5 border-b border-border pb-8 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-2xl font-extrabold text-foreground">Cobertura disponible</h2>
        <p class="mt-2 text-sm text-muted-foreground">{{totalCount}} región(es) registrada(s) en el sistema.</p>
      </div>
      <form action="/lands" method="GET" class="flex w-full max-w-md gap-2" role="search">
        <label for="region-search" class="sr-only">Buscar región</label>
        <input id="region-search" name="search" value="{{search}}" maxlength="80" placeholder="Buscar una región" class="min-w-0 flex-1 rounded-xl border border-input bg-card px-4 py-2.5 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20" />
        <button type="submit" class="rounded-xl bg-[#1b4332] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#133426]">Buscar</button>
      </form>
    </div>

    {{#if error}}
    <div class="mt-8 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700" role="alert">{{error}}</div>
    {{/if}}

    {{#if regions}}
    <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {{#each regions}}
      <article class="flex min-h-64 flex-col rounded-2xl border border-border bg-card p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
        <div class="flex items-start justify-between gap-4">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-[#1b4332]" aria-hidden="true">
            <span class="material-symbols-outlined">landscape</span>
          </div>
          <span class="rounded-full bg-muted px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Región {{this.id}}</span>
        </div>
        <h3 class="mt-5 text-xl font-extrabold text-[#0f2e2e]">{{this.name}}</h3>
        <p class="mt-2 text-sm text-muted-foreground">{{this.plagueCount}} ficha(s) fitosanitaria(s) publicadas con cobertura en esta región.</p>

        <div class="mt-5 border-t border-border pt-4">
          <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Referencias destacadas</p>
          {{#if this.featuredPlagues}}
          <ul class="mt-3 space-y-2">
            {{#each this.featuredPlagues}}
            <li>
              <a href="/plagues/{{this.id}}" class="text-sm font-bold text-[#1b4332] hover:underline">{{this.name}}</a>
              {{#if this.scientificName}}<p class="text-xs italic text-muted-foreground">{{this.scientificName}}</p>{{/if}}
            </li>
            {{/each}}
          </ul>
          {{else}}
          <p class="mt-3 text-sm text-muted-foreground">Sin fichas públicas relacionadas por el momento.</p>
          {{/if}}
        </div>
      </article>
      {{/each}}
    </div>
    {{else}}
    <div class="mt-8 rounded-2xl border border-dashed border-border bg-card p-12 text-center">
      <span class="material-symbols-outlined text-5xl text-muted-foreground" aria-hidden="true">travel_explore</span>
      <h2 class="mt-4 text-lg font-extrabold text-foreground">No encontramos regiones</h2>
      <p class="mt-2 text-sm text-muted-foreground">Prueba con otro término de búsqueda.</p>
      <a href="/lands" class="mt-5 inline-flex rounded-xl border border-border px-4 py-2 text-sm font-bold text-[#1b4332] hover:bg-muted">Ver todas</a>
    </div>
    {{/if}}

    {{#if hasMultiplePages}}
    <nav class="mt-10 flex items-center justify-center gap-3" aria-label="Paginación de regiones">
      {{#if hasPrevPage}}
      <a href="/lands?search={{urlEncode search}}&page={{prevPage}}" class="rounded-xl border border-border bg-card px-4 py-2 text-sm font-bold text-foreground hover:bg-muted">Anterior</a>
      {{/if}}
      <span class="px-3 text-sm text-muted-foreground">Página {{currentPage}} de {{totalPages}}</span>
      {{#if hasNextPage}}
      <a href="/lands?search={{urlEncode search}}&page={{nextPage}}" class="rounded-xl border border-border bg-card px-4 py-2 text-sm font-bold text-foreground hover:bg-muted">Siguiente</a>
      {{/if}}
    </nav>
    {{/if}}
  </section>
</div>
