<!-- Catálogo Público de Regiones Agrícolas (/lands) · Geist Design System -->
<div class="font-['Geist'] antialiased">
  <section aria-labelledby="catalogo-lands-title" class="bg-background min-h-screen pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-12 py-8 md:py-12">

      <!-- Encabezado Institucional Geist · INIFAP -->
      <div class="grid gap-8 border-b border-border pb-8 lg:grid-cols-[1.65fr_1fr] lg:items-end">
        <div class="flex flex-col gap-3">
          <div class="text-mono-label text-emerald-800 font-semibold tracking-wider flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            <span>Información regional · Cobertura Fitosanitaria Nacional</span>
          </div>
          <h1 id="catalogo-lands-title" class="text-3xl sm:text-4xl md:text-5xl font-headline font-extrabold leading-[1.05] tracking-tight text-foreground">
            Regiones agrícolas
          </h1>
          <p class="max-w-2xl text-xs sm:text-sm leading-relaxed text-muted-foreground">
            Consulta la cobertura regional del acervo fitosanitario documentado en el catálogo técnico del INIFAP. Esta sección presenta información agregada por zona y preserva íntegramente la privacidad territorial de los productores.
          </p>
        </div>

        <!-- Métricas Institucionales y Nota de Privacidad Territorial -->
        <div class="space-y-3">
          <dl class="grid grid-cols-3 divide-x divide-border border border-border rounded-xl bg-card shadow-xs overflow-hidden">
            <div class="flex flex-col gap-1 p-3.5 text-center sm:text-left">
              <dd class="font-mono text-xl sm:text-2xl font-bold tabular-nums text-[#1b4332]" id="total-lands-count-header">{{totalCount}}</dd>
              <dt class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground font-medium">Zonas registradas</dt>
            </div>
            <div class="flex flex-col gap-1 p-3.5 text-center sm:text-left">
              <dd class="font-mono text-xl sm:text-2xl font-bold tabular-nums text-[#1b4332]">{{#if coverageMap}}{{coverageMap.coveredStatesCount}}{{else}}0{{/if}}</dd>
              <dt class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground font-medium">Estados cubiertos</dt>
            </div>
            <div class="flex flex-col gap-1 p-3.5 text-center sm:text-left">
              <dd class="font-mono text-xl sm:text-2xl font-bold tabular-nums text-[#1b4332]">{{#if coverageMap}}{{coverageMap.totalPlagueRefs}}{{else}}0{{/if}}</dd>
              <dt class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground font-medium">Vínculos sanitarios</dt>
            </div>
          </dl>
          <div class="rounded-xl border border-emerald-900/10 bg-[#f4f8f5] px-4 py-2.5 text-[11px] leading-relaxed text-muted-foreground flex items-start gap-2">
            <span class="material-symbols-outlined text-sm text-[#1b4332] shrink-0 mt-0.5" aria-hidden="true">verified_user</span>
            <span>Privacidad territorial garantizada: los predios individuales y datos operativos sólo son visibles para personal técnico autorizado.</span>
          </div>
        </div>
      </div>

      {{#if error}}
        <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-xs sm:text-sm font-semibold text-red-700 flex items-center justify-between gap-4" role="alert">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-red-600">error</span>
            <span>{{error}}</span>
          </div>
          <a href="/lands" class="shrink-0 font-bold text-[#1b4332] hover:underline">Reintentar</a>
        </div>
      {{/if}}

      <!-- MAPA VECTORIAL NACIONAL DE COBERTURA REGIONAL (Cero CDNs) -->
      {{#if coverageMap}}
        <section aria-labelledby="national-coverage-map-heading" class="mt-6 mb-6 rounded-2xl border border-border/80 bg-card shadow-2xs overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/60 px-4 sm:px-6 py-3.5 bg-muted/20">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#e6f0e6] text-[#1b4332]">
                <span class="material-symbols-outlined text-lg" aria-hidden="true">map</span>
              </span>
              <div>
                <h2 id="national-coverage-map-heading" class="text-sm font-headline font-bold text-foreground">
                  Panorama Territorial de Vigilancia INIFAP
                </h2>
                <p class="text-[11px] text-muted-foreground">Selecciona una entidad con cobertura para filtrar sus fichas regionales asociadas.</p>
              </div>
            </div>
            <div class="flex items-center gap-3 text-[11px] font-medium text-muted-foreground">
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-xs bg-[#1b4332]"></span>
                Vigilancia activa
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-xs bg-emerald-400"></span>
                Zona documentada
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-xs bg-slate-200"></span>
                Sin registro regional
              </span>
              <button
                type="button"
                id="toggle-public-lands-map-btn"
                class="sm:hidden inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-[11px] font-bold text-foreground cursor-pointer"
                aria-expanded="true"
                aria-controls="public-lands-map-panel"
              >
                <span>Mapa</span>
              </button>
            </div>
          </div>

          <div id="public-lands-map-panel" class="relative bg-gradient-to-b from-[#f7faf8] to-card px-4 py-4 sm:px-6">
            <div class="mx-auto max-w-3xl">
              <svg
                id="national-regions-svg"
                viewBox="{{coverageMap.viewBox}}"
                class="h-auto max-h-[290px] w-full select-none"
                role="img"
                aria-label="Mapa de cobertura regional fitosanitaria en México"
              >
                {{#each coverageMap.states}}
                  <path
                    d="{{this.d}}"
                    data-state-name="{{this.estado}}"
                    data-region-name="{{this.regionName}}"
                    data-plague-count="{{this.plagueCount}}"
                    stroke-width="1"
                    class="{{this.stateClass}}"
                  >
                    <title>{{this.estado}}{{#if this.regionName}} · Región {{this.regionName}} ({{this.plagueCount}} fichas){{/if}}</title>
                  </path>
                {{/each}}
              </svg>
            </div>
            <div
              id="public-map-state-tooltip"
              class="mt-2 flex items-center justify-between rounded-xl border border-border/70 bg-background/90 px-3.5 py-2 text-xs text-muted-foreground"
              aria-live="polite"
            >
              <span id="public-map-tooltip-label">Explora el mapa nacional o utiliza el buscador inferior para consultar una región agrícola.</span>
              <button type="button" id="public-map-reset-btn" class="{{#unless hasActiveFilters}}hidden{{/unless}} font-bold text-[#1b4332] hover:underline cursor-pointer">
                Restablecer filtro
              </button>
            </div>
          </div>
        </section>
      {{/if}}

      <!-- BARRA PEGAJOSA COMPACTA DE BÚSQUEDA Y COBERTURA -->
      <div class="sticky top-0 md:top-16 z-30 -mx-4 sm:-mx-6 md:-mx-12 mb-6 border-b border-border bg-background/95 px-4 sm:px-6 md:px-12 py-2.5 sm:py-3 backdrop-blur-md shadow-2xs">
        <form action="/lands" method="GET" id="form-filtros-lands" role="search">
          <input type="hidden" name="coverage" id="lands-coverage-hidden" value="{{selectedCoverage}}" />

          <div class="flex items-center gap-2">
            <label for="region-search" class="sr-only">Buscar región</label>
            <div class="relative flex-1">
              <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-lg select-none">search</span>
              <input
                id="region-search"
                name="search"
                type="search"
                value="{{search}}"
                maxlength="80"
                placeholder="Buscar región agrícola (ej. El Bajío, Sinaloa, Michoacán)…"
                class="h-9 sm:h-10 w-full border border-input bg-card pl-9 sm:pl-10 pr-9 sm:pr-14 text-xs sm:text-sm rounded-xl outline-none transition-all placeholder:text-muted-foreground focus-visible:border-[#1b4332] focus-visible:ring-2 focus-visible:ring-[#1b4332]/20"
                autocomplete="off"
              />
              <kbd class="pointer-events-none hidden sm:inline-flex absolute right-8 top-1/2 -translate-y-1/2 items-center rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">/</kbd>
              <button
                type="button"
                id="clear-lands-search-btn"
                class="{{#unless search}}hidden{{/unless}} absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center rounded-full text-muted-foreground hover:text-foreground hover:bg-secondary cursor-pointer transition-all"
                title="Limpiar búsqueda"
                aria-label="Limpiar búsqueda"
              >
                <span class="material-symbols-outlined text-sm">close</span>
              </button>
            </div>

            <button
              type="submit"
              class="h-9 sm:h-10 rounded-xl bg-[#1b4332] px-4 sm:px-5 text-xs sm:text-sm font-bold text-white transition-colors hover:bg-[#2d6a4f] cursor-pointer shrink-0 shadow-2xs"
            >
              Buscar
            </button>
          </div>

          <!-- Píldoras horizontales compactas -->
          <div class="mt-2 flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-1.5 border-t border-border/50 text-xs">
            <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground mr-1 shrink-0">Cobertura:</span>
            <button
              type="button"
              data-coverage-chip=""
              class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#unless hasActiveFilters}}bg-[#1b4332] text-white border-[#1b4332] font-bold{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/unless}}"
            >
              Todas
            </button>
            <button
              type="button"
              data-coverage-chip="active"
              class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq selectedCoverage 'active')}}bg-[#1b4332] text-white border-[#1b4332] font-bold{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}"
            >
              Con vigilancia activa
            </button>
            {{#each quickRegions}}
              <button
                type="button"
                data-region-quick-chip="{{this}}"
                class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq ../search this)}}bg-emerald-700 text-white border-emerald-700 font-bold{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}"
              >
                {{this}}
              </button>
            {{/each}}
          </div>
        </form>
      </div>

      <!-- REGIÓN DINÁMICA DE RESULTADOS -->
      <div id="lands-results-region" class="space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground" role="status">
          <p>
            <strong class="font-mono text-foreground">{{totalCount}}</strong> región(es) agrícola(s) encontrada(s) en el sistema.
          </p>
          {{#if hasActiveFilters}}
            <a href="/lands" data-lands-reset-link class="inline-flex items-center gap-1 font-bold text-[#1b4332] hover:underline">
              <span class="material-symbols-outlined text-sm">restart_alt</span>
              <span>Limpiar filtros</span>
            </a>
          {{/if}}
        </div>

        {{#if regions.length}}
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {{#each regions}}
              <article class="group flex min-h-64 flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-2xs transition-all hover:border-[#1b4332]/40 hover:shadow-md">
                <div>
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e6f0e6] text-[#1b4332] transition-transform group-hover:scale-105" aria-hidden="true">
                      <span class="material-symbols-outlined">landscape</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      {{#if this.plagueCount}}
                        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800">
                          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
                          {{this.plagueCount}} ficha(s)
                        </span>
                      {{/if}}
                      <span class="rounded-full bg-muted px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
                        REG-{{this.id}}
                      </span>
                    </div>
                  </div>

                  <h3 class="mt-4 text-xl font-headline font-extrabold text-[#1b4332] group-hover:text-[#2d6a4f] transition-colors">
                    {{this.name}}
                  </h3>
                  <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                    {{#if this.plagueCount}}
                      {{this.plagueCount}} ficha(s) fitosanitaria(s) publicadas con cobertura documentada en esta zona agrícola.
                    {{else}}
                      Zona agrícola catalogada por INIFAP sin alertas públicas vinculadas actualmente.
                    {{/if}}
                  </p>

                  <div class="mt-5 border-t border-border/70 pt-4">
                    <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
                      Organismos con presencia documentada
                    </p>
                    {{#if this.featuredPlagues.length}}
                      <ul class="mt-2.5 space-y-2">
                        {{#each this.featuredPlagues}}
                          <li class="flex items-center justify-between gap-2 rounded-xl border border-border/60 bg-muted/30 px-3 py-2 transition-colors hover:border-[#1b4332]/30 hover:bg-[#e6f0e6]/40">
                            <div class="min-w-0">
                              <a href="/plagues/{{this.id}}" class="block truncate text-xs font-bold text-[#1b4332] hover:underline">
                                {{this.name}}
                              </a>
                              {{#if this.scientificName}}
                                <p class="truncate font-mono text-[10px] italic text-muted-foreground">{{this.scientificName}}</p>
                              {{/if}}
                            </div>
                            <a href="/plagues/{{this.id}}" aria-label="Ver ficha de {{this.name}}" class="shrink-0 text-muted-foreground hover:text-[#1b4332]">
                              <span class="material-symbols-outlined text-sm">arrow_outward</span>
                            </a>
                          </li>
                        {{/each}}
                      </ul>
                    {{else}}
                      <p class="mt-3 rounded-xl bg-muted/40 px-3 py-2.5 text-xs text-muted-foreground">
                        Sin fichas públicas relacionadas por el momento.
                      </p>
                    {{/if}}
                  </div>
                </div>

                <div class="mt-5 pt-3 border-t border-border/50 flex items-center justify-between text-[11px]">
                  <span class="text-muted-foreground font-mono">Cobertura pública INIFAP</span>
                  <a href="/plagues?search={{urlEncode this.name}}" class="inline-flex items-center gap-1 font-bold text-[#1b4332] hover:underline">
                    <span>Explorar catálogo</span>
                    <span class="material-symbols-outlined text-xs">arrow_forward</span>
                  </a>
                </div>
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="rounded-2xl border border-dashed border-border bg-card p-12 text-center">
            <span class="material-symbols-outlined text-5xl text-muted-foreground" aria-hidden="true">travel_explore</span>
            <h2 class="mt-4 text-lg font-headline font-extrabold text-foreground">No encontramos regiones coincidentes</h2>
            <p class="mt-1.5 text-xs sm:text-sm text-muted-foreground max-w-md mx-auto">
              Ajusta el término de búsqueda o restablece los filtros de cobertura para explorar todo el directorio regional.
            </p>
            <a href="/lands" data-lands-reset-link class="mt-5 inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f] transition-colors">
              <span class="material-symbols-outlined text-sm">restart_alt</span>
              <span>Ver todas las regiones</span>
            </a>
          </div>
        {{/if}}

        {{#if hasMultiplePages}}
          <nav class="mt-8 flex items-center justify-center gap-3" aria-label="Paginación de regiones">
            {{#if hasPrevPage}}
              <a href="/lands?search={{urlEncode search}}&coverage={{urlEncode selectedCoverage}}&page={{prevPage}}" data-lands-page-link class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-foreground hover:bg-muted transition-colors">
                ← Anterior
              </a>
            {{/if}}
            <span class="px-3 font-mono text-xs text-muted-foreground">Página {{currentPage}} de {{totalPages}}</span>
            {{#if hasNextPage}}
              <a href="/lands?search={{urlEncode search}}&coverage={{urlEncode selectedCoverage}}&page={{nextPage}}" data-lands-page-link class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-foreground hover:bg-muted transition-colors">
                Siguiente →
              </a>
            {{/if}}
          </nav>
        {{/if}}
      </div>

      <!-- BOLETINES Y AVISOS FITOSANITARIOS POR REGIÓN -->
      <section aria-labelledby="regional-bulletins-heading" class="mt-14 pt-10 border-t border-border">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-emerald-800 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-xs">campaign</span>
              <span>Comunicación Oficial INIFAP</span>
            </p>
            <h2 id="regional-bulletins-heading" class="mt-1 text-2xl sm:text-3xl font-headline font-extrabold tracking-tight text-foreground">
              Boletines y avisos fitosanitarios por región
            </h2>
            <p class="mt-1 text-xs sm:text-sm text-muted-foreground max-w-2xl">
              Reportes técnicos, alertas preventivas y avisos operativos emitidos por investigadores y personal acreditado del INIFAP para las zonas agrícolas del país.
            </p>
          </div>
          {{#if (canAccessPanel user)}}
            <button
              type="button"
              id="open-bulletin-modal-btn"
              class="inline-flex items-center gap-2 rounded-xl bg-[#1b4332] px-4 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-[#2d6a4f] transition-colors cursor-pointer shrink-0"
            >
              <span class="material-symbols-outlined text-base">post_add</span>
              <span>Publicar boletín regional</span>
            </button>
          {{/if}}
        </div>

        {{#if bulletins.length}}
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {{#each bulletins}}
              <article class="flex flex-col justify-between rounded-2xl border border-border bg-card p-5 shadow-2xs transition-all hover:border-[#1b4332]/40">
                <div>
                  <div class="flex items-center justify-between gap-2 text-[11px] font-mono text-muted-foreground">
                    <span class="font-bold text-foreground">{{this.date}}</span>
                    <span class="rounded-md bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-bold uppercase text-[#1b4332]">
                      {{this.tag}}
                    </span>
                  </div>
                  <p class="mt-2 inline-flex items-center gap-1 text-[11px] font-bold text-emerald-800">
                    <span class="material-symbols-outlined text-xs">location_on</span>
                    <span>{{this.region}}</span>
                  </p>
                  <h3 class="mt-1.5 text-base font-headline font-extrabold text-foreground leading-snug">
                    {{this.title}}
                  </h3>
                  <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                    {{this.excerpt}}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-[11px]">
                  <span class="font-mono text-muted-foreground">Emitido por {{this.authorName}}</span>
                  <a href="{{this.href}}" class="inline-flex items-center gap-1 font-bold text-[#1b4332] hover:underline">
                    <span>Ver ficha</span>
                    <span class="material-symbols-outlined text-xs">arrow_outward</span>
                  </a>
                </div>
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="rounded-2xl border border-dashed border-border bg-card p-8 text-center text-xs text-muted-foreground">
            No hay boletines regionales publicados en este momento.
          </div>
        {{/if}}
      </section>

    </div>
  </section>
</div>

{{#if (canAccessPanel user)}}
  <!-- Modal: Redactar y Publicar Boletín Regional (Personal INIFAP / Admin) -->
  <div
    id="modal-create-bulletin"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-xs"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-create-bulletin-title"
  >
    <div class="w-full max-w-lg rounded-2xl border border-border bg-card shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between border-b border-border px-6 py-4 bg-muted/30">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#e6f0e6] text-[#1b4332]">
            <span class="material-symbols-outlined text-lg">campaign</span>
          </span>
          <div>
            <h3 id="modal-create-bulletin-title" class="text-sm font-headline font-extrabold text-foreground">
              Publicar Boletín o Aviso Regional
            </h3>
            <p class="text-[11px] text-muted-foreground">Comunicado técnico visible en Inicio y Regiones Agrícolas</p>
          </div>
        </div>
        <button
          type="button"
          data-close-bulletin-modal
          class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
          aria-label="Cerrar modal"
        >
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <form action="/private/lands/bulletins" method="POST" class="p-6 space-y-4 overflow-y-auto">
        <input type="hidden" name="redirect_to" value="public" />

        <div>
          <label for="bulletin-title" class="block text-xs font-bold text-foreground mb-1">
            Título del boletín o aviso <span class="text-red-600">*</span>
          </label>
          <input
            type="text"
            id="bulletin-title"
            name="title"
            required
            minlength="5"
            maxlength="180"
            placeholder="Ej. Alerta preventiva por incremento de roya amarilla en trigo"
            class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-xs text-foreground outline-none focus:border-[#1b4332]"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="bulletin-region" class="block text-xs font-bold text-foreground mb-1">
              Región agrícola objetivo
            </label>
            <select
              id="bulletin-region"
              name="region_id"
              class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs text-foreground outline-none focus:border-[#1b4332]"
            >
              <option value="">Nacional / Multirregional</option>
              {{#each allRegions}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label for="bulletin-severity" class="block text-xs font-bold text-foreground mb-1">
              Nivel de prioridad
            </label>
            <select
              id="bulletin-severity"
              name="severity"
              class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs text-foreground outline-none focus:border-[#1b4332]"
            >
              <option value="Preventivo">Preventivo · Boletín Técnico</option>
              <option value="Moderado">Moderado · Vigilancia Activa</option>
              <option value="Crítico">Crítico · Alerta Sanitaria</option>
            </select>
          </div>
        </div>

        <div>
          <label for="bulletin-summary" class="block text-xs font-bold text-foreground mb-1">
            Resumen técnico y recomendaciones <span class="text-red-600">*</span>
          </label>
          <textarea
            id="bulletin-summary"
            name="summary"
            required
            minlength="12"
            maxlength="900"
            rows="4"
            placeholder="Describe el hallazgo fitosanitario, fenología afectada y medidas recomendadas por INIFAP..."
            class="w-full rounded-xl border border-input bg-background px-3.5 py-2.5 text-xs text-foreground outline-none focus:border-[#1b4332]"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-border">
          <button
            type="button"
            data-close-bulletin-modal
            class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-foreground hover:bg-muted cursor-pointer"
          >
            Cancelar
          </button>
          <button
            type="submit"
            data-loading-text="Publicando boletín..."
            class="rounded-xl bg-[#1b4332] px-5 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f] cursor-pointer"
          >
            Publicar boletín
          </button>
        </div>
      </form>
    </div>
  </div>
{{/if}}

<script type="module" src="/js/public/lands.js"></script>
