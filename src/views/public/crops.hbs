<!-- Área Principal del Catálogo de Cultivos (/crops) -->
<main class="font-['Geist'] antialiased">
  <section aria-labelledby="catalogo-crops-title" class="bg-background min-h-screen pb-20">
    <div class="mx-auto max-w-7xl px-6 py-10 md:py-14">
    
      <!-- Encabezado de la Sección idéntico al estándar Geist INIFAP -->
      <div class="grid gap-8 border-b border-border pb-10 md:grid-cols-[1.7fr_1fr] md:items-end">
        <div class="flex flex-col gap-3">
          <p class="text-mono-label text-[#1b4332] font-semibold tracking-wider">
            SISTEMA NACIONAL DE CONSULTA FITOSANITARIA · REGISTRO AGRONÓMICO
          </p>
          <h1 id="catalogo-crops-title" class="text-4xl font-headline font-extrabold leading-[1.05] tracking-tight text-foreground md:text-5xl">
            Catálogo de Cultivos
          </h1>
          <p class="max-w-xl text-sm leading-relaxed text-muted-foreground">
            Base de datos científica con registros técnicos optimizados para la agricultura de precisión mexicana. Información agronómica validada por el INIFAP.
          </p>
        </div>

        <!-- Muestra de Métricas Institucionales -->
        <dl class="grid grid-cols-2 divide-x divide-border border border-border rounded-lg bg-card shadow-2xs overflow-hidden">
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-3xl font-medium tabular-nums text-[#1b4332]" id="total-crops-count-header">{{totalCount}}</dd>
            <dt class="text-mono-label text-muted-foreground font-medium">Cultivos documentados</dt>
          </div>
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-3xl font-medium tabular-nums text-[#1b4332]">100%</dd>
            <dt class="text-mono-label text-muted-foreground font-medium">Validación INIFAP</dt>
          </div>
        </dl>
      </div>

      <!-- BARRA PEGAJOSA DE BUSCADOR Y FILTROS CON EFECTO DE FUSIÓN (sticky top-16) -->
      <div class="sticky top-16 z-30 -mx-6 mb-8 border-b border-border bg-background/95 px-6 py-4 backdrop-blur supports-backdrop-filter:bg-background/80 shadow-2xs">
        <form action="/crops" method="GET" id="form-filtros-crops">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
          
            <!-- Campo de Búsqueda -->
            <div class="relative flex-1">
              <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-lg">search</span>
              <input
                id="search-crops-input"
                name="search"
                type="search"
                value="{{search}}"
                placeholder="Buscar cultivo por nombre común, científico, variedad o familia botánica…"
                class="h-10 w-full border border-input bg-card pl-10 pr-4 text-sm rounded-md outline-none transition-all placeholder:text-muted-foreground focus-visible:border-[#1b4332] focus-visible:ring-2 focus-visible:ring-[#1b4332]/20"
              />
            </div>

            <!-- Dropdowns de Filtrado -->
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:w-auto lg:flex">
            
              <!-- Filtro Categoría -->
              <div class="relative lg:w-52">
                <select id="category-crops-filter" name="category" class="h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                  <option value="Categoría">Categoría · Todas</option>
                  <option value="cereal">Cereales</option>
                  <option value="hortaliza">Hortalizas</option>
                  <option value="frutal">Frutales</option>
                  <option value="leguminosa">Leguminosas</option>
                  <option value="oleaginosa">Oleaginosas</option>
                  <option value="tuberculo">Tubérculos</option>
                  <option value="forrajera">Forrajeras</option>
                  <option value="industrial">Industriales</option>
                  <option value="otro">Otros</option>
                </select>
                <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
              </div>

              <button type="submit" class="h-10 bg-[#1b4332] hover:bg-[#1b4332]/90 text-white font-bold text-xs px-6 rounded-md transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                <span class="material-symbols-outlined text-sm">filter_list</span>
                Filtrar
              </button>
            </div>
          </div>

          <!-- Barra de Estado de Filtros -->
          <div class="mt-3 flex items-center justify-between gap-4">
            <p class="text-mono-label flex items-center gap-2 text-muted-foreground font-medium">
              <span id="total-crops-count-number" class="font-mono font-bold text-foreground tabular-nums">{{totalCount}}</span> cultivos registrados
            </p>
            <a href="/crops" class="inline-flex items-center gap-1 text-xs font-semibold text-[#1b4332] hover:underline">
              ✕ Limpiar filtros
            </a>
          </div>
        </form>
      </div>

      <!-- REJILLA DE TARJETAS DE CULTIVO -->
      <section class="w-full">
        {{#if crops.length}}
        <div id="crops-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {{#each crops}}
            <article class="group flex flex-col border border-border bg-card transition-all duration-200 hover:border-[#1b4332]/40 rounded-lg overflow-hidden shadow-2xs hover:shadow-md">
            
              <!-- 1. Barra de Acento Superior -->
              <div class="h-1 w-full bg-[#1b4332]"></div>

              <!-- 2. Marco de Imagen 4:3 con Crédito de Foto Minimalista -->
              <div class="relative aspect-4/3 overflow-hidden bg-muted">
                {{#if image_url}}
                  <img
                    src="{{image_url}}"
                    alt="{{name}}"
                    class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                    onerror="this.onerror=null; this.src='/images/test/default.png';"
                  />
                {{else}}
                  <img src="/images/test/default.png" alt="Sin imagen" class="size-full object-cover" />
                {{/if}}
                <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>
              
                <!-- Badge Categoría (Top-Left) -->
                <div class="absolute left-3 top-3 flex items-center gap-1.5 bg-card/90 px-2.5 py-1 backdrop-blur rounded-md border border-border shadow-2xs">
                  <span aria-hidden="true" class="inline-block size-1.5 rounded-full bg-[#1b4332]"></span>
                  <span class="text-mono-label text-foreground capitalize font-bold">{{category}}</span>
                </div>

                <!-- Crédito de Imagen Minimalista (Bottom-Left) -->
                <span class="absolute left-3 bottom-3 text-mono-label text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
                  FOTO AGRONÓMICA · INIFAP
                </span>
              </div>

              <!-- 3. Contenido de la Tarjeta -->
              <div class="flex flex-1 flex-col gap-3 p-5">
              
                <!-- Taxonomía / Categoría -->
                <p class="text-mono-label text-muted-foreground font-semibold">
                  {{category}} — CULTIVO NACIONAL
                </p>

                <!-- Nombre Común H3 + Nombre Científico -->
                <div class="flex flex-col gap-1">
                  <h3 class="text-lg font-headline font-bold leading-tight tracking-tight text-foreground group-hover:text-[#1b4332] transition-colors">
                    <a href="/crops/{{id}}">{{name}}</a>
                  </h3>
                  {{#if scientificName}}
                    <p class="font-mono text-xs italic text-muted-foreground">{{scientificName}}</p>
                  {{else}}{{#if scientific_name}}
                    <p class="font-mono text-xs italic text-muted-foreground">{{scientific_name}}</p>
                  {{/if}}{{/if}}
                </div>

                <!-- Descripción corta -->
                <p class="line-clamp-3 text-sm leading-relaxed text-muted-foreground">
                  {{#if description}}{{description}}{{else}}Cultivo registrado en la enciclopedia fitosanitaria oficial del INIFAP.{{/if}}
                </p>

                <!-- Pie de Tarjeta -->
                <div class="mt-auto flex items-end justify-between gap-4 border-t border-border pt-4">
                  <div class="flex flex-col gap-0.5">
                    <span class="text-mono-label text-muted-foreground">Estatus registro</span>
                    <span class="text-xs font-semibold text-emerald-800">Validado INIFAP</span>
                  </div>
                  <a href="/crops/{{id}}" class="inline-flex shrink-0 items-center gap-1 text-xs font-bold text-[#1b4332] hover:underline">
                    Ver detalle →
                  </a>
                </div>

              </div>
            </article>
          {{/each}}

          <!-- Card CTA para solicitar registro de nuevo cultivo -->
          <article class="group flex flex-col items-center justify-center p-8 border-2 border-dashed border-border hover:border-[#1b4332]/40 rounded-lg bg-card/60 hover:bg-card transition-all text-center">
            <span class="material-symbols-outlined text-4xl text-[#1b4332]/60 mb-3">add_circle</span>
            <h3 class="text-base font-headline font-bold text-foreground mb-1">¿Nuevo cultivo?</h3>
            <p class="text-xs text-muted-foreground leading-relaxed mb-5 max-w-50">
              Colabora con nuestra red científica reportando un nuevo cultivo documentado.
            </p>
            <a href="/private/crops" class="px-4 py-2 bg-secondary hover:bg-emerald-100 text-[#1b4332] text-xs font-bold rounded-md border border-border transition-colors">
              Solicitar registro
            </a>
          </article>
        </div>

        <!-- Paginación Dinámica -->
        {{#if hasMultiplePages}}
        <div class="mt-12 flex justify-center">
          <nav class="flex items-center gap-2 bg-card border border-border p-1.5 rounded-lg shadow-2xs">
            {{#if hasPrevPage}}
            <a href="/crops?page={{prevPage}}&search={{search}}&category={{selectedCategory}}" class="w-9 h-9 flex items-center justify-center rounded-md hover:bg-secondary text-foreground transition-colors">
              <span class="material-symbols-outlined text-xl">chevron_left</span>
            </a>
            {{else}}
            <button disabled class="w-9 h-9 flex items-center justify-center rounded-md text-muted-foreground opacity-40 cursor-not-allowed">
              <span class="material-symbols-outlined text-xl">chevron_left</span>
            </button>
            {{/if}}

            <span class="px-4 text-xs font-mono font-semibold text-foreground">Página {{currentPage}} de {{totalPages}}</span>

            {{#if hasNextPage}}
            <a href="/crops?page={{nextPage}}&search={{search}}&category={{selectedCategory}}" class="w-9 h-9 flex items-center justify-center rounded-md hover:bg-secondary text-foreground transition-colors">
              <span class="material-symbols-outlined text-xl">chevron_right</span>
            </a>
            {{else}}
            <button disabled class="w-9 h-9 flex items-center justify-center rounded-md text-muted-foreground opacity-40 cursor-not-allowed">
              <span class="material-symbols-outlined text-xl">chevron_right</span>
            </button>
            {{/if}}
          </nav>
        </div>
        {{/if}}

        {{else}}
        <div class="text-center py-20 bg-card border border-border rounded-lg p-8">
          <span class="material-symbols-outlined text-6xl text-muted-foreground/40 mb-4">agriculture</span>
          <h3 class="text-xl font-bold text-foreground mb-2">No se encontraron cultivos</h3>
          <p class="text-sm text-muted-foreground max-w-md mx-auto mb-6">No hay registros agronómicos que coincidan con la búsqueda.</p>
          <a href="/crops" class="px-6 py-3 bg-[#1b4332] text-white font-bold text-xs rounded-md hover:bg-[#1b4332]/90 transition-colors inline-block">Ver todos los cultivos</a>
        </div>
        {{/if}}
      </section>

    </div>
  </section>
</main>