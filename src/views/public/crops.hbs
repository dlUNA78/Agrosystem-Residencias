<main class="pt-32 pb-24">
    <!-- Header Section -->
    <header class="max-w-[1440px] mx-auto px-10 mb-16">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
            <div class="max-w-2xl">
                <span
                    class="inline-block px-3 py-1 mb-4 rounded-full bg-primary-container text-on-primary-container font-label text-xs font-bold tracking-wider uppercase">Catálogo
                    Institucional</span>
                <h1 class="text-5xl md:text-6xl font-headline font-extrabold tracking-tighter text-on-surface mb-4">
                    Catálogo de Cultivos</h1>
                <p class="text-on-surface-variant text-lg font-medium leading-relaxed">
                    Explora nuestra base de datos científica con registros optimizados para la agricultura de precisión
                    mexicana. Respaldado por INIFAP.
                </p>
            </div>
            <div
                class="bg-surface-container rounded-xl p-6 ghost-border flex flex-col items-center justify-center min-w-[200px]">
                <span class="text-4xl font-headline font-extrabold text-primary tracking-tighter">{{totalCount}}</span>
                <span
                    class="text-xs font-label uppercase tracking-widest text-on-surface-variant font-bold mt-1">cultivos
                    documentados</span>
            </div>
        </div>
        <!-- Search & Filters -->
        <form action="/crops" method="GET" class="mt-12 p-2 bg-surface-container-low rounded-2xl ghost-border">
            <div class="flex flex-col lg:flex-row gap-2">
                <div class="flex-1 relative flex items-center">
                    <span class="material-symbols-outlined absolute left-4 text-on-surface-variant">search</span>
                    <input
                        name="search"
                        value="{{search}}"
                        class="w-full bg-surface-container-lowest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-on-surface-variant/60 focus:ring-2 focus:ring-primary/20 transition-all font-body"
                        placeholder="Buscar por nombre, especie o familia..." type="text" />
                </div>
                <div class="flex flex-wrap md:flex-nowrap gap-2">
                    <select
                        name="category"
                        class="bg-surface-container-lowest border-none rounded-xl py-4 px-6 text-sm font-semibold text-on-surface-variant focus:ring-2 focus:ring-primary/20 appearance-none min-w-[140px]">
                        <option value="Categoría">Categoría: Todas</option>
                        <option value="cereal">Cereales</option>
                        <option value="hortaliza">Hortalizas</option>
                        <option value="frutal">Frutales</option>
                        <option value="leguminosa">Leguminosas</option>
                        <option value="oleaginosa">Oleaginosas</option>
                        <option value="tuberculo">Tubérculos</option>
                        <option value="forrajera">Forrajeras</option>
                        <option value="industrial">Industriales</option>
                        <option value="otro">Otros</option>
                    </select>
                    <button
                        type="submit"
                        class="bg-primary text-on-primary px-8 py-4 rounded-xl font-bold text-sm hover:bg-primary-dim transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">filter_list</span>
                        Filtrar Resultados
                    </button>
                </div>
            </div>
        </form>
    </header>

    <!-- Catalog Grid -->
    <section class="max-w-[1440px] mx-auto px-10">
        {{#if crops.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {{#each crops}}
            <article
                class="group bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow ghost-border flex flex-col hover:translate-y-[-4px] transition-all duration-300">
                <div class="relative h-56 overflow-hidden bg-emerald-50">
                    {{#if image_url}}
                    <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        alt="{{name}}"
                        src="/{{image_url}}"
                        onerror="this.onerror=null; this.src='/images/test/default.png';" />
                    {{else}}
                    <img class="w-full h-full object-cover" src="/images/test/default.png" alt="Sin imagen" />
                    {{/if}}
                </div>
                <div class="p-6 flex-1 flex flex-col">
                    <span
                        class="text-[10px] font-label font-bold uppercase tracking-widest text-primary mb-2">{{category}}</span>
                    <h3 class="text-xl font-headline font-bold text-on-surface mb-1 leading-tight">{{name}}</h3>
                    {{#if scientificName}}
                    <p class="text-sm italic text-on-surface-variant mb-4">{{scientificName}}</p>
                    {{/if}}
                    <p class="text-sm text-on-surface-variant line-clamp-2 leading-relaxed mb-6">
                        {{#if description}}{{description}}{{else}}Cultivo registrado en el catálogo institucional del sistema.{{/if}}
                    </p>
                    <div class="mt-auto pt-4 border-t border-surface-container flex justify-between items-center">
                        <a href="/crops/{{id}}" class="text-primary font-bold text-sm flex items-center gap-1 group/btn">
                            Ver detalle
                            <span
                                class="material-symbols-outlined text-sm group-hover/btn:translate-x-1 transition-transform">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </article>
            {{/each}}

            <!-- CTA Card -->
            <article
                class="group bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow ghost-border flex flex-col hover:translate-y-[-4px] transition-all duration-300 border-2 border-dashed border-primary/20 items-center justify-center p-8">
                <div class="text-center">
                    <span class="material-symbols-outlined text-4xl text-primary/40 mb-4">add_circle</span>
                    <h3 class="text-lg font-headline font-bold text-on-surface mb-2">¿Nuevo cultivo?</h3>
                    <p class="text-xs text-on-surface-variant leading-relaxed mb-6">Colabora con nuestra red
                        científica reportando un nuevo cultivo documentado.</p>
                    <a href="/private/crops"
                        class="px-6 py-2 bg-surface-container-high rounded-full text-xs font-bold text-primary uppercase tracking-wider hover:bg-primary-container transition-colors inline-block">Solicitar
                        registro</a>
                </div>
            </article>
        </div>

        <!-- Pagination -->
        {{#if (gt totalPages 1)}}
        <div class="mt-20 flex justify-center">
            <nav class="flex items-center gap-1 bg-surface-container p-1 rounded-xl">
                {{#if (gt currentPage 1)}}
                <a href="/crops?page={{sub currentPage 1}}&search={{search}}&category={{selectedCategory}}"
                    class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-surface-container-highest text-on-surface-variant">
                    <span class="material-symbols-outlined">chevron_left</span>
                </a>
                {{/if}}

                <span class="px-4 text-xs font-bold text-on-surface">Página {{currentPage}} de {{totalPages}}</span>

                {{#if (lt currentPage totalPages)}}
                <a href="/crops?page={{add currentPage 1}}&search={{search}}&category={{selectedCategory}}"
                    class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-surface-container-highest text-on-surface-variant">
                    <span class="material-symbols-outlined">chevron_right</span>
                </a>
                {{/if}}
            </nav>
        </div>
        {{/if}}

        {{else}}
        <div class="text-center py-20 bg-surface-container-lowest rounded-2xl ghost-border p-8">
            <span class="material-symbols-outlined text-6xl text-on-surface-variant/40 mb-4">agriculture</span>
            <h3 class="text-xl font-bold text-on-surface mb-2">No se encontraron cultivos</h3>
            <p class="text-sm text-on-surface-variant max-w-md mx-auto mb-6">No hay registros que coincidan con la búsqueda. Intenta con otros términos o limpia los filtros.</p>
            <a href="/crops" class="px-6 py-3 bg-primary text-on-primary font-bold text-xs rounded-xl hover:bg-primary-dim transition-colors inline-block">Ver todos los cultivos</a>
        </div>
        {{/if}}
    </section>
</main>