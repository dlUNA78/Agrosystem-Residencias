<!-- Área Principal del Catálogo de Cultivos (/crops) -->
<div class="font-['Geist'] antialiased">
  <section aria-labelledby="catalogo-crops-title" class="bg-background min-h-screen pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-12 py-8 md:py-12">

      <!-- Encabezado de la Sección idéntico al estándar Geist INIFAP -->
      <div class="grid gap-8 border-b border-border pb-8 md:grid-cols-[1.7fr_1fr] md:items-end">
        <div class="flex flex-col gap-3">
          <div class="text-mono-label text-emerald-800 font-semibold tracking-wider flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            SISTEMA NACIONAL DE REGISTRO AGRONÓMICO · BASE CIENTÍFICA INIFAP
          </div>
          <h1 id="catalogo-crops-title" class="text-3xl sm:text-4xl md:text-5xl font-headline font-extrabold leading-[1.05] tracking-tight text-foreground">
            Catálogo de Cultivos
          </h1>
          <p class="max-w-xl text-xs sm:text-sm leading-relaxed text-muted-foreground">
            Base de datos científica con fichas técnicas validadas para la agricultura de precisión mexicana. Información agronómica certificada por el INIFAP.
          </p>
        </div>

        <!-- Muestra de Métricas Institucionales -->
        <dl class="grid grid-cols-2 divide-x divide-border border border-border rounded-xl bg-card shadow-xs overflow-hidden">
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-2xl sm:text-3xl font-medium tabular-nums text-[#1b4332]" id="total-crops-count-header">{{totalCount}}</dd>
            <dt class="text-mono-label text-muted-foreground font-medium text-[10px]">Cultivos documentados</dt>
          </div>
          <div class="flex flex-col gap-1 p-4 text-center sm:text-left">
            <dd class="font-mono text-2xl sm:text-3xl font-medium tabular-nums text-[#1b4332]">100%</dd>
            <dt class="text-mono-label text-muted-foreground font-medium text-[10px]">Validación INIFAP</dt>
          </div>
        </dl>
      </div>

      <!-- BARRA PEGAJOSA DE BUSCADOR Y FILTROS CON CHIPS TÁCTILES (Ultra compacta en móvil) -->
      <div class="sticky top-0 md:top-16 z-30 -mx-4 sm:-mx-6 md:-mx-12 mb-6 border-b border-border bg-background/95 px-4 sm:px-6 md:px-12 py-2.5 sm:py-3 backdrop-blur-md shadow-2xs">
        <form action="/crops" method="GET" id="form-filtros-crops">
          <!-- Fila Principal: Buscador + Botón Filtros Móvil + Selectores Desktop -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-2">
            <!-- Fila Buscador Móvil / Desktop -->
            <div class="flex items-center gap-2 w-full sm:flex-1">
              <div class="relative flex-1">
                <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-lg select-none">search</span>
                <input
                  id="search-crops-input"
                  name="search"
                  type="search"
                  value="{{search}}"
                  placeholder="Buscar cultivo por nombre común, científico, variedad o familia…"
                  class="h-9 sm:h-10 w-full border border-input bg-card pl-9 sm:pl-10 pr-9 sm:pr-10 text-xs sm:text-sm rounded-md outline-none transition-all placeholder:text-muted-foreground focus-visible:border-[#1b4332] focus-visible:ring-2 focus-visible:ring-[#1b4332]/20"
                  autocomplete="off"
                />
                <button
                  type="button"
                  id="clear-crops-search-btn"
                  class="{{#unless search}}hidden{{/unless}} absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center rounded-full text-muted-foreground hover:text-foreground hover:bg-secondary cursor-pointer transition-all active:scale-90"
                  title="Limpiar búsqueda"
                  aria-label="Limpiar búsqueda"
                >
                  <span class="material-symbols-outlined text-sm">close</span>
                </button>
              </div>

              <!-- Botón Toggle Filtros en Móvil (< sm) -->
              <button
                type="button"
                id="toggle-crops-filters-btn"
                class="sm:hidden h-9 px-2.5 flex items-center gap-1.5 rounded-md border border-input bg-card text-foreground font-semibold text-xs hover:bg-secondary transition-colors cursor-pointer shrink-0 shadow-2xs"
                aria-expanded="false"
                aria-controls="crops-collapsible-filters"
                title="Mostrar u ocultar filtros avanzados"
              >
                <span class="material-symbols-outlined text-base text-[#1b4332]">tune</span>
                <span class="text-xs">Filtros</span>
                <span id="crops-active-filters-count" class="hidden px-1.5 py-0.2 rounded-full bg-[#1b4332] text-white text-[10px] font-mono font-bold leading-none">0</span>
              </button>
            </div>

            <!-- Selectores y Botón (Desktop: en línea; Móvil: colapsable) -->
            <div id="crops-collapsible-filters" class="hidden sm:flex flex-col sm:flex-row sm:items-center gap-2 w-full sm:w-auto pt-2 sm:pt-0 border-t border-border/50 sm:border-t-0 mt-1 sm:mt-0">
              <!-- Selector de Categoría -->
              <div class="relative w-full sm:w-48 shrink-0">
                <select id="category-crops-filter" name="category" aria-label="Filtrar por categoría" class="h-9 sm:h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-xs sm:text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                  <option value="">Categoría · Todas</option>
                  {{#each categories}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
                <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
              </div>

              <!-- Selector de Temporada -->
              <div class="relative w-full sm:w-48 shrink-0">
                <select id="season-crops-filter" name="season" aria-label="Filtrar por temporada" class="h-9 sm:h-10 w-full appearance-none border border-input bg-card px-3 pr-8 text-xs sm:text-sm rounded-md outline-none transition-colors focus-visible:border-[#1b4332] text-foreground font-medium cursor-pointer">
                  <option value="">Temporada · Todas</option>
                  {{#each seasons}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
                <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">expand_more</span>
              </div>

              <button type="submit" class="h-9 sm:h-10 bg-[#1b4332] hover:bg-[#1b4332]/90 text-white font-bold text-xs px-4 rounded-md transition-colors flex items-center justify-center gap-1.5 cursor-pointer shrink-0">
                <span class="material-symbols-outlined text-sm">filter_list</span>
                <span>Filtrar</span>
              </button>
            </div>
          </div>

          <!-- Filtros Rápidos Táctiles (Chips con Touch-Scroll Móvil) -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 mt-2 pt-2 border-t border-border/40" id="category-chips-container" role="tablist" aria-label="Filtrar por categoría">
            <span class="text-mono-label text-muted-foreground font-bold shrink-0 mr-1 text-[10px]">CATEGORÍA:</span>
            <button
              type="button"
              data-value=""
              class="px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#unless selectedCategory}}bg-[#1b4332] text-white shadow-2xs font-bold{{else}}bg-secondary text-foreground hover:bg-border{{/unless}}"
            >
              Todas
            </button>
            {{#each categories}}
              <button
                type="button"
                data-value="{{value}}"
                class="px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if selected}}bg-[#1b4332] text-white shadow-2xs font-bold{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              >
                {{label}}
              </button>
            {{/each}}
          </div>

          <!-- Fila Temporada (Visible en desktop; colapsable en móvil) -->
          <div id="crops-secondary-chips" class="hidden sm:flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 pt-1.5 border-t border-border/40 mt-1" id="season-chips-container" role="tablist" aria-label="Filtrar por temporada">
            <span class="text-mono-label text-muted-foreground font-bold shrink-0 mr-1 text-[10px]">TEMPORADA:</span>
            <button
              type="button"
              data-value=""
              class="px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#unless selectedSeason}}bg-[#1b4332] text-white shadow-2xs font-bold{{else}}bg-secondary text-foreground hover:bg-border{{/unless}}"
            >
              Todas
            </button>
            {{#each seasons}}
              <button
                type="button"
                data-value="{{value}}"
                class="px-2.5 py-0.5 rounded-md text-xs font-semibold transition-all shrink-0 whitespace-nowrap cursor-pointer active:scale-95 {{#if selected}}bg-[#1b4332] text-white shadow-2xs font-bold{{else}}bg-secondary text-foreground hover:bg-border{{/if}}"
              >
                {{label}}
              </button>
            {{/each}}
          </div>
        </form>
      </div>

      <!-- Barra de Estado de Filtros (Fuera de la barra pegajosa) -->
      <div id="crops-filter-status" class="mb-4 flex items-center justify-between gap-4 px-1">
        <p class="text-mono-label flex items-center gap-2 text-muted-foreground font-medium text-[11px]">
          <span id="total-crops-count-number" class="font-mono font-bold text-foreground tabular-nums">{{totalCount}}</span> cultivos registrados
        </p>
        <a href="/crops" class="inline-flex items-center gap-1 text-xs font-semibold text-[#1b4332] hover:underline">
          ✕ Limpiar filtros
        </a>
      </div>

      <!-- REJILLA DE TARJETAS DE CULTIVO -->
      <section class="w-full">
        {{#if crops.length}}
          <div id="crops-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {{#each crops}}
              <article class="group flex flex-col border border-border bg-card transition-all duration-200 hover:border-[#1b4332]/40 rounded-xl overflow-hidden shadow-2xs hover:shadow-md hover:-translate-y-0.5">
                <!-- Barra de Acento Superior -->
                <div class="h-1.5 w-full bg-[#1b4332]"></div>

                <!-- Marco de Imagen 4:3 con Crédito Minimalista -->
                <div class="relative aspect-4/3 overflow-hidden bg-muted">
                  {{#if image_url}}
                    <img
                      src="{{image_url}}"
                      alt="{{name}}"
                      class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                  {{else}}
                    <img
                      src="/images/test/default.png"
                      alt="Cultivo sin imagen registrada"
                      class="size-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  {{/if}}
                  <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-black/20 pointer-events-none"></div>

                  <!-- Badge Categoría (Top-Left) -->
                  <div class="absolute left-3 top-3 flex items-center gap-1.5 bg-card/90 px-2.5 py-1 backdrop-blur rounded-md border border-border shadow-2xs">
                    <span aria-hidden="true" class="inline-block size-1.5 rounded-full bg-[#1b4332]"></span>
                    <span class="text-mono-label text-foreground capitalize font-bold text-[10px]">{{category}}</span>
                  </div>

                  <!-- Crédito de Imagen Minimalista (Bottom-Left) -->
                  <span class="absolute left-3 bottom-3 text-mono-label text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
                    ACERVO FOTOGRÁFICO · INIFAP
                  </span>
                </div>

                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-1 flex-col gap-3 p-5">
                  <p class="text-mono-label text-muted-foreground font-semibold text-[10px]">
                    {{category}} — CULTIVO NACIONAL
                  </p>

                  <div class="flex flex-col gap-1">
                    <h3 class="text-base sm:text-lg font-headline font-bold leading-tight tracking-tight text-foreground group-hover:text-[#1b4332] transition-colors">
                      <a href="/crops/{{id}}">{{name}}</a>
                    </h3>
                    {{#if scientificName}}
                      <p class="font-mono text-xs italic text-muted-foreground">{{scientificName}}</p>
                    {{/if}}
                  </div>

                  <p class="line-clamp-3 text-xs sm:text-sm leading-relaxed text-muted-foreground">
                    {{#if description}}{{description}}{{else}}Cultivo registrado en el catálogo oficial de INIFAP.{{/if}}
                  </p>

                  <!-- Micro-indicadores agronómicos -->
                  <div class="flex flex-wrap items-center gap-1.5 pt-1">
                    {{#if growthCycle}}
                      <span class="inline-flex items-center gap-1 rounded-md border border-emerald-200/80 bg-emerald-50/70 px-2 py-0.5 text-[10px] font-semibold text-[#1b4332]">
                        <span class="material-symbols-outlined text-xs">schedule</span>
                        {{growthCycle}}
                      </span>
                    {{/if}}
                    {{#if season}}
                      <span class="inline-flex items-center gap-1 rounded-md border border-blue-200/80 bg-blue-50/70 px-2 py-0.5 text-[10px] font-semibold text-blue-800">
                        <span class="material-symbols-outlined text-xs">calendar_month</span>
                        {{season}}
                      </span>
                    {{/if}}
                    {{#if plaguesCount}}
                      <span class="inline-flex items-center gap-1 rounded-md border border-rose-200/80 bg-rose-50/70 px-2 py-0.5 text-[10px] font-semibold text-rose-800">
                        <span class="material-symbols-outlined text-xs">bug_report</span>
                        {{plaguesCount}} plagas
                      </span>
                    {{/if}}
                  </div>

                  <!-- Pie de Tarjeta -->
                  <div class="mt-auto flex items-end justify-between gap-4 border-t border-border pt-4">
                    <div class="flex flex-col gap-0.5">
                      <span class="text-mono-label text-muted-foreground text-[10px]">Estatus normativo</span>
                      <span class="text-xs font-semibold text-emerald-800">Validado INIFAP</span>
                    </div>
                    <a href="/crops/{{id}}" class="inline-flex shrink-0 items-center gap-1 text-xs font-bold text-[#1b4332] hover:underline">
                      Ver detalle →
                    </a>
                  </div>
                </div>
              </article>
            {{/each}}

            <!-- Card CTA para solicitar registro de nuevo cultivo -->
            <article class="group flex flex-col items-center justify-center p-8 border-2 border-dashed border-border hover:border-[#1b4332]/40 rounded-xl bg-card/60 hover:bg-card transition-all text-center">
              <span class="material-symbols-outlined text-4xl text-[#1b4332]/60 mb-3">add_circle</span>
              <h3 class="text-base font-headline font-bold text-foreground mb-1">¿Nuevo cultivo?</h3>
              <p class="text-xs text-muted-foreground leading-relaxed mb-5 max-w-50">
                Colabora con nuestra red científica proponiendo la incorporación de nuevos cultivos y variedades para validación del INIFAP.
              </p>
              {{#if user}}
                <button
                  type="button"
                  data-open-suggestion-modal
                  class="px-4 py-2 bg-[#1b4332] hover:bg-[#2d6a4f] text-white text-xs font-bold rounded-md transition-colors cursor-pointer"
                >
                  Sugerir nuevo cultivo
                </button>
              {{else}}
                <a href="/auth/login" class="px-4 py-2 bg-secondary hover:bg-emerald-100 text-[#1b4332] text-xs font-bold rounded-md border border-border transition-colors">
                  Inicia sesión para colaborar
                </a>
              {{/if}}
            </article>
          </div>
        {{else}}
          <div id="crops-grid">
            <div class="col-span-full text-center py-16 bg-card border border-border rounded-xl p-8 shadow-2xs">
              <span class="material-symbols-outlined text-6xl text-muted-foreground/40 mb-3">agriculture</span>
              <h3 class="text-xl font-bold text-foreground mb-1">No se encontraron cultivos</h3>
              <p class="text-sm text-muted-foreground max-w-md mx-auto mb-6">
                {{#if search}}No hay resultados para "{{search}}". Intenta con otro término o limpia los filtros.{{else}}No hay registros agronómicos disponibles para el filtro seleccionado.{{/if}}
              </p>
              <a href="/crops" class="px-5 py-2.5 bg-[#1b4332] text-white font-bold text-xs rounded-lg hover:bg-[#2d6a4f] transition-colors inline-block shadow-2xs">
                Ver todos los cultivos
              </a>
            </div>
          </div>
        {{/if}}

        <!-- Banner de confirmación de sugerencia ciudadana -->
        <div id="suggestion-success-banner" class="hidden mt-6 items-center justify-between gap-3 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-950">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-700 text-base">verified</span>
            <span>¡Gracias por tu aportación agronómica! Tu propuesta de cultivo fue enviada a la bandeja de validación técnica del INIFAP.</span>
          </div>
        </div>

        <!-- Paginación Dinámica Interactiva -->
        <div class="mt-12 flex justify-center" id="crops-pagination-container">
          {{#if hasMultiplePages}}
            <nav class="flex items-center gap-2 bg-card border border-border p-1.5 rounded-xl shadow-2xs" aria-label="Navegación de páginas">
              {{#if hasPrevPage}}
                <button
                  type="button"
                  data-page="{{prevPage}}"
                  class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-secondary text-foreground transition-colors cursor-pointer"
                  aria-label="Página anterior"
                >
                  <span class="material-symbols-outlined text-xl">chevron_left</span>
                </button>
              {{else}}
                <button
                  type="button"
                  disabled
                  class="w-9 h-9 flex items-center justify-center rounded-lg text-muted-foreground opacity-40 cursor-not-allowed pointer-events-none"
                  aria-label="Página anterior"
                >
                  <span class="material-symbols-outlined text-xl">chevron_left</span>
                </button>
              {{/if}}

              <span class="px-4 text-xs font-mono font-semibold text-foreground">
                Página {{currentPage}} de {{totalPages}}
              </span>

              {{#if hasNextPage}}
                <button
                  type="button"
                  data-page="{{nextPage}}"
                  class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-secondary text-foreground transition-colors cursor-pointer"
                  aria-label="Página siguiente"
                >
                  <span class="material-symbols-outlined text-xl">chevron_right</span>
                </button>
              {{else}}
                <button
                  type="button"
                  disabled
                  class="w-9 h-9 flex items-center justify-center rounded-lg text-muted-foreground opacity-40 cursor-not-allowed pointer-events-none"
                  aria-label="Página siguiente"
                >
                  <span class="material-symbols-outlined text-xl">chevron_right</span>
                </button>
              {{/if}}
            </nav>
          {{/if}}
        </div>
      </section>

    </div>
  </section>
</div>

{{#if user}}
  <!-- Modal: Sugerir Nuevo Cultivo (Colaboración Ciudadana / Científica) -->
  <div id="modal-catalog-suggestion" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-xs" role="dialog" aria-modal="true" aria-labelledby="modal-suggest-crop-title">
    <div class="w-full max-w-lg rounded-2xl border border-border bg-card shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between border-b border-border px-6 py-4 bg-muted/30">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#e6f0e6] text-[#1b4332]">
            <span class="material-symbols-outlined text-lg">psychiatry</span>
          </span>
          <div>
            <h3 id="modal-suggest-crop-title" class="text-sm font-headline font-extrabold text-foreground">
              Sugerir Incorporación de Cultivo o Variedad
            </h3>
            <p class="text-[11px] text-muted-foreground">Se enviará a la bandeja de validación del comité técnico INIFAP</p>
          </div>
        </div>
        <button type="button" data-close-suggestion-modal class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted cursor-pointer" aria-label="Cerrar modal">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <form action="/suggestions/crops" method="POST" class="p-6 space-y-4 overflow-y-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="suggest-crop-name" class="block text-xs font-bold text-foreground mb-1">Nombre común / Variedad <span class="text-red-600">*</span></label>
            <input type="text" id="suggest-crop-name" name="name" required minlength="2" maxlength="140" placeholder="Ej. Chile Habanero Jaguar" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]" />
          </div>
          <div>
            <label for="suggest-crop-sci" class="block text-xs font-bold text-foreground mb-1">Nombre científico <span class="text-red-600">*</span></label>
            <input type="text" id="suggest-crop-sci" name="scientific_name" required minlength="3" maxlength="160" placeholder="Ej. Capsicum chinense Jacq." class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs italic outline-none focus:border-[#1b4332]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label for="suggest-crop-cat" class="block text-xs font-bold text-foreground mb-1">Grupo / Categoría</label>
            <select id="suggest-crop-cat" name="category" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]">
              <option value="Hortalizas">Hortalizas</option>
              <option value="Cereales">Cereales</option>
              <option value="Frutales">Frutales</option>
              <option value="Leguminosas">Leguminosas</option>
              <option value="Industriales">Industriales</option>
            </select>
          </div>
          <div>
            <label for="suggest-crop-family" class="block text-xs font-bold text-foreground mb-1">Familia botánica</label>
            <input type="text" id="suggest-crop-family" name="botanical_family" maxlength="100" placeholder="Ej. Solanaceae, Poaceae" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]" />
          </div>
          <div>
            <label for="suggest-crop-season" class="block text-xs font-bold text-foreground mb-1">Ciclo / Temporada</label>
            <select id="suggest-crop-season" name="planting_season" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]">
              <option value="Primavera-Verano">Primavera-Verano</option>
              <option value="Otoño-Invierno">Otoño-Invierno</option>
              <option value="Todo el año">Perenne / Todo el año</option>
            </select>
          </div>
        </div>

        <div>
          <label for="suggest-crop-state" class="block text-xs font-bold text-foreground mb-1">Estados o regiones productoras principales</label>
          <input type="text" id="suggest-crop-state" name="state" maxlength="120" placeholder="Ej. Yucatán, Sinaloa, Guanajuato" class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]" />
        </div>

        <div>
          <label for="suggest-crop-desc" class="block text-xs font-bold text-foreground mb-1">Descripción agronómica y relevancia <span class="text-red-600">*</span></label>
          <textarea id="suggest-crop-desc" name="description" required minlength="10" maxlength="1200" rows="3" placeholder="Características agronómicas, adaptación climática y observaciones técnicas..." class="w-full rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none focus:border-[#1b4332]"></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-border">
          <button type="button" data-close-suggestion-modal class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-foreground hover:bg-muted cursor-pointer">Cancelar</button>
          <button type="submit" data-loading-text="Enviando propuesta..." class="rounded-xl bg-[#1b4332] px-5 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f] cursor-pointer">Enviar a validación INIFAP</button>
        </div>
      </form>
    </div>
  </div>
{{/if}}
