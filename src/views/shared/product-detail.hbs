<div class="pt-24 px-4 md:px-10 pb-12 min-h-screen font-['Geist'] antialiased">

  {{! ── BREADCRUMB & HEADER ────────────────────────────────────────────────── }}
  <div class="mb-8 max-w-7xl mx-auto">
    <nav aria-label="Breadcrumb" class="flex mb-4">
      <ol class="inline-flex items-center space-x-1 md:space-x-3 text-xs font-mono tracking-widest uppercase text-muted-foreground">
        <li class="inline-flex items-center">
          {{#if isPrivate}}
            <a class="hover:text-[#1b4332] transition-colors" href="/dashboard">Dashboard</a>
          {{else}}
            <a class="hover:text-[#1b4332] transition-colors" href="/">Inicio</a>
          {{/if}}
        </li>
        <li>
          <div class="flex items-center">
            <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
            {{#if isPrivate}}
              <a class="hover:text-[#1b4332] transition-colors" href="/private/products">Productos</a>
            {{else}}
              <a class="hover:text-[#1b4332] transition-colors" href="/products">Productos</a>
            {{/if}}
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
            <span class="text-[#1b4332] font-bold">{{product.name}}</span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <span class="px-3 py-1 bg-[#1b4332]/10 text-[#1b4332] text-xs font-mono font-bold uppercase rounded-md flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">science</span> {{#if product.category}}{{product.category}}{{else}}Fitosanitario{{/if}}
          </span>
          {{#if product.validation_status}}
            <span class="px-3 py-1 bg-emerald-500/10 text-emerald-800 text-xs font-mono font-bold uppercase rounded-md flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">verified</span> {{product.validation_status}}
            </span>
          {{/if}}
        </div>
        <h1 class="text-4xl md:text-5xl font-headline font-extrabold text-foreground tracking-tight mb-1">
          {{product.name}}
        </h1>
        <p class="text-base text-muted-foreground font-medium">
          Ingrediente Activo: <span class="font-mono font-bold text-[#1b4332]">{{product.active_ingredient}}</span> — <span class="font-bold text-foreground">{{product.manufacturer}}</span>
        </p>
      </div>

      {{#if isPrivate}}
        <div class="flex items-center gap-3">
          <a href="/private/products/update/{{product.id}}" class="px-4 py-2 bg-card border border-border text-foreground font-bold text-xs rounded-md hover:bg-secondary transition-colors shadow-2xs flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">edit</span> Editar Producto
          </a>
        </div>
      {{/if}}
    </div>
  </div>

  {{! ── HERO & TARJETA PRINCIPAL ────────────────────────────────────────────── }}
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 mb-14">
    {{! Imagen del Producto }}
    <div class="col-span-1 lg:col-span-5">
      <div class="relative overflow-hidden rounded-lg bg-card border border-border shadow-2xs aspect-[4/3] group">
        {{#if product.image_url}}
          <img class="w-full h-full object-contain p-6 transition-transform duration-500 group-hover:scale-105"
               src="{{product.image_url}}"
               alt="{{product.name}}"
               onerror="this.onerror=null; this.src='/images/test/default.png';" />
        {{else}}
          <div class="w-full h-full flex flex-col items-center justify-center bg-muted text-muted-foreground p-8 text-center">
            <span class="material-symbols-outlined text-6xl mb-2">science</span>
            <p class="text-xs font-bold">Imagen de producto no disponible</p>
          </div>
        {{/if}}
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>

        <!-- Tag de Registro Oficial Top-Left -->
        <div class="absolute top-3 left-3">
          <span class="px-2.5 py-1 bg-card/90 backdrop-blur border border-border text-foreground text-[10px] font-mono font-bold uppercase rounded-md shadow-2xs">
            REG: {{#if product.registration_code}}{{product.registration_code}}{{else}}CICOPLAFEST / INIFAP{{/if}}
          </span>
        </div>

        <!-- Crédito Fotográfico Minimalista Bottom-Left -->
        <span class="absolute left-3 bottom-3 text-mono-label text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
          ACERVO FOTO · INIFAP
        </span>
      </div>
    </div>

    {{! Resumen y Banda Toxicológica }}
    <div class="col-span-1 lg:col-span-7 flex flex-col justify-between gap-6">
      <div class="bg-card p-6 md:p-8 rounded-lg border border-border shadow-2xs flex-1 flex flex-col justify-between">
        <div>
          <span class="text-mono-label text-muted-foreground font-semibold block mb-2">DESCRIPCIÓN GENERAL DEL AGROQUÍMICO</span>
          <p class="text-foreground leading-relaxed text-sm mb-6">
            {{#if product.description}}{{product.description}}{{else}}Producto fitosanitario registrado en la plataforma institucional del INIFAP para el control agronómico.{{/if}}
          </p>
        </div>

        {{! Banda de Clasificación Toxicológica }}
        <div class="p-5 rounded-lg border border-border bg-secondary/50">
          <span class="text-mono-label text-muted-foreground block mb-2">CLASIFICACIÓN DE TOXICOLOGÍA (NOM)</span>
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-2xl text-amber-600">warning</span>
            <div>
              <p class="text-sm font-headline font-bold text-foreground">
                {{#if product.hazard_category}}{{product.hazard_category}}{{else}}Categoría III — Ligeramente Peligroso (Banda Azul){{/if}}
              </p>
              <p class="text-xs text-muted-foreground">Norma Oficial Mexicana de Manejo Seguro de Agroquímicos</p>
            </div>
          </div>
        </div>
      </div>

      {{#if product.safety_sheet_url}}
        <a href="{{product.safety_sheet_url}}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 p-3.5 bg-secondary hover:bg-emerald-100 text-[#1b4332] font-bold text-xs rounded-md transition-colors border border-border shadow-2xs">
          <span class="material-symbols-outlined text-base">picture_as_pdf</span> Descargar Ficha Técnica / Hoja de Seguridad (PDF)
        </a>
      {{/if}}
    </div>
  </div>

  {{! ── FICHA TÉCNICA (4 TARJETAS TÉCNICAS) ────────────────────────────────── }}
  <div class="mb-14 max-w-7xl mx-auto">
    <h2 class="text-2xl font-headline font-extrabold text-foreground tracking-tight mb-6">Ficha Técnica Fitosanitaria</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-card p-5 rounded-lg border border-border shadow-2xs">
        <span class="material-symbols-outlined text-[#1b4332] mb-2">bolt</span>
        <span class="text-mono-label text-muted-foreground block mb-1">Mecanismo de Acción</span>
        <p class="text-sm font-headline font-bold text-foreground">
          {{#if product.mode_of_action}}{{product.mode_of_action}}{{else}}Sistémico y de contacto{{/if}}
        </p>
      </div>

      <div class="bg-card p-5 rounded-lg border border-border shadow-2xs">
        <span class="material-symbols-outlined text-emerald-600 mb-2">view_in_ar</span>
        <span class="text-mono-label text-muted-foreground block mb-1">Formulación</span>
        <p class="text-sm font-headline font-bold text-foreground">
          {{#if product.formulation_type}}{{product.formulation_type}}{{else}}Suspensión Concentrada (SC){{/if}}
        </p>
      </div>

      <div class="bg-card p-5 rounded-lg border border-border shadow-2xs">
        <span class="material-symbols-outlined text-blue-600 mb-2">vaccines</span>
        <span class="text-mono-label text-muted-foreground block mb-1">Dosis Sugerida</span>
        <p class="text-sm font-headline font-bold text-foreground font-mono">
          {{#if product.suggested_dosage}}{{product.suggested_dosage}}{{else}}350 - 500 ml / ha{{/if}}
        </p>
      </div>

      <div class="bg-card p-5 rounded-lg border border-border shadow-2xs">
        <span class="material-symbols-outlined text-amber-600 mb-2">event_busy</span>
        <span class="text-mono-label text-muted-foreground block mb-1">Periodo de Carencia</span>
        <p class="text-sm font-headline font-bold text-foreground font-mono">
          {{#if product.safety_interval_days}}{{product.safety_interval_days}} días a cosecha{{else}}14 días pre-cosecha{{/if}}
        </p>
      </div>
    </div>
  </div>

  {{! ── ASOCIACIONES (PLAGAS Y CULTIVOS) ─────────────────────────────────── }}
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 mb-14">
    {{! 🐛 PLAGAS COMBATIDAS }}
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl font-headline font-extrabold text-foreground flex items-center gap-2">
          <span class="material-symbols-outlined text-rose-600">pest_control</span> Plagas Objetivo Combatidas
        </h3>
        {{#if product.plagues}}
          <span class="px-3 py-1 bg-rose-500/10 text-rose-700 text-xs font-mono font-bold rounded-md">
            {{product.plagues.length}} Registradas
          </span>
        {{/if}}
      </div>

      {{#if product.plagues.length}}
        <div class="space-y-3">
          {{#each product.plagues}}
            <div class="bg-card p-5 rounded-lg border border-border hover:border-[#1b4332]/40 transition-all flex items-center justify-between shadow-2xs">
              <div>
                <h4 class="text-base font-headline font-bold text-foreground">{{this.name}}</h4>
                <p class="font-mono text-xs italic text-muted-foreground">{{this.scientific_name}}</p>
              </div>
              <a href="/plagues/{{this.id}}" class="px-3.5 py-1.5 bg-secondary hover:bg-emerald-100 text-[#1b4332] font-bold text-xs rounded-md transition-colors flex items-center gap-1 border border-border">
                Ver Plaga <span class="material-symbols-outlined text-xs">arrow_forward</span>
              </a>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="p-8 bg-card rounded-lg border border-border text-center shadow-2xs">
          <span class="material-symbols-outlined text-4xl text-muted-foreground/40 mb-2">pest_control_rodent</span>
          <p class="text-sm font-bold text-foreground mb-1">Sin Plagas Específicas Vinculadas</p>
          <p class="text-xs text-muted-foreground">Consulte la etiqueta del fabricante para ver el catálogo ampliado de plagas blanco.</p>
        </div>
      {{/if}}
    </div>

    {{! 🌾 CULTIVOS AUTORIZADOS }}
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl font-headline font-extrabold text-foreground flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-600">eco</span> Cultivos Autorizados
        </h3>
        {{#if product.crops}}
          <span class="px-3 py-1 bg-emerald-500/10 text-emerald-800 text-xs font-mono font-bold rounded-md">
            {{product.crops.length}} Cultivos
          </span>
        {{/if}}
      </div>

      {{#if product.crops.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each product.crops}}
            <div class="bg-card p-5 rounded-lg border border-border hover:border-[#1b4332]/40 transition-all flex flex-col justify-between shadow-2xs">
              <div>
                <span class="text-mono-label text-[#1b4332] block mb-1 capitalize">{{this.category}}</span>
                <h4 class="text-base font-headline font-bold text-foreground mb-1">{{this.name}}</h4>
                {{#if this.scientific_name}}
                  <p class="font-mono text-xs italic text-muted-foreground mb-3">{{this.scientific_name}}</p>
                {{/if}}
              </div>
              <a href="/crops/{{this.id}}" class="inline-flex items-center justify-center gap-1 w-full py-2 bg-secondary hover:bg-emerald-100 text-[#1b4332] font-bold text-xs rounded-md transition-colors border border-border">
                Ver Cultivo <span class="material-symbols-outlined text-xs">arrow_forward</span>
              </a>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="p-8 bg-card rounded-lg border border-border text-center shadow-2xs">
          <span class="material-symbols-outlined text-4xl text-muted-foreground/40 mb-2">agriculture</span>
          <p class="text-sm font-bold text-foreground mb-1">Sin Cultivos Específicos Vinculados</p>
          <p class="text-xs text-muted-foreground">Este insumo puede aplicarse a los cultivos declarados en el registro oficial CICOPLAFEST.</p>
        </div>
      {{/if}}
    </div>
  </div>
</div>
