<div class="max-w-[1440px] mx-auto px-6 md:px-10 pt-28 pb-20">
  {{! ── BREADCRUMB & HEADER ────────────────────────────────────────────────── }}
  <div class="mb-8">
    <nav aria-label="Breadcrumb" class="flex mb-4">
      <ol class="inline-flex items-center space-x-1 md:space-x-3 text-xs font-medium tracking-widest uppercase text-on-surface-variant">
        <li class="inline-flex items-center">
          {{#if isPrivate}}
            <a class="hover:text-primary transition-colors" href="/dashboard">Dashboard</a>
          {{else}}
            <a class="hover:text-primary transition-colors" href="/">Inicio</a>
          {{/if}}
        </li>
        <li>
          <div class="flex items-center">
            <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
            {{#if isPrivate}}
              <a class="hover:text-primary transition-colors" href="/private/products">Productos</a>
            {{else}}
              <a class="hover:text-primary transition-colors" href="/products">Productos</a>
            {{/if}}
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
            <span class="text-primary font-bold">{{product.name}}</span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider rounded-full flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">science</span> {{product.category}}
          </span>
          {{#if product.validation_status}}
            <span class="px-3 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider rounded-full flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">verified</span> {{product.validation_status}}
            </span>
          {{/if}}
        </div>
        <h1 class="text-4xl md:text-5xl font-headline font-extrabold text-on-surface tracking-tighter mb-1">
          {{product.name}}
        </h1>
        <p class="text-lg text-on-surface-variant font-medium">
          {{product.active_ingredient}} — <span class="font-bold text-on-surface">{{product.manufacturer}}</span>
        </p>
      </div>

      {{#if isPrivate}}
        <div class="flex items-center gap-3">
          <a href="/private/products/update/{{product.id}}" class="px-5 py-2.5 bg-surface-container-high text-on-surface hover:bg-surface-container-highest font-bold text-xs rounded-xl transition-all flex items-center gap-2 shadow-xs">
            <span class="material-symbols-outlined text-sm">edit</span> Editar Producto
          </a>
        </div>
      {{/if}}
    </div>
  </div>

  {{! ── HERO & TARJETA PRINCIPAL ────────────────────────────────────────────── }}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
    {{! Imagen del Producto }}
    <div class="col-span-1 lg:col-span-5">
      <div class="relative overflow-hidden rounded-2xl bg-surface-container-low border border-outline-variant/10 shadow-sm aspect-4/3 group">
        {{#if product.image_url}}
          <img class="w-full h-full object-contain p-6 transition-transform duration-500 group-hover:scale-105"
               src="{{product.image_url}}"
               alt="{{product.name}}"
               onerror="this.onerror=null; this.src='/images/test/default.png';" />
        {{else}}
          <div class="w-full h-full flex flex-col items-center justify-center bg-surface-container-highest text-on-surface-variant p-8 text-center">
            <span class="material-symbols-outlined text-6xl mb-2">science</span>
            <p class="text-xs font-bold">Imagen de producto no disponible</p>
          </div>
        {{/if}}

        <div class="absolute top-4 left-4">
          <span class="px-3 py-1 bg-black/50 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-widest rounded-lg">
            Reg: {{#if product.registration_code}}{{product.registration_code}}{{else}}CICOPLAFEST{{/if}}
          </span>
        </div>
      </div>
    </div>

    {{! Resumen y Banda Toxicológica }}
    <div class="col-span-1 lg:col-span-7 flex flex-col justify-between gap-6">
      <div class="bg-surface-container-low p-6 md:p-8 rounded-2xl border border-outline-variant/10 shadow-sm flex-1 flex flex-col justify-between">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-on-surface-variant mb-2">Descripción General</h2>
          <p class="text-on-surface leading-relaxed text-base mb-6">
            {{#if product.description}}{{product.description}}{{else}}Producto fitosanitario registrado en la plataforma institucional del INIFAP para el control agronómico.{{/if}}
          </p>
        </div>

        {{! Banda de Clasificación Toxicológica }}
        <div class="p-5 rounded-xl border border-outline-variant/15 bg-surface-container">
          <span class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant block mb-2">Clasificación de Toxicología</span>
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-2xl text-amber-500">warning</span>
            <div>
              <p class="text-sm font-headline font-bold text-on-surface">
                {{#if product.hazard_category}}{{product.hazard_category}}{{else}}Categoría III — Ligeramente Peligroso (Banda Azul){{/if}}
              </p>
              <p class="text-xs text-on-surface-variant">Norma Oficial Mexicana de Manejo Seguro de Agroquímicos</p>
            </div>
          </div>
        </div>
      </div>

      {{#if product.safety_sheet_url}}
        <a href="{{product.safety_sheet_url}}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 p-4 bg-primary/10 hover:bg-primary/20 text-primary font-bold text-sm rounded-2xl transition-colors border border-primary/20">
          <span class="material-symbols-outlined">picture_as_pdf</span> Descargar Ficha Técnica / Hoja de Seguridad
        </a>
      {{/if}}
    </div>
  </div>

  {{! ── FICHA TÉCNICA (4 TARJETAS TÉCNICAS) ────────────────────────────────── }}
  <div class="mb-16">
    <h2 class="text-2xl font-headline font-extrabold text-on-surface tracking-tight mb-6">Ficha Técnica Fitosanitaria</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-surface-container-low p-6 rounded-2xl border border-outline-variant/10">
        <span class="material-symbols-outlined text-primary mb-2">bolt</span>
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Mecanismo de Acción</h3>
        <p class="text-sm font-headline font-bold text-on-surface">
          {{#if product.mode_of_action}}{{product.mode_of_action}}{{else}}Sistémico y de contacto{{/if}}
        </p>
      </div>

      <div class="bg-surface-container-low p-6 rounded-2xl border border-outline-variant/10">
        <span class="material-symbols-outlined text-emerald-500 mb-2">view_in_ar</span>
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Formulación</h3>
        <p class="text-sm font-headline font-bold text-on-surface">
          {{#if product.formulation_type}}{{product.formulation_type}}{{else}}Suspensión Concentrada (SC){{/if}}
        </p>
      </div>

      <div class="bg-surface-container-low p-6 rounded-2xl border border-outline-variant/10">
        <span class="material-symbols-outlined text-blue-500 mb-2">vaccines</span>
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Dosis Sugerida</h3>
        <p class="text-sm font-headline font-bold text-on-surface">
          {{#if product.suggested_dosage}}{{product.suggested_dosage}}{{else}}350 - 500 ml / ha{{/if}}
        </p>
      </div>

      <div class="bg-surface-container-low p-6 rounded-2xl border border-outline-variant/10">
        <span class="material-symbols-outlined text-amber-500 mb-2">event_busy</span>
        <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Periodo de Carencia</h3>
        <p class="text-sm font-headline font-bold text-on-surface">
          {{#if product.safety_interval_days}}{{product.safety_interval_days}} días a cosecha{{else}}14 días pre-cosecha{{/if}}
        </p>
      </div>
    </div>
  </div>

  {{! ── ASOCIACIONES (PLAGAS Y CULTIVOS) ─────────────────────────────────── }}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
    {{! 🐛 PLAGAS COMBATIDAS }}
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl font-headline font-extrabold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-rose-500">pest_control</span> Plagas Objetivo Combatidas
        </h3>
        {{#if product.plagues}}
          <span class="px-3 py-1 bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-bold rounded-full">
            {{product.plagues.length}} Registradas
          </span>
        {{/if}}
      </div>

      {{#if product.plagues.length}}
        <div class="space-y-4">
          {{#each product.plagues}}
            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/10 hover:shadow-md transition-all flex items-center justify-between">
              <div>
                <h4 class="text-base font-headline font-bold text-on-surface">{{this.name}}</h4>
                <p class="text-xs italic text-on-surface-variant">{{this.scientific_name}}</p>
              </div>
              <a href="/plagues/{{this.id}}" class="px-4 py-2 bg-surface-container hover:bg-surface-container-highest text-on-surface font-bold text-xs rounded-xl transition-colors flex items-center gap-1">
                Ver Plaga <span class="material-symbols-outlined text-xs">arrow_forward</span>
              </a>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="p-8 bg-surface-container-low rounded-2xl border border-outline-variant/10 text-center">
          <span class="material-symbols-outlined text-4xl text-on-surface-variant/40 mb-2">pest_control_rodent</span>
          <p class="text-sm font-bold text-on-surface mb-1">Sin Plagas Específicas Vinculadas</p>
          <p class="text-xs text-on-surface-variant">Consulte la etiqueta del fabricante para ver el catálogo ampliado de plagas blanco.</p>
        </div>
      {{/if}}
    </div>

    {{! 🌾 CULTIVOS AUTORIZADOS }}
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl font-headline font-extrabold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-emerald-500">eco</span> Cultivos Autorizados
        </h3>
        {{#if product.crops}}
          <span class="px-3 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold rounded-full">
            {{product.crops.length}} Cultivos
          </span>
        {{/if}}
      </div>

      {{#if product.crops.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {{#each product.crops}}
            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/10 hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <span class="text-[10px] uppercase font-bold text-primary block mb-1">{{this.category}}</span>
                <h4 class="text-base font-headline font-bold text-on-surface mb-1">{{this.name}}</h4>
                {{#if this.scientific_name}}
                  <p class="text-xs italic text-on-surface-variant mb-3">{{this.scientific_name}}</p>
                {{/if}}
              </div>
              <a href="/crops/{{this.id}}" class="inline-flex items-center justify-center gap-1 w-full py-2 bg-surface-container hover:bg-surface-container-highest text-on-surface font-bold text-xs rounded-xl transition-colors">
                Ver Cultivo <span class="material-symbols-outlined text-xs">arrow_forward</span>
              </a>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="p-8 bg-surface-container-low rounded-2xl border border-outline-variant/10 text-center">
          <span class="material-symbols-outlined text-4xl text-on-surface-variant/40 mb-2">agriculture</span>
          <p class="text-sm font-bold text-on-surface mb-1">Sin Cultivos Específicos Vinculados</p>
          <p class="text-xs text-on-surface-variant">Este insumo puede aplicarse a los cultivos declarados en el registro oficial CICOPLAFEST.</p>
        </div>
      {{/if}}
    </div>
  </div>
</div>
