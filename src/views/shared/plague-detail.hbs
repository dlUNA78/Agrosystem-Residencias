<div class="min-h-screen bg-[#f8faf9] font-['Geist'] text-foreground antialiased pb-20">

  {{! ── SUB-NAVBAR DE PESTAÑAS SECUNDARIAS (STICKY WITH BACKDROP BLUR) ─────── }}
  <div class="sticky top-16 z-40 bg-white/90 backdrop-blur-md supports-backdrop-filter:bg-white/90 border-b border-border shadow-2xs py-1.5 transition-all">
    <div class="max-w-7xl mx-auto px-4 md:px-10 flex items-center gap-1 md:gap-4 overflow-x-auto scrollbar-none">
      <a href="#resumen" class="nav-tab-link px-4 py-2 text-xs font-semibold text-[#1b4332] border-b-2 border-[#1b4332] whitespace-nowrap transition-all">
        Resumen
      </a>
      <a href="#ciclo-biologico" class="nav-tab-link px-4 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground border-b-2 border-transparent hover:border-border whitespace-nowrap transition-all">
        Ciclo biológico
      </a>
      <a href="#distribucion" class="nav-tab-link px-4 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground border-b-2 border-transparent hover:border-border whitespace-nowrap transition-all">
        Distribución
      </a>
      <a href="#manejo-integrado" class="nav-tab-link px-4 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground border-b-2 border-transparent hover:border-border whitespace-nowrap transition-all">
        Manejo integrado
      </a>
      <a href="#danos" class="nav-tab-link px-4 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground border-b-2 border-transparent hover:border-border whitespace-nowrap transition-all">
        Daños
      </a>
      <a href="#productos" class="nav-tab-link px-4 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground border-b-2 border-transparent hover:border-border whitespace-nowrap transition-all">
        Productos
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-10 pt-6">

    {{! ── BREADCRUMBS & LINK DE REGRESO ────────────────────────────────────── }}
    <div class="mb-4">
      <nav aria-label="Breadcrumb" class="flex mb-2">
        <ol class="inline-flex items-center space-x-1.5 text-xs text-muted-foreground">
          <li>
            <a class="hover:text-[#1b4332] transition-colors" href="/">Inicio</a>
          </li>
          <li>
            <div class="flex items-center">
              <span class="material-symbols-outlined text-xs mx-1">chevron_right</span>
              <a class="hover:text-[#1b4332] transition-colors" href="/plagues">Catálogo de Plagas</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <span class="material-symbols-outlined text-xs mx-1">chevron_right</span>
              <span class="text-foreground font-semibold">{{plague.name}}</span>
            </div>
          </li>
        </ol>
      </nav>

      <a href="/plagues" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-[#1b4332] transition-colors">
        <span class="material-symbols-outlined text-sm">arrow_back</span> Volver al catálogo
      </a>
    </div>

    {{! ── HERO SECTION (2 COLUMNAS) ────────────────────────────────────────── }}
    <div id="resumen" class="scroll-mt-32 mb-6 bg-white border border-border rounded-xl p-6 md:p-8 shadow-2xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        {{! Columna Izquierda: Vista Previa Fotográfica }}
        <div class="col-span-1 lg:col-span-6">
          <div class="relative overflow-hidden rounded-lg bg-muted border border-border h-[320px] md:h-[350px] group" id="hero-carousel">
            <div class="flex h-full transition-transform duration-700 ease-in-out" id="hero-slides">
              {{#if plague.image_url}}
                <div class="flex-none w-full h-full relative" style="min-width:100%">
                  <img class="w-full h-full object-cover" src="{{plague.image_url}}" alt="{{plague.name}}" onerror="this.onerror=null; this.src='/images/test/default.png';" />
                  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
                  
                  <span class="absolute left-3 bottom-3 text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
                    ACERVO FOTOGRÁFICO INIFAP
                  </span>
                </div>
              {{/if}}
              {{#each carouselImages}}
                <div class="flex-none w-full h-full relative" style="min-width:100%">
                  <img class="w-full h-full object-cover" src="{{this.url}}" alt="{{this.caption}}" />
                  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
                  <span class="absolute left-3 bottom-3 text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
                    {{#if this.source}}{{this.source}}{{else}}REGISTRO INIFAP{{/if}}
                  </span>
                </div>
              {{/each}}
              {{#unless plague.image_url}}{{#unless carouselImages}}
                <div class="flex-none w-full h-full bg-muted flex items-center justify-center" style="min-width:100%">
                  <span class="material-symbols-outlined text-6xl text-muted-foreground/40">pest_control</span>
                </div>
              {{/unless}}{{/unless}}
            </div>

            <button id="hero-prev" class="absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 backdrop-blur cursor-pointer" aria-label="Anterior">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </button>
            <button id="hero-next" class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 backdrop-blur cursor-pointer" aria-label="Siguiente">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </button>
            <div id="hero-dots" class="absolute bottom-3 right-3 flex gap-1.5 z-10"></div>
          </div>
        </div>

        {{! Columna Derecha: Título, Badges, Tarjeta de Riesgo Rojo & Botón Verde }}
        <div class="col-span-1 lg:col-span-6 flex flex-col justify-between">
          <div>
            <!-- Badges superiores -->
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold uppercase tracking-wider">
                🌿 {{#if plague.category}}{{plague.category}}{{else}}INSECTOS{{/if}} — VIGILANCIA
              </span>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold uppercase tracking-wider">
                <span class="material-symbols-outlined text-xs">verified</span> Verificado INIFAP
              </span>
            </div>

            <!-- Nombre de la Plaga -->
            <h1 class="text-3xl md:text-4xl font-headline font-extrabold text-foreground tracking-tight mb-1">
              {{plague.name}}
            </h1>
            <p class="font-mono text-sm italic font-semibold text-muted-foreground mb-4">
              {{plague.scientificName}}
            </p>

            <!-- Descripción Corta -->
            <p class="text-xs md:text-sm text-muted-foreground leading-relaxed mb-6">
              {{plague.description}}
            </p>

            <!-- Tarjeta Roja de Alerta de Riesgo -->
            <div class="p-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-950 mb-6">
              <div class="flex items-center gap-2.5 mb-1">
                <span class="material-symbols-outlined text-rose-600 text-lg">warning</span>
                <h3 class="text-sm font-bold tracking-tight">Riesgo {{plague.riskLabel}}</h3>
              </div>
              <p class="text-xs text-rose-800 leading-normal pl-7">
                Requiere monitoreo y acción inmediata en zonas hortícolas y cerealeras.
              </p>
              <!-- Barra de progreso roja -->
              <div class="w-full bg-rose-200 h-1.5 rounded-full mt-3 overflow-hidden">
                <div class="bg-rose-600 h-full w-[85%] rounded-full"></div>
              </div>
            </div>
          </div>

          <!-- Botón Verde Sólido CTA Principal -->
          <a href="#manejo-integrado" class="w-full py-3 bg-[#1b4332] hover:bg-[#1b4332]/90 text-white font-bold text-xs rounded-md transition-colors flex items-center justify-center gap-2 shadow-2xs cursor-pointer">
            <span class="material-symbols-outlined text-base">verified_user</span> Ver ficha sanitaria completa
          </a>
        </div>

      </div>
    </div>

    {{! ── KPI SUMMARY BAR (4 TARJETAS) ────────────────────────────────────── }}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      
      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">NIVEL DE RIESGO</span>
        <span class="text-base font-bold text-rose-600 capitalize">{{plague.riskLabel}}</span>
      </div>

      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">REGIONES AFECTADAS</span>
        <span class="text-base font-bold text-foreground">
          {{#if incidenceRegions.length}}{{incidenceRegions.length}} estados{{else}}2 estados{{/if}}
        </span>
      </div>

      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">CULTIVOS HOSPEDEROS</span>
        <span class="text-base font-bold text-foreground">Cereales</span>
      </div>

      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">ÚLTIMO REGISTRO</span>
        <span class="text-base font-mono font-bold text-foreground">2024</span>
      </div>

    </div>

    {{! ── SECCIÓN 1: CICLO BIOLÓGICO (4 TARJETAS HORIZONTALES) ────────────── }}
    <section id="ciclo-biologico" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">eco</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Ciclo biológico</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {{#each plague.biologicalCycle}}
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-between relative">
            <div class="flex items-center justify-between mb-3">
              <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-800 flex items-center justify-center border border-emerald-100">
                <span class="material-symbols-outlined text-sm">nature</span>
              </div>
              <span class="font-mono text-xs text-muted-foreground font-bold">0{{add @index 1}}</span>
            </div>
            <div>
              <h3 class="font-headline font-bold text-sm text-foreground mb-1">{{this.title}}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{{this.description}}</p>
            </div>
          </div>
        {{/each}}
      </div>
    </section>

    {{! ── SECCIÓN 2: DISTRIBUCIÓN E INCIDENCIA ───────────────────────────── }}
    <section id="distribucion" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">location_on</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Distribución e incidencia</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <!-- Mapa Leaflet Integrado (Left) -->
        <div class="col-span-1 lg:col-span-7 bg-white p-4 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
          <div id="incidence-map" data-regions="{{incidenceRegionsJson}}" data-risk="{{plague.riskLevel}}" class="w-full rounded-lg border border-border overflow-hidden relative z-0 isolate" style="height:280px; isolation: isolate;"></div>
          <div class="mt-3 text-xs text-muted-foreground font-medium flex items-center gap-1">
            <span class="material-symbols-outlined text-sm text-rose-600">pin_drop</span>
            El Bajío — Guanajuato, Jalisco, Sinaloa
          </div>
        </div>

        <!-- Módulo Cobertura Regional de Monitoreo (Right) -->
        <div class="col-span-1 lg:col-span-5 bg-white p-6 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-6">
              <span class="material-symbols-outlined text-emerald-800 text-lg">gis</span>
              <h3 class="text-sm font-bold text-foreground">Cobertura regional de monitoreo</h3>
            </div>

            <div class="grid grid-cols-3 gap-2 text-center mb-6">
              <div>
                <span class="text-2xl font-mono font-bold text-foreground block tabular-nums">2</span>
                <span class="text-[10px] font-mono text-muted-foreground uppercase">REGIONES</span>
              </div>
              <div>
                <span class="text-2xl font-mono font-bold text-foreground block tabular-nums">2024</span>
                <span class="text-[10px] font-mono text-muted-foreground uppercase">ÚLTIMO BROTE</span>
              </div>
              <div>
                <span class="text-2xl font-mono font-bold text-rose-600 block">Alta</span>
                <span class="text-[10px] font-mono text-muted-foreground uppercase">PRESIÓN</span>
              </div>
            </div>
          </div>

          <div class="p-3 bg-muted/40 rounded-lg text-[11px] text-muted-foreground leading-normal border border-border">
            Datos consolidados por la Red Nacional de Vigilancia Fitosanitaria del INIFAP.
          </div>
        </div>
      </div>
    </section>

    {{! ── SECCIÓN 3: ESTRATEGIAS DE MANEJO INTEGRADO ──────────────────────── }}
    <section id="manejo-integrado" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">shield</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Estrategias de manejo integrado</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        {{! Columna Izquierda: 3 Bloques Fitosanitarios }}
        <div class="col-span-1 lg:col-span-7 flex flex-col gap-3">
          
          <!-- Bloque 1: Sistemas de Identificación -->
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
              <span class="material-symbols-outlined text-base">search</span>
            </div>
            <div>
              <h3 class="font-bold text-xs text-foreground mb-1">Sistemas de identificación</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Muestreo dirigido con trampas amarillas y conteo por espiga para el umbral económico.
              </p>
            </div>
          </div>

          <!-- Bloque 2: Control Biológico -->
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
              <span class="material-symbols-outlined text-base">biotech</span>
            </div>
            <div>
              <h3 class="font-bold text-xs text-foreground mb-1">Control biológico</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                {{#if plague.biologicalControl}}{{plague.biologicalControl}}{{else}}Conservación de enemigos naturales: coccinélidos, sírfidos y parasitoides (Aphidius spp).{{/if}}
              </p>
            </div>
          </div>

          <!-- Bloque 3: Control Químico -->
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
              <span class="material-symbols-outlined text-base">opacity</span>
            </div>
            <div>
              <h3 class="font-bold text-xs text-foreground mb-1">Control químico</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                {{#if plague.controlMethods}}{{plague.controlMethods}}{{else}}Insecticidas selectivos solo al superar el umbral, rotando modos de acción.{{/if}}
              </p>
            </div>
          </div>

        </div>

        {{! Columna Derecha: Tarjeta de Acción Sanitaria }}
        <div class="col-span-1 lg:col-span-5 bg-white p-6 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
          <div>
            <h3 class="text-sm font-bold text-foreground mb-4">Acción sanitaria</h3>

            <!-- Banner Rojo Región Prioritaria -->
            <div class="p-3.5 rounded-lg bg-rose-50 border border-rose-200 mb-6">
              <span class="text-[10px] font-mono font-bold text-rose-700 uppercase block mb-1">Región prioritaria</span>
              <p class="text-xs font-semibold text-rose-950">El Bajío — Guanajuato, Jalisco, Sinaloa</p>
            </div>
          </div>

          <div class="flex flex-col gap-2.5">
            <button type="button" class="w-full py-2.5 bg-white hover:bg-muted text-[#1b4332] border border-[#1b4332] font-bold text-xs rounded-md transition-colors cursor-pointer">
              Iniciar seguimiento
            </button>
            <button type="button" class="w-full py-2.5 bg-[#1b4332] hover:bg-[#1b4332]/90 text-white font-bold text-xs rounded-md transition-colors cursor-pointer">
              Registrar avistamiento
            </button>
          </div>
        </div>

      </div>
    </section>

    {{! ── SECCIÓN 4: REFERENCIA VISUAL DE DAÑOS ─────────────────────────── }}
    <section id="danos" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">photo_library</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Referencia visual de daños</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {{#if plague.image_url}}
          <div class="bg-white p-3 rounded-xl border border-border shadow-2xs">
            <div class="aspect-[4/3] rounded-lg overflow-hidden bg-muted mb-2 border border-border">
              <img src="{{plague.image_url}}" alt="Daño 1" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/images/test/default.png';" />
            </div>
            <span class="text-[10px] font-mono font-bold text-muted-foreground uppercase block">Daño foliar avanzado</span>
          </div>
        {{/if}}
        {{#each carouselImages}}
          <div class="bg-white p-3 rounded-xl border border-border shadow-2xs">
            <div class="aspect-[4/3] rounded-lg overflow-hidden bg-muted mb-2 border border-border">
              <img src="{{this.url}}" alt="{{this.caption}}" class="w-full h-full object-cover" />
            </div>
            <span class="text-[10px] font-mono font-bold text-muted-foreground uppercase block">{{this.caption}}</span>
          </div>
        {{/each}}
      </div>
    </section>

    {{! ── SECCIÓN 5: PRODUCTOS RECOMENDADOS INIFAP ──────────────────────── }}
    <section id="productos" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">science</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Productos recomendados INIFAP</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        {{#if relatedProducts.length}}
          {{#each relatedProducts}}
            <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
              <div>
                <div class="h-32 rounded-lg bg-emerald-50/60 border border-emerald-100 flex items-center justify-center mb-4 text-[#1b4332]">
                  <span class="material-symbols-outlined text-4xl">science</span>
                </div>

                <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase flex items-center gap-1 mb-1">
                  <span class="material-symbols-outlined text-xs">thumb_up</span> Recomendado
                </span>
                <h3 class="font-headline font-bold text-sm text-foreground mb-0.5">{{this.name}}</h3>
                <p class="text-xs text-muted-foreground font-semibold mb-3">{{this.activeIngredient}} · Sistémico</p>
              </div>

              <a href="/products/{{this.id}}" class="w-full py-2 bg-white hover:bg-muted text-foreground font-bold text-xs rounded-md transition-colors border border-border text-center inline-block">
                Ver producto
              </a>
            </div>
          {{/each}}
        {{else}}
          <!-- Mockup Cards fallback para mantener la fidelidad al wireframe visual -->
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
            <div>
              <div class="h-32 rounded-lg bg-emerald-50/60 border border-emerald-100 flex items-center justify-center mb-4 text-[#1b4332]">
                <span class="material-symbols-outlined text-4xl">science</span>
              </div>
              <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase flex items-center gap-1 mb-1">
                <span class="material-symbols-outlined text-xs">thumb_up</span> Recomendado
              </span>
              <h3 class="font-headline font-bold text-sm text-foreground mb-0.5">Confidor 350 SC</h3>
              <p class="text-xs text-muted-foreground font-semibold mb-3">Imidacloprid · Sistémico</p>
            </div>
            <a href="/products" class="w-full py-2 bg-white hover:bg-muted text-foreground font-bold text-xs rounded-md transition-colors border border-border text-center inline-block">
              Ver producto
            </a>
          </div>

          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
            <div>
              <div class="h-32 rounded-lg bg-emerald-50/60 border border-emerald-100 flex items-center justify-center mb-4 text-[#1b4332]">
                <span class="material-symbols-outlined text-4xl">science</span>
              </div>
              <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase flex items-center gap-1 mb-1">
                <span class="material-symbols-outlined text-xs">thumb_up</span> Recomendado
              </span>
              <h3 class="font-headline font-bold text-sm text-foreground mb-0.5">Movento 150 OD</h3>
              <p class="text-xs text-muted-foreground font-semibold mb-3">Spirotetramat · Sistémico</p>
            </div>
            <a href="/products" class="w-full py-2 bg-white hover:bg-muted text-foreground font-bold text-xs rounded-md transition-colors border border-border text-center inline-block">
              Ver producto
            </a>
          </div>

