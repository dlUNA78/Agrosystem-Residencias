<!-- CSS y Script interactivo local para Pestañas y z-index del Mapa -->
<style>
  #incidence-map {
    isolation: isolate;
    position: relative;
    z-index: 0;
  }
  #incidence-map .leaflet-pane,
  #incidence-map .leaflet-[#top],
  #incidence-map .leaflet-[#bottom] {
    z-index: 1 !important;
  }
  #incidence-map .leaflet-control-zoom {
    z-index: 2 !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.nav-tab-link');
    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        tabs.forEach(t => {
          t.classList.remove('text-[#1b4332]', 'border-[#1b4332]');
          t.classList.add('text-muted-foreground', 'border-transparent');
        });
        this.classList.remove('text-muted-foreground', 'border-transparent');
        this.classList.add('text-[#1b4332]', 'border-[#1b4332]');
      });
    });
  });
</script>