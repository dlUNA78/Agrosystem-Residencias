<div class="min-h-screen font-['Geist'] antialiased bg-background text-foreground pb-20">

  {{! ── SUB-NAVBAR PEGAJOSO (NAVEGACIÓN RÁPIDA GLASSMORPHIC) ─────────────── }}
  <header class="sticky top-16 z-30 bg-background/80 backdrop-blur-md border-b border-border shadow-2xs transition-all">
    <div class="max-w-7xl mx-auto px-4 md:px-10 py-2.5 flex items-center justify-between gap-4 overflow-x-auto no-scrollbar">
      <nav class="flex items-center gap-1.5 md:gap-3 text-xs font-medium text-muted-foreground whitespace-nowrap">
        <a href="#resumen" class="px-3 py-1.5 rounded-lg hover:text-foreground hover:bg-muted transition-colors flex items-center gap-1.5 font-bold text-foreground">
          <span class="material-symbols-outlined text-sm text-[#1b4332]">info</span> Resumen
        </a>
        <a href="#ciclo-biologico" class="px-3 py-1.5 rounded-lg hover:text-foreground hover:bg-muted transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">sync</span> Ciclo Biológico
        </a>
        <a href="#distribucion" class="px-3 py-1.5 rounded-lg hover:text-foreground hover:bg-muted transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">map</span> Distribución
        </a>
        <a href="#manejo-integrado" class="px-3 py-1.5 rounded-lg hover:text-foreground hover:bg-muted transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">shield</span> Manejo Integrado
        </a>
        <a href="#danos" class="px-3 py-1.5 rounded-lg hover:text-foreground hover:bg-muted transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">warning</span> Daños
        </a>
        <a href="#productos" class="px-3 py-1.5 rounded-lg hover:text-foreground hover:bg-muted transition-colors flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">science</span> Productos
          {{#if relatedProducts.length}}<span class="px-1.5 py-0.5 text-[10px] font-mono bg-blue-50 text-blue-700 rounded-full font-bold">{{relatedProducts.length}}</span>{{/if}}
        </a>
        {{#if isPrivate}}
          <a href="#relaciones-tecnicas" class="px-3 py-1.5 rounded-lg hover:text-foreground hover:bg-muted transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">account_tree</span> Relaciones
          </a>
        {{/if}}
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        {{#if isPrivate}}
          <a href="/private/plagues" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-card border border-border text-foreground font-bold text-xs rounded-md hover:bg-secondary transition-colors shadow-2xs">
            <span class="material-symbols-outlined text-xs">arrow_back</span> Panel
          </a>
        {{else}}
          <a href="/plagues" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-card border border-border text-foreground font-bold text-xs rounded-md hover:bg-secondary transition-colors shadow-2xs">
            <span class="material-symbols-outlined text-xs">arrow_back</span> Catálogo
          </a>
        {{/if}}
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 md:px-10 pt-6">

    {{! ── BREADCRUMBS & ENCABEZADO ────────────────────────────────────────── }}
    <div class="mb-4">
      <nav aria-label="Breadcrumb" class="flex mb-2">
        <ol class="inline-flex items-center space-x-1.5 text-xs font-mono tracking-widest uppercase text-muted-foreground">
          <li>
            {{#if isPrivate}}
              <a class="hover:text-[#1b4332] transition-colors" href="/dashboard">Dashboard</a>
            {{else}}
              <a class="hover:text-[#1b4332] transition-colors" href="/">Inicio</a>
            {{/if}}
          </li>
          <li>
            <div class="flex items-center">
              <span class="material-symbols-outlined text-xs mx-1">chevron_right</span>
              {{#if isPrivate}}
                <a class="hover:text-[#1b4332] transition-colors" href="/private/plagues">Plagas</a>
              {{else}}
                <a class="hover:text-[#1b4332] transition-colors" href="/plagues">Catálogo de Plagas</a>
              {{/if}}
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <span class="material-symbols-outlined text-xs mx-1">chevron_right</span>
              <span class="text-[#1b4332] font-bold">{{plague.name}}</span>
            </div>
          </li>
        </ol>
      </nav>
    </div>

    {{#if isPrivate}}
      <section class="mb-6 rounded-xl border border-border bg-white p-5 shadow-2xs">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground">Estado editorial</span>
            <div class="mt-1 flex items-center gap-2">
              <span class="inline-flex rounded-full border border-border bg-muted px-3 py-1 text-xs font-bold text-foreground">
                {{#if (eq plague.workflowStatus 'draft')}}Borrador
                {{else if (eq plague.workflowStatus 'in_review')}}En revisión
                {{else if (eq plague.workflowStatus 'changes_requested')}}Cambios solicitados
                {{else if (eq plague.workflowStatus 'verified')}}Verificada
                {{else if (eq plague.workflowStatus 'published')}}Publicada
                {{else if (eq plague.workflowStatus 'archived')}}Archivada
                {{else}}Sin estado editorial{{/if}}
              </span>
              {{#if plague.reviewNotes}}
                <span class="text-xs text-amber-700">{{plague.reviewNotes}}</span>
              {{/if}}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            {{#if (eq plague.workflowStatus 'draft')}}
              {{#if permissions.canSubmitReview}}
                {{#if readiness.isReady}}
                  <form method="POST" action="/private/plagues/{{plague.id}}/workflow">
                    <input type="hidden" name="action" value="submit_review" />
                    <button type="submit" class="rounded-lg bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f]">Enviar a revisión</button>
                  </form>
                {{else}}
                  <button type="button" disabled class="cursor-not-allowed rounded-lg bg-muted px-4 py-2 text-xs font-bold text-muted-foreground opacity-70">Completa el checklist para enviar</button>
                {{/if}}
              {{/if}}
            {{/if}}

            {{#if (eq plague.workflowStatus 'changes_requested')}}
              {{#if permissions.canSubmitReview}}
                {{#if readiness.isReady}}
                  <form method="POST" action="/private/plagues/{{plague.id}}/workflow">
                    <input type="hidden" name="action" value="submit_review" />
                    <button type="submit" class="rounded-lg bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f]">Reenviar a revisión</button>
                  </form>
                {{else}}
                  <button type="button" disabled class="cursor-not-allowed rounded-lg bg-muted px-4 py-2 text-xs font-bold text-muted-foreground opacity-70">Completa el checklist para reenviar</button>
                {{/if}}
              {{/if}}
            {{/if}}

            {{#if (eq plague.workflowStatus 'in_review')}}
              {{#if permissions.canVerify}}
                <form method="POST" action="/private/plagues/{{plague.id}}/workflow" class="flex flex-wrap items-center gap-2">
                  <input type="hidden" name="action" value="request_changes" />
                  <input type="text" name="review_notes" required maxlength="500" placeholder="Observaciones requeridas" class="rounded-lg border border-input bg-background px-3 py-2 text-xs" />
                  <button type="submit" class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-xs font-bold text-amber-800 hover:bg-amber-100">Solicitar cambios</button>
                </form>
                {{#if readiness.isReady}}
                  <form method="POST" action="/private/plagues/{{plague.id}}/workflow">
                    <input type="hidden" name="action" value="verify" />
                    <button type="submit" class="rounded-lg bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f]">Verificar</button>
                  </form>
                {{else}}
                  <button type="button" disabled class="cursor-not-allowed rounded-lg bg-muted px-4 py-2 text-xs font-bold text-muted-foreground opacity-70">Ficha incompleta</button>
                {{/if}}
              {{/if}}
            {{/if}}

            {{#if (eq plague.workflowStatus 'verified')}}
              {{#if permissions.canPublish}}
                {{#if readiness.isReady}}
                  <form method="POST" action="/private/plagues/{{plague.id}}/workflow">
                    <input type="hidden" name="action" value="publish" />
                    <button type="submit" class="rounded-lg bg-[#1b4332] px-4 py-2 text-xs font-bold text-white hover:bg-[#2d6a4f]">Publicar</button>
                  </form>
                {{else}}
                  <button type="button" disabled class="cursor-not-allowed rounded-lg bg-muted px-4 py-2 text-xs font-bold text-muted-foreground opacity-70">Ficha incompleta</button>
                {{/if}}
              {{/if}}
            {{/if}}

            {{#if (eq plague.workflowStatus 'published')}}
              {{#if permissions.canArchive}}
                <form method="POST" action="/private/plagues/{{plague.id}}/workflow">
                  <input type="hidden" name="action" value="archive" />
                  <button type="submit" class="rounded-lg border border-border bg-white px-4 py-2 text-xs font-bold text-foreground hover:bg-muted">Archivar</button>
                </form>
              {{/if}}
            {{/if}}

            {{#if (eq plague.workflowStatus 'archived')}}
              {{#if permissions.canRestore}}
                <form method="POST" action="/private/plagues/{{plague.id}}/workflow">
                  <input type="hidden" name="action" value="restore" />
                  <button type="submit" class="rounded-lg border border-border bg-white px-4 py-2 text-xs font-bold text-foreground hover:bg-muted">Restaurar como borrador</button>
                </form>
              {{/if}}
            {{/if}}
          </div>
        </div>
      </section>
    {{/if}}

    {{#if isPrivate}}
      <section id="publication-checklist" class="mb-6 rounded-xl border border-border bg-white p-5 shadow-2xs">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground">Control de calidad</span>
            <h2 class="mt-1 text-base font-headline font-bold text-foreground">Requisitos para revisión y publicación</h2>
            <p class="mt-1 text-xs text-muted-foreground">La ficha debe cumplir todos los requisitos antes de verificarse o hacerse pública.</p>
          </div>
          {{#if readiness.isReady}}
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-800">
              <span class="material-symbols-outlined text-sm">task_alt</span>
              Lista para revisión
            </span>
          {{else}}
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-800">
              <span class="material-symbols-outlined text-sm">pending_actions</span>
              {{readiness.completeCount}} de {{readiness.totalCount}} completos
            </span>
          {{/if}}
        </div>

        <div class="mt-4 grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
          {{#each readiness.items}}
            <div class="flex items-start gap-3 rounded-lg border p-3 {{#if this.complete}}border-emerald-100 bg-emerald-50/60{{else}}border-amber-100 bg-amber-50/60{{/if}}">
              <span class="material-symbols-outlined mt-0.5 text-base {{#if this.complete}}text-emerald-700{{else}}text-amber-600{{/if}}">
                {{#if this.complete}}check_circle{{else}}radio_button_unchecked{{/if}}
              </span>
              <div>
                <p class="text-xs font-bold text-foreground">{{this.label}}</p>
                <p class="mt-0.5 text-[11px] leading-relaxed text-muted-foreground">{{this.hint}}</p>
              </div>
            </div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if isPrivate}}
      <section id="relaciones-tecnicas" class="scroll-mt-32 mb-6 rounded-xl border border-border bg-white p-5 shadow-2xs">
        <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground">Relaciones técnicas</span>
            <h2 class="mt-1 text-base font-headline font-bold text-foreground">Productos, cultivos y regiones asociados</h2>
            <p class="mt-1 max-w-3xl text-xs leading-relaxed text-muted-foreground">
              Estas relaciones alimentan la ficha pública cuando la plaga se publica. Guardar reemplaza la selección actual completa.
            </p>
          </div>
          {{#if relationsLocked}}
            <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800">
              <span class="material-symbols-outlined text-sm">lock</span>
              Bloqueadas por estado editorial
            </span>
          {{/if}}
        </div>

        {{#if canEditRelations}}
          <form method="POST" action="/private/plagues/{{plague.id}}/relations" class="mt-5">
            <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
              <fieldset class="rounded-xl border border-border bg-muted/20 p-4">
                <legend class="px-2 text-xs font-bold text-foreground">Productos autorizados</legend>
                <div class="mt-2 max-h-64 space-y-2 overflow-y-auto pr-1">
                  {{#each relationEditor.products}}
                    <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-transparent bg-white p-3 text-xs transition-colors hover:border-border">
                      <input type="checkbox" name="product_ids" value="{{this.id}}" {{#if this.isSelected}}checked{{/if}} class="mt-0.5 h-4 w-4 rounded border-input text-[#1b4332]" />
                      <span>
                        <span class="block font-bold text-foreground">{{this.name}}</span>
                        <span class="mt-0.5 block text-muted-foreground">{{#if this.activeIngredient}}{{this.activeIngredient}}{{else}}Sin ingrediente activo registrado{{/if}}</span>
                      </span>
                    </label>
                  {{else}}
                    <p class="rounded-lg border border-dashed border-border bg-white p-4 text-center text-xs text-muted-foreground">No hay productos en el catálogo.</p>
                  {{/each}}
                </div>
              </fieldset>

              <fieldset class="rounded-xl border border-border bg-muted/20 p-4">
                <legend class="px-2 text-xs font-bold text-foreground">Cultivos afectados</legend>
                <div class="mt-2 max-h-64 space-y-2 overflow-y-auto pr-1">
                  {{#each relationEditor.crops}}
                    <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-transparent bg-white p-3 text-xs transition-colors hover:border-border">
                      <input type="checkbox" name="crop_ids" value="{{this.id}}" {{#if this.isSelected}}checked{{/if}} class="mt-0.5 h-4 w-4 rounded border-input text-[#1b4332]" />
                      <span>
                        <span class="block font-bold text-foreground">{{this.name}}</span>
                        <span class="mt-0.5 block italic text-muted-foreground">{{#if this.scientificName}}{{this.scientificName}}{{else}}Sin nombre científico registrado{{/if}}</span>
                      </span>
                    </label>
                  {{else}}
                    <p class="rounded-lg border border-dashed border-border bg-white p-4 text-center text-xs text-muted-foreground">No hay cultivos en el catálogo.</p>
                  {{/each}}
                </div>
              </fieldset>

              <fieldset class="rounded-xl border border-border bg-muted/20 p-4">
                <legend class="px-2 text-xs font-bold text-foreground">Regiones y riesgo</legend>
                <div class="mt-2 max-h-64 space-y-2 overflow-y-auto pr-1">
                  {{#each relationEditor.regions}}
                    <div class="rounded-lg border border-transparent bg-white p-3 transition-colors hover:border-border">
                      <label class="flex cursor-pointer items-center gap-3 text-xs font-bold text-foreground">
                        <input type="checkbox" name="region_ids" value="{{this.id}}" {{#if this.isSelected}}checked{{/if}} class="h-4 w-4 rounded border-input text-[#1b4332]" />
                        {{this.name}}
                      </label>
                      <label class="mt-2 block text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground" for="region-risk-{{this.id}}">Nivel de riesgo</label>
                      <select id="region-risk-{{this.id}}" name="region_risk_{{this.id}}" class="mt-1 w-full rounded-lg border border-input bg-background px-3 py-2 text-xs text-foreground">
                        <option value="Bajo" {{#if this.isRiskLow}}selected{{/if}}>Bajo</option>
                        <option value="Medio" {{#if this.isRiskMedium}}selected{{/if}}>Medio</option>
                        <option value="Alto" {{#if this.isRiskHigh}}selected{{/if}}>Alto</option>
                        <option value="Crítico" {{#if this.isRiskCritical}}selected{{/if}}>Crítico</option>
                      </select>
                    </div>
                  {{else}}
                    <p class="rounded-lg border border-dashed border-border bg-white p-4 text-center text-xs text-muted-foreground">No hay regiones en el catálogo.</p>
                  {{/each}}
                </div>
              </fieldset>
            </div>

            <div class="mt-5 flex justify-end">
              <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#1b4332] px-5 py-2.5 text-xs font-bold text-white shadow-2xs transition-colors hover:bg-[#2d6a4f]">
                <span class="material-symbols-outlined text-base">save</span>
                Guardar relaciones
              </button>
            </div>
          </form>
        {{else}}
          {{#if relationsLocked}}
            <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-xs leading-relaxed text-amber-900">
              Para modificar las relaciones, la ficha debe volver a borrador o recibir una solicitud de correcciones.
            </p>
          {{else if relationsOwnershipRestricted}}
            <p class="mt-4 rounded-lg border border-sky-200 bg-sky-50 p-4 text-xs leading-relaxed text-sky-900">
              Estás consultando el expediente de otro autor. Sólo su autor o un administrador puede modificar las relaciones técnicas.
            </p>
          {{/if}}
        {{/if}}
      </section>
    {{/if}}

    {{! ── HERO SECTION (2 COLUMNAS) ────────────────────────────────────────── }}
    <div id="resumen" class="scroll-mt-32 mb-6 bg-white border border-border rounded-xl p-6 md:p-8 shadow-2xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        {{! Columna Izquierda: Vista Previa Fotográfica }}
        <div class="col-span-1 lg:col-span-6">
          <div class="relative overflow-hidden rounded-lg bg-muted border border-border h-[320px] md:h-[350px] group" id="hero-carousel">
            <div class="flex h-full transition-transform duration-700 ease-in-out" id="hero-slides">
              {{#each carouselImages}}
                <div class="flex-none min-w-full w-full h-full relative">
                  <img class="w-full h-full object-cover" src="{{this.url}}" alt="{{this.caption}}" />
                  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
                  <span class="absolute left-3 bottom-3 text-[10px] text-white/90 font-mono tracking-wider drop-shadow-xs select-none">
                    {{#if this.source}}{{this.source}}{{else}}FUENTE NO REGISTRADA{{/if}}
                  </span>
                </div>
              {{else}}
                <div class="flex-none min-w-full w-full h-full bg-muted flex items-center justify-center">
                  <span class="material-symbols-outlined text-6xl text-muted-foreground/40">pest_control</span>
                </div>
              {{/each}}
            </div>

            <button id="hero-prev" class="absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 backdrop-blur cursor-pointer" aria-label="Anterior">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </button>
            <button id="hero-next" class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 backdrop-blur cursor-pointer" aria-label="Siguiente">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </button>
            <div id="hero-dots" class="absolute bottom-3 right-3 flex gap-1.5 z-10"></div>
          </div>
        </div>

        {{! Columna Derecha: Título, Badges, Tarjeta de Riesgo Rojo & Botón Verde }}
        <div class="col-span-1 lg:col-span-6 flex flex-col justify-between">
          <div>
            <!-- Badges superiores -->
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold uppercase tracking-wider">
                🌿 {{#if plague.category}}{{plague.category}}{{else}}SIN CATEGORÍA{{/if}} — VIGILANCIA
              </span>
              {{#if plague.isVerified}}
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold uppercase tracking-wider">
                  <span class="material-symbols-outlined text-xs">verified</span> Verificado
                </span>
              {{else}}{{#if isPrivate}}
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 text-[11px] font-bold uppercase tracking-wider">
                  <span class="material-symbols-outlined text-xs">pending</span> Pendiente de verificación
                </span>
              {{/if}}{{/if}}
            </div>

            <!-- Nombre de la Plaga -->
            <h1 class="text-3xl md:text-4xl font-headline font-extrabold text-foreground tracking-tight mb-1">
              {{plague.name}}
            </h1>
            <p class="font-mono text-sm italic font-semibold text-muted-foreground mb-4">
              {{plague.scientificName}}
            </p>

            <!-- Descripción Corta -->
            <p class="text-xs md:text-sm text-muted-foreground leading-relaxed mb-6">
              {{#if plague.description}}{{plague.description}}{{else}}Sin descripción registrada.{{/if}}
            </p>

            <!-- Tarjeta Dinámica de Alerta de Riesgo (Crítico = Rose, Moderado = Amber, Bajo = Emerald) -->
            <div class="p-4 rounded-lg {{#if plague.riskTheme.alertBgClass}}{{plague.riskTheme.alertBgClass}}{{else if (eq plague.riskLabel 'Crítico')}}bg-rose-50 border border-rose-200 text-rose-950{{else if (eq plague.riskLabel 'Moderado')}}bg-amber-50 border border-amber-200 text-amber-950{{else}}bg-emerald-50 border border-emerald-200 text-emerald-950{{/if}} mb-6">
              <div class="flex items-center gap-2.5 mb-1">
                <span class="material-symbols-outlined {{#if plague.riskTheme.alertIconClass}}{{plague.riskTheme.alertIconClass}}{{else if (eq plague.riskLabel 'Crítico')}}text-rose-600{{else if (eq plague.riskLabel 'Moderado')}}text-amber-600{{else}}text-emerald-600{{/if}} text-lg">
                  {{#if plague.riskTheme.alertIcon}}{{plague.riskTheme.alertIcon}}{{else if (eq plague.riskLabel 'Bajo')}}check_circle{{else}}warning{{/if}}
                </span>
                <h3 class="text-sm font-bold tracking-tight">Riesgo {{plague.riskLabel}}</h3>
              </div>
              <p class="text-xs opacity-90 leading-normal pl-7">
                {{#if plague.riskTheme.alertText}}{{plague.riskTheme.alertText}}{{else if (eq plague.riskLabel 'Crítico')}}Requiere monitoreo y acción inmediata en zonas hortícolas y cerealeras.{{else if (eq plague.riskLabel 'Moderado')}}Requiere monitoreo continuo y control fitosanitario preventivo.{{else}}Bajo impacto fitosanitario. Mantener vigilancia preventiva estándar.{{/if}}
              </p>
              <!-- Barra de progreso dinámica -->
              <div class="w-full bg-black/10 h-1.5 rounded-full mt-3 overflow-hidden">
                <div class="{{#if plague.riskTheme.alertBarClass}}{{plague.riskTheme.alertBarClass}}{{else if (eq plague.riskLabel 'Crítico')}}bg-rose-600 w-[85%]{{else if (eq plague.riskLabel 'Moderado')}}bg-amber-500 w-[50%]{{else}}bg-emerald-500 w-[20%]{{/if}} h-full rounded-full"></div>
              </div>
            </div>
          </div>

          <!-- Botón Verde Sólido CTA Principal -->
          <a href="#manejo-integrado" class="w-full py-3 bg-[#1b4332] hover:bg-[#1b4332]/90 text-white font-bold text-xs rounded-md transition-colors flex items-center justify-center gap-2 shadow-2xs cursor-pointer">
            <span class="material-symbols-outlined text-base">verified_user</span> Ver ficha sanitaria completa
          </a>
        </div>

      </div>
    </div>

    {{! ── KPI SUMMARY BAR (4 TARJETAS) ────────────────────────────────────── }}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      
      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">NIVEL DE RIESGO</span>
        <span class="text-base font-bold {{#if plague.riskTheme.kpiTextClass}}{{plague.riskTheme.kpiTextClass}}{{else if (eq plague.riskLabel 'Crítico')}}text-rose-600{{else if (eq plague.riskLabel 'Moderado')}}text-amber-600{{else}}text-emerald-600{{/if}} capitalize">{{plague.riskLabel}}</span>
      </div>

      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">REGIONES AFECTADAS</span>
        <span class="text-base font-bold text-foreground">
          {{#if incidenceRegions.length}}{{incidenceRegions.length}}{{else}}Sin regiones{{/if}}
        </span>
      </div>

      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">CULTIVOS HOSPEDEROS</span>
        <span class="text-base font-bold text-foreground">{{#if cropSummary}}{{cropSummary}}{{else}}Sin cultivos{{/if}}</span>
      </div>

      <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-center">
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">ÚLTIMO REGISTRO</span>
        <span class="text-base font-mono font-bold text-foreground">{{#if plague.updatedAt}}{{plague.updatedAt}}{{else}}Sin fecha{{/if}}</span>
      </div>

    </div>

    {{! ── SECCIÓN 1: CICLO BIOLÓGICO (HIGH-FIDELITY WIREFRAME V0.1) ────────────── }}
    <section id="ciclo-biologico" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">sync</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Ciclo biológico</h2>
      </div>

      <!-- Grilla de Tarjetas de Etapas (01, 02, 03, 04) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-2">
        {{#each plague.biologicalCycle}}
          <div class="bg-white p-5 rounded-xl border {{#if this.isControlWindow}}border-2 border-rose-300 shadow-xs{{else}}border-border shadow-2xs{{/if}} flex flex-col justify-between relative transition-all">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="w-8 h-8 rounded-lg {{#if this.isControlWindow}}bg-rose-50 text-rose-600 border border-rose-100{{else}}bg-emerald-50 text-emerald-800 border border-emerald-100{{/if}} flex items-center justify-center">
                  <span class="material-symbols-outlined text-base">
                    {{#if this.icon}}{{this.icon}}{{else if (eq @index 0)}}egg{{else if (eq @index 1)}}bug_report{{else if (eq @index 2)}}eco{{else}}air{{/if}}
                  </span>
                </div>
                <span class="font-mono text-xs {{#if this.isControlWindow}}text-rose-400 font-bold{{else}}text-muted-foreground/60 font-semibold{{/if}}">
                  {{#if this.step}}{{this.step}}{{else}}0{{add @index 1}}{{/if}}
                </span>
              </div>

              <h3 class="font-headline font-bold text-sm text-foreground mb-1">{{this.title}}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{{this.description}}</p>
            </div>

            <div class="mt-4 pt-3 border-t {{#if this.isControlWindow}}border-rose-100{{else}}border-border/60{{/if}}">
              <div class="flex items-center gap-1.5 font-mono text-xs {{#if this.isControlWindow}}text-rose-600 font-bold mb-2.5{{else}}text-muted-foreground{{/if}}">
                <span class="material-symbols-outlined text-sm">schedule</span>
                <span>{{#if this.duration}}{{this.duration}}{{else}}Duración no registrada{{/if}}</span>
              </div>

              {{#if this.isControlWindow}}
                <div class="bg-rose-50 text-rose-700 border border-rose-200/60 rounded-full px-2.5 py-1 text-[11px] font-bold flex items-center justify-center gap-1.5 shadow-2xs">
                  <span class="material-symbols-outlined text-xs">target</span>
                  <span>Ventana óptima de control</span>
                </div>
              {{/if}}
            </div>
          </div>
        {{else}}
          <div class="sm:col-span-2 lg:col-span-4 bg-white p-6 rounded-xl border border-dashed border-border text-center text-xs text-muted-foreground">
            Sin información registrada sobre el ciclo biológico.
          </div>
        {{/each}}
      </div>
    </section>

    {{! ── SECCIÓN 2: DISTRIBUCIÓN E INCIDENCIA ───────────────────────────── }}
    <section id="distribucion" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">location_on</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Distribución e incidencia</h2>
      </div>

      {{#if incidenceRegions.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {{#each incidenceRegions}}
            <article class="bg-white p-5 rounded-xl border border-border shadow-2xs">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground">Región registrada</span>
                  <h3 class="mt-1 text-sm font-bold text-foreground">{{this.name}}</h3>
                </div>
                <span class="px-2 py-1 rounded-full border text-[10px] font-bold {{this.riskBadgeClass}}">
                  {{this.riskLabel}}
                </span>
              </div>
              {{#if this.hasCoords}}
                <p class="mt-4 text-xs font-mono text-muted-foreground">{{this.lat}}, {{this.lng}}</p>
              {{else}}
                <p class="mt-4 text-xs text-muted-foreground">Sin coordenadas registradas.</p>
              {{/if}}
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="bg-white p-6 rounded-xl border border-dashed border-border text-center text-xs text-muted-foreground">
          Esta plaga todavía no tiene regiones relacionadas.
        </div>
      {{/if}}
    </section>

    {{! ── SECCIÓN 3: ESTRATEGIAS DE MANEJO INTEGRADO ──────────────────────── }}
    <section id="manejo-integrado" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">shield</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Estrategias de manejo integrado</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        {{! Columna Izquierda: 3 Bloques Fitosanitarios }}
        <div class="col-span-1 lg:col-span-7 flex flex-col gap-3">
          
          <!-- Bloque 1: Síntomas registrados -->
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
              <span class="material-symbols-outlined text-base">troubleshoot</span>
            </div>
            <div>
              <h3 class="font-bold text-xs text-foreground mb-1">Síntomas registrados</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                {{#if plague.symptoms}}{{plague.symptoms}}{{else}}Sin síntomas registrados.{{/if}}
              </p>
            </div>
          </div>

          <!-- Bloque 2: Control Biológico -->
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
              <span class="material-symbols-outlined text-base">biotech</span>
            </div>
            <div>
              <h3 class="font-bold text-xs text-foreground mb-1">Control biológico</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                {{#if plague.biologicalControl}}{{plague.biologicalControl}}{{else}}Sin información de control biológico.{{/if}}
              </p>
            </div>
          </div>

          <!-- Bloque 3: Control Químico -->
          <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex items-start gap-4">
            <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
              <span class="material-symbols-outlined text-base">opacity</span>
            </div>
            <div>
              <h3 class="font-bold text-xs text-foreground mb-1">Control químico</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                {{#if plague.controlMethods}}{{plague.controlMethods}}{{else}}Sin métodos de control registrados.{{/if}}
              </p>
            </div>
          </div>

        </div>

        {{! Columna Derecha: trazabilidad del expediente }}
        <div class="col-span-1 lg:col-span-5 bg-white p-6 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
          <div>
            <h3 class="text-sm font-bold text-foreground mb-4">Trazabilidad del expediente</h3>

            <div class="p-3.5 rounded-lg {{#if plague.riskTheme.bannerClass}}{{plague.riskTheme.bannerClass}}{{else if (eq plague.riskLabel 'Crítico')}}bg-rose-50 border border-rose-200 text-rose-950{{else if (eq plague.riskLabel 'Moderado')}}bg-amber-50 border border-amber-200 text-amber-950{{else}}bg-emerald-50 border border-emerald-200 text-emerald-950{{/if}} mb-6">
              <span class="text-[10px] font-mono font-bold {{plague.riskTheme.bannerTagClass}} uppercase block mb-1">Regiones relacionadas</span>
              <p class="text-xs font-semibold">{{#if regionSummary}}{{regionSummary}}{{else}}Sin regiones relacionadas{{/if}}</p>
            </div>
          </div>

          <div class="space-y-3 text-xs">
            <div class="flex justify-between gap-4 border-t border-border pt-3">
              <span class="text-muted-foreground">Verificación</span>
              <span class="font-semibold text-right">{{#if plague.isVerified}}{{plague.verifiedBy}}{{else}}Pendiente{{/if}}</span>
            </div>
            <div class="flex justify-between gap-4 border-t border-border pt-3">
              <span class="text-muted-foreground">Fecha de verificación</span>
              <span class="font-semibold text-right">{{#if plague.verifiedAt}}{{plague.verifiedAt}}{{else}}Sin fecha{{/if}}</span>
            </div>
            <div class="flex justify-between gap-4 border-t border-border pt-3">
              <span class="text-muted-foreground">Última actualización</span>
              <span class="font-semibold text-right">{{#if plague.updatedAt}}{{plague.updatedAt}}{{else}}Sin fecha{{/if}}</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    {{! ── SECCIÓN 4: REFERENCIA VISUAL DE DAÑOS ─────────────────────────── }}
    <section id="danos" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">photo_library</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Referencia visual de daños</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {{#each carouselImages}}
          <div class="bg-white p-3 rounded-xl border border-border shadow-2xs">
            <div class="aspect-[4/3] rounded-lg overflow-hidden bg-muted mb-2 border border-border">
              <img src="{{this.url}}" alt="{{this.caption}}" class="w-full h-full object-cover" />
            </div>
            <span class="text-[10px] font-mono font-bold text-muted-foreground uppercase block">{{this.caption}}</span>
          </div>
        {{else}}
          <div class="sm:col-span-2 md:col-span-4 bg-white p-6 rounded-xl border border-dashed border-border text-center text-xs text-muted-foreground">
            Sin imágenes de referencia registradas.
          </div>
        {{/each}}
      </div>
    </section>

    {{! ── SECCIÓN 5: PRODUCTOS RECOMENDADOS INIFAP ──────────────────────── }}
    <section id="productos" class="scroll-mt-32 mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#1b4332] text-xl">science</span>
        <h2 class="text-lg font-headline font-bold text-foreground tracking-tight">Productos recomendados INIFAP</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        {{#if relatedProducts.length}}
          {{#each relatedProducts}}
            <div class="bg-white p-5 rounded-xl border border-border shadow-2xs flex flex-col justify-between">
              <div>
                <div class="h-36 rounded-lg bg-muted/30 border border-border flex items-center justify-center mb-4 overflow-hidden p-2">
                  {{#if this.image_url}}
                    <img src="{{this.image_url}}" alt="{{this.name}}" class="w-full h-full object-contain transition-transform hover:scale-105" />
                  {{else}}
                    <span class="material-symbols-outlined text-4xl text-muted-foreground/40">science</span>
                  {{/if}}
                </div>

                <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase flex items-center gap-1 mb-1">
                  <span class="material-symbols-outlined text-xs">{{#if this.isValidated}}verified{{else}}link{{/if}}</span>
                  {{#if this.isValidated}}Validado{{else}}Relacionado{{/if}}
                </span>
                <h3 class="font-headline font-bold text-sm text-foreground mb-0.5">{{this.name}}</h3>
                <p class="text-xs text-muted-foreground font-semibold mb-3">{{#if this.activeIngredient}}{{this.activeIngredient}}{{else}}Ingrediente activo no registrado{{/if}}</p>
              </div>

              <a href="{{#if ../isPrivate}}/private/products/{{this.id}}{{else}}/products/{{this.id}}{{/if}}" class="w-full py-2 bg-white hover:bg-muted text-foreground font-bold text-xs rounded-md transition-colors border border-border text-center inline-block">
                Ver producto
              </a>
            </div>
          {{/each}}
        {{else}}
          <div class="md:col-span-3 bg-white p-6 rounded-xl border border-dashed border-border text-center text-xs text-muted-foreground">
            Esta plaga todavía no tiene productos relacionados.
          </div>
        {{/if}}
      </div>

      <!-- Botón Verde Sólido al Centro -->
      <div class="text-center">
        <a href="{{#if isPrivate}}/private/products{{else}}/products{{/if}}" class="inline-flex items-center justify-center px-6 py-3 bg-[#1b4332] hover:bg-[#1b4332]/90 text-white font-bold text-xs rounded-md transition-colors shadow-2xs">
          Ver catálogo completo de productos
        </a>
      </div>
    </section>

  </main>
</div>
