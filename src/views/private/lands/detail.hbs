{{!-- ============================================================
     TERRENOS — Vista de Detalle: El Expediente del Predio
     ============================================================ --}}
<main class="min-h-screen flex flex-col">
    <div class="mt-20 p-10 space-y-8">

        {{!-- ── Breadcrumb ── --}}
        <nav class="flex items-center gap-2 text-xs text-on-surface-variant">
            <a href="/private/lands" class="hover:text-primary transition-colors font-medium flex items-center gap-1">
                <span class="material-symbols-outlined text-sm" data-icon="landscape">landscape</span>
                Terrenos
            </a>
            <span class="material-symbols-outlined text-sm opacity-40" data-icon="chevron_right">chevron_right</span>
            <span class="font-bold text-[#0F2E2E]">Expediente: {{landName}}</span>
        </nav>

        {{!-- ── Cabecera del Expediente ── --}}
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-primary-container flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-2xl text-on-primary-container" data-icon="landscape">landscape</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <h1 class="text-xl font-extrabold text-[#0F2E2E]">{{landName}}</h1>
                            <span class="text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-100 px-2.5 py-0.5 rounded-full font-black uppercase">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block mr-1 align-middle"></span>Activo
                            </span>
                        </div>
                        <div class="flex flex-wrap items-center gap-4 text-xs text-on-surface-variant">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm" data-icon="location_on">location_on</span>
                                {{landLocation}} — <span class="font-mono ml-1">{{landLat}}, {{landLng}}</span>
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm" data-icon="straighten">straighten</span>
                                {{landHectares}} hectáreas
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm" data-icon="badge">badge</span>
                                ID: {{landId}}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button id="btn-open-edit-land" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition-colors">
                        <span class="material-symbols-outlined text-base" data-icon="edit">edit</span>
                        Editar Terreno
                    </button>
                </div>
            </div>
        </div>

        {{!-- ══════════════════════════════════════════════════════════
             SECCIÓN 1: VISTA DE CULTIVOS SEMBRADOS (Puntos 1 & 2)
             ══════════════════════════════════════════════════════════ --}}
        <div id="section-crop-list" class="space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-extrabold text-[#0F2E2E] flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary" data-icon="grass">grass</span>
                        Cultivos Sembrados en el Predio
                        <span class="bg-emerald-100 text-emerald-800 text-xs font-black px-2.5 py-0.5 rounded-full">{{farmCropsCount}}</span>
                    </h2>
                    <p class="text-xs text-on-surface-variant mt-0.5">Selecciona un cultivo sembrado para gestionar sus reportes de salud y bitácora de aplicaciones.</p>
                </div>
                <button id="btn-open-nuevo-ciclo" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#43655c] text-white text-sm font-bold hover:bg-[#0F2E2E] transition-all shadow-md hover:shadow-lg">
                    <span class="material-symbols-outlined text-base" data-icon="add_circle">add_circle</span>
                    Nuevo Ciclo de Cultivo
                </button>
            </div>

            {{#if farmCropsCount}}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {{#each farmCrops}}
                <div class="crop-card bg-white border border-slate-200 hover:border-primary/50 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
                    <div>
                        <div class="flex items-start justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-primary-container/40 group-hover:bg-primary-container flex items-center justify-center transition-colors">
                                <span class="material-symbols-outlined text-2xl text-on-primary-container" data-icon="energy_savings_leaf">energy_savings_leaf</span>
                            </div>
                            <span class="text-[10px] bg-slate-100 text-slate-700 font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider border border-slate-200">
                                {{this.status}}
                            </span>
                        </div>
                        <h3 class="text-base font-extrabold text-[#0F2E2E] mb-1 group-hover:text-primary transition-colors">
                            {{this.displayName}}
                        </h3>
                        <p class="text-xs font-medium text-slate-500 mb-3">
                            📍 Sección / Lote: <span class="font-bold text-slate-700">{{this.areaSection}}</span>
                        </p>
                        <div class="text-xs text-on-surface-variant space-y-1 pt-3 border-t border-slate-100">
                            <p class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm text-slate-400" data-icon="calendar_today">calendar_today</span>
                                Plantado el: <span class="font-bold text-slate-700">{{this.planting_date}}</span>
                            </p>
                        </div>
                    </div>
                    <div class="pt-5 mt-4">
                        <button data-crop-id="{{this.id}}" data-crop-name="{{this.displayName}}" data-crop-section="{{this.areaSection}}"
                            class="btn-select-crop w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-primary hover:text-white text-slate-700 text-xs font-bold transition-all border border-slate-200 hover:border-primary">
                            <span>Ver Expediente del Cultivo</span>
                            <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
                        </button>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center shadow-sm">
                <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
                    <span class="material-symbols-outlined text-3xl" data-icon="grass">grass</span>
                </div>
                <h3 class="text-base font-extrabold text-[#0F2E2E]">Sin Cultivos Sembrados Registrados</h3>
                <p class="text-xs text-on-surface-variant max-w-md mx-auto mt-1 mb-6">
                    Aún no has agregado cultivos en este predio. Puedes registrar varios cultivos activos divididos por lotes o áreas.
                </p>
                <button id="btn-open-nuevo-ciclo-empty" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#43655c] text-white text-sm font-bold hover:bg-[#0F2E2E] transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-base" data-icon="add">add</span>
                    Registrar Primer Cultivo
                </button>
            </div>
            {{/if}}
        </div>

        {{!-- ══════════════════════════════════════════════════════════
             SECCIÓN 2: EXPEDIENTE DETALLADO DEL CULTIVO SELECCIONADO
             ══════════════════════════════════════════════════════════ --}}
        <div id="section-crop-detail" class="hidden space-y-6">
            {{!-- Barra de navegación de retorno --}}
            <div class="flex items-center justify-between bg-white rounded-2xl border border-slate-100 p-4 shadow-sm">
                <button id="btn-back-to-crop-list" class="flex items-center gap-2 text-xs font-bold text-slate-600 hover:text-primary transition-colors bg-slate-50 hover:bg-slate-100 px-4 py-2 rounded-xl border border-slate-200">
                    <span class="material-symbols-outlined text-base" data-icon="arrow_back">arrow_back</span>
                    Volver a Lista de Cultivos
                </button>
                <div class="text-right">
                    <span class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Cultivo En Enfoque</span>
                    <h3 id="focused-crop-title" class="text-sm font-extrabold text-[#0F2E2E]">Cultivo Seleccionado</h3>
                </div>
            </div>

            {{!-- Contenedor de Pestañas --}}
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                {{!-- Tab Bar --}}
                <div class="flex border-b border-slate-100 bg-slate-50/50 overflow-x-auto">
                    <button data-tab="cultivo"
                        class="tab-btn flex items-center gap-2 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 border-primary text-[#0F2E2E] transition-colors">
                        <span class="material-symbols-outlined text-base" data-icon="grass">grass</span>
                        Estado del Cultivo
                    </button>
                    <button data-tab="reportes"
                        class="tab-btn flex items-center gap-2 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 border-transparent text-on-surface-variant hover:text-[#0F2E2E] transition-colors">
                        <span class="material-symbols-outlined text-base" data-icon="pest_control">pest_control</span>
                        Reportes de Salud
                        <span class="bg-red-100 text-red-700 text-[9px] font-black px-1.5 py-0.5 rounded-full">{{healthReportsCount}}</span>
                    </button>
                    <button data-tab="bitacora"
                        class="tab-btn flex items-center gap-2 px-6 py-4 text-sm font-bold whitespace-nowrap border-b-2 border-transparent text-on-surface-variant hover:text-[#0F2E2E] transition-colors">
                        <span class="material-symbols-outlined text-base" data-icon="science">science</span>
                        Bitácora de Aplicaciones
                    </button>
                </div>

                {{!-- ══ PESTAÑA 1: Estado del Cultivo ══ --}}
                <div id="tab-cultivo" class="tab-panel p-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
                        <div class="bg-primary-container/30 rounded-2xl p-5 border border-primary/10">
                            <p class="text-[10px] font-black text-on-surface-variant uppercase tracking-widest mb-2">Cultivo Sembrado</p>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center">
                                    <span class="material-symbols-outlined text-on-primary-container" data-icon="grass">grass</span>
                                </div>
                                <div>
                                    <p id="detail-crop-name" class="font-extrabold text-[#0F2E2E] text-base">Cultivo</p>
                                    <p id="detail-crop-section" class="text-xs text-on-surface-variant">Área: General</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-slate-50 rounded-2xl p-5 border border-slate-100">
                            <p class="text-[10px] font-black text-on-surface-variant uppercase tracking-widest mb-2">Estado Fenológico</p>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-emerald-700" data-icon="energy_savings_leaf">energy_savings_leaf</span>
                                </div>
                                <div>
                                    <p class="font-extrabold text-[#0F2E2E] text-base">En Crecimiento</p>
                                    <p class="text-xs text-on-surface-variant">Desarrollo vegetativo activo</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-slate-50 rounded-2xl p-5 border border-slate-100">
                            <p class="text-[10px] font-black text-on-surface-variant uppercase tracking-widest mb-2">Riego y Suelo</p>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-blue-700" data-icon="water_drop">water_drop</span>
                                </div>
                                <div>
                                    <p class="font-extrabold text-[#0F2E2E] text-base">{{farm.farming_type}}</p>
                                    <p class="text-xs text-on-surface-variant">Humedad de suelo óptima</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {{!-- ══ PESTAÑA 2: Reportes de Salud ══ --}}
                <div id="tab-reportes" class="tab-panel p-8 hidden">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="font-extrabold text-[#0F2E2E] text-base">Hallazgos Fitosanitarios & Alertas</h2>
                            <p class="text-xs text-on-surface-variant mt-0.5">Historial de plagas u observaciones detectadas en campo.</p>
                        </div>
                        <button id="btn-open-reporte" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-red-500 text-white text-sm font-bold hover:bg-red-600 transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-base" data-icon="add_alert">add_alert</span>
                            Reportar Hallazgo
                        </button>
                    </div>

                    {{#if healthReports.length}}
                    <div class="space-y-4">
                        {{#each healthReports}}
                        <div class="flex items-start gap-4 p-5 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 transition-colors">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 
                                {{#if (eq this.severidad 'alta')}}bg-red-100 text-red-700{{else if (eq this.severidad 'media')}}bg-amber-100 text-amber-700{{else}}bg-emerald-100 text-emerald-700{{/if}}">
                                <span class="material-symbols-outlined text-xl" data-icon="pest_control">pest_control</span>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-1">
                                    <h3 class="font-bold text-[#0F2E2E] text-sm">{{this.plaga_nombre}}</h3>
                                    <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded-full border
                                        {{#if (eq this.severidad 'alta')}}bg-red-50 text-red-700 border-red-200{{else if (eq this.severidad 'media')}}bg-amber-50 text-amber-700 border-amber-200{{else}}bg-emerald-50 text-emerald-700 border-emerald-200{{/if}}">
                                        Severidad: {{this.severidad}}
                                    </span>
                                </div>
                                <p class="text-xs text-slate-600 mb-2">{{this.descripcion}}</p>
                                <p class="text-[10px] text-slate-400 flex items-center gap-1 font-medium">
                                    <span class="material-symbols-outlined text-xs" data-icon="person">person</span>
                                    Reportado por {{this.reporter_name}}
                                </p>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 text-center">
                        <span class="material-symbols-outlined text-4xl text-slate-300 mb-2" data-icon="health_and_safety">health_and_safety</span>
                        <h3 class="font-bold text-[#0F2E2E]">Sin Alertas Sanitarias Registradas</h3>
                        <p class="text-xs text-on-surface-variant mt-1">El estado de la parcela se mantiene sin incidencias o plagas reportadas.</p>
                    </div>
                    {{/if}}
                </div>

                {{!-- ══ PESTAÑA 3: Bitácora de Aplicaciones Químicas ══ --}}
                <div id="tab-bitacora" class="tab-panel p-8 hidden">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="font-extrabold text-[#0F2E2E] text-base">Bitácora de Productos Químicos</h2>
                            <p class="text-xs text-on-surface-variant mt-0.5">Control de plaguicidas y fertilizantes aplicados.</p>
                        </div>
                        <button id="btn-open-aplicacion" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-[#43655c] text-white text-sm font-bold hover:bg-[#0F2E2E] transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-base" data-icon="add">add</span>
                            Registrar Aplicación
                        </button>
                    </div>

                    {{#if applicationLogs.length}}
                    <div class="overflow-x-auto border border-slate-200 rounded-2xl">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-[10px] font-black uppercase text-slate-500 tracking-wider border-b border-slate-200">
                                    <th class="px-6 py-4">Fecha</th>
                                    <th class="px-6 py-4">Producto Comercial</th>
                                    <th class="px-6 py-4">Ingrediente Activo</th>
                                    <th class="px-6 py-4">Dosis</th>
                                    <th class="px-6 py-4">Aplicador</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs">
                                {{#each applicationLogs}}
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-mono text-slate-500">{{this.fecha_aplicacion}}</td>
                                    <td class="px-6 py-4 font-bold text-[#0F2E2E]">{{this.producto_nombre}}</td>
                                    <td class="px-6 py-4 text-slate-600">{{this.ingrediente_activo}}</td>
                                    <td class="px-6 py-4 font-bold text-[#0F2E2E]">{{this.dosis}}</td>
                                    <td class="px-6 py-4 text-slate-600">{{this.applicator_name}}</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                    {{else}}
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 text-center">
                        <span class="material-symbols-outlined text-4xl text-slate-300 mb-2" data-icon="science">science</span>
                        <h3 class="font-bold text-[#0F2E2E]">Sin Registros en la Bitácora</h3>
                        <p class="text-xs text-on-surface-variant mt-1">Aún no se han registrado aplicaciones de productos fitosanitarios en este predio.</p>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>

    </div>
</main>


{{!-- ════════════════════════════════════════════
     MODAL 1 — Editar Terreno
     ════════════════════════════════════════════ --}}
<div id="modal-edit-land" class="hidden fixed inset-0 z-[200] flex items-center justify-center">
    <div id="modal-edit-land-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <form action="/lands/update/{{farm.id}}" method="POST" class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h3 class="font-extrabold text-[#0F2E2E] text-base flex items-center gap-2">
                <span class="material-symbols-outlined text-primary" data-icon="edit">edit</span>
                Editar Información del Terreno
            </h3>
            <button type="button" id="btn-close-edit-land" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined" data-icon="close">close</span>
            </button>
        </div>
        <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1">Nombre del Predio <span class="text-primary">*</span></label>
                <input type="text" name="name" value="{{farm.name}}" required class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none" />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Superficie (ha) <span class="text-primary">*</span></label>
                    <input type="number" step="0.1" name="size_hectares" value="{{farm.size_hectares}}" required class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Tipo de Agricultura</label>
                    <select name="farming_type" class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none">
                        <option value="Riego">Riego</option>
                        <option value="Temporal">Temporal</option>
                        <option value="Invernadero">Invernadero / Protegido</option>
                        <option value="Orgánico">Orgánico</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1">Municipio <span class="text-primary">*</span></label>
                <input type="text" name="municipality" value="{{farm.municipality}}" required class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1">Región Agrícola</label>
                <select name="region_id" class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none">
                    <option value="">— Seleccionar Región —</option>
                    {{#each regions}}
                    <option value="{{this.id}}">{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        <div class="flex justify-end gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50">
            <button type="button" id="btn-cancel-edit-land" class="px-5 py-2 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancelar</button>
            <button type="submit" class="px-6 py-2 rounded-xl bg-[#43655c] text-white text-sm font-bold hover:bg-[#0F2E2E]">Guardar Cambios</button>
        </div>
    </form>
</div>


{{!-- ════════════════════════════════════════════
     MODAL 2 — Nuevo Ciclo de Cultivo (Puntos 2 & 4)
     ════════════════════════════════════════════ --}}
<div id="modal-nuevo-ciclo" class="hidden fixed inset-0 z-[200] flex items-center justify-center">
    <div id="modal-nuevo-ciclo-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <form action="/lands/{{farm.id}}/crop/create" method="POST" class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h3 class="font-extrabold text-[#0F2E2E] text-base flex items-center gap-2">
                <span class="material-symbols-outlined text-primary" data-icon="grass">grass</span>
                Iniciar Nuevo Ciclo de Cultivo
            </h3>
            <button type="button" id="btn-close-nuevo-ciclo" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined" data-icon="close">close</span>
            </button>
        </div>
        <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1">Cultivo a Sembrar (Búsqueda en Catálogo) <span class="text-primary">*</span></label>
                <select id="select-crop-id" name="crop_id" required class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none">
                    <option value="">— Buscar o Seleccionar Cultivo —</option>
                    {{#each crops}}
                    <option value="{{this.id}}">{{this.name}} ({{this.common_name}})</option>
                    {{/each}}
                    <option value="otro" class="font-bold text-primary">➕ Otro / Personalizado (Escribir nombre)</option>
                </select>
            </div>
            
            {{!-- Campo dinámico para 'Otro Cultivo' --}}
            <div id="field-custom-crop" class="hidden bg-slate-50 p-4 rounded-xl border border-slate-200">
                <label class="block text-xs font-bold text-slate-700 mb-1">Nombre del Cultivo Personalizado <span class="text-primary">*</span></label>
                <input type="text" id="input-custom-crop-name" name="custom_crop_name" placeholder="Ej. Chile Jalapeño Criollo, Melón Cantaloupe..." class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm bg-white focus:ring-2 focus:ring-primary/20 outline-none" />
                <p class="text-[10px] text-slate-500 mt-1">Este cultivo se registrará en tu predio sin necesidad de agregarlo al catálogo base.</p>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1">Área / Sección / Lote de la Parcela</label>
                <input type="text" name="area_section" placeholder="Ej. Lote Norte 1, Sector A, Invernadero 2..." class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none" />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Fecha de Siembra <span class="text-primary">*</span></label>
                    <input type="date" name="planting_date" required class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Etapa Inicial</label>
                    <select name="status" class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 outline-none">
                        <option value="Siembra">Siembra / Germinación</option>
                        <option value="En Crecimiento" selected>En Crecimiento</option>
                        <option value="Floración">Floración</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="flex justify-end gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50">
            <button type="button" id="btn-cancel-nuevo-ciclo" class="px-5 py-2 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-100">Cancelar</button>
            <button type="submit" class="px-6 py-2 rounded-xl bg-[#43655c] text-white text-sm font-bold hover:bg-[#0F2E2E]">Iniciar Ciclo</button>
        </div>
    </form>
</div>


{{!-- ════════════════════════════════════════════
     MODAL 3 — Reportar Hallazgo de Plaga (Puntos 3 & 4)
     ════════════════════════════════════════════ --}}
<div id="modal-reporte" class="hidden fixed inset-0 z-[200] flex items-center justify-center">
    <div id="modal-reporte-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <form action="/lands/{{farm.id}}/health-report/create" method="POST" class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h3 class="font-extrabold text-[#0F2E2E] text-base flex items-center gap-2">
                <span class="material-symbols-outlined text-primary" data-icon="pest_control">pest_control</span>
                Reportar Hallazgo de Plaga
            </h3>
            <button type="button" id="btn-close-reporte" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined" data-icon="close">close</span>
            </button>
        </div>
        <div class="p-6 space-y-5 max-h-[70vh] overflow-y-auto">
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5">Plaga Identificada (Búsqueda en Catálogo) <span class="text-primary">*</span></label>
                <select id="select-plague-id" name="plaga_nombre" required class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                    <option value="">— Buscar o Seleccionar Plaga —</option>
                    {{#each plagues}}
                    <option value="{{this.name}}">{{this.name}} ({{this.scientific_name}})</option>
                    {{/each}}
                    <option value="otro" class="font-bold text-red-600">➕ Otro / Desconocido (Escribir nombre)</option>
                </select>
            </div>

            {{!-- Campo dinámico para 'Plaga Desconocida' --}}
            <div id="field-custom-plague" class="hidden bg-red-50 p-4 rounded-xl border border-red-200">
                <label class="block text-xs font-bold text-red-800 mb-1">Nombre de la Plaga o Sintomatología <span class="text-primary">*</span></label>
                <input type="text" id="input-custom-plague-name" name="custom_plaga_nombre" placeholder="Ej. Mancha foliar inusual, Ácaro rojizo no identificado..." class="w-full px-4 py-2 border border-red-200 rounded-xl text-sm bg-white focus:ring-2 focus:ring-red-200 outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-600 mb-2">Nivel de Severidad <span class="text-primary">*</span></label>
                <div class="grid grid-cols-3 gap-3">
                    <label class="flex items-center justify-center gap-2 p-3 rounded-xl border-2 border-slate-200 cursor-pointer hover:border-primary transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-container/20">
                        <input type="radio" name="severidad" value="baja" checked class="accent-primary" />
                        <div class="text-center">
                            <p class="text-lg">🟡</p>
                            <p class="text-xs font-bold text-slate-600">Baja</p>
                        </div>
                    </label>
                    <label class="flex items-center justify-center gap-2 p-3 rounded-xl border-2 border-slate-200 cursor-pointer hover:border-primary transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-container/20">
                        <input type="radio" name="severidad" value="media" class="accent-primary" />
                        <div class="text-center">
                            <p class="text-lg">🟠</p>
                            <p class="text-xs font-bold text-slate-600">Media</p>
                        </div>
                    </label>
                    <label class="flex items-center justify-center gap-2 p-3 rounded-xl border-2 border-slate-200 cursor-pointer hover:border-primary transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-container/20">
                        <input type="radio" name="severidad" value="alta" class="accent-primary" />
                        <div class="text-center">
                            <p class="text-lg">🔴</p>
                            <p class="text-xs font-bold text-slate-600">Alta</p>
                        </div>
                    </label>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5">Descripción del Hallazgo</label>
                <textarea name="descripcion" rows="3" placeholder="Describe lo que observaste en campo..." class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none resize-none"></textarea>
            </div>
        </div>
        <div class="flex justify-end gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50">
            <button type="button" id="btn-cancel-reporte" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancelar</button>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-red-500 text-white text-sm font-bold hover:bg-red-600 transition-colors shadow-sm">Enviar Reporte</button>
        </div>
    </form>
</div>


{{!-- ════════════════════════════════════════════
     MODAL 4 — Registrar Aplicación Química (Puntos 3 & 4)
     ════════════════════════════════════════════ --}}
<div id="modal-aplicacion" class="hidden fixed inset-0 z-[200] flex items-center justify-center">
    <div id="modal-aplicacion-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <form action="/lands/{{farm.id}}/application-log/create" method="POST" class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h3 class="font-extrabold text-[#0F2E2E] text-base flex items-center gap-2">
                <span class="material-symbols-outlined text-primary" data-icon="science">science</span>
                Registrar Aplicación Química
            </h3>
            <button type="button" id="btn-close-aplicacion" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined" data-icon="close">close</span>
            </button>
        </div>
        <div class="p-6 space-y-5 max-h-[70vh] overflow-y-auto">
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5">Producto Comercial (Búsqueda en Catálogo) <span class="text-primary">*</span></label>
                <select id="select-product-id" name="producto_nombre" required class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none">
                    <option value="">— Buscar o Seleccionar Producto —</option>
                    {{#each products}}
                    <option value="{{this.name}}" data-active-ingredient="{{this.active_ingredient}}">{{this.name}} ({{this.active_ingredient}})</option>
                    {{/each}}
                    <option value="otro" class="font-bold text-primary">➕ Otro Producto (Escribir nombre)</option>
                </select>
            </div>

            {{!-- Campo dinámico para 'Otro Producto' --}}
            <div id="field-custom-product" class="hidden bg-slate-50 p-4 rounded-xl border border-slate-200">
                <label class="block text-xs font-bold text-slate-700 mb-1">Nombre del Producto Personalizado <span class="text-primary">*</span></label>
                <input type="text" id="input-custom-product-name" name="custom_producto_nombre" placeholder="Ej. Bio-Fungicida Orgánico Especial..." class="w-full px-4 py-2 border border-slate-200 rounded-xl text-sm bg-white focus:ring-2 focus:ring-primary/20 outline-none" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5">Ingrediente Activo</label>
                    <input type="text" id="input-active-ingredient" name="ingrediente_activo" placeholder="Ej. Clorpirifós" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5">Dosis Aplicada <span class="text-primary">*</span></label>
                    <input type="text" name="dosis" required placeholder="Ej. 1.5 L/ha" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5">Fecha de Aplicación <span class="text-primary">*</span></label>
                <input type="date" name="fecha_aplicacion" required class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-on-surface-variant" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5">Notas adicionales</label>
                <textarea name="notas" rows="2" placeholder="Condiciones climatológicas, método de aplicación, etc." class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none resize-none"></textarea>
            </div>
        </div>
        <div class="flex justify-end gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50">
            <button type="button" id="btn-cancel-aplicacion" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancelar</button>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-[#43655c] text-white text-sm font-bold hover:bg-[#0F2E2E] transition-colors shadow-sm">Guardar Registro</button>
        </div>
    </form>
</div>
