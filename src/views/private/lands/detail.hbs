<div class="mx-auto max-w-7xl space-y-7 pb-12 pt-6 text-foreground">
    <nav class="flex items-center gap-2 text-xs text-muted-foreground" aria-label="Ruta de navegación">
        <a href="/private/lands" class="font-semibold transition-colors hover:text-primary">Terrenos</a>
        <span aria-hidden="true">/</span>
        <span class="font-bold text-foreground">{{land.name}}</span>
    </nav>

    <header class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex flex-col justify-between gap-5 lg:flex-row lg:items-start">
            <div>
                <div class="mb-2 flex flex-wrap items-center gap-3">
                    <p class="text-xs font-black uppercase tracking-[0.18em] text-primary">Expediente operativo</p>
                    <span class="rounded-full px-2.5 py-1 text-[10px] font-black uppercase {{#if land.status}}bg-emerald-50 text-emerald-700{{else}}bg-slate-100 text-slate-600{{/if}}">
                        {{#if land.status}}Activo{{else}}Archivado{{/if}}
                    </span>
                </div>
                <h1 class="text-2xl font-extrabold tracking-tight text-foreground md:text-3xl">{{land.name}}</h1>
                <p class="mt-2 text-sm text-muted-foreground">
                    {{#if land.municipality}}{{land.municipality}}{{else}}Municipio sin especificar{{/if}}
                    {{#if land.region}} · {{land.region.name}}{{/if}}
                    · {{landId}}
                </p>
                {{#if land.user}}
                <p class="mt-1 text-sm text-muted-foreground">Responsable: <span class="font-semibold text-foreground">{{land.user.full_name}}</span></p>
                {{/if}}
            </div>

            <div class="flex flex-wrap gap-2">
                {{#if permissions.canEdit}}
                <button id="btn-open-edit-land" type="button" class="rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground transition-colors hover:bg-muted">
                    Editar terreno
                </button>
                {{/if}}
                {{#if permissions.canArchive}}
                <form action="/private/lands/archive/{{land.id}}" method="POST">
                    <button type="submit" class="rounded-xl border border-amber-200 px-4 py-2.5 text-sm font-bold text-amber-700 transition-colors hover:bg-amber-50">Archivar</button>
                </form>
                {{/if}}
                {{#if permissions.canRestore}}
                <form action="/private/lands/restore/{{land.id}}" method="POST">
                    <button type="submit" class="rounded-xl border border-emerald-200 px-4 py-2.5 text-sm font-bold text-emerald-700 transition-colors hover:bg-emerald-50">Restaurar</button>
                </form>
                {{/if}}
            </div>
        </div>
    </header>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumen del terreno">
        <article class="rounded-2xl border border-border bg-card p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Superficie</p>
            <p class="mt-2 text-2xl font-extrabold text-foreground">{{landHectares}} <span class="text-sm font-semibold text-muted-foreground">ha</span></p>
        </article>
        <article class="rounded-2xl border border-border bg-card p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Agricultura</p>
            <p class="mt-2 text-lg font-extrabold text-foreground">{{#if land.farming_type}}{{land.farming_type}}{{else}}No especificada{{/if}}</p>
        </article>
        <article class="rounded-2xl border border-border bg-card p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Región</p>
            <p class="mt-2 text-lg font-extrabold text-foreground">{{#if land.region}}{{land.region.name}}{{else}}Sin región{{/if}}</p>
        </article>
        <article class="rounded-2xl border border-border bg-card p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Municipio</p>
            <p class="mt-2 text-lg font-extrabold text-foreground">{{#if land.municipality}}{{land.municipality}}{{else}}Sin municipio{{/if}}</p>
        </article>
    </section>

    <div class="grid gap-6 lg:grid-cols-5">
        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm lg:col-span-2">
            <h2 class="text-lg font-extrabold text-foreground">Ubicación registrada</h2>
            {{#if land.location_lat}}
            <dl class="mt-5 grid grid-cols-2 gap-4">
                <div class="rounded-xl bg-muted p-4">
                    <dt class="text-xs font-bold uppercase text-muted-foreground">Latitud</dt>
                    <dd class="mt-1 font-mono text-sm font-semibold text-foreground">{{landLat}}</dd>
                </div>
                <div class="rounded-xl bg-muted p-4">
                    <dt class="text-xs font-bold uppercase text-muted-foreground">Longitud</dt>
                    <dd class="mt-1 font-mono text-sm font-semibold text-foreground">{{landLng}}</dd>
                </div>
            </dl>
            <p class="mt-4 text-xs leading-relaxed text-muted-foreground">Las coordenadas son información privada del expediente y no se muestran en el área pública.</p>
            {{else}}
            <p class="mt-4 rounded-xl bg-muted p-4 text-sm text-muted-foreground">Todavía no se ha registrado una ubicación para este terreno.</p>
            {{/if}}
        </section>

        <section class="rounded-2xl border border-border bg-card p-6 shadow-sm lg:col-span-3">
            <h2 class="text-lg font-extrabold text-foreground">Seguimiento agrícola</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Este expediente será el punto de entrada para consultar ciclos de cultivo, etapas fenológicas, hallazgos fitosanitarios y aplicaciones registradas.</p>
            <div class="mt-5 grid gap-3 sm:grid-cols-3">
                <div class="rounded-xl border border-dashed border-border p-4">
                    <p class="text-sm font-bold text-foreground">Ciclos de cultivo</p>
                    <p class="mt-1 text-xs text-muted-foreground">Sin registros conectados.</p>
                </div>
                <div class="rounded-xl border border-dashed border-border p-4">
                    <p class="text-sm font-bold text-foreground">Hallazgos</p>
                    <p class="mt-1 text-xs text-muted-foreground">Sin registros conectados.</p>
                </div>
                <div class="rounded-xl border border-dashed border-border p-4">
                    <p class="text-sm font-bold text-foreground">Aplicaciones</p>
                    <p class="mt-1 text-xs text-muted-foreground">Sin registros conectados.</p>
                </div>
            </div>
        </section>
    </div>
</div>

{{#if permissions.canEdit}}
<div id="modal-edit-land" class="hidden fixed inset-0 z-[200] items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="edit-land-title">
    <button id="modal-edit-land-backdrop" type="button" class="absolute inset-0 bg-black/40 backdrop-blur-sm" aria-label="Cerrar edición"></button>
    <div class="relative z-10 w-full max-w-2xl overflow-hidden rounded-2xl border border-border bg-card shadow-2xl">
        <header class="flex items-center justify-between border-b border-border px-6 py-4">
            <h2 id="edit-land-title" class="text-lg font-extrabold text-foreground">Editar terreno</h2>
            <button id="btn-close-edit-land" type="button" class="rounded-lg px-3 py-2 text-sm font-bold text-muted-foreground hover:bg-muted">Cerrar</button>
        </header>
        <form action="/private/lands/update/{{land.id}}" method="POST">
            <div class="grid max-h-[70vh] gap-5 overflow-y-auto p-6 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    <label for="edit-land-name" class="mb-1.5 block text-xs font-bold text-muted-foreground">Nombre del terreno</label>
                    <input id="edit-land-name" name="name" value="{{land.name}}" required minlength="2" maxlength="120" class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label for="edit-land-size" class="mb-1.5 block text-xs font-bold text-muted-foreground">Superficie en hectáreas</label>
                    <input id="edit-land-size" name="size_hectares" type="number" value="{{land.size_hectares}}" required min="0.01" max="1000000" step="0.01" class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label for="edit-land-municipality" class="mb-1.5 block text-xs font-bold text-muted-foreground">Municipio</label>
                    <input id="edit-land-municipality" name="municipality" value="{{land.municipality}}" maxlength="100" class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label for="edit-land-type" class="mb-1.5 block text-xs font-bold text-muted-foreground">Tipo de agricultura</label>
                    <select id="edit-land-type" name="farming_type" class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
                        <option value="">Sin especificar</option>
                        <option value="Temporal" {{#if (eq land.farming_type 'Temporal')}}selected{{/if}}>Temporal</option>
                        <option value="Riego" {{#if (eq land.farming_type 'Riego')}}selected{{/if}}>Riego</option>
                        <option value="Mixto" {{#if (eq land.farming_type 'Mixto')}}selected{{/if}}>Mixto</option>
                        <option value="Tecnificado" {{#if (eq land.farming_type 'Tecnificado')}}selected{{/if}}>Tecnificado</option>
                        <option value="Orgánico" {{#if (eq land.farming_type 'Orgánico')}}selected{{/if}}>Orgánico</option>
                        <option value="Hidroponía" {{#if (eq land.farming_type 'Hidroponía')}}selected{{/if}}>Hidroponía</option>
                    </select>
                </div>
                <div>
                    <label for="edit-land-region" class="mb-1.5 block text-xs font-bold text-muted-foreground">Región agrícola</label>
                    <select id="edit-land-region" name="region_id" class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
                        <option value="">Sin especificar</option>
                        {{#each regions}}
                        <option value="{{this.id}}" {{#if (eq this.id @root.land.region_id)}}selected{{/if}}>{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                <div>
                    <label for="edit-land-lat" class="mb-1.5 block text-xs font-bold text-muted-foreground">Latitud</label>
                    <input id="edit-land-lat" name="location_lat" type="number" value="{{land.location_lat}}" min="-90" max="90" step="0.0000001" class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label for="edit-land-lng" class="mb-1.5 block text-xs font-bold text-muted-foreground">Longitud</label>
                    <input id="edit-land-lng" name="location_lng" type="number" value="{{land.location_lng}}" min="-180" max="180" step="0.0000001" class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
                </div>
            </div>
            <footer class="flex justify-end gap-3 border-t border-border bg-muted/50 px-6 py-4">
                <button id="btn-cancel-edit-land" type="button" class="rounded-xl border border-border bg-card px-5 py-2.5 text-sm font-bold text-muted-foreground hover:bg-muted">Cancelar</button>
                <button type="submit" class="rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-white hover:bg-primary/90">Guardar cambios</button>
            </footer>
        </form>
    </div>
</div>
{{/if}}
