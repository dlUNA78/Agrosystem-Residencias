<main class="pt-24 px-10 pb-12 min-h-screen">

    {{!-- ── Page Header ── --}}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h2 class="text-2xl font-extrabold text-[#0F2E2E] leading-tight">Reportes y Estadísticas Operativas</h2>
            <p class="text-xs text-slate-400 font-medium mt-1">Ciclo agrícola activo · Sinaloa, México · Período: <span class="capitalize font-bold text-slate-600">{{query.period}}</span></p>
        </div>
        <div class="flex items-center gap-3 relative">
            <!-- Period Selector -->
            <label for="report-period" class="sr-only">Seleccionar Período</label>
            <select id="report-period"
                class="bg-white border border-slate-200 rounded-xl py-2.5 px-4 text-sm text-slate-600 font-semibold shadow-sm focus:ring-2 focus:ring-primary/20 cursor-pointer">
                <option value="mensual" {{#if (eq query.period 'mensual')}}selected{{/if}}>Último Mes (30 días)</option>
                <option value="trimestral" {{#if (eq query.period 'trimestral')}}selected{{/if}}>Trimestre (90 días)</option>
                <option value="anual" {{#if (eq query.period 'anual')}}selected{{/if}}>Año Completo</option>
            </select>

            <!-- Export Button & Dropdown -->
            <div class="relative">
                <button type="button" id="btn-export-report"
                    class="bg-[#2D4F4F] hover:bg-[#0F2E2E] text-white px-5 py-2.5 rounded-xl font-bold text-sm flex items-center gap-2 transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-base" data-icon="download">download</span>
                    <span>Exportar CSV</span>
                    <span class="material-symbols-outlined text-xs" data-icon="arrow_drop_down">arrow_drop_down</span>
                </button>

                <!-- Export Options Menu -->
                <div id="export-dropdown-menu"
                    class="hidden absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50 animate-in fade-in zoom-in-95 duration-100">
                    <div class="px-4 py-2 border-b border-slate-100">
                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Descargar reporte en Excel / CSV</p>
                    </div>
                    <a href="/private/reports?format=csv&period={{query.period}}&reportType=applications"
                        class="flex items-center gap-3 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg text-blue-600" data-icon="water_drop">water_drop</span>
                        <span>Aplicaciones de Agroquímicos</span>
                    </a>
                    <a href="/private/reports?format=csv&period={{query.period}}&reportType=health"
                        class="flex items-center gap-3 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg text-emerald-600" data-icon="bug_report">bug_report</span>
                        <span>Sanidad e Incidencias</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {{#if errorMessage}}
    <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-semibold flex items-center gap-3">
        <span class="material-symbols-outlined text-xl">error</span>
        <span>{{errorMessage}}</span>
    </div>
    {{/if}}

    {{!-- ── Row 1: KPI Cards ── --}}
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50 hover:shadow-[0_20px_25px_-5px_rgba(0,0,0,0.07)] transition-all">
            <div class="flex items-start justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                    <span class="material-symbols-outlined text-2xl" data-icon="bug_report">bug_report</span>
                </div>
                <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">Período</span>
            </div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Plagas Reportadas</p>
            <span class="text-3xl font-extrabold text-[#0F2E2E]">{{kpis.reportedPlagues}}</span>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50 hover:shadow-[0_20px_25px_-5px_rgba(0,0,0,0.07)] transition-all">
            <div class="flex items-start justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500">
                    <span class="material-symbols-outlined text-2xl" data-icon="water_drop">water_drop</span>
                </div>
                <span class="text-[11px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full">{{kpis.formattedHectares}}</span>
            </div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Aplicaciones Químicas</p>
            <span class="text-3xl font-extrabold text-[#0F2E2E]">{{kpis.chemicalApplications}}</span>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50 hover:shadow-[0_20px_25px_-5px_rgba(0,0,0,0.07)] transition-all">
            <div class="flex items-start justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-500">
                    <span class="material-symbols-outlined text-2xl" data-icon="landscape">landscape</span>
                </div>
                <span class="text-[11px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">Activos</span>
            </div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Predios Monitoreados</p>
            <span class="text-3xl font-extrabold text-[#0F2E2E]">{{kpis.monitoredFarms}}</span>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50 hover:shadow-[0_20px_25px_-5px_rgba(0,0,0,0.07)] transition-all">
            <div class="flex items-start justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center text-red-500">
                    <span class="material-symbols-outlined text-2xl" data-icon="notification_important">notification_important</span>
                </div>
                <span class="text-[11px] font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded-full uppercase">Críticas</span>
            </div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Alertas Sanitarias</p>
            <span class="text-3xl font-extrabold text-[#0F2E2E]">{{kpis.criticalAlerts}}</span>
        </div>
    </section>

    {{!-- ── Row 2: Charts ── --}}
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">

        {{!-- Left (2/3): Aplicaciones por mes — Bar Chart CSS --}}
        <div class="lg:col-span-2 bg-white p-8 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="font-extrabold text-[#0F2E2E]">Aplicaciones Químicas por Mes</h3>
                    <p class="text-[11px] text-slate-400 font-medium mt-0.5">Histórico reciente de aplicaciones</p>
                </div>
                <span class="text-[11px] font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-full">Operación Campo</span>
            </div>
            <!-- Bar Chart -->
            <div class="flex items-end gap-3 h-44 mt-4">
                {{#each monthlyApplications}}
                <div class="flex-1 flex flex-col items-center gap-2">
                    <span class="text-[10px] font-bold text-slate-500">{{count}}</span>
                    <div class="w-full rounded-t-lg transition-all hover:opacity-80" style="height: {{heightPercentage}}%; background-color: {{barColor}};"></div>
                    <span class="text-[10px] text-slate-400 font-semibold">{{label}}</span>
                </div>
                {{/each}}
            </div>
            <div class="flex items-center gap-5 mt-4 pt-4 border-t border-slate-100">
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-sm bg-[#0F2E2E]"></div>
                    <span class="text-[11px] text-slate-500 font-semibold">Aplicaciones realizadas</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-sm bg-slate-200"></div>
                    <span class="text-[11px] text-slate-500 font-semibold">Sin registros</span>
                </div>
            </div>
        </div>

        {{!-- Right (1/3): Distribución por tipo de producto --}}
        <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50">
            <div class="flex items-center justify-between mb-6">
                <h3 class="font-extrabold text-[#0F2E2E]">Tipo de Producto Aplicado</h3>
            </div>
            <!-- Donut -->
            <div class="flex justify-center mb-6">
                <div class="relative w-36 h-36 rounded-full flex items-center justify-center">
                    <div class="absolute inset-0 rounded-full"
                        style="{{productDistribution.conicGradientStyle}} mask: radial-gradient(transparent 62%, black 64%); -webkit-mask: radial-gradient(transparent 62%, black 64%);">
                    </div>
                    <div class="text-center z-10">
                        <span class="block text-xl font-black text-[#0F2E2E] leading-none">{{productDistribution.total}}</span>
                        <span class="text-[9px] text-slate-400 uppercase font-bold tracking-wide">apps.</span>
                    </div>
                </div>
            </div>
            <!-- Legend -->
            <div class="space-y-3">
                {{#if productDistribution.types.length}}
                    {{#each productDistribution.types}}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-2.5 h-2.5 rounded-full" style="background-color: {{color}};"></div>
                            <span class="text-xs font-semibold text-slate-600">{{name}}</span>
                        </div>
                        <span class="text-xs font-black text-slate-800">{{percentage}}% ({{count}})</span>
                    </div>
                    {{/each}}
                {{else}}
                    <p class="text-xs text-center text-slate-400 py-4">Sin datos de aplicación en este período</p>
                {{/if}}
            </div>
        </div>
    </section>

    {{!-- ── Row 3: Top Plagas + Top Predios ── --}}
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">

        {{!-- Top 5 Plagas --}}
        <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50">
            <div class="flex items-center justify-between mb-7">
                <h3 class="font-extrabold text-[#0F2E2E]">Top Plagas del Período</h3>
                <a href="/private/plagues" class="text-xs font-bold text-primary hover:underline">Ver catálogo →</a>
            </div>
            <div class="space-y-5">
                {{#if hasPlagues}}
                    {{#each topPlagues}}
                    <div class="space-y-1.5">
                        <div class="flex justify-between text-xs font-bold">
                            <span class="text-slate-600">{{name}}</span>
                            <span class="text-slate-900">{{count}} reportes</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2">
                            <div class="h-2 rounded-full" style="width: {{percentage}}%; background-color: {{color}};"></div>
                        </div>
                    </div>
                    {{/each}}
                {{else}}
                    <div class="py-8 text-center">
                        <span class="material-symbols-outlined text-4xl text-slate-300 mb-2">pest_control</span>
                        <p class="text-xs font-semibold text-slate-400">No se registraron incidencias fitosanitarias en este período.</p>
                    </div>
                {{/if}}
            </div>
        </div>

        {{!-- Predios con más alertas --}}
        <div class="bg-white p-8 rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50">
            <div class="flex items-center justify-between mb-7">
                <h3 class="font-extrabold text-[#0F2E2E]">Predios con Mayor Actividad</h3>
                <a href="/private/lands" class="text-xs font-bold text-primary hover:underline">Ver terrenos →</a>
            </div>
            <div class="space-y-3">
                {{#if activeFarms.length}}
                    {{#each activeFarms}}
                    <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-emerald-600 text-lg" data-icon="landscape">landscape</span>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-slate-800">{{name}}</p>
                                <p class="text-[10px] text-slate-400">{{municipality}} · {{sizeHectares}} ha</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="px-2.5 py-1 {{alertBadgeClass}} rounded-full text-[10px] font-black uppercase">{{alertBadgeText}}</span>
                        </div>
                    </div>
                    {{/each}}
                {{else}}
                    <div class="py-8 text-center">
                        <span class="material-symbols-outlined text-4xl text-slate-300 mb-2">landscape</span>
                        <p class="text-xs font-semibold text-slate-400">No se encontraron predios activos registrados.</p>
                    </div>
                {{/if}}
            </div>
        </div>
    </section>

    {{!-- ── Row 4: Últimas Aplicaciones Químicas ── --}}
    <section class="bg-white rounded-2xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.05),0_2px_10px_-2px_rgba(0,0,0,0.02)] border border-slate-50 overflow-hidden mb-8">
        <div class="flex items-center justify-between px-8 py-6 border-b border-slate-50">
            <div>
                <h3 class="font-extrabold text-[#0F2E2E]">Últimas Aplicaciones Registradas</h3>
                <p class="text-xs text-slate-400 font-medium mt-0.5">Trazabilidad de agroquímicos aplicados en campo</p>
            </div>
            <a href="/private/reports?format=csv&period={{query.period}}&reportType=applications"
               class="text-xs font-bold text-[#2D4F4F] hover:text-[#0F2E2E] transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-sm" data-icon="download">download</span>
                Descargar bitácora completa
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[700px]">
                <thead>
                    <tr class="bg-slate-50/60">
                        <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Fecha</th>
                        <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Predio</th>
                        <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Producto</th>
                        <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Ingrediente Activo</th>
                        <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400 text-center">Dosis</th>
                        <th class="px-8 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400 text-center">Técnico</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {{#if hasApplications}}
                        {{#each latestApplications}}
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-8 py-5 text-xs text-slate-500 font-semibold">{{formattedDate}}</td>
                            <td class="px-8 py-5">
                                <p class="text-sm font-bold text-slate-800">{{farmName}}</p>
                                <p class="text-[10px] text-slate-400">{{farmDetails}}</p>
                            </td>
                            <td class="px-8 py-5">
                                <p class="text-sm font-semibold text-slate-700">{{productName}}</p>
                                <span class="px-2 py-0.5 {{categoryBadgeClass}} rounded text-[10px] font-bold">{{category}}</span>
                            </td>
                            <td class="px-8 py-5 text-sm text-slate-600 italic">{{activeIngredient}}</td>
                            <td class="px-8 py-5 text-center text-xs font-bold text-slate-700">{{doseText}}</td>
                            <td class="px-8 py-5 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-[#0F2E2E] flex items-center justify-center text-white text-[10px] font-extrabold">{{technicianInitials}}</div>
                                    <span class="text-xs font-semibold text-slate-600">{{technicianName}}</span>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="6" class="px-8 py-10 text-center text-sm font-medium text-slate-400">
                                <div class="flex flex-col items-center gap-2">
                                    <span class="material-symbols-outlined text-4xl text-slate-300">water_drop</span>
                                    <span>No se encontraron aplicaciones de agroquímicos registradas en este período.</span>
                                </div>
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </section>

</main>

<script src="/js/private/reports/reportsFilter.js"></script>
