<div id="audit-page-root" class="mx-auto max-w-7xl space-y-5 font-['Geist'] text-slate-900">
  <header class="flex flex-col gap-3 rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav aria-label="Ruta de navegación" class="mb-1.5 flex items-center gap-1.5 text-[11px] font-medium text-slate-500">
        <a href="/dashboard" class="transition-colors hover:text-[#1b4332]">Panel</a>
        <span aria-hidden="true">/</span>
        <span class="font-semibold text-slate-800">Auditoría</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2.5">
        <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
          Bitácora Institucional de Auditoría
        </h1>
        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-[#1b4332]">
          Trazabilidad Activa
        </span>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        Registro inmutable de operaciones técnicas, cambios de flujo editorial y mutaciones con inspección de carga JSON.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div class="inline-flex items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50/70 px-3.5 py-2 text-xs text-[#1b4332]">
        <span class="h-2 w-2 rounded-full bg-emerald-600 animate-pulse" aria-hidden="true"></span>
        <span>Hoy: <strong class="font-['Geist_Mono'] font-bold">{{todayActionsCount}}</strong> eventos</span>
      </div>
      <a
        href="/private/audit?format=csv{{filterSuffix}}"
        id="btn-export-daily"
        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:bg-slate-50 hover:text-[#1b4332]"
      >
        <i data-lucide="file-spreadsheet" class="h-3.5 w-3.5 text-[#1b4332]"></i>
        <span>Descargar reporte CSV</span>
      </a>
    </div>
  </header>

  {{#if error}}
  <div role="alert" class="flex items-center gap-2.5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-xs font-semibold text-rose-800">
    <i data-lucide="alert-circle" class="h-4 w-4 shrink-0 text-rose-600"></i>
    <span>{{error}}</span>
  </div>
  {{/if}}

  {{> private/search-bar}}

  <form
    id="audit-date-filter-form"
    action="/private/audit"
    method="GET"
    class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/90 bg-white px-4 py-2.5 text-xs shadow-2xs"
  >
    <input type="hidden" name="search" value="{{query.search}}" />
    <input type="hidden" name="module" value="{{query.module}}" />
    <input type="hidden" name="action" value="{{query.action}}" />

    <div class="flex flex-wrap items-center gap-2.5">
      <span class="inline-flex items-center gap-1.5 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
        <i data-lucide="calendar-range" class="h-3.5 w-3.5 text-[#1b4332]"></i>
        Periodo:
      </span>
      <label class="inline-flex items-center gap-1.5 text-slate-600">
        <span class="text-[11px]">Desde</span>
        <input
          type="date"
          name="dateFrom"
          value="{{query.dateFrom}}"
          aria-label="Fecha inicial"
          class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-['Geist_Mono'] text-[11px] text-slate-800 focus:border-[#1b4332] focus:bg-white focus:outline-none"
        />
      </label>
      <label class="inline-flex items-center gap-1.5 text-slate-600">
        <span class="text-[11px]">Hasta</span>
        <input
          type="date"
          name="dateTo"
          value="{{query.dateTo}}"
          aria-label="Fecha final"
          class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-['Geist_Mono'] text-[11px] text-slate-800 focus:border-[#1b4332] focus:bg-white focus:outline-none"
        />
      </label>
      <button
        type="submit"
        class="rounded-lg bg-slate-900 px-3 py-1.5 text-[11px] font-semibold text-white transition-colors hover:bg-slate-800 cursor-pointer"
      >
        Aplicar fechas
      </button>
    </div>

    <p class="text-[11px] text-slate-500" role="status">
      Mostrando <strong class="font-['Geist_Mono'] text-slate-900">{{startRecord}}–{{endRecord}}</strong> de
      <strong class="font-['Geist_Mono'] text-slate-900">{{totalCount}}</strong> eventos auditados
    </p>
  </form>

  <div id="audit-results-region" class="space-y-4">
    <div
      id="audit-table-view"
      class="hidden overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-2xs"
    >
      <div class="overflow-x-auto">
        <table class="w-full min-w-[920px] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/80 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-5 py-3.5">Fecha y Hora</th>
              <th class="px-4 py-3.5">Actor</th>
              <th class="px-4 py-3.5">Acción Ejecutada</th>
              <th class="px-4 py-3.5 text-center">Módulo</th>
              <th class="px-4 py-3.5">Resumen</th>
              <th class="px-5 py-3.5 text-right">Payload</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs">
            {{#if auditLogs.length}}
            {{#each auditLogs}}
            <tr class="transition-colors hover:bg-slate-50/70">
              <td class="px-5 py-3.5">
                <p class="font-semibold text-slate-900">{{this.dates.dateText}} · <span class="font-['Geist_Mono']">{{this.dates.timeText}}</span></p>
                <p class="font-['Geist_Mono'] text-[11px] text-slate-400">{{this.dates.fullDate}}</p>
              </td>
              <td class="px-4 py-3.5">
                <div class="flex items-center gap-2.5">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#1b4332] font-['Geist_Mono'] text-[11px] font-bold text-white">
                    {{this.user.initials}}
                  </div>
                  <div class="min-w-0">
                    <p class="truncate font-semibold text-slate-900">{{this.user.name}}</p>
                    <p class="font-['Geist_Mono'] text-[10px] uppercase tracking-wider text-slate-500">{{this.user.role}}</p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3.5">
                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase {{this.actionBadgeClass}}">
                  <i data-lucide="{{this.actionIcon}}" class="h-3 w-3"></i>
                  <span>{{this.actionLabel}}</span>
                </span>
                <p class="mt-1 text-xs font-medium text-slate-700">{{this.actionText}}</p>
              </td>
              <td class="px-4 py-3.5 text-center">
                <span class="rounded-lg bg-slate-100 px-2.5 py-1 font-['Geist_Mono'] text-[10px] font-semibold uppercase text-slate-700">
                  {{this.moduleLabel}}
                </span>
              </td>
              <td class="px-4 py-3.5">
                <p class="max-w-[240px] truncate text-xs text-slate-600" title="{{this.detailsText}}">
                  {{this.detailsText}}
                </p>
              </td>
              <td class="px-5 py-3.5 text-right">
                <button
                  type="button"
                  data-audit-inspect
                  data-log-id="{{this.id}}"
                  data-record-id="{{this.recordId}}"
                  data-action="{{this.actionText}}"
                  data-action-label="{{this.actionLabel}}"
                  data-module="{{this.moduleLabel}}"
                  data-table="{{this.tableName}}"
                  data-user="{{this.user.name}}"
                  data-email="{{this.user.email}}"
                  data-role="{{this.user.role}}"
                  data-date="{{this.dates.fullDate}}"
                  data-details="{{this.detailsText}}"
                  data-old-json="{{this.oldValuesJson}}"
                  data-new-json="{{this.newValuesJson}}"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 font-['Geist_Mono'] text-[11px] font-semibold text-slate-700 transition-colors hover:border-[#1b4332]/40 hover:bg-emerald-50 hover:text-[#1b4332] cursor-pointer"
                >
                  <i data-lucide="braces" class="h-3.5 w-3.5"></i>
                  <span>Inspeccionar</span>
                </button>
              </td>
            </tr>
            {{/each}}
            {{else}}
            <tr>
              <td colspan="6" class="px-6 py-14 text-center text-xs text-slate-500">
                No se encontraron registros de auditoría que coincidan con los criterios seleccionados.
              </td>
            </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>

    <div
      id="audit-grid-view"
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    >
      {{#if auditLogs.length}}
      {{#each auditLogs}}
      <article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
        <div>
          <div class="mb-3 flex items-start justify-between gap-2">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#1b4332] font-['Geist_Mono'] text-xs font-bold text-white shadow-2xs">
              {{this.user.initials}}
            </div>
            <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase {{this.actionBadgeClass}}">
              <i data-lucide="{{this.actionIcon}}" class="h-3 w-3"></i>
              <span>{{this.actionLabel}}</span>
            </span>
          </div>

          <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-[#1b4332]">
            {{this.user.name}} · {{this.user.role}}
          </p>
          <h3 class="mt-1 text-sm font-bold text-slate-900">{{this.actionText}}</h3>
          <p class="mt-0.5 text-xs text-slate-500">
            Módulo: <strong class="font-semibold text-slate-700">{{this.moduleLabel}}</strong>
          </p>

          <div class="mt-2.5 rounded-xl bg-slate-50 p-2.5">
            <p class="truncate font-['Geist_Mono'] text-[11px] text-slate-600" title="{{this.detailsText}}">
              {{this.detailsText}}
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
          <span class="font-['Geist_Mono'] text-[10px] font-semibold text-slate-400">
            {{this.dates.dateText}} · {{this.dates.timeText}}
          </span>
          <button
            type="button"
            data-audit-inspect
            data-log-id="{{this.id}}"
            data-record-id="{{this.recordId}}"
            data-action="{{this.actionText}}"
            data-action-label="{{this.actionLabel}}"
            data-module="{{this.moduleLabel}}"
            data-table="{{this.tableName}}"
            data-user="{{this.user.name}}"
            data-email="{{this.user.email}}"
            data-role="{{this.user.role}}"
            data-date="{{this.dates.fullDate}}"
            data-details="{{this.detailsText}}"
            data-old-json="{{this.oldValuesJson}}"
            data-new-json="{{this.newValuesJson}}"
            class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-['Geist_Mono'] text-[10px] font-semibold text-slate-700 transition-colors hover:border-[#1b4332]/40 hover:bg-emerald-50 hover:text-[#1b4332] cursor-pointer"
          >
            <i data-lucide="braces" class="h-3 w-3"></i>
            <span>Ver JSON</span>
          </button>
        </div>
      </article>
      {{/each}}
      {{else}}
      <div class="col-span-full rounded-2xl border border-slate-200/90 bg-white py-14 text-center text-xs text-slate-500 shadow-2xs">
        No se encontraron registros de auditoría que coincidan con los criterios seleccionados.
      </div>
      {{/if}}
    </div>

    {{#if hasMultiplePages}}
    <nav
      aria-label="Paginación de auditoría"
      class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/90 bg-white px-5 py-3.5 text-xs shadow-2xs"
    >
      <p class="text-slate-500">
        Página <strong class="font-['Geist_Mono'] text-slate-900">{{currentPage}}</strong> de
        <strong class="font-['Geist_Mono'] text-slate-900">{{totalPages}}</strong>
      </p>
      <div class="flex items-center gap-2">
        {{#if hasPrevPage}}
        <a
          href="?page={{prevPage}}{{filterSuffix}}"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-1.5 font-semibold text-slate-700 transition-colors hover:bg-slate-50"
        >
          <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i>
          <span>Anterior</span>
        </a>
        {{/if}}
        {{#if hasNextPage}}
        <a
          href="?page={{nextPage}}{{filterSuffix}}"
          class="inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-3.5 py-1.5 font-semibold text-white shadow-2xs transition-colors hover:bg-[#143326]"
        >
          <span>Siguiente</span>
          <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
        </a>
        {{/if}}
      </div>
    </nav>
    {{/if}}
  </div>
</div>

<div
  id="modal-audit-detail"
  role="dialog"
  aria-modal="true"
  aria-labelledby="audit-detail-title"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-xs font-['Geist']"
>
  <div class="flex max-h-[88vh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-[#1b4332]">
          <i data-lucide="braces" class="h-4 w-4"></i>
        </span>
        <div>
          <h2 id="audit-detail-title" class="text-sm font-bold text-slate-900">
            Inspección Técnica de Evento Auditado
          </h2>
          <p id="audit-detail-subtitle" class="font-['Geist_Mono'] text-[11px] text-slate-500">
            Evento #---
          </p>
        </div>
      </div>

      <button
        id="btn-close-audit-detail"
        type="button"
        aria-label="Cerrar inspector de auditoría"
        class="rounded-xl p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 cursor-pointer"
      >
        <i data-lucide="x" class="h-4 w-4"></i>
      </button>
    </div>

    <div class="flex-1 space-y-4 overflow-y-auto p-6 text-xs">
      <div class="grid grid-cols-2 gap-3 rounded-xl border border-slate-200 bg-slate-50/70 p-4 sm:grid-cols-4">
        <div>
          <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-400">Actor</p>
          <p id="audit-detail-user" class="mt-0.5 font-semibold text-slate-900">---</p>
          <p id="audit-detail-email" class="truncate text-[11px] text-slate-500">---</p>
        </div>
        <div>
          <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-400">Módulo / Tabla</p>
          <p id="audit-detail-module" class="mt-0.5 font-semibold text-slate-900">---</p>
          <p id="audit-detail-table" class="font-['Geist_Mono'] text-[11px] text-slate-500">---</p>
        </div>
        <div>
          <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-400">Acción</p>
          <p id="audit-detail-action" class="mt-0.5 font-semibold text-slate-900">---</p>
        </div>
        <div>
          <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-400">Estampa Temporal</p>
          <p id="audit-detail-date" class="mt-0.5 font-['Geist_Mono'] text-[11px] font-semibold text-slate-900">---</p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="flex flex-col rounded-xl border border-slate-200 bg-slate-950 p-4 text-slate-100">
          <div class="mb-2 flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-amber-300">
              Estado Anterior (old_values)
            </span>
          </div>
          <pre id="audit-detail-old-json" class="max-h-64 overflow-auto font-['Geist_Mono'] text-[11px] leading-relaxed text-slate-300">Sin valores previos registrados</pre>
        </div>

        <div class="flex flex-col rounded-xl border border-slate-200 bg-slate-950 p-4 text-slate-100">
          <div class="mb-2 flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-emerald-300">
              Estado Nuevo (new_values)
            </span>
          </div>
          <pre id="audit-detail-new-json" class="max-h-64 overflow-auto font-['Geist_Mono'] text-[11px] leading-relaxed text-emerald-100">Sin valores nuevos registrados</pre>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end border-t border-slate-200 bg-slate-50/80 px-6 py-3">
      <button
        id="btn-done-audit-detail"
        type="button"
        class="rounded-xl bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-slate-800 cursor-pointer"
      >
        Cerrar inspector
      </button>
    </div>
  </div>
</div>

<script type="module" src="/js/private/audit.js"></script>
