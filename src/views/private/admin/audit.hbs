<main class="min-h-screen flex flex-col">
    <!-- Content Area -->
    <div class="mt-20 p-12 space-y-10">

        {{!-- Control Bar & Search --}}
        {{> private/search-bar}}

        <!-- Alert Panel -->
        <div class="bg-blue-50 border border-blue-100 p-4 rounded-xl flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-3">
                <div class="bg-blue-100 p-2 rounded-full">
                    <span class="material-symbols-outlined text-blue-700" data-icon="info">info</span>
                </div>
                <p class="text-blue-900 font-medium text-sm tracking-tight">Registro de auditoría activo. <span class="font-bold">{{todayActionsCount}} acciones</span> registradas hoy.</p>
            </div>
            <a href="/private/audit?format=csv" id="btn-export-daily" class="bg-white text-blue-800 border border-blue-200 px-5 py-2 rounded-lg text-xs font-bold hover:bg-blue-100 transition-colors inline-block">
                Descargar reporte diario
            </a>
        </div>

        <!-- TABLE VIEW -->
        <div id="audit-table-view" class="hidden bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden border border-outline-variant/10">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/50">
                        <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                            Fecha y Hora</th>
                        <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                            Usuario</th>
                        <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                            Acción Realizada</th>
                        <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-center">
                            Módulo</th>
                        <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-right">
                            Detalles</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container">
                    {{#if auditLogs.length}}
                        {{#each auditLogs}}
                        <tr class="hover:bg-surface/50 transition-colors">
                            <td class="px-8 py-5">
                                <p class="font-bold text-on-surface text-sm">{{this.dates.dateText}}, {{this.dates.timeText}}</p>
                                <p class="text-xs text-on-surface-variant">{{this.dates.fullDate}}</p>
                            </td>
                            <td class="px-8 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-extrabold text-xs shrink-0">
                                        {{this.user.initials}}</div>
                                    <div>
                                        <p class="font-bold text-on-surface text-sm">{{this.user.name}}</p>
                                        <p class="text-[10px] text-on-surface-variant uppercase tracking-wide">{{this.user.role}}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-5">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm" data-icon="{{this.actionIcon}}">{{this.actionIcon}}</span>
                                    <p class="text-sm font-medium text-on-surface">{{this.actionText}}</p>
                                </div>
                            </td>
                            <td class="px-8 py-5 text-center">
                                <span class="px-3 py-1.5 bg-surface-container text-on-surface-variant rounded-full text-[10px] font-black uppercase">{{this.moduleLabel}}</span>
                            </td>
                            <td class="px-8 py-5 text-right">
                                <p class="text-xs text-on-surface-variant">{{this.detailsText}}</p>
                            </td>
                        </tr>
                        {{/each}}
                    {{else}}
                        <tr>
                            <td colspan="5" class="px-8 py-12 text-center text-sm text-on-surface-variant">
                                No se encontraron registros de auditoría que coincidan con los criterios.
                            </td>
                        </tr>
                    {{/if}}
                </tbody>
            </table>

            {{#if hasMultiplePages}}
            <!-- Pagination Table -->
            <div class="px-8 py-6 bg-surface-container-low/30 border-t border-outline-variant/10 flex items-center justify-between">
                <p class="text-xs font-medium text-on-surface-variant">
                    Mostrando <span class="font-bold text-on-surface">{{startRecord}} a {{endRecord}}</span> de <span
                        class="font-bold text-on-surface">{{totalCount}}</span> registros
                </p>
                <div class="flex gap-2">
                    {{#if hasPrevPage}}
                    <a href="?page={{prevPage}}{{#if searchValue}}&search={{searchValue}}{{/if}}"
                        class="px-5 py-2 rounded-lg bg-surface-container-highest/50 text-on-surface text-xs font-bold hover:bg-surface-container-highest transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm" data-icon="chevron_left">chevron_left</span>
                        Anterior
                    </a>
                    {{/if}}
                    {{#if hasNextPage}}
                    <a href="?page={{nextPage}}{{#if searchValue}}&search={{searchValue}}{{/if}}"
                        class="px-5 py-2 rounded-lg bg-[#43655c] text-white text-xs font-bold hover:bg-[#354f47] transition-colors flex items-center gap-2 shadow-sm">
                        Siguiente
                        <span class="material-symbols-outlined text-sm" data-icon="chevron_right">chevron_right</span>
                    </a>
                    {{/if}}
                </div>
            </div>
            {{/if}}
        </div>

        <!-- GRID VIEW -->
        <div id="audit-grid-view" class="grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 grid">
            {{#if auditLogs.length}}
                {{#each auditLogs}}
                <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/10 shadow-sm overflow-hidden group hover:-translate-y-1 transition-all duration-300">
                    <div class="p-5">
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-on-primary font-extrabold text-base shrink-0 shadow-md">
                                {{this.user.initials}}
                            </div>
                            <div class="flex items-center justify-center gap-1.5 px-2.5 py-1 rounded-full {{this.actionBadgeClass}}">
                                <span class="material-symbols-outlined text-xs">{{this.actionIcon}}</span>
                                <span class="text-[9px] font-black uppercase">{{this.actionLabel}}</span>
                            </div>
                        </div>
                        <span class="text-[9px] font-black uppercase tracking-widest text-primary">{{this.user.name}}</span>
                        <h3 class="font-bold text-on-surface text-base mt-1">{{this.actionText}}</h3>
                        <p class="text-xs text-on-surface-variant truncate mt-1">Módulo: {{this.moduleLabel}}</p>
                        <div class="flex items-center gap-1.5 mt-2">
                            <span class="px-2 py-0.5 bg-surface-container text-on-surface-variant rounded text-[10px] font-bold tracking-tight">{{this.detailsText}}</span>
                        </div>

                        <div class="mt-4 pt-4 border-t border-surface-container flex justify-between items-center">
                            <span class="text-[10px] text-on-surface-variant font-bold">{{this.dates.dateText}} · {{this.dates.timeText}}</span>
                            <span class="text-[10px] text-on-surface-variant font-mono">#{{this.recordId}}</span>
                        </div>
                    </div>
                </div>
                {{/each}}
            {{else}}
                <div class="col-span-full py-12 text-center text-sm text-on-surface-variant bg-surface-container-lowest rounded-xl border border-outline-variant/10">
                    No se encontraron registros de auditoría que coincidan con los criterios.
                </div>
            {{/if}}
        </div>

        {{#if hasMultiplePages}}
        <!-- Pagination Grid -->
        <div class="px-8 py-6 bg-surface-container-low/30 rounded-xl border border-outline-variant/10 flex items-center justify-between">
            <p class="text-xs font-medium text-on-surface-variant">
                Mostrando <span class="font-bold text-on-surface">{{startRecord}} a {{endRecord}}</span> de <span
                    class="font-bold text-on-surface">{{totalCount}}</span> registros
            </p>
            <div class="flex gap-2">
                {{#if hasPrevPage}}
                <a href="?page={{prevPage}}{{#if searchValue}}&search={{searchValue}}{{/if}}"
                    class="px-5 py-2 rounded-lg bg-surface-container-highest/50 text-on-surface text-xs font-bold hover:bg-surface-container-highest transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm" data-icon="chevron_left">chevron_left</span>
                    Anterior
                </a>
                {{/if}}
                {{#if hasNextPage}}
                <a href="?page={{nextPage}}{{#if searchValue}}&search={{searchValue}}{{/if}}"
                    class="px-5 py-2 rounded-lg bg-[#43655c] text-white text-xs font-bold hover:bg-[#354f47] transition-colors flex items-center gap-2 shadow-sm">
                    Siguiente
                    <span class="material-symbols-outlined text-sm" data-icon="chevron_right">chevron_right</span>
                </a>
                {{/if}}
            </div>
        </div>
        {{/if}}

    </div>
</main>

<script type="module" src="/js/private/audit.js"></script>
