<!-- Modal Configurar Permisos RBAC de Usuario -->
<div
  id="modal-user-permissions"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-permissions-title"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-xs font-['Geist']"
>
  <div class="w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-purple-50 text-purple-700">
          <i data-lucide="shield-alert" class="h-4 w-4"></i>
        </div>
        <div>
          <h3 id="modal-permissions-title" class="text-sm font-bold text-slate-900">
            Gobernanza RBAC de Usuario
          </h3>
          <p id="permissions-user-subtitle" class="text-[11px] text-slate-500">---</p>
        </div>
      </div>
      <button
        id="btn-close-modal-permissions"
        type="button"
        aria-label="Cerrar modal de permisos"
        class="rounded-xl p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 cursor-pointer"
      >
        <i data-lucide="x" class="h-4 w-4"></i>
      </button>
    </div>

    <form id="form-user-permissions" action="" method="POST" class="overflow-y-auto p-6 space-y-5">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <label for="perm-user-role" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Nivel Base
          </label>
          <select
            id="perm-user-role"
            name="role"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-900"
          >
            <option value="inifap">Personal Técnico INIFAP</option>
            <option value="agricultor">Productor Agrícola</option>
            <option value="admin" disabled id="opt-perm-role-admin">Administrador General (Inmutable)</option>
          </select>
        </div>

        <div>
          <label for="perm-user-status" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Estatus Operativo
          </label>
          <select
            id="perm-user-status"
            name="status"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-900"
          >
            <option value="activo">Activo</option>
            <option value="pendiente">Pendiente</option>
            <option value="suspendido">Suspendido (Sin acceso)</option>
          </select>
        </div>

        <div>
          <label for="perm-user-subrole" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Sub-rol RBAC Asignado
          </label>
          <select
            id="perm-user-subrole"
            name="rbac_role_id"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-900"
          >
            <option value="">Sin sub-rol (Base estándar)</option>
            {{#each rbacRoles}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <!-- Excepciones individuales (Allow / Deny) -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 space-y-3">
        <div>
          <h4 class="text-xs font-bold text-slate-900">Excepciones Granulares Individuales (Overrides)</h4>
          <p class="text-[11px] text-slate-500">
            Concede permisos específicos adicionales (<span class="font-bold text-emerald-700">Allow</span>) o retira permisos específicos (<span class="font-bold text-rose-700">Deny</span>) exclusivamente para esta cuenta.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="mb-1.5 block font-['Geist_Mono'] text-[10px] font-bold uppercase tracking-wider text-emerald-800">
              Conceder Permisos (Allow)
            </label>
            <div id="allow-permissions-container" class="max-h-48 overflow-y-auto rounded-lg border border-slate-200 bg-white p-2.5 space-y-1.5 text-xs">
              {{#each permissionDefinitions}}
                <div class="font-bold text-[10px] text-slate-400 uppercase tracking-wider pt-1">{{category}}</div>
                {{#each items}}
                <label class="flex items-center gap-2 cursor-pointer hover:bg-slate-50 p-0.5 rounded">
                  <input type="checkbox" name="allow" value="{{id}}" class="perm-allow-checkbox rounded text-emerald-600" />
                  <span>{{label}}</span>
                </label>
                {{/each}}
              {{/each}}
            </div>
          </div>

          <div>
            <label class="mb-1.5 block font-['Geist_Mono'] text-[10px] font-bold uppercase tracking-wider text-rose-800">
              Restringir Permisos (Deny)
            </label>
            <div id="deny-permissions-container" class="max-h-48 overflow-y-auto rounded-lg border border-slate-200 bg-white p-2.5 space-y-1.5 text-xs">
              {{#each permissionDefinitions}}
                <div class="font-bold text-[10px] text-slate-400 uppercase tracking-wider pt-1">{{category}}</div>
                {{#each items}}
                <label class="flex items-center gap-2 cursor-pointer hover:bg-slate-50 p-0.5 rounded">
                  <input type="checkbox" name="deny" value="{{id}}" class="perm-deny-checkbox rounded text-rose-600" />
                  <span>{{label}}</span>
                </label>
                {{/each}}
              {{/each}}
            </div>
          </div>
        </div>
      </div>
    </form>

    <div class="flex items-center justify-end gap-2.5 border-t border-slate-200 bg-slate-50/80 px-6 py-3.5">
      <button
        id="btn-cancel-permissions"
        type="button"
        class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 cursor-pointer"
      >
        Cancelar
      </button>
      <button
        type="submit"
        form="form-user-permissions"
        class="inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-5 py-2 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#143326] cursor-pointer"
      >
        <i data-lucide="check-shield" class="h-3.5 w-3.5"></i>
        <span>Guardar Permisos</span>
      </button>
    </div>
  </div>
</div>

