<!-- Modal Desafío Modo Sudo (Confirmación de Seguridad) -->
<div
  id="modal-sudo-challenge"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-sudo-title"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-xs font-['Geist']"
>
  <div class="w-full max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-50 text-amber-700">
          <i data-lucide="shield-alert" class="h-4 w-4"></i>
        </div>
        <div>
          <h3 id="modal-sudo-title" class="text-sm font-bold text-slate-900">
            Confirmación de Seguridad
          </h3>
          <p class="text-[11px] text-slate-500">Modo Sudo requerido para emitir tokens</p>
        </div>
      </div>
      <button
        id="btn-close-modal-sudo"
        type="button"
        aria-label="Cerrar modal de confirmación"
        class="rounded-xl p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 cursor-pointer"
      >
        <i data-lucide="x" class="h-4 w-4"></i>
      </button>
    </div>

    <div class="p-6 space-y-4">
      <div class="rounded-xl border border-amber-200/80 bg-amber-50/50 p-3.5 text-xs text-amber-900">
        <p class="font-medium leading-relaxed">
          Estás a punto de generar un nuevo lote de tokens de ascenso institucional con validez en el sistema. Confirma tu identidad para continuar.
        </p>
      </div>

      <div class="space-y-1.5">
        <label for="sudo-challenge-password" class="block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-700">
          Contraseña Actual de Administrador *
        </label>
        <div class="relative">
          <input
            type="password"
            id="sudo-challenge-password"
            required
            placeholder="Introduce tu contraseña actual"
            autocomplete="current-password"
            class="w-full rounded-xl border border-slate-200 bg-slate-50/70 py-2.5 pr-10 pl-3.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
          />
          <button
            type="button"
            id="btn-toggle-sudo-password"
            aria-label="Mostrar u ocultar contraseña"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 cursor-pointer"
          >
            <i data-lucide="eye" class="h-4 w-4"></i>
          </button>
        </div>
      </div>

      <!-- Espacio preparado para autenticación biométrica WebAuthn / Passkeys -->
      <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50/70 p-3 text-center">
        <div class="flex items-center justify-center gap-2 text-xs font-semibold text-slate-500">
          <i data-lucide="fingerprint" class="h-4 w-4 text-slate-400"></i>
          <span>Autenticación Biométrica (FIDO2 / WebAuthn)</span>
        </div>
        <p class="mt-1 text-[11px] text-slate-400">
          Próximamente disponible: autorización instantánea con huella dactilar o Windows Hello.
        </p>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2.5 border-t border-slate-200 bg-slate-50/80 px-6 py-3.5">
      <button
        id="btn-cancel-sudo-modal"
        type="button"
        class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 cursor-pointer"
      >
        Cancelar
      </button>
      <button
        id="btn-confirm-sudo-submit"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-5 py-2 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#143326] cursor-pointer"
      >
        <i data-lucide="shield-check" class="h-3.5 w-3.5"></i>
        <span>Confirmar y Emitir Lote</span>
      </button>
    </div>
  </div>
</div>

