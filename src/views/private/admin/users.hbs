<div id="users-page-root" class="mx-auto max-w-7xl space-y-6 font-['Geist'] text-slate-900">
  <!-- Cabecera Institucional y Ruta -->
  <header class="flex flex-col gap-3 rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs sm:flex-row sm:items-center sm:justify-between">
    <div>
      <nav aria-label="Ruta de navegación" class="mb-1.5 flex items-center gap-1.5 text-[11px] font-medium text-slate-500">
        <a href="/dashboard" class="transition-colors hover:text-[#1b4332]">Panel</a>
        <span aria-hidden="true">/</span>
        <span class="font-semibold text-slate-800">Gobernanza y Usuarios</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2.5">
        <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
          Control de Acceso y Credenciales
        </h1>
        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-[#1b4332]">
          IAM & RBAC Híbrido
        </span>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        Administra cuentas de personal, define sub-roles operativos y emite códigos de ascenso institucional INIFAP.
      </p>
    </div>
  </header>

  {{#if success}}
  <div role="status" class="flex items-center gap-2.5 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-800">
    <i data-lucide="check-circle-2" class="h-4 w-4 shrink-0 text-emerald-600"></i>
    <span>{{success}}</span>
  </div>
  {{/if}}

  {{#if error}}
  <div role="alert" class="flex items-center gap-2.5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-xs font-semibold text-rose-800">
    <i data-lucide="alert-circle" class="h-4 w-4 shrink-0 text-rose-600"></i>
    <span>{{error}}</span>
  </div>
  {{/if}}

  <!-- Navegación por Pestañas del Hub de Gestión -->
  <nav aria-label="Secciones de administración" class="flex flex-wrap items-center gap-2 border-b border-slate-200/90 pb-3">
    <a
      href="/private/users?tab=users"
      class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold transition-all {{#if (eq activeTab 'users')}}bg-[#1b4332] text-white shadow-2xs{{else}}border border-slate-200/80 bg-white text-slate-600 hover:bg-slate-100 hover:text-slate-900{{/if}}"
    >
      <i data-lucide="users" class="h-4 w-4"></i>
      <span>Usuarios Institucionales</span>
      <span class="ml-1 rounded-full px-2 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold {{#if (eq activeTab 'users')}}bg-white/20 text-white{{else}}bg-slate-100 text-slate-700{{/if}}">{{users.length}}</span>
    </a>

    <a
      href="/private/users?tab=rbac"
      class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold transition-all {{#if (eq activeTab 'rbac')}}bg-[#1b4332] text-white shadow-2xs{{else}}border border-slate-200/80 bg-white text-slate-600 hover:bg-slate-100 hover:text-slate-900{{/if}}"
    >
      <i data-lucide="shield-check" class="h-4 w-4"></i>
      <span>Sub-roles y Matriz RBAC</span>
      <span class="ml-1 rounded-full px-2 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold {{#if (eq activeTab 'rbac')}}bg-white/20 text-white{{else}}bg-slate-100 text-slate-700{{/if}}">{{rbacRoles.length}}</span>
    </a>

    <a
      href="/private/users?tab=codes"
      class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold transition-all {{#if (eq activeTab 'codes')}}bg-[#1b4332] text-white shadow-2xs{{else}}border border-slate-200/80 bg-white text-slate-600 hover:bg-slate-100 hover:text-slate-900{{/if}}"
    >
      <i data-lucide="key" class="h-4 w-4"></i>
      <span>Códigos INIFAP</span>
      <span class="ml-1 rounded-full px-2 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold {{#if (eq activeTab 'codes')}}bg-white/20 text-white{{else}}bg-slate-100 text-slate-700{{/if}}">{{codes.length}}</span>
    </a>
  </nav>

  {{#if (eq activeTab 'users')}}
  <!-- ════════════════════════════════════════════════════════════════════════ -->
  <!-- PESTAÑA 1: GESTIÓN DE USUARIOS INSTITUCIONALES                           -->
  <!-- ════════════════════════════════════════════════════════════════════════ -->
  <section aria-label="Resumen de cuentas" class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <article class="flex items-center justify-between rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs">
      <div>
        <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          Cuentas Listadas
        </p>
        <p class="mt-1 font-['Geist_Mono'] text-2xl font-bold text-slate-900">
          {{stats.total}}
        </p>
      </div>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-700">
        <i data-lucide="users" class="h-5 w-5"></i>
      </span>
    </article>

    <article class="flex items-center justify-between rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs">
      <div>
        <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          Cuentas Activas
        </p>
        <p class="mt-1 font-['Geist_Mono'] text-2xl font-bold text-emerald-700">
          {{stats.activos}}
        </p>
      </div>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
        <i data-lucide="user-check" class="h-5 w-5"></i>
      </span>
    </article>

    <article class="flex items-center justify-between rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs">
      <div>
        <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          Personal INIFAP
        </p>
        <p class="mt-1 font-['Geist_Mono'] text-2xl font-bold text-[#1b4332]">
          {{stats.inifap}}
        </p>
      </div>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-[#1b4332]">
        <i data-lucide="microscope" class="h-5 w-5"></i>
      </span>
    </article>

    <article class="flex items-center justify-between rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs">
      <div>
        <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          Administradores
        </p>
        <p class="mt-1 font-['Geist_Mono'] text-2xl font-bold text-purple-700">
          {{stats.admins}}
        </p>
      </div>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-50 text-purple-700">
        <i data-lucide="shield" class="h-5 w-5"></i>
      </span>
    </article>
  </section>

  {{> private/search-bar}}

  <div class="flex items-center justify-between gap-3 px-1">
    <p class="text-xs text-slate-600" role="status">
      <strong>{{users.length}}</strong> usuario(s) encontrado(s).
    </p>
    {{#if hasActiveFilters}}
    <a href="/private/users" class="text-xs font-semibold text-[#1b4332] hover:underline">
      Limpiar búsqueda y filtros
    </a>
    {{/if}}
  </div>

  <div id="users-views-container" class="space-y-4">
    <!-- Tabla de Usuarios -->
    <div
      id="users-table-view"
      class="hidden overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-2xs"
    >
      <div class="overflow-x-auto">
        <table class="w-full min-w-[900px] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/80 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-5 py-3.5">Usuario</th>
              <th class="px-4 py-3.5">Cargo / Puesto</th>
              <th class="px-4 py-3.5">Nivel Base</th>
              <th class="px-4 py-3.5">Sub-rol RBAC</th>
              <th class="px-4 py-3.5">Estatus</th>
              <th class="px-4 py-3.5">Contacto</th>
              <th class="px-5 py-3.5 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs">
            {{#each users}}
            <tr class="transition-colors hover:bg-slate-50/70">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  {{#if photo_url}}
                  <img
                    src="{{photo_url}}"
                    alt="{{full_name}}"
                    data-fallback-src="/images/defaults/crop-fallback.svg"
                    class="h-9 w-9 shrink-0 rounded-full object-cover ring-2 ring-emerald-900/10"
                  />
                  {{else}}
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#1b4332] font-['Geist_Mono'] text-xs font-bold text-white">
                    {{userInitial this}}
                  </div>
                  {{/if}}
                  <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-slate-900">{{full_name}}</p>
                    <p class="truncate text-[11px] text-slate-500">{{email}}</p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3.5 font-medium text-slate-700">
                {{#if job_title}}{{job_title}}{{else}}<span class="italic text-slate-400">Sin especificar</span>{{/if}}
              </td>
              <td class="px-4 py-3.5">
                <span class="inline-flex rounded-md border px-2.5 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider
                  {{#if (eq role 'admin')}}border-purple-200 bg-purple-50 text-purple-700{{/if}}
                  {{#if (eq role 'inifap')}}border-emerald-200 bg-emerald-50 text-[#1b4332]{{/if}}
                  {{#if (eq role 'agricultor')}}border-sky-200 bg-sky-50 text-sky-700{{/if}}">
                  {{role}}
                </span>
              </td>
              <td class="px-4 py-3.5">
                {{#if rbacRole}}
                <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold text-slate-800">
                  <i data-lucide="shield" class="h-3 w-3 text-[#1b4332]"></i>
                  <span>{{rbacRole.name}}</span>
                </span>
                {{else}}
                <span class="text-[11px] italic text-slate-400">Predeterminado</span>
                {{/if}}
              </td>
              <td class="px-4 py-3.5">
                <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[10px] font-semibold capitalize
                  {{#if (eq status 'activo')}}bg-emerald-50 text-emerald-700 border border-emerald-200{{/if}}
                  {{#if (eq status 'suspendido')}}bg-rose-50 text-rose-700 border border-rose-200{{/if}}
                  {{#if (eq status 'pendiente')}}bg-amber-50 text-amber-700 border border-amber-200{{/if}}">
                  {{status}}
                </span>
              </td>
              <td class="px-4 py-3.5 font-['Geist_Mono'] text-[11px] text-slate-600">
                {{#if phone}}{{phone}}{{else}}<span class="font-['Geist'] italic text-slate-400">No registrado</span>{{/if}}
              </td>
              <td class="px-5 py-3.5 text-right">
                <div class="inline-flex items-center justify-end gap-1">
                  <button
                    type="button"
                    class="btn-user-rbac rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#1b4332] cursor-pointer"
                    title="Configurar Sub-rol y Excepciones RBAC"
                    aria-label="Permisos RBAC de {{full_name}}"
                    data-id="{{id}}"
                    data-name="{{full_name}}"
                    data-email="{{email}}"
                    data-role="{{role}}"
                    data-status="{{status}}"
                    data-subrole="{{rbac_role_id}}"
                    data-allow="{{json custom_permissions.allow}}"
                    data-deny="{{json custom_permissions.deny}}"
                  >
                    <i data-lucide="shield-alert" class="h-4 w-4"></i>
                  </button>

                  <button
                    type="button"
                    class="btn-view-user rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#1b4332] cursor-pointer"
                    title="Ver ficha"
                    aria-label="Ver ficha de {{full_name}}"
                    data-id="{{id}}"
                    data-name="{{full_name}}"
                    data-email="{{email}}"
                    data-role="{{role}}"
                    data-subrole-name="{{#if rbacRole}}{{rbacRole.name}}{{else}}Sin sub-rol{{/if}}"
                    data-job="{{job_title}}"
                    data-phone="{{phone}}"
                    data-address="{{address}}"
                    data-status="{{status}}"
                  >
                    <i data-lucide="eye" class="h-4 w-4"></i>
                  </button>

                  <button
                    type="button"
                    class="btn-edit-user rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#1b4332] cursor-pointer"
                    title="Editar datos de usuario"
                    aria-label="Editar usuario {{full_name}}"
                    data-id="{{id}}"
                    data-name="{{full_name}}"
                    data-email="{{email}}"
                    data-role="{{role}}"
                    data-subrole="{{rbac_role_id}}"
                    data-job="{{job_title}}"
                    data-phone="{{phone}}"
                    data-address="{{address}}"
                    data-status="{{status}}"
                  >
                    <i data-lucide="pencil" class="h-4 w-4"></i>
                  </button>

                  <form
                    action="/private/users/delete/{{id}}"
                    method="POST"
                    class="delete-user-form inline"
                    data-user-name="{{full_name}}"
                  >
                    <button
                      type="submit"
                      class="rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-rose-50 hover:text-rose-600 cursor-pointer"
                      title="Eliminar usuario"
                      aria-label="Eliminar usuario {{full_name}}"
                    >
                      <i data-lucide="trash-2" class="h-4 w-4"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="7" class="px-6 py-14 text-center text-xs font-medium text-slate-500">
                No se encontraron usuarios registrados con los criterios solicitados.
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Cuadrícula de Tarjetas de Usuarios -->
    <div
      id="users-grid-view"
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    >
      {{#each users}}
      <article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
        <div>
          <div class="mb-3.5 flex items-start justify-between gap-2">
            {{#if photo_url}}
            <img
              src="{{photo_url}}"
              alt="{{full_name}}"
              data-fallback-src="/images/defaults/crop-fallback.svg"
              class="h-11 w-11 shrink-0 rounded-full border border-slate-200 object-cover shadow-2xs"
            />
            {{else}}
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#1b4332] font-['Geist_Mono'] text-sm font-bold text-white shadow-2xs">
              {{userInitial this}}
            </div>
            {{/if}}
            <span class="inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-[10px] font-semibold uppercase
              {{#if (eq status 'activo')}}border-emerald-200 bg-emerald-50 text-emerald-700{{/if}}
              {{#if (eq status 'pendiente')}}border-amber-200 bg-amber-50 text-amber-700{{/if}}
              {{#if (eq status 'suspendido')}}border-rose-200 bg-rose-50 text-rose-700{{/if}}">
              <span class="h-1.5 w-1.5 rounded-full
                {{#if (eq status 'activo')}}bg-emerald-600{{/if}}
                {{#if (eq status 'pendiente')}}bg-amber-500{{/if}}
                {{#if (eq status 'suspendido')}}bg-rose-600{{/if}}"></span>
              <span>{{status}}</span>
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            <span class="inline-flex rounded-md border px-2 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider
              {{#if (eq role 'admin')}}border-purple-200 bg-purple-50 text-purple-700{{/if}}
              {{#if (eq role 'inifap')}}border-emerald-200 bg-emerald-50 text-[#1b4332]{{/if}}
              {{#if (eq role 'agricultor')}}border-sky-200 bg-sky-50 text-sky-700{{/if}}">
              {{role}}
            </span>
            {{#if rbacRole}}
            <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-['Geist_Mono'] text-[9px] font-semibold text-slate-700">
              <i data-lucide="shield" class="h-2.5 w-2.5 text-[#1b4332]"></i>
              <span>{{rbacRole.name}}</span>
            </span>
            {{/if}}
          </div>

          <h3 class="mt-2.5 truncate text-sm font-bold text-slate-900" title="{{full_name}}">
            {{full_name}}
          </h3>
          <p class="truncate text-xs text-slate-500" title="{{email}}">{{email}}</p>
          <p class="mt-1.5 truncate text-xs font-medium text-slate-700">
            {{#if job_title}}{{job_title}}{{else}}Cargo sin especificar{{/if}}
          </p>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
          <span class="font-['Geist_Mono'] text-[10px] text-slate-400">ID #{{id}}</span>
          <div class="flex items-center gap-1">
            <button
              type="button"
              class="btn-user-rbac rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#1b4332] cursor-pointer"
              title="Permisos RBAC"
              aria-label="Permisos RBAC de {{full_name}}"
              data-id="{{id}}"
              data-name="{{full_name}}"
              data-email="{{email}}"
              data-role="{{role}}"
              data-status="{{status}}"
              data-subrole="{{rbac_role_id}}"
              data-allow="{{json custom_permissions.allow}}"
              data-deny="{{json custom_permissions.deny}}"
            >
              <i data-lucide="shield-alert" class="h-4 w-4"></i>
            </button>

            <button
              type="button"
              class="btn-view-user rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#1b4332] cursor-pointer"
              title="Ver ficha"
              aria-label="Ver ficha de {{full_name}}"
              data-id="{{id}}"
              data-name="{{full_name}}"
              data-email="{{email}}"
              data-role="{{role}}"
              data-subrole-name="{{#if rbacRole}}{{rbacRole.name}}{{else}}Sin sub-rol{{/if}}"
              data-job="{{job_title}}"
              data-phone="{{phone}}"
              data-address="{{address}}"
              data-status="{{status}}"
            >
              <i data-lucide="eye" class="h-4 w-4"></i>
            </button>

            <button
              type="button"
              class="btn-edit-user rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#1b4332] cursor-pointer"
              title="Editar usuario"
              aria-label="Editar usuario {{full_name}}"
              data-id="{{id}}"
              data-name="{{full_name}}"
              data-email="{{email}}"
              data-role="{{role}}"
              data-subrole="{{rbac_role_id}}"
              data-job="{{job_title}}"
              data-phone="{{phone}}"
              data-address="{{address}}"
              data-status="{{status}}"
            >
              <i data-lucide="pencil" class="h-4 w-4"></i>
            </button>

            <form
              action="/private/users/delete/{{id}}"
              method="POST"
              class="delete-user-form inline"
              data-user-name="{{full_name}}"
            >
              <button
                type="submit"
                class="rounded-lg p-1.5 text-slate-500 transition-colors hover:bg-rose-50 hover:text-rose-600 cursor-pointer"
                title="Eliminar usuario"
                aria-label="Eliminar usuario {{full_name}}"
              >
                <i data-lucide="trash-2" class="h-4 w-4"></i>
              </button>
            </form>
          </div>
        </div>
      </article>
      {{else}}
      <div class="col-span-full rounded-2xl border border-slate-200/90 bg-white py-12 text-center text-xs font-medium text-slate-500 shadow-2xs">
        No se encontraron usuarios registrados con los criterios solicitados.
      </div>
      {{/each}}

      <button
        type="button"
        id="btn-add-user-card"
        class="group flex min-h-[200px] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-white/70 p-6 text-center transition-all hover:border-[#1b4332]/40 hover:bg-emerald-50/30 cursor-pointer"
      >
        <span class="mb-2.5 flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-slate-500 transition-colors group-hover:bg-[#1b4332] group-hover:text-white">
          <i data-lucide="user-plus" class="h-5 w-5"></i>
        </span>
        <span class="text-xs font-bold text-slate-700 group-hover:text-[#1b4332]">
          Añadir usuario
        </span>
        <span class="mt-0.5 text-[11px] text-slate-400">
          Crear nueva credencial institucional
        </span>
      </button>
    </div>
  </div>
  {{/if}}

  {{#if (eq activeTab 'rbac')}}
  <!-- ════════════════════════════════════════════════════════════════════════ -->
  <!-- PESTAÑA 2: CATÁLOGO DE SUB-ROLES Y MATRIZ RBAC                          -->
  <!-- ════════════════════════════════════════════════════════════════════════ -->
  <section class="space-y-6">
    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-base font-bold text-slate-900">Perfiles y Sub-roles Dinámicos</h2>
        <p class="mt-0.5 text-xs text-slate-500">
          Define plantillas de permisos granulares para el personal técnico sin requerir privilegios de superadministrador.
        </p>
      </div>
      <button
        id="btn-add-role"
        type="button"
        class="inline-flex items-center gap-2 rounded-xl bg-[#1b4332] px-4 py-2.5 text-xs font-bold text-white shadow-xs transition-colors hover:bg-[#143326] cursor-pointer"
      >
        <i data-lucide="plus-circle" class="h-4 w-4"></i>
        <span>Nuevo Sub-rol</span>
      </button>
    </div>

    <!-- Lista de Sub-roles -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {{#each rbacRoles}}
      <article class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs transition-all hover:border-slate-300 hover:shadow-md">
        <div>
          <div class="flex items-start justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 font-['Geist_Mono'] text-[10px] font-semibold uppercase text-slate-700">
              <span class="h-2 w-2 rounded-full bg-emerald-600"></span>
              <span>{{base_role}}</span>
            </span>

            {{#if is_system}}
            <span class="inline-flex items-center gap-1 rounded-full border border-purple-200 bg-purple-50 px-2 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold text-purple-700">
              <i data-lucide="lock" class="h-3 w-3"></i>
              <span>Sistema</span>
            </span>
            {{/if}}
          </div>

          <h3 class="mt-3 text-base font-bold text-slate-900">{{name}}</h3>
          <p class="font-['Geist_Mono'] text-[11px] text-slate-400">slug: {{slug}}</p>
          <p class="mt-2 text-xs text-slate-600 leading-relaxed">{{description}}</p>

          <div class="mt-4 border-t border-slate-100 pt-3">
            <p class="font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
              Permisos Concedidos ({{permissions.length}})
            </p>
            <div class="mt-2 flex flex-wrap gap-1">
              {{#each permissions}}
              <span class="rounded bg-slate-100 px-1.5 py-0.5 font-['Geist_Mono'] text-[9px] font-medium text-slate-700">
                {{this}}
              </span>
              {{else}}
              <span class="text-[11px] italic text-slate-400">Sin permisos adicionales asignados</span>
              {{/each}}
            </div>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
          <button
            type="button"
            class="btn-edit-role inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-50 cursor-pointer"
            data-id="{{id}}"
            data-name="{{name}}"
            data-slug="{{slug}}"
            data-description="{{description}}"
            data-badge-color="{{badge_color}}"
            data-base-role="{{base_role}}"
            data-permissions="{{json permissions}}"
          >
            <i data-lucide="edit-3" class="h-3.5 w-3.5"></i>
            <span>Editar</span>
          </button>

          {{#unless is_system}}
          <form
            action="/private/rbac/roles/delete/{{id}}"
            method="POST"
            class="delete-role-form inline"
            data-role-name="{{name}}"
          >
            <button
              type="submit"
              class="inline-flex items-center gap-1 rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 transition-colors hover:bg-rose-100 cursor-pointer"
            >
              <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
              <span>Eliminar</span>
            </button>
          </form>
          {{/unless}}
        </div>
      </article>
      {{/each}}
    </div>

    <!-- Matriz de Cobertura General -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-2xs">
      <div class="mb-4">
        <h3 class="text-sm font-bold text-slate-900">Matriz de Permisos del Panel Operativo</h3>
        <p class="text-xs text-slate-500">
          Esquema de capacidades granulares soportadas en la plataforma de investigación y control fitosanitario.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {{#each permissionDefinitions}}
        <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-4">
          <h4 class="mb-2 font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-[#1b4332]">
            {{category}}
          </h4>
          <ul class="space-y-1.5">
            {{#each items}}
            <li class="flex items-start gap-2 text-xs text-slate-700">
              <i data-lucide="check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-600"></i>
              <span class="flex-1 font-medium">{{label}}</span>
              <span class="font-['Geist_Mono'] text-[10px] text-slate-400">({{id}})</span>
            </li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  {{#if (eq activeTab 'codes')}}
  <!-- ════════════════════════════════════════════════════════════════════════ -->
  <!-- PESTAÑA 3: GESTOR DE CÓDIGOS DE ASCENSO INIFAP                           -->
  <!-- ════════════════════════════════════════════════════════════════════════ -->
  <section class="space-y-6">
    <!-- Panel Generador de Códigos -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-2xs">
      <div class="mb-4 flex items-center gap-2.5 border-b border-slate-100 pb-3.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-[#1b4332]">
          <i data-lucide="key-round" class="h-5 w-5"></i>
        </span>
        <div>
          <h2 class="text-sm font-bold text-slate-900">Emisión de Códigos de Acceso Institucional</h2>
          <p class="text-[11px] text-slate-500">
            Genera tokens seguros para permitir que investigadores y técnicos asciendan su cuenta desde el portal público.
          </p>
        </div>
      </div>

      <form
        id="form-generate-codes"
        action="/private/codes/generate"
        method="POST"
        class="space-y-4"
      >
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <label for="code-count" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
              Cantidad a Generar
            </label>
            <select
              id="code-count"
              name="count"
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
            >
              <option value="1">1 código</option>
              <option value="3">3 códigos</option>
              <option value="5" selected>5 códigos</option>
              <option value="10">10 códigos</option>
              <option value="20">20 códigos (Lote)</option>
            </select>
          </div>

          <div>
            <label for="code-expires" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
              Vigencia / Expiración
            </label>
            <select
              id="code-expires"
              name="expiresInDays"
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
            >
              <option value="">Sin fecha límite (Permanente)</option>
              <option value="1">24 Horas</option>
              <option value="7" selected>7 Días</option>
              <option value="30">30 Días</option>
              <option value="90">90 Días</option>
            </select>
          </div>

          <div>
            <label for="code-subrole" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
              Preasignar Sub-rol RBAC
            </label>
            <select
              id="code-subrole"
              name="rbacRoleId"
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
            >
              <option value="">Estándar (Investigador General)</option>
              {{#each rbacRoles}}
              <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
          </div>

          <div>
            <label for="code-note" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
              Nota Interna / Destinatario
            </label>
            <input
              type="text"
              id="code-note"
              name="note"
              placeholder="Ej. Personal Campo Celaya"
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2.5 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
            />
          </div>
        </div>

        <input type="hidden" id="form-codes-sudo-password" name="sudo_password" />

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-slate-100">
          <div class="flex items-center gap-2.5 text-xs text-slate-500">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-50 text-emerald-800">
              <i data-lucide="shield-check" class="h-4 w-4"></i>
            </span>
            <span>Se requerirá confirmación de identidad (Modo Sudo) al procesar la emisión.</span>
          </div>

          <button
            type="button"
            id="btn-open-sudo-codes-modal"
            class="inline-flex items-center gap-2 rounded-xl bg-[#1b4332] px-5 py-2.5 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#143326] cursor-pointer shrink-0"
          >
            <i data-lucide="sparkles" class="h-3.5 w-3.5"></i>
            <span>Generar Códigos Seguros</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Listado de Códigos -->
    <div class="rounded-2xl border border-slate-200/90 bg-white shadow-2xs">
      <div class="flex flex-col gap-3 border-b border-slate-100 p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-sm font-bold text-slate-900">Historial de Códigos Emitidos</h3>
          <p class="text-xs text-slate-500">Supervisa canjes, vigencias y revoca tokens que ya no deban ser utilizados.</p>
        </div>

        <form action="/private/users" method="GET" class="m-0 flex items-center gap-2">
          <input type="hidden" name="tab" value="codes" />
          <select
            name="codeStatus"
            class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 font-['Geist_Mono'] text-xs text-slate-700"
          >
            <option value="all" {{#if (eq codeFilters.status 'all')}}selected{{/if}}>Todos los estatus</option>
            <option value="available" {{#if (eq codeFilters.status 'available')}}selected{{/if}}>Disponibles</option>
            <option value="used" {{#if (eq codeFilters.status 'used')}}selected{{/if}}>Canjeados</option>
            <option value="revoked" {{#if (eq codeFilters.status 'revoked')}}selected{{/if}}>Revocados</option>
            <option value="expired" {{#if (eq codeFilters.status 'expired')}}selected{{/if}}>Expirados</option>
          </select>
          <input
            type="text"
            name="codeSearch"
            value="{{codeFilters.search}}"
            placeholder="Buscar código o nota..."
            class="w-48 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-900"
          />
          <button
            type="submit"
            class="rounded-xl bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-slate-800 cursor-pointer"
          >
            Filtrar
          </button>
        </form>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[850px] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/80 font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-500">
              <th class="px-5 py-3.5">Código Institucional</th>
              <th class="px-4 py-3.5">Estatus</th>
              <th class="px-4 py-3.5">Sub-rol Preasignado</th>
              <th class="px-4 py-3.5">Nota Interna</th>
              <th class="px-4 py-3.5">Expiración</th>
              <th class="px-4 py-3.5">Canjeado Por</th>
              <th class="px-5 py-3.5 text-right">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs">
            {{#each codes}}
            <tr class="transition-colors hover:bg-slate-50/70">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-2">
                  <span class="font-['Geist_Mono'] text-xs font-bold text-slate-900">{{code}}</span>
                  <button
                    type="button"
                    class="btn-copy-code rounded-lg p-1 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 cursor-pointer"
                    title="Copiar código"
                    data-code="{{code}}"
                    aria-label="Copiar código {{code}}"
                  >
                    <i data-lucide="copy" class="h-3.5 w-3.5"></i>
                  </button>
                </div>
              </td>
              <td class="px-4 py-3.5">
                <span class="inline-flex rounded-full px-2.5 py-0.5 text-[10px] font-semibold capitalize
                  {{#if (eq statusKey 'available')}}bg-sky-50 text-sky-700 border border-sky-200{{/if}}
                  {{#if (eq statusKey 'used')}}bg-emerald-50 text-emerald-700 border border-emerald-200{{/if}}
                  {{#if (eq statusKey 'revoked')}}bg-rose-50 text-rose-700 border border-rose-200{{/if}}
                  {{#if (eq statusKey 'expired')}}bg-amber-50 text-amber-700 border border-amber-200{{/if}}">
                  {{statusLabel}}
                </span>
              </td>
              <td class="px-4 py-3.5">
                {{#if targetRole}}
                <span class="font-semibold text-slate-800">{{targetRole.name}}</span>
                {{else}}
                <span class="italic text-slate-400">Estándar INIFAP</span>
                {{/if}}
              </td>
              <td class="px-4 py-3.5 text-slate-600">
                {{#if note}}{{note}}{{else}}<span class="italic text-slate-400">Sin nota</span>{{/if}}
              </td>
              <td class="px-4 py-3.5 font-['Geist_Mono'] text-[11px] text-slate-500">
                {{#if expires_at}}{{expires_at}}{{else}}Sin expiración{{/if}}
              </td>
              <td class="px-4 py-3.5">
                {{#if usedBy}}
                <div>
                  <p class="font-semibold text-slate-900">{{usedBy.full_name}}</p>
                  <p class="font-['Geist_Mono'] text-[10px] text-slate-400">{{usedBy.email}}</p>
                </div>
                {{else}}
                <span class="italic text-slate-400">No canjeado</span>
                {{/if}}
              </td>
              <td class="px-5 py-3.5 text-right">
                {{#if isAvailable}}
                <form action="/private/codes/revoke/{{id}}" method="POST" class="revoke-code-form inline">
                  <button
                    type="submit"
                    class="rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-[11px] font-semibold text-rose-700 transition-colors hover:bg-rose-100 cursor-pointer"
                  >
                    Revocar
                  </button>
                </form>
                {{else}}
                <span class="text-[11px] text-slate-400">—</span>
                {{/if}}
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="7" class="px-6 py-12 text-center text-xs font-medium text-slate-500">
                No hay códigos de acceso emitidos con los filtros actuales.
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {{/if}}
</div>

<!-- ════════════════════════════════════════════════════════════════════════════ -->
<!-- MODALES DEL HUB ADMINISTRATIVO                                               -->
<!-- ════════════════════════════════════════════════════════════════════════════ -->

<!-- Modal Crear / Editar Usuario -->
<div
  id="modal-user"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-user-title"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-xs font-['Geist']"
>
  <div class="w-full max-w-lg overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-[#1b4332]">
          <i data-lucide="user-cog" class="h-4 w-4"></i>
        </div>
        <h2 id="modal-user-title" class="text-sm font-bold text-slate-900">
          Nuevo Usuario
        </h2>
      </div>
      <button
        id="btn-close-modal-user"
        type="button"
        aria-label="Cerrar formulario de usuario"
        class="rounded-xl p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 cursor-pointer"
      >
        <i data-lucide="x" class="h-4 w-4"></i>
      </button>
    </div>

    <form id="form-user" action="/private/users/create" method="POST" class="space-y-3.5 px-6 py-5">
      <div>
        <label for="user-nombre" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
          Nombre Completo *
        </label>
        <input
          type="text"
          id="user-nombre"
          name="full_name"
          required
          placeholder="Nombre y apellidos"
          class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
        />
      </div>

      <div>
        <label for="user-email" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
          Correo Electrónico *
        </label>
        <input
          type="email"
          id="user-email"
          name="email"
          required
          placeholder="usuario@inifap.gob.mx"
          class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
        />
      </div>

      <div id="password-group">
        <label for="user-password" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
          Contraseña Inicial *
        </label>
        <input
          type="password"
          id="user-password"
          name="password"
          placeholder="Mínimo 8 caracteres"
          class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
        />
      </div>

      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
        <div>
          <label for="user-puesto" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Puesto / Cargo
          </label>
          <input
            type="text"
            id="user-puesto"
            name="job_title"
            placeholder="Ej. Investigador Fitosanitario"
            class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
          />
        </div>

        <div>
          <label for="user-telefono" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Teléfono
          </label>
          <input
            type="text"
            id="user-telefono"
            name="phone"
            placeholder="+52 55 1234 5678"
            class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 font-['Geist_Mono'] text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3">
        <div>
          <label for="user-rol" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Nivel Base *
          </label>
          <select
            id="user-rol"
            name="role"
            required
            class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
          >
            <option value="inifap">Personal Técnico INIFAP</option>
            <option value="agricultor">Productor Agrícola</option>
          </select>
        </div>

        <div>
          <label for="user-subrole" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Sub-rol RBAC
          </label>
          <select
            id="user-subrole"
            name="rbac_role_id"
            class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
          >
            <option value="">Ninguno (Predeterminado)</option>
            {{#each rbacRoles}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
        </div>

        <div>
          <label for="user-estatus" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
            Estatus *
          </label>
          <select
            id="user-estatus"
            name="status"
            required
            class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-3.5 py-2 text-xs text-slate-900 focus:border-[#1b4332] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1b4332]/15"
          >
            <option value="activo">Activo</option>
            <option value="pendiente">Pendiente</option>
            <option value="suspendido">Suspendido</option>
          </select>
        </div>
      </div>

      <div>
        <label for="user-direccion" class="mb-1 block font-['Geist_Mono'] text-[10px] font-semibold uppercase tracking-wider text-slate-600">
          Ubicación / Adscripción
        </label>
        <input
          type="text"
          id="user-direccion"
          name="address"
          placeholder="Campo experimental o municipio"
