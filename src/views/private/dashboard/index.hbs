<div class="space-y-6 font-sans text-foreground antialiased pb-12">

  {{! ── ENCABEZADO DEL DASHBOARD ──────────────────────────────────────────── }}
  <div class="mb-6">
    <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-1">
      VIGILANCIA FITOSANITARIA NACIONAL
    </span>
    <h1 class="text-3xl font-headline font-black text-foreground tracking-tight">
      Panel de administración
    </h1>
  </div>

  {{! ── FILA 1: TARJETAS DE KPIS PRINCIPALES (4 COLUMNAS) ─────────────────── }}
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- KPI 1: Validaciones Pendientes -->
    <div class="bg-card p-5 rounded-xl border border-border shadow-2xs hover:border-[#1b4332]/30 transition-all flex flex-col justify-between">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-3">
        VALIDACIONES PENDIENTES
      </span>
      <div class="flex items-baseline justify-between">
        <span class="text-3xl font-headline font-black text-foreground">{{validations.total}}</span>
        {{#if validations.todayNewCount}}
          <span class="inline-flex items-center gap-1 text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
            <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i> +{{validations.todayNewCount}} hoy
          </span>
        {{else}}
          <span class="text-xs font-mono text-muted-foreground font-semibold">Al día</span>
        {{/if}}
      </div>
    </div>

    <!-- KPI 2: Alertas Críticas Activas -->
    <div class="bg-card p-5 rounded-xl border border-border shadow-2xs hover:border-[#1b4332]/30 transition-all flex flex-col justify-between">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-3">
        ALERTAS CRÍTICAS ACTIVAS
      </span>
      <div>
        <span class="text-3xl font-headline font-black text-rose-600 block leading-tight">{{alerts.criticalCount}}</span>
        <span class="text-xs text-muted-foreground font-medium">En terrenos monitoreados</span>
      </div>
    </div>

    <!-- KPI 3: Hectáreas Monitoreadas -->
    <div class="bg-card p-5 rounded-xl border border-border shadow-2xs hover:border-[#1b4332]/30 transition-all flex flex-col justify-between">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-3">
        HECTÁREAS MONITOREADAS
      </span>
      <div class="flex items-baseline gap-1.5">
        <span class="text-3xl font-headline font-black text-foreground">{{land.formattedHectares}}</span>
        <span class="text-xs font-mono font-bold text-muted-foreground uppercase">ha</span>
      </div>
    </div>

    <!-- KPI 4: Predios y Ciclos en Operación (reemplaza foro descartado) -->
    <div class="bg-card p-5 rounded-xl border border-border shadow-2xs hover:border-[#1b4332]/30 transition-all flex flex-col justify-between">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted-foreground block mb-3">
        PREDIOS ACTIVOS
      </span>
      <div class="flex items-baseline justify-between">
        <span class="text-3xl font-headline font-black text-foreground">{{land.totalFarms}}</span>
        <span class="text-xs font-mono font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
          {{land.activeCyclesCount}} ciclos
        </span>
      </div>
    </div>
  </section>

  {{! ── FILA 2: GRID PRINCIPAL (8 COLUMNAS IZQUIERDA / 4 COLUMNAS DERECHA) ─── }}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- COLUMNA IZQUIERDA (8 COLUMNAS) -->
    <div class="col-span-1 lg:col-span-8 space-y-6">

      <!-- TARJETA: REQUIERE TU ATENCIÓN -->
      <div class="bg-card rounded-xl border border-border shadow-2xs overflow-hidden">
        <div class="p-5 border-b border-border flex items-center justify-between">
          <div>
            <h2 class="text-base font-headline font-bold text-foreground">Requiere tu atención</h2>
            <p class="text-xs text-muted-foreground">Tareas y alertas ordenadas por prioridad</p>
          </div>
          <span class="text-xs font-mono text-muted-foreground font-bold px-2.5 py-0.5 rounded-md bg-muted">
            Monitoreo en tiempo real
          </span>
        </div>

        <div class="divide-y divide-border">
          {{#if alerts.latestAlert}}
            <!-- Item 1: ALERTA FITOSANITARIA -->
            <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-muted/30 transition-colors">
              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-rose-100/70 text-rose-600 flex items-center justify-center shrink-0 mt-0.5">
                  <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="px-2 py-0.5 text-[9px] font-mono font-bold uppercase rounded bg-rose-100 text-rose-800 tracking-wider">
                      INCIDENCIA
                    </span>
                    <h3 class="text-sm font-bold text-foreground">Alerta crítica: {{alerts.latestAlert.plague_name}}</h3>
                  </div>
                  <p class="text-xs text-muted-foreground">
                    Predio: {{#if alerts.latestAlert.farm}}{{alerts.latestAlert.farm.name}}{{else}}No especificado{{/if}} · Severidad {{alerts.latestAlert.severity}}
                  </p>
                </div>
              </div>
              <a href="/private/lands" class="inline-flex items-center justify-center px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-lg transition-colors shrink-0 shadow-2xs">
                Ver predio
              </a>
            </div>
          {{/if}}

          {{#if validations.total}}
            <!-- Item 2: VALIDACIÓN -->
            <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-muted/30 transition-colors">
              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-100/70 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
                  <i data-lucide="clipboard-check" class="w-5 h-5"></i>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="px-2 py-0.5 text-[9px] font-mono font-bold uppercase rounded bg-emerald-100 text-emerald-800 tracking-wider">
                      VALIDACIÓN
                    </span>
                    <h3 class="text-sm font-bold text-foreground">{{validations.total}} fichas técnicas esperan revisión</h3>
                  </div>
                  <p class="text-xs text-muted-foreground">{{validations.plaguesPending}} plagas, {{validations.cropsPending}} cultivos, {{validations.productsPending}} productos</p>
                </div>
              </div>
              <a href="/private/catalog/plagues" class="inline-flex items-center justify-center px-4 py-2 bg-card border border-border hover:bg-muted text-foreground font-bold text-xs rounded-lg transition-colors shrink-0">
                Revisar
              </a>
            </div>
          {{/if}}

          <!-- Item 3: OPERACIÓN DE PREDIOS -->
          <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-muted/30 transition-colors">
            <div class="flex items-start gap-3.5">
              <div class="w-9 h-9 rounded-xl bg-amber-100/70 text-amber-700 flex items-center justify-center shrink-0 mt-0.5">
                <i data-lucide="map-pin" class="w-5 h-5"></i>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="px-2 py-0.5 text-[9px] font-mono font-bold uppercase rounded bg-amber-100 text-amber-800 tracking-wider">
                    OPERACIÓN
                  </span>
                  <h3 class="text-sm font-bold text-foreground">Registro y bitácora de predios agrícolas</h3>
                </div>
                <p class="text-xs text-muted-foreground">Monitoreo fenológico y seguimiento de aplicaciones fitosanitarias</p>
              </div>
            </div>
            <a href="/private/lands" class="inline-flex items-center justify-center px-4 py-2 bg-card border border-border hover:bg-muted text-foreground font-bold text-xs rounded-lg transition-colors shrink-0">
              Ir a predios
            </a>
          </div>

          {{#if isAdmin}}
            <!-- Item 4: ACCESO INIFAP -->
            <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-muted/30 transition-colors">
              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-slate-200/70 text-slate-700 flex items-center justify-center shrink-0 mt-0.5">
                  <i data-lucide="key" class="w-5 h-5"></i>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="px-2 py-0.5 text-[9px] font-mono font-bold uppercase rounded bg-slate-200 text-slate-800 tracking-wider">
                      ACCESO
                    </span>
                    <h3 class="text-sm font-bold text-foreground">Gestión de usuarios y accesos INIFAP</h3>
                  </div>
                  <p class="text-xs text-muted-foreground">Administración de roles y generación de códigos de vinculación</p>
                </div>
              </div>
              <a href="/private/users" class="inline-flex items-center justify-center px-4 py-2 bg-card border border-border hover:bg-muted text-foreground font-bold text-xs rounded-lg transition-colors shrink-0">
                Gestionar
              </a>
            </div>
          {{/if}}
        </div>

        <!-- Botones de Acción Rápida Inferiores -->
        <div class="p-4 bg-muted/20 border-t border-border flex items-center gap-2 flex-wrap">
          <a href="/private/lands" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-card border border-border hover:bg-muted text-foreground font-bold text-xs rounded-md transition-colors shadow-2xs">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Registrar predio
          </a>
          <a href="/private/audit" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-card border border-border hover:bg-muted text-foreground font-bold text-xs rounded-md transition-colors shadow-2xs">
            <i data-lucide="history" class="w-3.5 h-3.5"></i> Auditoría
          </a>
          {{#if isAdmin}}
            <a href="/private/users" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-card border border-border hover:bg-muted text-foreground font-bold text-xs rounded-md transition-colors shadow-2xs">
              <i data-lucide="key" class="w-3.5 h-3.5"></i> Código INIFAP
            </a>
          {{/if}}
        </div>
      </div>

      <!-- TARJETA: TOP 5 PLAGAS DEL MES -->
      <div class="bg-card p-6 rounded-xl border border-border shadow-2xs">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-base font-headline font-bold text-foreground">Top 5 plagas del mes</h2>
          <span class="text-xs font-mono text-muted-foreground font-bold">reportes</span>
        </div>

        {{#if topPlagues.length}}
          <div class="space-y-4">
            {{#each topPlagues}}
              <div>
                <div class="flex justify-between items-center text-xs font-bold mb-1.5">
                  <span class="text-foreground flex items-center gap-2">
                    <span class="font-mono text-muted-foreground font-semibold">{{this.index}}</span> {{this.name}}
                  </span>
                  <span class="font-mono text-foreground font-bold">{{this.count}}</span>
                </div>
                <div class="w-full bg-muted rounded-full h-2.5 overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-700" style="width: {{this.percentage}}%; background-color: {{this.color}}"></div>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="py-8 text-center">
            <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3">
              <i data-lucide="shield-check" class="w-6 h-6"></i>
            </div>
            <p class="text-sm font-bold text-foreground">Sin incidencias este mes</p>
            <p class="text-xs text-muted-foreground mt-1">No se han registrado reportes fitosanitarios en los últimos 30 días.</p>
          </div>
        {{/if}}
      </div>

    </div>

    <!-- COLUMNA DERECHA (4 COLUMNAS) -->
    <div class="col-span-1 lg:col-span-4 space-y-6">

      <!-- TARJETA: DISTRIBUCIÓN DE CULTIVOS -->
      <div class="bg-card p-6 rounded-xl border border-border shadow-2xs">
        <h2 class="text-base font-headline font-bold text-foreground mb-6">Distribución de cultivos</h2>

        {{#if cropDistribution.hasData}}
          <div class="flex flex-col items-center justify-center gap-6">
            <!-- Gráfico Donut SVG con CSS Conic Gradient -->
            <div class="relative w-44 h-44 rounded-full flex items-center justify-center">
              <div class="absolute inset-0 rounded-full"
                style="{{cropDistribution.conicGradientStyle}} mask: radial-gradient(transparent 62%, black 64%); -webkit-mask: radial-gradient(transparent 62%, black 64%);">
              </div>
              <div class="text-center z-10">
                <span class="block text-2xl font-headline font-black text-foreground leading-none">{{cropDistribution.totalHectaresText}}</span>
                <span class="text-[9px] font-mono text-muted-foreground uppercase font-bold tracking-widest">HECTÁREAS</span>
              </div>
            </div>

            <!-- Leyenda de cultivos -->
            <div class="w-full space-y-3">
              {{#each cropDistribution.crops}}
                <div class="flex items-center justify-between text-xs">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full" style="background-color: {{this.color}}"></span>
                    <span class="font-bold text-foreground">{{this.name}}</span>
                  </div>
                  <span class="text-muted-foreground font-mono text-[11px]">{{this.percentage}}% del total</span>
                </div>
              {{/each}}
            </div>
          </div>
        {{else}}
          <div class="py-8 text-center">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center mx-auto mb-3">
              <i data-lucide="sprout" class="w-6 h-6"></i>
            </div>
            <p class="text-sm font-bold text-foreground">Sin ciclos activos</p>
            <p class="text-xs text-muted-foreground mt-1">Registra siembras en predios para visualizar la distribución.</p>
          </div>
        {{/if}}
      </div>

      <!-- TARJETA: ACTIVIDAD RECIENTE -->
      <div class="bg-card p-6 rounded-xl border border-border shadow-2xs">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-headline font-bold text-foreground">Actividad reciente</h2>
          <a href="/private/audit" class="text-xs font-bold text-muted-foreground hover:text-[#1b4332] transition-colors">
            Ver historial
          </a>
        </div>

        {{#if recentActivity.length}}
          <div class="space-y-4">
            {{#each recentActivity}}
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-100 text-[#1b4332] font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                  {{this.initials}}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-foreground leading-snug">
                    <span class="font-bold">{{this.userName}}</span> {{this.action}} en <span class="font-bold text-[#1b4332]">{{this.tableName}}</span>
                    {{#if this.entityName}} · {{this.entityName}}{{/if}}
                  </p>
                  <p class="text-[10px] text-muted-foreground font-mono mt-0.5">{{this.relativeTime}}</p>
                </div>
                <i data-lucide="check" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="py-6 text-center text-xs text-muted-foreground">
            No se han registrado eventos de auditoría recientes.
          </div>
        {{/if}}
      </div>

    </div>

  </div>
</div>