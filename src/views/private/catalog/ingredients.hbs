<main class="min-h-screen flex flex-col">
    <!-- Content Area -->
    <div class="mt-20 p-12 space-y-10">

        {{!-- Control Bar & Search --}}
        {{> private/search-bar}}

        {{!-- Stats Bar --}}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div
                class="bg-surface-container-lowest rounded-xl border border-outline-variant/10 shadow-sm p-5 flex items-center gap-4">
                <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-primary" data-icon="science">science</span>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Total</p>
                    <p class="text-2xl font-extrabold text-on-surface">312</p>
                </div>
            </div>
            <div
                class="bg-surface-container-lowest rounded-xl border border-outline-variant/10 shadow-sm p-5 flex items-center gap-4">
                <div class="w-11 h-11 rounded-full bg-emerald-500/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-emerald-600"
                        data-icon="check_circle">check_circle</span>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Aprobados</p>
                    <p class="text-2xl font-extrabold text-on-surface">278</p>
                </div>
            </div>
            <div
                class="bg-surface-container-lowest rounded-xl border border-outline-variant/10 shadow-sm p-5 flex items-center gap-4">
                <div class="w-11 h-11 rounded-full bg-amber-500/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-amber-600" data-icon="schedule">schedule</span>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Pendientes</p>
                    <p class="text-2xl font-extrabold text-on-surface">21</p>
                </div>
            </div>
            <div
                class="bg-surface-container-lowest rounded-xl border border-outline-variant/10 shadow-sm p-5 flex items-center gap-4">
                <div class="w-11 h-11 rounded-full bg-error/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-error" data-icon="dangerous">dangerous</span>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Restringidos</p>
                    <p class="text-2xl font-extrabold text-on-surface">13</p>
                </div>
            </div>
        </div>

        {{!-- Table View --}}
        {{> private/ingredients/table}}

        {{!-- Grid View --}}
        {{> private/ingredients/grid}}

    </div>
</main>

{{!-- Modal: Añadir / Editar Ingrediente Activo --}}
{{> private/ingredients/form-modal}}

<script type="module" src="/js/private/ingredients.js"></script>