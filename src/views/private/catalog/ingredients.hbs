<main class="w-full flex flex-col justify-between items-center py-6 px-4 md:px-12 bg-background min-h-screen">
    <div class="w-full max-w-7xl space-y-6">

        {{!-- Search bar with title, add button, and view toggle --}}
        {{> private/search-bar
        title="Ingredientes Activos"
        description="Gestión y catálogo de materias primas y compuestos químicos"
        searchPlaceholder="Buscar por nombre común, IUPAC o grupo químico..."
        btnId="btn-add-ingredient"
        btnLabel="Nuevo Ingrediente"
        filterPrefix="active-ingredient"
        }}

        {{!-- Quick Stats Bar --}}
        <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant/10 shadow-sm">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <div class="border-r border-outline-variant/10">
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Total Ingredientes</p>
                    <p class="text-2xl font-extrabold text-on-surface">148</p>
                </div>
                <div class="border-r border-outline-variant/10">
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Insecticidas</p>
                    <p class="text-2xl font-extrabold text-on-surface">62</p>
                </div>
                <div class="border-r border-outline-variant/10">
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Fungicidas</p>
                    <p class="text-2xl font-extrabold text-on-surface">45</p>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-widest font-black text-on-surface-variant">Restringidos</p>
                    <p class="text-2xl font-extrabold text-on-surface">13</p>
                </div>
            </div>
        </div>

        {{!-- Table View --}}
        {{> private/ingredients/table}}

        {{!-- Grid View --}}
        {{> private/ingredients/grid}}

    </div>
</main>

{{!-- Modal: Añadir / Editar Ingrediente Activo --}}
{{> private/ingredients/form-modal}}

<script type="module" src="/js/private/ingredients.js"></script>