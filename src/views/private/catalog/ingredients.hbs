<div class="mx-auto max-w-7xl space-y-6 pb-12 pt-2 font-['Geist'] text-slate-900">
    <!-- Encabezado ejecutivo -->
    <header class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <div class="space-y-1.5">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50/70 px-2.5 py-0.5 font-['Geist_Mono'] text-[10px] font-bold uppercase tracking-[0.14em] text-[#1b4332]">
                        <i data-lucide="flask-conical" class="h-3 w-3"></i>
                        Catálogo Químico · OMS / COFEPRIS
                    </span>
                    {{#unless canManage}}
                    <span class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                        <i data-lucide="eye" class="h-3 w-3"></i>
                        Consulta técnica INIFAP
                    </span>
                    {{/unless}}
                </div>
                <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Ingredientes Activos</h1>
                <p class="max-w-2xl text-xs leading-relaxed text-slate-500 sm:text-sm">
                    Registro normativo de moléculas fitosanitarias, familias químicas, tipo de acción biológica y clasificación toxicológica OMS.
                </p>
            </div>

            {{#if canManage}}
            <div class="flex shrink-0 items-center gap-2">
                <button
                    id="btn-add-ingredient"
                    type="button"
                    class="inline-flex items-center gap-2 rounded-xl bg-[#1b4332] px-4 py-2.5 text-xs font-bold text-white shadow-xs transition-colors hover:bg-[#143325]"
                >
                    <i data-lucide="plus" class="h-4 w-4"></i>
                    <span>Añadir Ingrediente</span>
                </button>
            </div>
            {{/if}}
        </div>
    </header>

    {{#if error}}
    <div role="alert" class="flex items-center gap-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-xs font-semibold text-rose-800">
        <i data-lucide="alert-circle" class="h-4 w-4 shrink-0"></i>
        <span>{{error}}</span>
    </div>
    {{/if}}

    <!-- Indicadores en tiempo real -->
    <section id="ingredients-kpi-region" aria-label="Indicadores del catálogo químico" class="grid grid-cols-2 gap-3.5 lg:grid-cols-4">
        <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-slate-500">Total moléculas</p>
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-[#1b4332]">
                    <i data-lucide="atom" class="h-4 w-4"></i>
                </span>
            </div>
            <p class="mt-2 font-['Geist_Mono'] text-2xl font-extrabold text-slate-900">{{stats.total}}</p>
            <p class="mt-0.5 text-[11px] text-slate-500">{{stats.distinctGroups}} grupos químicos</p>
        </article>

        <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-slate-500">Aprobados OMS</p>
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">
                    <i data-lucide="shield-check" class="h-4 w-4"></i>
                </span>
            </div>
            <p class="mt-2 font-['Geist_Mono'] text-2xl font-extrabold text-emerald-700">{{stats.approvedCount}}</p>
            <p class="mt-0.5 text-[11px] text-slate-500">Clases II, III, IV y U</p>
        </article>

        <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-slate-500">Por clasificar</p>
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-700">
                    <i data-lucide="clock-3" class="h-4 w-4"></i>
                </span>
            </div>
            <p class="mt-2 font-['Geist_Mono'] text-2xl font-extrabold text-amber-700">{{stats.pendingCount}}</p>
            <p class="mt-0.5 text-[11px] text-slate-500">Sin banda OMS asignada</p>
        </article>

        <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-slate-500">Restringidos</p>
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-50 text-rose-700">
                    <i data-lucide="triangle-alert" class="h-4 w-4"></i>
                </span>
            </div>
            <p class="mt-2 font-['Geist_Mono'] text-2xl font-extrabold text-rose-700">{{stats.restrictedCount}}</p>
            <p class="mt-0.5 text-[11px] text-slate-500">Clase I · Riesgo extremo</p>
        </article>
    </section>

    <!-- Sticky Bar ultracompacta -->
    <section
        id="ingredients-filter-bar"
        aria-label="Filtros de ingredientes activos"
        class="sticky top-16 z-30 rounded-2xl border border-slate-200/90 bg-white/95 p-2.5 shadow-xs backdrop-blur-md"
    >
        <form id="form-filter-ingredients" action="/private/ingredients" method="GET" class="space-y-2">
            <div class="flex items-center gap-2">
                <div class="relative flex-1">
                    <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
                    <input
                        id="ingredient-search"
                        name="search"
                        type="search"
                        aria-label="Buscar ingrediente activo por nombre, número CAS o grupo químico"
                        value="{{query.search}}"
                        placeholder="{{searchPlaceholder}}"
                        autocomplete="off"
                        class="h-9 w-full rounded-xl border border-slate-200 bg-slate-50/70 pl-9 pr-3 text-xs font-medium text-slate-900 placeholder:text-slate-400 outline-none transition-all focus:border-[#1b4332] focus:bg-white focus:ring-2 focus:ring-[#1b4332]/15"
                    />
                </div>

                <!-- Botón colapsable móvil -->
                <button
                    id="btn-toggle-ingredient-filters"
                    type="button"
                    aria-expanded="false"
                    aria-controls="ingredient-advanced-filters"
                    class="inline-flex h-9 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold text-slate-700 hover:bg-slate-50 lg:hidden"
                >
                    <i data-lucide="sliders-horizontal" class="h-3.5 w-3.5"></i>
                    <span>Filtros</span>
                    {{#if activeFilterCount}}
                    <span class="rounded-full bg-[#1b4332] px-1.5 py-0.5 font-['Geist_Mono'] text-[10px] text-white">{{activeFilterCount}}</span>
                    {{/if}}
                </button>

                <!-- Selectores desktop inline -->
                <div id="ingredient-advanced-filters" class="hidden w-full flex-col gap-2 pt-2 lg:flex lg:w-auto lg:flex-row lg:items-center lg:pt-0">
                    {{#each searchFilters}}
                    <select
                        id="{{this.id}}"
                        name="{{this.name}}"
                        aria-label="{{this.label}}"
                        class="h-9 rounded-xl border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 outline-none transition-colors focus:border-[#1b4332]"
                    >
                        <option value="">{{this.label}}</option>
                        {{#each this.options}}
                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.text}}</option>
                        {{/each}}
                    </select>
                    {{/each}}
                </div>

                <!-- Conmutador de vista Grilla / Tabla -->
                <div class="inline-flex h-9 shrink-0 items-center rounded-xl border border-slate-200 bg-slate-100/80 p-0.5" role="group" aria-label="Modo de visualización">
                    <button
                        id="view-grid"
                        type="button"
                        title="Vista en cuadrícula"
                        aria-label="Vista en cuadrícula"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[#1b4332] text-white transition-colors"
                    >
                        <i data-lucide="layout-grid" class="h-3.5 w-3.5"></i>
                    </button>
                    <button
                        id="view-table"
                        type="button"
                        title="Vista en tabla"
                        aria-label="Vista en tabla"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-600 hover:text-slate-900 transition-colors"
                    >
                        <i data-lucide="table-2" class="h-3.5 w-3.5"></i>
                    </button>
                </div>
            </div>

            <!-- Píldoras rápidas + Contador compacto -->
            <div class="flex items-center justify-between gap-2 border-t border-slate-100 pt-1.5">
                <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-0.5">
                    <button
                        type="button"
                        data-ingredient-type-pill=""
                        class="shrink-0 rounded-lg px-2.5 py-1 text-[11px] font-bold transition-colors {{#unless query.tipo}}bg-[#1b4332] text-white{{else}}bg-slate-100 text-slate-600 hover:bg-slate-200{{/unless}}"
                    >
                        Todos
                    </button>
                    {{#each quickTypes}}
                    <button
                        type="button"
                        data-ingredient-type-pill="{{this.value}}"
                        class="shrink-0 rounded-lg px-2.5 py-1 text-[11px] font-bold transition-colors {{#if this.selected}}bg-[#1b4332] text-white{{else}}bg-slate-100 text-slate-600 hover:bg-slate-200{{/if}}"
                    >
                        {{this.text}}
                    </button>
                    {{/each}}
                </div>

                <div class="flex shrink-0 items-center gap-2.5">
                    <span id="ingredients-results-counter" class="font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-wider text-slate-500">
                        <strong class="text-slate-900">{{totalCount}}</strong> resultado(s)
                    </span>
                    {{#if hasActiveFilters}}
                    <a
                        href="/private/ingredients"
                        data-ingredients-clear
                        class="inline-flex items-center gap-1 text-[11px] font-bold text-[#1b4332] hover:underline"
                    >
                        <i data-lucide="x" class="h-3 w-3"></i>
                        <span>Limpiar</span>
                    </a>
                    {{/if}}
                </div>
            </div>
        </form>
    </section>

    <!-- Región dinámica de resultados -->
    <div id="ingredients-results-region" class="space-y-5">
        {{> private/ingredients/grid}}
        {{> private/ingredients/table}}

        {{#if totalCount}}
        <nav aria-label="Paginación de ingredientes activos" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/90 bg-white px-5 py-3.5 shadow-xs">
            <p class="font-['Geist_Mono'] text-xs text-slate-500">
                Mostrando <strong class="text-slate-900">{{pagination.startItem}}–{{pagination.endItem}}</strong> de <strong class="text-slate-900">{{totalCount}}</strong> moléculas · Página {{currentPage}} de {{totalPages}}
            </p>
            <div class="flex items-center gap-2">
                {{#if pagination.hasPrev}}
                <a
                    href="/private/ingredients?page={{pagination.prevPage}}&search={{query.search}}&tipo={{query.tipo}}&toxicidad={{query.toxicidad}}&status={{query.status}}"
                    data-ingredients-page="{{pagination.prevPage}}"
                    class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors"
                >
                    <i data-lucide="chevron-left" class="h-3.5 w-3.5"></i>
                    <span>Anterior</span>
                </a>
                {{/if}}
                {{#if pagination.hasNext}}
                <a
                    href="/private/ingredients?page={{pagination.nextPage}}&search={{query.search}}&tipo={{query.tipo}}&toxicidad={{query.toxicidad}}&status={{query.status}}"
                    data-ingredients-page="{{pagination.nextPage}}"
                    class="inline-flex items-center gap-1.5 rounded-xl bg-[#1b4332] px-3.5 py-1.5 text-xs font-bold text-white hover:bg-[#143325] transition-colors"
                >
                    <span>Siguiente</span>
                    <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
                </a>
                {{/if}}
            </div>
        </nav>
        {{/if}}
    </div>
</div>

{{> private/ingredients/form-modal}}

<!-- Modal Solicitud Justificada de Baja para Ingrediente Activo -->
<div id="modal-request-archive-ingredient" role="dialog" aria-modal="true" class="fixed inset-0 z-100 hidden items-center justify-center p-4 font-['Geist']">
    <div id="modal-request-archive-ingredient-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-xs"></div>
    <div class="relative z-10 w-full max-w-lg bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden">
        <div class="p-6 border-b border-slate-200">
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                    <i data-lucide="shield-alert" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">Solicitud de Baja de Molécula Activa</h3>
                    <p class="mt-0.5 text-xs text-slate-500">
                        Principio de los 4 ojos: Para dar de baja un ingrediente activo normativo, debes capturar la justificación técnica. La solicitud requerirá la aprobación de otro especialista antes de archivarse.
                    </p>
                </div>
            </div>
        </div>
        <form id="form-request-archive-ingredient" method="POST" action="" class="p-6 space-y-4">
            <input type="hidden" name="action" value="request_archive" />
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">Motivo / Causa de la baja <span class="text-rose-500">*</span></label>
                <select name="archive_reason_category" required class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs text-slate-800 focus:border-[#1b4332] focus:outline-none">
                    <option value="cambio_normativo">Prohibición Regulatoria (CICOPLAFEST / OMS / Convenio de Róterdam)</option>
                    <option value="riesgo_sanitario">Riesgo Toxicológico o Fitosanitario Extremo</option>
                    <option value="obsolescencia_tecnica">Obsolescencia Técnica / Reemplazo por Nuevas Moléculas</option>
                    <option value="duplicado_invalido">Registro Duplicado o Error de Nomenclatura</option>
                    <option value="otro">Otro motivo técnico justificado</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">Justificación técnica detallada <span class="text-rose-500">* (mínimo 20 caracteres)</span></label>
                <textarea name="archive_reason" required minlength="20" maxlength="1000" rows="4" placeholder="Describe detalladamente los fundamentos normativos o agronómicos que justifican la baja de esta molécula..." class="w-full rounded-xl border border-slate-200 bg-white p-3 text-xs text-slate-800 focus:border-[#1b4332] focus:outline-none placeholder:text-slate-400"></textarea>
            </div>
            <div class="pt-2 border-t border-slate-200 flex justify-end gap-2">
                <button type="button" id="btn-cancel-request-archive-ingredient" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-600 text-white text-xs font-bold hover:bg-amber-700 transition-colors shadow-2xs cursor-pointer">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span>Tramitar Solicitud de Baja</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script type="module" src="/js/private/ingredients.js"></script>
