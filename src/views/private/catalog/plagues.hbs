<!-- Catálogo Privado y Panel de Control Fitosanitario INIFAP (RBAC + KPIs + Geist Design System) -->
<main class="min-h-screen font-['Geist'] antialiased bg-background text-foreground pb-20">

    <div class="max-w-7xl mx-auto px-4 md:px-10 pt-6 space-y-8">

        <!-- ===================================================== -->
        <!-- ENCABEZADO ADMINISTRATIVO + ACCIONES SEGÚN ROL (RBAC) -->
        <!-- ===================================================== -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-border/80 pb-8">
            <div class="space-y-2.5">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="px-3 py-1 rounded-full bg-[#e6f0e6] text-[#1b4332] text-[11px] font-mono font-bold tracking-wider uppercase">
                        SISTEMA NACIONAL DE VIGILANCIA FITOSANITARIA · INIFAP
                    </span>
                    {{#if isAdmin}}
                    <span class="px-2.5 py-0.5 rounded-md bg-purple-100 text-purple-800 text-[10px] font-mono font-bold uppercase">
                        ADMINISTRADOR
                    </span>
                    {{else}}{{#if isInifap}}
                    <span class="px-2.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-mono font-bold uppercase">
                        INVESTIGADOR INIFAP
                    </span>
                    {{else}}
                    <span class="px-2.5 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[10px] font-mono font-bold uppercase">
                        CONSULTA PRIVADA
                    </span>
                    {{/if}}{{/if}}
                </div>
                <h1 class="text-3xl md:text-5xl font-headline font-black tracking-tight text-[#1b4332] leading-none">
                    Gestión de Plagas y Amenazas
                </h1>
                <p class="max-w-2xl text-xs md:text-sm leading-relaxed text-muted-foreground">
                    Módulo de administración fitosanitaria, validación técnica de patógenos y control biológico.
                </p>
            </div>

            <!-- Botones de Acción (Protegidos por RBAC) -->
            <div class="flex items-center gap-3 shrink-0">
                <button type="button" id="btn-export-plagues"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-border/80 bg-card text-foreground text-xs font-bold hover:bg-muted transition-all shadow-2xs cursor-pointer">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Exportar Informe</span>
                </button>

                {{#if permissions.canCreate}}
                <button type="button" id="btn-add-plague"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#1b4332] text-white text-xs font-bold hover:bg-[#2d6a4f] transition-all shadow-md active:scale-95 cursor-pointer">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Nueva Plaga</span>
                </button>
                {{/if}}
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- TARJETAS KPIS ADMINISTRATIVOS Y MÉTRICAS FITOSANITARIAS -->
        <!-- ===================================================== -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- KPI 1: Total Plagas -->
            <div class="bg-card border border-border/80 rounded-2xl p-5 shadow-2xs flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Total Catalogadas</p>
                    <h3 class="text-3xl font-headline font-black text-[#1b4332] mt-1 tabular-nums">{{stats.totalPlagues}}</h3>
                    <p class="text-[11px] text-muted-foreground mt-1 flex items-center gap-1">
                        <i data-lucide="database" class="w-3.5 h-3.5 text-[#2d6a4f]"></i>
                        <span>En base de datos</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center">
                    <i data-lucide="bug" class="w-6 h-6"></i>
                </div>
            </div>

            <!-- KPI 2: Plagas publicadas -->
            <div class="bg-card border border-border/80 rounded-2xl p-5 shadow-2xs flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Publicadas</p>
                    <h3 class="text-3xl font-headline font-black text-emerald-700 mt-1 tabular-nums">{{stats.activePlagues}}</h3>
                    <p class="text-[11px] text-emerald-700 mt-1 flex items-center gap-1 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Visibles al público</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
                    <i data-lucide="activity" class="w-6 h-6"></i>
                </div>
            </div>

            <!-- KPI 3: Amenazas Críticas / Alto Riesgo -->
            <div class="bg-card border border-border/80 rounded-2xl p-5 shadow-2xs flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Riesgo Alto / Crítico</p>
                    <h3 class="text-3xl font-headline font-black text-rose-600 mt-1 tabular-nums">{{stats.criticalPlagues}}</h3>
                    <p class="text-[11px] text-rose-600 mt-1 flex items-center gap-1 font-medium">
                        <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>
                        <span>Atención prioritaria</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center">
                    <i data-lucide="shield-alert" class="w-6 h-6"></i>
                </div>
            </div>

            <!-- KPI 4: Pendientes de Verificación INIFAP -->
            <div class="bg-card border border-border/80 rounded-2xl p-5 shadow-2xs flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Pendientes de Validación</p>
                    <h3 class="text-3xl font-headline font-black text-amber-600 mt-1 tabular-nums">{{stats.pendingVerification}}</h3>
                    <p class="text-[11px] text-amber-600 mt-1 flex items-center gap-1 font-medium">
                        <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                        <span>Requieren dictamen</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <i data-lucide="file-check" class="w-6 h-6"></i>
                </div>
            </div>

        </div>

        <!-- ===================================================== -->
        <!-- BARRA PEGAJOSA DE FILTROS ADMINISTRATIVOS (STICKY GLASS) -->
        <!-- ===================================================== -->
        <div class="sticky top-16 z-30 -mx-4 md:-mx-10 px-4 md:px-10 py-4 bg-background/90 backdrop-blur-md border-b border-border/80 shadow-2xs">
            <form id="plague-filter-form" action="/private/plagues" method="GET" class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
                
                <!-- Buscador de Administración -->
                <div class="relative flex-1 min-w-65">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-muted-foreground"></i>
                    <input id="plague-search" name="search" type="search" value="{{filters.search}}" maxlength="120"
                        class="w-full pl-10 pr-4 py-2.5 bg-card border border-input rounded-xl text-xs text-foreground placeholder:text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all"
                        placeholder="Buscar por ID, nombre común, científico, región o síntomas..." />
                </div>

                <!-- Dropdowns y Selectores -->
                <div class="flex flex-wrap items-center gap-3">
                    
                    <!-- Filtro Categoría -->
                    <div class="relative min-w-37.5">
                        <select id="filter-category" name="category"
                            class="filter-select appearance-none w-full bg-card border border-input rounded-xl px-3.5 py-2.5 pr-8 text-xs font-medium text-foreground focus:outline-hidden focus:border-[#1b4332] transition-all cursor-pointer">
                            <option value="">Categoría · Todas</option>
                            <option value="Insecto" {{#if (eq filters.category 'Insecto')}}selected{{/if}}>Insecto</option>
                            <option value="Hongo" {{#if (eq filters.category 'Hongo')}}selected{{/if}}>Hongo</option>
                            <option value="Bacteria" {{#if (eq filters.category 'Bacteria')}}selected{{/if}}>Bacteria</option>
                            <option value="Virus" {{#if (eq filters.category 'Virus')}}selected{{/if}}>Virus</option>
                            <option value="Ácaro" {{#if (eq filters.category 'Ácaro')}}selected{{/if}}>Ácaro</option>
                        </select>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"></i>
                    </div>

                    <!-- Filtro Estatus -->
                    <div class="relative min-w-35">
                        <select id="filter-workflow" name="workflow"
                            class="filter-select appearance-none w-full bg-card border border-input rounded-xl px-3.5 py-2.5 pr-8 text-xs font-medium text-foreground focus:outline-hidden focus:border-[#1b4332] transition-all cursor-pointer">
                            <option value="">Estatus · Todos</option>
                            <option value="draft" {{#if (eq filters.workflow 'draft')}}selected{{/if}}>Borrador</option>
                            <option value="in_review" {{#if (eq filters.workflow 'in_review')}}selected{{/if}}>En revisión</option>
                            <option value="changes_requested" {{#if (eq filters.workflow 'changes_requested')}}selected{{/if}}>Cambios solicitados</option>
                            <option value="verified" {{#if (eq filters.workflow 'verified')}}selected{{/if}}>Verificada</option>
                            <option value="published" {{#if (eq filters.workflow 'published')}}selected{{/if}}>Publicada</option>
                            <option value="archived" {{#if (eq filters.workflow 'archived')}}selected{{/if}}>Archivada</option>
                        </select>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"></i>
                    </div>

                    <!-- Cambiador de Vista Grilla / Tabla -->
                    <div class="flex items-center bg-card border border-input rounded-xl p-1 gap-1 shrink-0">
                        <button type="button" id="view-grid" title="Vista en tarjetas"
                            class="p-2 rounded-lg bg-[#1b4332] text-white transition-all cursor-pointer">
                            <i data-lucide="layout-grid" class="w-4 h-4"></i>
                        </button>
                        <button type="button" id="view-table" title="Vista en tabla"
                            class="p-2 rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer">
                            <i data-lucide="table-properties" class="w-4 h-4"></i>
                        </button>
                    </div>

                    <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-[#1b4332] px-4 py-2.5 text-xs font-bold text-white shadow-2xs transition-colors hover:bg-[#2d6a4f]">
                        <i data-lucide="search" class="h-3.5 w-3.5"></i>
                        Aplicar
                    </button>

                    {{#if hasActiveFilters}}
                    <a href="/private/plagues" class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-bold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                        <i data-lucide="x" class="h-3.5 w-3.5"></i>
                        Limpiar
                    </a>
                    {{/if}}
                </div>
            </form>
        </div>

        <div class="flex flex-col gap-1 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
            <p>
                Mostrando <strong class="text-foreground">{{pagination.fromItem}}–{{pagination.toItem}}</strong>
                de <strong class="text-foreground">{{pagination.totalItems}}</strong> resultados.
            </p>
            {{#if hasActiveFilters}}
            <p class="font-mono text-[10px] uppercase tracking-wider">Filtros activos</p>
            {{/if}}
        </div>

        <!-- ===================================================== -->
        <!-- VISTA DE TARJETAS (GRID VIEW EN GEIST) -->
        <!-- ===================================================== -->
        <section id="plagues-grid-view" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

            {{#each plagues}}
            <article class="group bg-card border border-border/80 rounded-2xl overflow-hidden shadow-2xs flex flex-col hover:border-[#1b4332]/50 hover:shadow-md transition-all duration-300">
                
                <!-- Imagen con Badges Fitosanitarios -->
                <div class="relative h-48 overflow-hidden bg-muted/50">
                    {{#if image_url}}
                    <img class="plague-list-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        src="{{image_url}}" alt="{{name}}">
                    <div class="plague-image-fallback hidden w-full h-full flex-col items-center justify-center text-muted-foreground/40 gap-2">
                        <i data-lucide="bug" class="w-10 h-10 stroke-[1.5]"></i>
                        <span class="text-[10px] font-mono uppercase tracking-widest">Imagen no disponible</span>
                    </div>
                    {{else}}
                    <div class="w-full h-full flex flex-col items-center justify-center text-muted-foreground/40 gap-2">
                        <i data-lucide="bug" class="w-10 h-10 stroke-[1.5]"></i>
                        <span class="text-[10px] font-mono uppercase tracking-widest">Sin imagen</span>
                    </div>
                    {{/if}}

                    <!-- Risk Level Badge -->
                    {{#if risk_level}}
                    <div class="absolute top-3 left-3">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider shadow-2xs backdrop-blur-md 
                            {{#if (eq risk_level 'Crítico')}}bg-rose-600/90 text-white
                            {{else}}{{#if (eq risk_level 'Alto')}}bg-amber-600/90 text-white
                            {{else}}{{#if (eq risk_level 'Medio')}}bg-yellow-500/90 text-slate-900
                            {{else}}bg-emerald-600/90 text-white{{/if}}{{/if}}{{/if}}">
                            {{risk_level}}
                        </span>
                    </div>
                    {{/if}}

                    <!-- Status Badge -->
                    <div class="absolute top-3 right-3">
                        {{#if (eq workflow_status 'published')}}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-bold text-[#1b4332] shadow-2xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            Publicada
                        </span>
                        {{else if (eq workflow_status 'in_review')}}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-bold text-amber-700 shadow-2xs">En revisión</span>
                        {{else if (eq workflow_status 'verified')}}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-bold text-blue-700 shadow-2xs">Verificada</span>
                        {{else if (eq workflow_status 'changes_requested')}}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-bold text-orange-700 shadow-2xs">Cambios solicitados</span>
                        {{else if (eq workflow_status 'archived')}}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-bold text-slate-600 shadow-2xs">Archivada</span>
                        {{else}}
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-[10px] font-bold text-muted-foreground shadow-2xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                            Borrador
                        </span>
                        {{/if}}
                    </div>
                </div>

                <!-- Detalles de la Plaga -->
                <div class="p-5 flex-1 flex flex-col">
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                        <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#2d6a4f] bg-[#e6f0e6] px-2 py-0.5 rounded-md">
                            {{#if category}}{{category}}{{else}}Plaga General{{/if}}
                        </span>
                        {{#if verified_by}}
                        <span class="flex items-center gap-1 text-[10px] text-emerald-700 font-bold" title="Verificado por INIFAP">
                            <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                            <span>INIFAP</span>
                        </span>
                        {{/if}}
                    </div>

                    <h3 class="text-base font-headline font-bold text-foreground group-hover:text-[#1b4332] transition-colors leading-snug">
                        {{name}}
                    </h3>
                    
                    {{#if scientific_name}}
                    <p class="text-xs italic text-muted-foreground mb-3 font-serif">
                        {{scientific_name}}
                    </p>
                    {{/if}}

                    <div class="space-y-1.5 text-xs text-muted-foreground mb-4">
                        {{#if region}}
                        <div class="flex items-center gap-1.5">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5 shrink-0 text-[#2d6a4f]"></i>
                            <span class="truncate">{{region}}</span>
                        </div>
                        {{/if}}
                        {{#if verified_by}}
                        <div class="flex items-center gap-1.5">
                            <i data-lucide="user-check" class="w-3.5 h-3.5 shrink-0 text-muted-foreground"></i>
                            <span class="truncate">Por: {{verified_by}}</span>
                        </div>
                        {{/if}}
                    </div>

                    <!-- Footer de Acciones con RBAC Control -->
                    <div class="mt-auto pt-3 border-t border-border/60 flex items-center justify-between gap-2">
                        <a href="/private/plagues/{{id}}"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#e6f0e6] text-[#1b4332] text-xs font-bold hover:bg-[#1b4332] hover:text-white transition-all">
                            <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                            <span>Ver Detalles</span>
                        </a>

                        <div class="flex items-center gap-1">
                            {{#if canEditRecord}}
                            <button type="button"
                                class="btn-edit-plague p-2 rounded-lg text-muted-foreground hover:text-[#1b4332] hover:bg-muted transition-colors cursor-pointer"
                                title="Editar plaga" data-id="{{id}}" data-name="{{name}}"
                                data-scientific-name="{{scientific_name}}" data-category="{{category}}"
                                data-region="{{region}}" data-risk-level="{{risk_level}}"
                                data-description="{{description}}" data-symptoms="{{symptoms}}"
                                data-control-methods="{{control_methods}}"
                                data-biological-control="{{biological_control}}"
                                data-biological-cycle="{{biological_cycle_json}}" data-images="{{images_json}}" data-image-url="{{image_url}}">
                                <i data-lucide="edit-2" class="w-4 h-4"></i>
                            </button>
                            {{/if}}

                            {{#if ../permissions.canDelete}}
                            <button type="button"
                                class="btn-delete-plague p-2 rounded-lg text-muted-foreground hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer"
                                title="Eliminar plaga" data-id="{{id}}" data-name="{{name}}">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </article>

            {{else}}
            <div class="col-span-full bg-card border border-border/80 rounded-2xl p-12 text-center flex flex-col items-center justify-center">
                <div class="w-14 h-14 rounded-2xl bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center mb-3">
                    <i data-lucide="bug" class="w-7 h-7"></i>
                </div>
                <h3 class="text-base font-bold text-foreground">No hay plagas registradas</h3>
                <p class="text-xs text-muted-foreground mt-1 max-w-sm">
                    No se encontraron registros que coincidan con la búsqueda o filtros aplicados.
                </p>
            </div>
            {{/each}}

            <!-- CTA Crear Plaga -->
            {{#if permissions.canCreate}}
            <button type="button" id="btn-add-plague-card"
                class="group bg-card/50 hover:bg-card border-2 border-dashed border-border hover:border-[#1b4332]/50 rounded-2xl p-6 min-h-70 flex flex-col items-center justify-center text-center transition-all cursor-pointer shadow-2xs hover:shadow-md">
                <div class="w-12 h-12 rounded-2xl bg-[#e6f0e6] text-[#1b4332] group-hover:bg-[#1b4332] group-hover:text-white flex items-center justify-center mb-3 transition-colors">
                    <i data-lucide="plus" class="w-6 h-6"></i>
                </div>
                <h3 class="text-sm font-bold text-foreground group-hover:text-[#1b4332] transition-colors">¿Registrar Nueva Plaga?</h3>
                <p class="text-xs text-muted-foreground mt-1 mb-4 max-w-xs">
                    Añade un nuevo patógeno o amenaza fitosanitaria al catálogo oficial INIFAP.
                </p>
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#e6f0e6] text-[#1b4332] text-xs font-bold group-hover:bg-[#1b4332] group-hover:text-white transition-colors">
                    <span>Añadir Registro</span>
                </span>
            </button>
            {{/if}}

        </section>

        <!-- ===================================================== -->
        <!-- VISTA EN TABLA ADMINISTRATIVA (TABLE VIEW EN GEIST) -->
        <!-- ===================================================== -->
        <section id="plagues-table-view" class="hidden bg-card border border-border/80 rounded-2xl overflow-hidden shadow-2xs">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse font-['Geist']">
                    <thead>
                        <tr class="bg-muted/50 border-b border-border/80">
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Muestra</th>
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Plaga / Especie</th>
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Categoría</th>
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground text-center">Nivel Riesgo</th>
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Región</th>
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Verificación</th>
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground text-center">Estado</th>
                            <th class="px-6 py-3.5 text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border/60 text-xs">
                        {{#each plagues}}
                        <tr class="hover:bg-muted/30 transition-colors">
                            <td class="px-6 py-4">
                                {{#if image_url}}
                                <img src="{{image_url}}" alt="{{name}}" class="plague-list-image w-10 h-10 rounded-xl object-cover border border-border/80">
                                <div class="plague-image-fallback hidden w-10 h-10 rounded-xl bg-muted items-center justify-center text-muted-foreground">
                                    <i data-lucide="bug" class="w-5 h-5"></i>
                                </div>
                                {{else}}
                                <div class="w-10 h-10 rounded-xl bg-muted flex items-center justify-center text-muted-foreground">
                                    <i data-lucide="bug" class="w-5 h-5"></i>
                                </div>
                                {{/if}}
                            </td>
                            <td class="px-6 py-4">
                                <p class="font-bold text-foreground">{{name}}</p>
                                {{#if scientific_name}}
                                <p class="text-[11px] italic font-serif text-muted-foreground">{{scientific_name}}</p>
                                {{/if}}
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-0.5 rounded-md bg-[#e6f0e6] text-[#1b4332] text-[10px] font-mono font-bold uppercase">
                                    {{category}}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                {{#if risk_level}}
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase
                                    {{#if (eq risk_level 'Crítico')}}bg-rose-100 text-rose-800
                                    {{else}}{{#if (eq risk_level 'Alto')}}bg-amber-100 text-amber-800
                                    {{else}}{{#if (eq risk_level 'Medio')}}bg-yellow-100 text-yellow-800
                                    {{else}}bg-emerald-100 text-emerald-800{{/if}}{{/if}}{{/if}}">
                                    {{risk_level}}
                                </span>
                                {{else}}
                                <span class="text-xs text-muted-foreground">-</span>
                                {{/if}}
                            </td>
                            <td class="px-6 py-4 text-muted-foreground">
                                {{#if region}}{{region}}{{else}}Sin especificar{{/if}}
                            </td>
                            <td class="px-6 py-4 text-muted-foreground">
                                {{#if verified_by}}
                                <div class="flex items-center gap-1 text-emerald-700 font-medium">
                                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                                    <span>{{verified_by}}</span>
                                </div>
                                {{else}}
                                <span class="text-muted-foreground">Pendiente</span>
                                {{/if}}
                            </td>
                            <td class="px-6 py-4 text-center">
                                {{#if (eq workflow_status 'published')}}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    Publicada
                                </span>
                                {{else if (eq workflow_status 'in_review')}}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-[10px] font-bold">En revisión</span>
                                {{else if (eq workflow_status 'verified')}}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-[10px] font-bold">Verificada</span>
                                {{else if (eq workflow_status 'changes_requested')}}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-orange-50 text-orange-700 text-[10px] font-bold">Cambios solicitados</span>
                                {{else if (eq workflow_status 'archived')}}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold">Archivada</span>
                                {{else}}
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                    Borrador
                                </span>
                                {{/if}}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="/private/plagues/{{id}}" class="p-1.5 rounded-lg text-muted-foreground hover:text-[#1b4332] hover:bg-muted transition-colors" title="Ver detalles">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </a>
                                    {{#if canEditRecord}}
                                    <button type="button" class="btn-edit-plague p-1.5 rounded-lg text-muted-foreground hover:text-[#1b4332] hover:bg-muted transition-colors cursor-pointer"
                                        title="Editar plaga" data-id="{{id}}" data-name="{{name}}"
                                        data-scientific-name="{{scientific_name}}" data-category="{{category}}"
                                        data-region="{{region}}" data-risk-level="{{risk_level}}"
                                        data-description="{{description}}" data-symptoms="{{symptoms}}"
                                        data-control-methods="{{control_methods}}"
                                        data-biological-control="{{biological_control}}"
                                        data-biological-cycle="{{biological_cycle_json}}" data-images="{{images_json}}" data-image-url="{{image_url}}">
                                        <i data-lucide="edit-2" class="w-4 h-4"></i>
                                    </button>
                                    {{/if}}
                                    {{#if ../permissions.canDelete}}
                                    <button type="button" class="btn-delete-plague p-1.5 rounded-lg text-muted-foreground hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer"
                                        title="Eliminar plaga" data-id="{{id}}" data-name="{{name}}">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                    {{/if}}
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="8" class="px-6 py-12 text-center text-xs text-muted-foreground">
                                No se encontraron registros de plagas en la base de datos.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </section>

        {{#if pagination.hasMultiplePages}}
        <nav aria-label="Paginación de plagas" class="flex flex-col items-center justify-between gap-4 rounded-2xl border border-border/80 bg-card px-4 py-3 shadow-2xs sm:flex-row">
            <p class="text-xs text-muted-foreground">
                Página <strong class="text-foreground">{{pagination.currentPage}}</strong> de
                <strong class="text-foreground">{{pagination.totalPages}}</strong>
            </p>

            <div class="flex items-center gap-1">
                {{#if pagination.hasPrevPage}}
                <a href="{{pagination.prevUrl}}" aria-label="Página anterior" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border text-foreground transition-colors hover:bg-muted">
                    <i data-lucide="chevron-left" class="h-4 w-4"></i>
                </a>
                {{else}}
                <span aria-disabled="true" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted-foreground opacity-40">
                    <i data-lucide="chevron-left" class="h-4 w-4"></i>
                </span>
                {{/if}}

                {{#each pagination.pages}}
                    {{#if this.isCurrent}}
                    <span aria-current="page" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg bg-[#1b4332] px-2 text-xs font-bold text-white">{{this.number}}</span>
                    {{else}}
                    <a href="{{this.url}}" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-border px-2 text-xs font-bold text-foreground transition-colors hover:bg-muted">{{this.number}}</a>
                    {{/if}}
                {{/each}}

                {{#if pagination.hasNextPage}}
                <a href="{{pagination.nextUrl}}" aria-label="Página siguiente" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border text-foreground transition-colors hover:bg-muted">
                    <i data-lucide="chevron-right" class="h-4 w-4"></i>
                </a>
                {{else}}
                <span aria-disabled="true" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted-foreground opacity-40">
                    <i data-lucide="chevron-right" class="h-4 w-4"></i>
                </span>
                {{/if}}
            </div>
        </nav>
        {{/if}}

    </div>
</main>

<!-- ========================================================= -->
<!-- MODAL ELIMINAR PLAGA -->
<!-- ========================================================= -->
{{#if permissions.canDelete}}
<div id="modal-delete-plague" class="fixed inset-0 z-50 hidden items-center justify-center p-4 font-['Geist']">
    <div id="modal-delete-plague-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-xs"></div>
    <div class="relative z-10 w-full max-w-md bg-card border border-border/80 rounded-2xl shadow-xl overflow-hidden">
        <div class="p-6 border-b border-border/60">
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-foreground">¿Eliminar plaga?</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Esta acción removerá el registro del catálogo INIFAP permanentemente.
                    </p>
                </div>
            </div>
        </div>
        <div class="p-6 text-xs text-muted-foreground">
            ¿Confirmas la eliminación definitiva de la plaga <strong id="delete-plague-name" class="text-foreground"></strong>?
        </div>
        <div class="px-6 py-4 bg-muted/40 border-t border-border/60 flex justify-end gap-2">
            <button type="button" id="btn-cancel-delete-plague"
                class="px-4 py-2 rounded-xl border border-border/80 text-xs font-bold text-muted-foreground hover:bg-muted transition-colors cursor-pointer">
                Cancelar
            </button>
            <form id="delete-plague-form" method="POST">
                <button type="submit"
                    class="px-4 py-2 rounded-xl bg-rose-600 text-white text-xs font-bold hover:bg-rose-700 transition-colors shadow-2xs cursor-pointer">
                    Eliminar
                </button>
            </form>
        </div>
    </div>
</div>
{{/if}}

<!-- ========================================================= -->
<!-- MODAL AÑADIR / EDITAR PLAGA -->
<!-- ========================================================= -->
{{#if permissions.canCreate}}
<div id="modal-plague" class="fixed inset-0 z-50 hidden items-center justify-center p-4 font-['Geist']">
    <div id="modal-plague-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-xs"></div>
    <div class="relative z-10 bg-card border border-border/80 rounded-2xl shadow-xl w-full max-w-3xl max-h-[90vh] overflow-y-auto flex flex-col">
        
        <form id="plague-form" action="/private/plagues/create" method="POST" enctype="multipart/form-data" class="flex flex-col flex-1">
            
            <!-- Header Modal -->
            <div class="sticky top-0 z-20 bg-card/95 backdrop-blur-md border-b border-border/80 px-6 py-4 flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#2d6a4f]">Catálogo Fitosanitario</span>
                    <h3 id="modal-plague-title" class="text-base font-headline font-black text-foreground">Nueva Plaga</h3>
                </div>
                <button type="button" id="modal-plague-close" class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Campos Formulario -->
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                
                <div>
                    <label class="block font-bold text-foreground mb-1.5">Nombre Común *</label>
                    <input type="text" name="name" required placeholder="Ej. Mosca blanca"
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
                </div>

                <div>
                    <label class="block font-bold text-foreground mb-1.5">Nombre Científico *</label>
                    <input type="text" name="scientific_name" required placeholder="Ej. Bemisia tabaci"
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs italic font-serif text-foreground focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
                </div>

                <div>
                    <label class="block font-bold text-foreground mb-1.5">Categoría</label>
                    <select name="category"
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
                        <option value="">Seleccione categoría...</option>
                        <option value="Insecto">Insecto</option>
                        <option value="Hongo">Hongo</option>
                        <option value="Bacteria">Bacteria</option>
                        <option value="Virus">Virus</option>
                        <option value="Ácaro">Ácaro</option>
                    </select>
                </div>

                <div>
                    <label class="block font-bold text-foreground mb-1.5">Región Afectada</label>
                    <input type="text" name="region" placeholder="Ej. Centro de México, El Bajío..."
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
                </div>

                <div>
                    <label class="block font-bold text-foreground mb-1.5">Nivel de Riesgo</label>
                    <select name="risk_level"
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all">
                        <option value="Bajo">Bajo</option>
                        <option value="Medio">Medio</option>
                        <option value="Alto">Alto</option>
                        <option value="Crítico">Crítico</option>
                    </select>
                </div>

                <div class="md:col-span-2">
                    <label class="block font-bold text-foreground mb-1.5">Descripción de la Plaga</label>
                    <textarea name="description" rows="3" placeholder="Describe las características morfológicas y biológicas..."
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground resize-none focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all"></textarea>
                </div>

                <div class="md:col-span-2">
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <label class="block font-bold text-foreground">Ciclo Biológico</label>
                            <p class="mt-0.5 text-[11px] text-muted-foreground">Organiza el ciclo en hasta 20 etapas.</p>
                        </div>
                        <button type="button" id="btn-add-biological-stage"
                            class="inline-flex items-center gap-1.5 rounded-xl border border-[#1b4332]/20 bg-[#e6f0e6] px-3 py-2 text-xs font-bold text-[#1b4332] transition-colors hover:bg-[#d8ead8] cursor-pointer">
                            <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                            Añadir etapa
                        </button>
                    </div>

                    <div id="biological-cycle-builder" class="space-y-3" aria-live="polite"></div>

                    <template id="biological-cycle-stage-template">
                        <article data-biological-stage class="rounded-2xl border border-border/80 bg-muted/20 p-4">
                            <div class="mb-3 flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#1b4332] text-[11px] font-bold text-white" data-stage-number></span>
                                    <span class="text-xs font-bold text-foreground">Etapa del ciclo</span>
                                </div>
                                <button type="button" class="remove-biological-stage inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-[11px] font-bold text-rose-600 transition-colors hover:bg-rose-50 cursor-pointer" aria-label="Eliminar etapa">
                                    <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                                    Eliminar
                                </button>
                            </div>
                            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                <div>
                                    <label class="mb-1 block text-[11px] font-bold text-foreground">Nombre de la etapa</label>
                                    <input type="text" name="biological_cycle_title[]" maxlength="150" placeholder="Ej. Huevo, larva o adulto"
                                        class="w-full rounded-xl border border-input bg-card px-3.5 py-2.5 text-xs text-foreground transition-all focus:border-[#1b4332] focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20">
                                </div>
                                <div>
                                    <label class="mb-1 block text-[11px] font-bold text-foreground">Duración estimada</label>
                                    <input type="text" name="biological_cycle_duration[]" maxlength="100" placeholder="Ej. 3 a 5 días"
                                        class="w-full rounded-xl border border-input bg-card px-3.5 py-2.5 text-xs text-foreground transition-all focus:border-[#1b4332] focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="mb-1 block text-[11px] font-bold text-foreground">Descripción</label>
                                    <textarea name="biological_cycle_description[]" maxlength="500" rows="2" placeholder="Describe qué ocurre durante esta etapa..."
                                        class="w-full resize-none rounded-xl border border-input bg-card px-3.5 py-2.5 text-xs text-foreground transition-all focus:border-[#1b4332] focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20"></textarea>
                                </div>
                            </div>
                        </article>
                    </template>
                </div>

                <div class="md:col-span-2">
                    <label class="block font-bold text-foreground mb-1.5">Síntomas en el Cultivo</label>
                    <textarea name="symptoms" rows="2" placeholder="Describe las lesiones o síntomas observables..."
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground resize-none focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all"></textarea>
                </div>

                <div>
                    <label class="block font-bold text-foreground mb-1.5">Métodos de Control Químico/Físico</label>
                    <textarea name="control_methods" rows="3" placeholder="Recomendaciones de manejo..."
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground resize-none focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all"></textarea>
                </div>

                <div>
                    <label class="block font-bold text-foreground mb-1.5">Control Biológico</label>
                    <textarea name="biological_control" rows="3" placeholder="Organismos o parasitoides recomendados..."
                        class="w-full bg-muted/40 border border-input rounded-xl px-3.5 py-2.5 text-xs text-foreground resize-none focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="block font-bold text-foreground mb-1.5">Galería de imágenes</label>
                    <div class="bg-muted/40 border border-input rounded-xl p-4 space-y-4">
                        <div id="plague-image-previews" class="hidden grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5" aria-live="polite"></div>
                        <div class="w-full">
                            <input id="plague-images" type="file" name="images" multiple accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                class="block w-full text-xs text-muted-foreground file:mr-4 file:py-2 file:px-3 file:rounded-xl file:border-0 file:bg-[#e6f0e6] file:text-[#1b4332] file:font-bold file:text-xs">
                            <p class="text-[11px] text-muted-foreground mt-1.5">Selecciona hasta 10 imágenes por vez · JPG, PNG o WEBP · máximo 5 MB cada una.</p>
                            <p id="plague-existing-images-note" class="hidden text-[11px] text-[#2d6a4f] mt-1">Las imágenes actuales se conservarán; la nueva selección se añadirá al final de la galería.</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Footer Botones Modal -->
            <div class="sticky bottom-0 bg-card/95 backdrop-blur-md border-t border-border/80 px-6 py-4 flex justify-end gap-2">
                <button type="button" id="modal-plague-cancel"
                    class="px-4 py-2 rounded-xl border border-border/80 text-xs font-bold text-muted-foreground hover:bg-muted transition-colors cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" id="btn-save-plague"
                    class="px-5 py-2 rounded-xl bg-[#1b4332] text-white text-xs font-bold hover:bg-[#2d6a4f] transition-all shadow-2xs cursor-pointer inline-flex items-center gap-1.5">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    <span id="btn-save-plague-text">Guardar Plaga</span>
                </button>
            </div>

        </form>

    </div>
</div>
{{/if}}

<!-- JS de la vista -->
<script src="/js/private/plagues.js"></script>
