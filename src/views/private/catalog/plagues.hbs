<main class="min-h-screen flex flex-col">

    <div class="mt-20 p-8 lg:p-12 space-y-10">

        {{> private/search-bar}}


        <!-- ===================================================== -->
        <!-- PANEL DE SUGERENCIAS -->
        <!-- ===================================================== -->

        <section
            class="bg-surface-container rounded-2xl ghost-border p-4 lg:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">

            <div class="flex items-center gap-4">

                <div class="w-11 h-11 rounded-xl bg-primary-container flex items-center justify-center shrink-0">

                    <span class="material-symbols-outlined text-on-primary-container">
                        feedback
                    </span>

                </div>

                <div>

                    <p class="text-sm font-bold text-on-surface">
                        Sugerencias de la comunidad
                    </p>

                    <p class="text-xs text-on-surface-variant mt-0.5">
                        Tienes
                        <span class="font-bold text-primary">
                            24 sugerencias
                        </span>
                        pendientes de revisión.
                    </p>

                </div>

            </div>

            <button type="button"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-surface-container-lowest ghost-border text-primary text-xs font-bold hover:bg-primary-container hover:text-on-primary-container transition-all">

                <span class="material-symbols-outlined text-[18px]">
                    rate_review
                </span>

                Revisar sugerencias

            </button>

        </section>



        <!-- ===================================================== -->
        <!-- TABLA -->
        <!-- ===================================================== -->

        <section id="plagues-table-view" style="display:none"
            class="bg-surface-container-lowest rounded-2xl overflow-hidden editorial-shadow ghost-border">

            <div class="overflow-x-auto">

                <table class="w-full text-left border-collapse">

                    <thead>

                        <tr class="bg-surface-container">

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                Imagen
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                Nombre
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                Nombre científico
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                Categoría
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant text-center">
                                Riesgo
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                Región
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                Verificado por
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant">
                                Verificado
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant text-center">
                                Estado
                            </th>

                            <th
                                class="px-7 py-5 text-[10px] font-label font-bold uppercase tracking-widest text-on-surface-variant text-right">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        {{#each plagues}}

                        <tr class="border-t border-surface-container hover:bg-surface-container-low transition-colors">


                            <!-- IMAGEN -->

                            <td class="px-7 py-5">

                                {{#if image_url}}

                                <img src="/{{image_url}}" alt="{{name}}"
                                    class="w-14 h-14 rounded-xl object-cover ghost-border"
                                    onerror="this.src='/images/test/default.png'">

                                {{else}}

                                <div class="w-14 h-14 rounded-xl bg-surface-container flex items-center justify-center">

                                    <span class="material-symbols-outlined text-2xl text-primary/30">
                                        bug_report
                                    </span>

                                </div>

                                {{/if}}

                            </td>


                            <!-- NOMBRE -->

                            <td class="px-7 py-5">

                                <p class="font-headline font-bold text-on-surface">
                                    {{name}}
                                </p>

                            </td>


                            <!-- NOMBRE CIENTÍFICO -->

                            <td class="px-7 py-5">

                                <p class="text-sm italic text-on-surface-variant">
                                    {{scientific_name}}
                                </p>

                            </td>


                            <!-- CATEGORÍA -->

                            <td class="px-7 py-5">

                                <span class="text-xs font-bold uppercase tracking-wide text-primary">
                                    {{category}}
                                </span>

                            </td>


                            <!-- RIESGO -->

                            <td class="px-7 py-5 text-center">

                                {{#if risk_level}}

                                <span
                                    class="inline-flex px-3 py-1.5 rounded-full bg-primary-container text-on-primary-container text-[10px] font-bold uppercase tracking-wider">

                                    {{risk_level}}

                                </span>

                                {{else}}

                                <span class="text-xs text-on-surface-variant">
                                    Sin especificar
                                </span>

                                {{/if}}

                            </td>


                            <!-- REGIÓN -->

                            <td class="px-7 py-5">

                                <p class="text-sm text-on-surface-variant">

                                    {{#if region}}
                                    {{region}}
                                    {{else}}
                                    No especificada
                                    {{/if}}

                                </p>

                            </td>


                            <!-- VERIFICADO POR -->

                            <td class="px-7 py-5">

                                {{#if verified_by}}

                                <p class="text-sm font-medium text-on-surface">
                                    {{verified_by}}
                                </p>

                                {{else}}

                                <span class="text-xs text-on-surface-variant">
                                    No verificado
                                </span>

                                {{/if}}

                            </td>


                            <!-- FECHA VERIFICACIÓN -->

                            <td class="px-7 py-5">

                                {{#if verified_at}}

                                <p class="text-sm text-on-surface-variant">
                                    {{verified_at}}
                                </p>

                                {{else}}

                                <span class="text-xs text-on-surface-variant">
                                    Pendiente
                                </span>

                                {{/if}}

                            </td>


                            <!-- ESTADO -->

                            <td class="px-7 py-5 text-center">

                                {{#if status}}

                                <span
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary-container text-on-primary-container text-[10px] font-bold uppercase tracking-wider">

                                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>

                                    Activa

                                </span>

                                {{else}}

                                <span
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold uppercase tracking-wider">

                                    <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant"></span>

                                    Inactiva

                                </span>

                                {{/if}}

                            </td>


                            <!-- ================================================= -->
                            <!-- ACCIONES -->
                            <!-- ================================================= -->

                            <td class="px-7 py-5">

                                <div class="flex justify-end items-center gap-2">

                                    <!-- EDITAR -->
                                    <button type="button"
                                        class="btn-edit-plague inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container text-primary hover:bg-primary-container hover:text-on-primary-container transition-all active:scale-95"
                                        title="Editar plaga" data-id="{{id}}" data-name="{{name}}"
                                        data-scientific-name="{{scientific_name}}" data-category="{{category}}"
                                        data-region="{{region}}" data-risk-level="{{risk_level}}"
                                        data-status="{{status}}" data-description="{{description}}"
                                        data-symptoms="{{symptoms}}" data-control-methods="{{control_methods}}"
                                        data-biological-control="{{biological_control}}"
                                        data-biological-cycle="{{biological_cycle}}" data-verified-by="{{verified_by}}"
                                        data-verified-at="{{verified_at}}" data-image-url="{{image_url}}">

                                        <span class="material-symbols-outlined text-[18px]">
                                            edit
                                        </span>

                                    </button>

                                    <!-- ELIMINAR -->
                                    <button type="button"
                                        class="btn-delete-plague inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container text-error hover:bg-error-container transition-all active:scale-95"
                                        title="Eliminar plaga" data-id="{{id}}" data-name="{{name}}">

                                        <span class="material-symbols-outlined text-[18px]">
                                            delete
                                        </span>

                                    </button>


                                    <!-- VER DETALLE -->
                                    <a href="/private/plagues/{{id}}"
                                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container text-primary text-xs font-bold hover:bg-primary-container hover:text-on-primary-container transition-all active:scale-95"
                                        title="Ver detalles">

                                        <span class="material-symbols-outlined text-[18px]">
                                            visibility
                                        </span>

                                        Ver detalles

                                    </a>

                                </div>

                            </td>
                        </tr>


                        {{else}}

                        <tr>

                            <td colspan="10" class="px-8 py-16 text-center">

                                <div class="flex flex-col items-center">

                                    <div
                                        class="w-16 h-16 rounded-2xl bg-surface-container flex items-center justify-center">

                                        <span class="material-symbols-outlined text-4xl text-primary/30">
                                            bug_report
                                        </span>

                                    </div>

                                    <p class="mt-4 font-headline font-bold text-on-surface">
                                        No hay plagas registradas
                                    </p>

                                    <p class="mt-1 text-sm text-on-surface-variant">
                                        Comienza agregando una nueva plaga al catálogo.
                                    </p>

                                </div>

                            </td>

                        </tr>

                        {{/each}}

                    </tbody>

                </table>

            </div>


            <!-- PAGINACIÓN -->

            <div
                class="px-7 py-5 bg-surface-container border-t border-surface-container flex flex-col sm:flex-row items-center justify-between gap-4">

                <p class="text-xs text-on-surface-variant">

                    Mostrando

                    <span class="font-bold text-on-surface">
                        {{plagues.length}}
                    </span>

                    registros

                </p>

                <div class="flex items-center gap-2">

                    <button type="button"
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-surface-container-lowest ghost-border text-on-surface-variant text-xs font-bold hover:bg-surface-container-high transition-colors">

                        <span class="material-symbols-outlined text-sm">
                            chevron_left
                        </span>

                        Anterior

                    </button>

                    <button type="button"
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary text-xs font-bold hover:bg-primary-dim transition-colors shadow-sm">

                        Siguiente

                        <span class="material-symbols-outlined text-sm">
                            chevron_right
                        </span>

                    </button>

                </div>

            </div>

        </section>



        <!-- ===================================================== -->
        <!-- MODAL ELIMINAR -->
        <!-- ===================================================== -->

        <div id="modal-delete-plague" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">

            <div id="modal-delete-plague-backdrop" class="absolute inset-0 bg-on-surface/40 backdrop-blur-sm">
            </div>


            <div
                class="relative z-10 w-full max-w-md bg-surface-container-lowest rounded-2xl editorial-shadow ghost-border overflow-hidden">


                <div class="p-6 border-b border-surface-container">

                    <div class="flex items-start gap-4">

                        <div class="w-11 h-11 rounded-xl bg-error-container flex items-center justify-center shrink-0">

                            <span class="material-symbols-outlined text-error">
                                delete
                            </span>

                        </div>

                        <div>

                            <h3 class="text-lg font-headline font-bold text-on-surface">
                                ¿Eliminar plaga?
                            </h3>

                            <p class="mt-1 text-sm text-on-surface-variant">
                                Esta acción eliminará permanentemente el registro.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="p-6">

                    <p class="text-sm text-on-surface-variant leading-relaxed">

                        ¿Seguro que deseas eliminar

                        <strong id="delete-plague-name" class="text-on-surface">
                        </strong>?

                    </p>

                </div>


                <div class="px-6 py-5 bg-surface-container flex justify-end gap-3">

                    <button type="button" id="btn-cancel-delete-plague"
                        class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-surface-container-lowest ghost-border text-on-surface-variant text-xs font-bold hover:bg-surface-container-high transition-colors">

                        Cancelar

                    </button>


                    <form id="delete-plague-form" method="POST">

                        <button type="submit"
                            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-error text-on-error text-xs font-bold hover:opacity-90 transition-all active:scale-95">

                            <span class="material-symbols-outlined text-[17px]">
                                delete
                            </span>

                            Eliminar plaga

                        </button>

                    </form>

                </div>

            </div>

        </div>



        <!-- ===================================================== -->
        <!-- GRID -->
        <!-- ===================================================== -->

        <section id="plagues-grid-view" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7">


            {{#each plagues}}

            <article
                class="group bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow ghost-border flex flex-col hover:translate-y-[-4px] transition-all duration-300">


                <!-- IMAGEN -->

                <div class="relative h-56 overflow-hidden bg-surface-container">

                    {{#if image_url}}

                    <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        src="/{{image_url}}" alt="{{name}}" onerror="this.src='/images/test/default.png'">

                    {{else}}

                    <div class="w-full h-full flex items-center justify-center">

                        <span class="material-symbols-outlined text-6xl text-primary/20">
                            bug_report
                        </span>

                    </div>

                    {{/if}}


                    {{#if risk_level}}

                    <div class="absolute top-4 left-4">

                        <span
                            class="px-2 py-1 rounded bg-primary-container text-on-primary-container text-[10px] font-bold uppercase tracking-wider">

                            {{risk_level}}

                        </span>

                    </div>

                    {{/if}}

                </div>



                <!-- CONTENIDO -->

                <div class="p-6 flex-1 flex flex-col">

                    <span class="text-[10px] font-label font-bold uppercase tracking-widest text-primary mb-2">

                        {{category}}

                    </span>


                    <h3 class="text-xl font-headline font-bold text-on-surface mb-1 leading-tight">

                        {{name}}

                    </h3>


                    <p class="text-sm italic text-on-surface-variant mb-4">

                        {{scientific_name}}

                    </p>


                    <div class="space-y-2 mb-6">

                        <p class="text-sm text-on-surface-variant">

                            <span class="font-bold text-on-surface">
                                Región:
                            </span>

                            {{#if region}}
                            {{region}}
                            {{else}}
                            No especificada
                            {{/if}}

                        </p>


                        <p class="text-sm text-on-surface-variant">

                            <span class="font-bold text-on-surface">
                                Verificado por:
                            </span>

                            {{#if verified_by}}
                            {{verified_by}}
                            {{else}}
                            No verificado
                            {{/if}}

                        </p>

                    </div>


                    <!-- ACCIONES CARD -->

                    <div class="mt-auto pt-4 border-t border-surface-container flex justify-between items-center gap-3">


                        <!-- ESTADO -->

                        {{#if status}}

                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-primary">

                            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>

                            Activa

                        </span>

                        {{else}}

                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-on-surface-variant">

                            <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant">
                            </span>

                            Inactiva

                        </span>

                        {{/if}}

                        <div class="flex items-center gap-2">

                            <!-- EDITAR -->
                            <button type="button"
                                class="btn-edit-plague inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container text-primary hover:bg-primary-container hover:text-on-primary-container transition-all active:scale-95"
                                title="Editar plaga" data-id="{{id}}" data-name="{{name}}"
                                data-scientific-name="{{scientific_name}}" data-category="{{category}}"
                                data-region="{{region}}" data-risk-level="{{risk_level}}" data-status="{{status}}"
                                data-description="{{description}}" data-symptoms="{{symptoms}}"
                                data-control-methods="{{control_methods}}"
                                data-biological-control="{{biological_control}}"
                                data-biological-cycle="{{biological_cycle}}" data-verified-by="{{verified_by}}"
                                data-verified-at="{{verified_at}}" data-image-url="{{image_url}}">

                                <span class="material-symbols-outlined text-[18px]">
                                    edit
                                </span>

                            </button>


                            <!-- ELIMINAR -->
                            <button type="button"
                                class="btn-delete-plague inline-flex items-center justify-center w-9 h-9 rounded-lg bg-surface-container text-error hover:bg-error-container transition-all active:scale-95"
                                title="Eliminar plaga" data-id="{{id}}" data-name="{{name}}">

                                <span class="material-symbols-outlined text-sm">
                                    delete
                                </span>

                            </button>


                            <!-- VER DETALLES -->
                            <a href="/private/plagues/{{id}}"
                                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-surface-container text-primary text-xs font-bold hover:bg-primary-container hover:text-on-primary-container transition-all active:scale-95"
                                title="Ver detalles">

                                <span class="material-symbols-outlined text-sm">
                                    visibility
                                </span>

                                Ver detalles

                            </a>

                        </div>

                    </div>

                </div>

            </article>


            {{else}}

            <div class="col-span-full flex flex-col items-center justify-center py-16 text-center">

                <div class="w-16 h-16 rounded-2xl bg-surface-container flex items-center justify-center">

                    <span class="material-symbols-outlined text-4xl text-primary/30">
                        bug_report
                    </span>

                </div>

                <p class="mt-4 font-headline font-bold text-on-surface">
                    No hay plagas registradas
                </p>

                <p class="mt-1 text-sm text-on-surface-variant">
                    No se encontraron registros para mostrar.
                </p>

            </div>

            {{/each}}



            <!-- ================================================= -->
            <!-- AÑADIR PLAGA -->
            <!-- ================================================= -->

            <button type="button" id="btn-add-plague-card"
                class="group bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow ghost-border flex flex-col items-center justify-center min-h-[360px] p-8 cursor-pointer border-2 border-dashed border-primary/20 hover:translate-y-[-4px] hover:border-primary/40 transition-all duration-300">

                <div class="text-center">

                    <span
                        class="material-symbols-outlined text-4xl text-primary/40 mb-4 group-hover:text-primary transition-colors">

                        add_circle

                    </span>

                    <h3 class="text-lg font-headline font-bold text-on-surface mb-2">

                        ¿Nueva plaga?

                    </h3>

                    <p class="text-xs text-on-surface-variant leading-relaxed mb-6">

                        Registra una nueva plaga en el catálogo científico.

                    </p>

                    <span
                        class="inline-flex items-center gap-2 px-6 py-2 bg-surface-container-high rounded-full text-xs font-bold text-primary uppercase tracking-wider group-hover:bg-primary-container transition-colors">

                        <span class="material-symbols-outlined text-sm">
                            add
                        </span>

                        Añadir plaga

                    </span>

                </div>

            </button>

        </section>

    </div>

</main>



<!-- ========================================================= -->
<!-- MODAL AÑADIR / EDITAR -->
<!-- ========================================================= -->

<div id="modal-plague" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">

    <div id="modal-plague-backdrop" class="absolute inset-0 bg-on-surface/40 backdrop-blur-sm">
    </div>


    <div
        class="relative z-10 bg-surface-container-lowest rounded-2xl editorial-shadow ghost-border w-full max-w-4xl max-h-[90vh] overflow-y-auto">


        <!-- ================================================= -->
        <!-- FORMULARIO -->
        <!-- ================================================= -->

        <form id="plague-form" action="/private/plagues/create" method="POST" enctype="multipart/form-data">


            <!-- HEADER -->

            <div
                class="sticky top-0 z-20 bg-surface-container-lowest flex items-center justify-between border-b border-surface-container px-6 py-5">

                <div>

                    <p class="text-[10px] font-label font-bold uppercase tracking-widest text-primary mb-1">

                        Catálogo científico

                    </p>

                    <h3 id="modal-plague-title" class="text-xl font-headline font-extrabold text-on-surface">

                        Nueva Plaga

                    </h3>

                </div>


                <button type="button" id="modal-plague-close"
                    class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors">

                    <span class="material-symbols-outlined">
                        close
                    </span>

                </button>

            </div>



            <!-- CAMPOS -->

            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">


                <!-- NOMBRE -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Nombre

                    </label>

                    <input type="text" name="name" required placeholder="Ej. Mosca blanca"
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                </div>


                <!-- NOMBRE CIENTÍFICO -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Nombre científico

                    </label>

                    <input type="text" name="scientific_name" required placeholder="Ej. Bemisia tabaci"
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm italic text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                </div>


                <!-- CATEGORÍA -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Categoría

                    </label>

                    <select name="category"
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                        <option value="">
                            Seleccione una categoría...
                        </option>

                        <option value="Insecto">
                            Insecto
                        </option>

                        <option value="Hongo">
                            Hongo
                        </option>

                        <option value="Bacteria">
                            Bacteria
                        </option>

                        <option value="Virus">
                            Virus
                        </option>

                        <option value="Ácaro">
                            Ácaro
                        </option>

                    </select>

                </div>


                <!-- REGIÓN -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Región

                    </label>

                    <input type="text" name="region" placeholder="Ej. Centro de México"
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                </div>


                <!-- RIESGO -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Nivel de riesgo

                    </label>

                    <select name="risk_level"
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                        <option value="Bajo">
                            Bajo
                        </option>

                        <option value="Medio">
                            Medio
                        </option>

                        <option value="Alto">
                            Alto
                        </option>

                        <option value="Crítico">
                            Crítico
                        </option>

                    </select>

                </div>


                <!-- ESTADO -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Estado

                    </label>

                    <select name="status"
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                        <option value="true">
                            Activa
                        </option>

                        <option value="false">
                            Inactiva
                        </option>

                    </select>

                </div>


                <!-- DESCRIPCIÓN -->

                <div class="md:col-span-2">

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Descripción

                    </label>

                    <textarea name="description" rows="3"
                        placeholder="Describe las características principales de la plaga..."
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface resize-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"></textarea>

                </div>
                <!-- ================================================= -->
                <!-- CICLO BIOLÓGICO -->
                <!-- ================================================= -->

                <div class="md:col-span-2">

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Ciclo biológico

                    </label>

                    <textarea name="biological_cycle" rows="5"
                        placeholder="Describe las etapas del ciclo biológico de la plaga..."
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface resize-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"></textarea>

                    <p class="text-xs text-on-surface-variant mt-2">
                        Describe las diferentes etapas del desarrollo de la plaga.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- VERIFICADO POR -->
                <!-- ================================================= -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Verificado por

                    </label>

                    <input type="text" name="verified_by" placeholder="Ej. INIFAP, Ing. Juan Pérez..."
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                </div>


                <!-- ================================================= -->
                <!-- FECHA DE VERIFICACIÓN -->
                <!-- ================================================= -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Fecha de verificación

                    </label>

                    <input type="date" name="verified_at"
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">

                </div>


                <!-- SÍNTOMAS -->

                <div class="md:col-span-2">

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Síntomas

                    </label>

                    <textarea name="symptoms" rows="3" placeholder="Describe los síntomas observables..."
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface resize-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"></textarea>

                </div>


                <!-- MÉTODOS DE CONTROL -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Métodos de control

                    </label>

                    <textarea name="control_methods" rows="5"
                        placeholder="Describe los métodos de control recomendados..."
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface resize-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"></textarea>

                </div>


                <!-- CONTROL BIOLÓGICO -->

                <div>

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Control biológico

                    </label>

                    <textarea name="biological_control" rows="5"
                        placeholder="Describe alternativas de control biológico..."
                        class="w-full bg-surface-container border border-outline-variant/20 rounded-xl px-4 py-3 text-sm text-on-surface resize-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"></textarea>

                </div>


                <!-- IMAGEN -->

                <div class="md:col-span-2">

                    <label class="block text-xs font-bold text-on-surface mb-2">

                        Imagen

                    </label>

                    <div
                        class="bg-surface-container rounded-2xl p-5 ghost-border flex flex-col sm:flex-row items-start gap-5">

                        <img id="plague-preview" class="hidden w-32 h-32 rounded-xl object-cover ghost-border"
                            alt="Vista previa de la plaga">


                        <div class="flex-1 w-full">

                            <input id="plague-image" type="file" name="image" accept="image/*"
                                class="block w-full text-sm text-on-surface-variant file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:bg-primary-container file:text-on-primary-container file:font-bold file:text-xs">

                            <p class="text-xs text-on-surface-variant mt-2">
                                Formatos permitidos: JPG, PNG o WEBP.
                            </p>

                        </div>

                    </div>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <div
                class="sticky bottom-0 bg-surface-container border-t border-surface-container px-6 py-5 flex justify-end gap-3">

                <button type="button" id="modal-plague-cancel"
                    class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-surface-container-lowest ghost-border text-on-surface-variant text-xs font-bold hover:bg-surface-container-high transition-colors">

                    Cancelar

                </button>


                <button type="submit" id="btn-save-plague"
                    class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:bg-primary-dim transition-all active:scale-95 shadow-sm">

                    <span class="material-symbols-outlined text-[18px]">
                        save
                    </span>

                    <span id="btn-save-plague-text">
                        Guardar plaga
                    </span>

                </button>

            </div>

        </form>

    </div>

</div>



