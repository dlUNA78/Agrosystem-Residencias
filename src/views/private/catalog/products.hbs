<div class="min-h-screen bg-background pb-12 text-foreground">
  <div class="mx-auto max-w-7xl space-y-7 px-0 pt-6 md:px-4">
    <header class="flex flex-col justify-between gap-5 border-b border-border/80 pb-7 lg:flex-row lg:items-end">
      <div class="space-y-3">
        <span class="inline-block rounded-full bg-primary/5 px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-primary">Catálogo fitosanitario · INIFAP</span>
        <h1 class="text-3xl font-black tracking-tight text-primary md:text-4xl">Gestión de Productos</h1>
        <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">Administra fichas técnicas, registros y evidencia de productos agroquímicos antes de su publicación.</p>
      </div>
      {{#if permissions.canCreate}}
        <button type="button" id="btn-add-product" class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-xl bg-primary px-5 py-3 text-xs font-bold text-primary-foreground shadow-2xs transition hover:bg-primary/90">
          <span class="material-symbols-outlined text-lg" aria-hidden="true">add</span>
          Nuevo producto
        </button>
      {{/if}}
    </header>

    <section aria-label="Resumen editorial de productos" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="flex items-center justify-between gap-3 rounded-2xl border border-border/80 bg-card p-5 shadow-2xs">
        <div><p class="font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Resultados</p><p class="mt-1 text-3xl font-black tabular-nums text-primary">{{stats.total}}</p><p class="mt-1 text-[11px] text-muted-foreground">Productos registrados</p></div>
        <span class="rounded-xl bg-primary/5 p-3 text-primary"><span class="material-symbols-outlined">science</span></span>
      </div>
      <a href="/private/products?workflow=published" class="flex items-center justify-between gap-3 rounded-2xl border border-border/80 bg-card p-5 shadow-2xs transition hover:border-emerald-300">
        <div><p class="font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Publicados</p><p class="mt-1 text-3xl font-black tabular-nums text-emerald-700">{{stats.published}}</p><p class="mt-1 text-[11px] text-muted-foreground">Visibles para el público</p></div>
        <span class="rounded-xl bg-emerald-50 p-3 text-emerald-700"><span class="material-symbols-outlined">public</span></span>
      </a>
      <a href="/private/products?workflow=in_review" class="flex items-center justify-between gap-3 rounded-2xl border border-border/80 bg-card p-5 shadow-2xs transition hover:border-amber-300">
        <div><p class="font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">En revisión</p><p class="mt-1 text-3xl font-black tabular-nums text-amber-700">{{stats.inReview}}</p><p class="mt-1 text-[11px] text-muted-foreground">Evaluación técnica pendiente</p></div>
        <span class="rounded-xl bg-amber-50 p-3 text-amber-700"><span class="material-symbols-outlined">fact_check</span></span>
      </a>
      <a href="/private/products?workflow=changes_requested" class="flex items-center justify-between gap-3 rounded-2xl border border-border/80 bg-card p-5 shadow-2xs transition hover:border-orange-300">
        <div><p class="font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Con cambios</p><p class="mt-1 text-3xl font-black tabular-nums text-orange-700">{{stats.changesRequested}}</p><p class="mt-1 text-[11px] text-muted-foreground">Requieren ajustes del autor</p></div>
        <span class="rounded-xl bg-orange-50 p-3 text-orange-700"><span class="material-symbols-outlined">edit_note</span></span>
      </a>
    </section>

    <form method="GET" action="/private/products" class="flex flex-wrap items-end gap-3 rounded-2xl border border-border/80 bg-card p-4 shadow-2xs" aria-label="Filtrar productos">
      <div class="min-w-0 basis-full lg:flex-1">
        <label for="product-search" class="mb-2 block text-xs font-medium text-muted-foreground">Buscar producto</label>
        <div class="relative">
          <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-lg text-muted-foreground">search</span>
          <input id="product-search" name="search" type="search" maxlength="120" value="{{filters.search}}" placeholder="Nombre, ingrediente o fabricante…" class="w-full rounded-xl border border-input bg-background py-2.5 pl-10 pr-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
        </div>
      </div>
      {{#each searchFilters}}
        <div class="min-w-0 flex-1 basis-40 lg:flex-none">
          <label for="{{id}}" class="mb-2 block text-xs font-medium text-muted-foreground">{{label}}</label>
          <select id="{{id}}" name="{{param}}" class="w-full rounded-xl border border-input bg-background px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
            <option value="">Todos</option>
            {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{text}}</option>{{/each}}
          </select>
        </div>
      {{/each}}
      <button type="submit" class="rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-primary-foreground hover:bg-primary/90">Aplicar</button>
      <a href="/private/products" class="rounded-xl border border-border px-4 py-2.5 text-sm font-medium hover:bg-muted">Limpiar</a>
      <div class="flex items-center gap-1 rounded-xl border border-input p-1" role="group" aria-label="Presentación del catálogo">
        <button type="button" id="view-grid" aria-label="Vista en tarjetas" aria-pressed="true" class="rounded-lg bg-primary p-2 text-white"><span class="material-symbols-outlined text-lg">grid_view</span></button>
        <button type="button" id="view-table" aria-label="Vista en tabla" aria-pressed="false" class="rounded-lg p-2 text-muted-foreground"><span class="material-symbols-outlined text-lg">table_rows</span></button>
      </div>
    </form>

    {{#if expiringSoon}}
      <aside class="flex flex-col justify-between gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 sm:flex-row sm:items-center">
        <div class="flex items-center gap-3"><span class="material-symbols-outlined rounded-xl bg-amber-100 p-2 text-amber-700">event_busy</span><div><p class="text-sm font-bold text-amber-950">{{expiringSoon}} registro(s) próximo(s) a vencer</p><p class="text-xs text-amber-800">Vencen durante los siguientes 60 días.</p></div></div>
        <button type="button" id="btn-expiring-products" class="rounded-xl border border-amber-300 bg-white px-4 py-2 text-xs font-bold text-amber-900 hover:bg-amber-100">Revisar registros</button>
      </aside>
    {{/if}}

    <p class="text-xs text-muted-foreground" role="status">Mostrando <strong class="text-foreground">{{products.length}}</strong> productos con los filtros actuales.</p>
    {{> private/products/grid}}
    {{> private/products/table}}
  </div>
</div>

{{> private/products/form-modal}}
{{> private/products/expiring-modal}}
{{> private/products/delete-modal}}
<script type="module" src="/js/private/product.js"></script>
<script src="/js/shared/image-fallback.js"></script>
