<!-- Breadcrumbs & Header -->
<div class="max-w-7xl mx-auto px-4 md:px-10 mt-12 mb-8">
    <nav aria-label="Breadcrumb" class="flex mb-4">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-xs font-medium tracking-widest uppercase text-on-surface-variant">
            <li class="inline-flex items-center">
                <a class="hover:text-[#0F2E2E] transition-colors" href="/private/dashboard">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
                    <a class="hover:text-[#0F2E2E] transition-colors" href="/private/crops">Cultivos</a>
                </div>
            </li>
            <li aria-current="page">
                <div class="flex items-center">
                    <span class="material-symbols-outlined text-sm mx-1">chevron_right</span>
                    <span class="text-[#0F2E2E] font-bold">{{crop.name}}</span>
                </div>
            </li>
        </ol>
    </nav>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <h1 class="text-5xl md:text-6xl font-extrabold text-[#0F2E2E] tracking-tighter mb-2">{{crop.name}}</h1>
            <p class="text-lg text-on-surface-variant font-medium">
                Ficha técnica agronómica {{#if crop.scientific_name}}de <span class="italic">{{crop.scientific_name}}</span>{{/if}}
            </p>
        </div>
        <div>
            <a href="/private/crops" class="flex items-center gap-2 px-6 py-4 bg-[#0F2E2E] text-white font-bold text-sm rounded-lg hover:opacity-90 transition-all shadow-lg inline-block">
                <span class="material-symbols-outlined text-xl align-middle">arrow_back</span>
                Volver a cultivos
            </a>
        </div>
    </div>
</div>

<!-- Hero Image Carousel Section -->
<div class="max-w-7xl mx-auto px-4 md:px-10 mb-20">
    <div class="relative group">
        <div class="overflow-hidden rounded-xl bg-surface-container-low shadow-sm mb-4 aspect-[21/9] flex items-center justify-center">
            {{#if primaryImage}}
            <img id="main-crop-image" alt="{{crop.name}}" class="w-full h-full object-cover" src="/{{primaryImage}}" onerror="this.onerror=null; this.src='/images/test/default.png';" />
            {{else}}
            <img id="main-crop-image" alt="Sin imagen" class="w-full h-full object-cover" src="/images/test/default.png" />
            {{/if}}
        </div>
    </div>

    {{#if carouselImages.length}}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex gap-3 overflow-x-auto no-scrollbar py-2">
            {{#each carouselImages}}
            <button onclick="document.getElementById('main-crop-image').src='/\{{image_url}}'" class="w-24 h-16 rounded-lg overflow-hidden border-2 border-transparent hover:border-[#0F2E2E] opacity-80 hover:opacity-100 transition-all">
                <img class="w-full h-full object-cover" src="/{{image_url}}" alt="Imagen cultivo" />
            </button>
            {{/each}}
        </div>
        <span class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold">Imágenes del sistema INIFAP</span>
    </div>
    {{/if}}
</div>

<!-- Technical Sheet -->
<div class="max-w-7xl mx-auto px-4 md:px-10 mb-24">
    <h2 class="text-2xl font-extrabold tracking-tight mb-8">Ficha Técnica Completa</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
        <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/10">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Clima / Agua</h3>
            <p class="text-base font-bold text-on-surface leading-tight">{{#if crop.water_requirement}}{{crop.water_requirement}}{{else}}No especificado{{/if}}</p>
        </div>
        <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/10">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Temp. Óptima</h3>
            <p class="text-base font-bold text-on-surface leading-tight">
                {{#if crop.min_temperature}}{{crop.min_temperature}}°C{{else}}-{{/if}} / {{#if crop.max_temperature}}{{crop.max_temperature}}°C{{else}}-{{/if}}
            </p>
        </div>
        <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/10">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Tipo de Suelo</h3>
            <p class="text-base font-bold text-on-surface leading-tight">{{#if crop.soil_type}}{{crop.soil_type}}{{else}}Franco{{/if}}</p>
        </div>
        <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/10">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">pH Ideal</h3>
            <p class="text-base font-bold text-on-surface leading-tight">{{#if crop.ph_range}}{{crop.ph_range}}{{else}}6.0 - 7.5{{/if}}</p>
        </div>
        <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/10">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Categoría</h3>
            <p class="text-base font-bold text-on-surface leading-tight capitalize">{{#if crop.category}}{{crop.category}}{{else}}General{{/if}}</p>
        </div>
        <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/10">
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Luz Solar</h3>
            <p class="text-base font-bold text-on-surface leading-tight">{{#if crop.sunlight_requirement}}{{crop.sunlight_requirement}}{{else}}Pleno sol{{/if}}</p>
        </div>
    </div>
</div>

<!-- Biological Cycle -->
<div class="bg-surface-container-low py-20 mb-24">
    <div class="max-w-7xl mx-auto px-4 md:px-10">
        <div class="mb-12">
            <h2 class="text-3xl font-extrabold tracking-tight mb-4">Ciclo de Cultivo</h2>
            <p class="text-on-surface-variant max-w-2xl">
                Días de cosecha estimados: <span class="font-bold text-on-surface">{{#if crop.harvest_days}}{{crop.harvest_days}} días{{else}}No especificados{{/if}}</span>.
                Temporada: <span class="font-bold text-on-surface">{{#if crop.season}}{{crop.season}}{{else}}Todo el año{{/if}}</span>.
            </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="relative flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-[#0F2E2E] text-white flex items-center justify-center text-xl font-bold mb-6 z-10">1</div>
                <div class="hidden md:block absolute top-8 left-1/2 w-full h-[2px] bg-[#0F2E2E]/20"></div>
                <h4 class="font-bold text-lg mb-2">Siembra - Germinación</h4>
                <p class="text-sm text-on-surface-variant leading-relaxed">Fase inicial de germinación y establecimiento radicular.</p>
            </div>
            <div class="relative flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-[#0F2E2E] text-white flex items-center justify-center text-xl font-bold mb-6 z-10">2</div>
                <div class="hidden md:block absolute top-8 left-1/2 w-full h-[2px] bg-[#0F2E2E]/20"></div>
                <h4 class="font-bold text-lg mb-2">Desarrollo Vegetativo</h4>
                <p class="text-sm text-on-surface-variant leading-relaxed">Crecimiento foliar activo y absorción de nutrientes.</p>
            </div>
            <div class="relative flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-[#0F2E2E] text-white flex items-center justify-center text-xl font-bold mb-6 z-10">3</div>
                <div class="hidden md:block absolute top-8 left-1/2 w-full h-[2px] bg-[#0F2E2E]/20"></div>
                <h4 class="font-bold text-lg mb-2">Floración / Fructificación</h4>
                <p class="text-sm text-on-surface-variant leading-relaxed">Emisión de flores y formación de fruto o grano.</p>
            </div>
            <div class="relative flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-full bg-[#0F2E2E] text-white flex items-center justify-center text-xl font-bold mb-6 z-10">4</div>
                <h4 class="font-bold text-lg mb-2">Maduración y Cosecha</h4>
                <p class="text-sm text-on-surface-variant leading-relaxed">Secado o madurez fisiológica lista para recolección.</p>
            </div>
        </div>
    </div>
</div>
