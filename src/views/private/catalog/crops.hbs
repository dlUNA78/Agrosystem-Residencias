<main class="min-h-screen flex flex-col">
    <!-- Content Area -->
    <div class="mt-20 p-12 space-y-10">
        {{!-- Control Bar & Search --}}
        {{> private/search-bar}}



        <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Resumen editorial de cultivos">
            <div class="rounded-xl border border-outline-variant/10 bg-surface-container-lowest p-4 shadow-sm">
                <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Resultados</p>
                <p class="mt-1 text-2xl font-black text-on-surface">{{stats.total}}</p>
            </div>
            <a href="/private/crops?workflow=in_review" class="rounded-xl border border-amber-100 bg-amber-50 p-4 shadow-sm hover:bg-amber-100">
                <p class="text-[10px] font-bold uppercase tracking-widest text-amber-800">En revisión</p>
                <p class="mt-1 text-2xl font-black text-amber-900">{{stats.inReview}}</p>
            </a>
            <a href="/private/crops?workflow=changes_requested" class="rounded-xl border border-orange-100 bg-orange-50 p-4 shadow-sm hover:bg-orange-100">
                <p class="text-[10px] font-bold uppercase tracking-widest text-orange-800">Con cambios</p>
                <p class="mt-1 text-2xl font-black text-orange-900">{{stats.changesRequested}}</p>
            </a>
            <a href="/private/crops?workflow=published" class="rounded-xl border border-emerald-100 bg-emerald-50 p-4 shadow-sm hover:bg-emerald-100">
                <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-800">Publicados</p>
                <p class="mt-1 text-2xl font-black text-emerald-900">{{stats.published}}</p>
            </a>
        </section>

        {{!-- ══════════════════════════════════════════════════════════════
        TABLE VIEW
        ══════════════════════════════════════════════════════════════ --}}

        <div id="crops-table-view"
            class="hidden bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden border border-outline-variant/10">

            <div class="overflow-x-auto">

                <table class="w-full text-left border-collapse">

                    {{!-- CABECERA --}}
                    <thead>

                        <tr class="bg-surface-container-low/50">

                            <th
                                class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                                Imagen
                            </th>

                            <th
                                class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                                Cultivo
                            </th>

                            <th
                                class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                                Clasificación
                            </th>

                            <th
                                class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-center">
                                Temporada
                            </th>

                            <th
                                class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-center">
                                Cosecha
                            </th>

                            <th
                                class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-center">
                                Estatus
                            </th>

                            <th
                                class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-on-surface-variant text-right">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    {{!-- CUERPO --}}
                    <tbody class="divide-y divide-outline-variant/10">

                        {{#if crops}}

                        {{#each crops}}

                        <tr class="hover:bg-surface-container-low/30 transition-colors">


                            {{!-- ═════════════════════════════════════
                            IMAGEN
                            ══════════════════════════════════════ --}}

                            <td class="px-6 py-5">

                                <div class="w-16 h-16 rounded-xl overflow-hidden
                                            bg-emerald-50
                                            border border-emerald-100
                                            shadow-sm">

                                    {{#if image_url}}

                                    <img src="{{image_url}}" alt="{{name}}" class="w-full h-full object-cover"
                                        data-fallback-src="/images/test/default.png">

                                    {{else}}

                                    <img src="/images/test/default.png" alt="Sin imagen"
                                        class="w-full h-full object-cover">

                                    {{/if}}

                                </div>

                            </td>


                            {{!-- ═════════════════════════════════════
                            CULTIVO
                            ══════════════════════════════════════ --}}

                            <td class="px-6 py-5">

                                <div class="min-w-52.5">

                                    <p class="font-bold text-on-surface text-sm">
                                        {{name}}
                                    </p>


                                    {{#if scientific_name}}

                                    <p class="text-xs italic text-on-surface-variant mt-1">
                                        {{scientific_name}}
                                    </p>

                                    {{/if}}


                                    {{#if variety}}

                                    <p class="text-[11px] text-on-surface-variant mt-2">

                                        <span class="font-semibold">
                                            Variedad:
                                        </span>

                                        {{variety}}

                                    </p>

                                    {{/if}}

                                </div>

                            </td>


                            {{!-- ═════════════════════════════════════
                            CLASIFICACIÓN
                            ══════════════════════════════════════ --}}

                            <td class="px-6 py-5">

                                <div class="space-y-2">

                                    {{#if category}}

                                    <span class="inline-flex
                                                     px-3 py-1
                                                     rounded-full
                                                     bg-emerald-50
                                                     text-emerald-700
                                                     text-[10px]
                                                     font-bold
                                                     uppercase">

                                        {{category}}

                                    </span>

                                    {{else}}

                                    <span class="text-xs text-on-surface-variant">
                                        Sin categoría
                                    </span>

                                    {{/if}}


                                    {{#if family}}

                                    <p class="text-xs text-on-surface-variant">

                                        <span class="font-semibold">
                                            Familia:
                                        </span>

                                        {{family}}

                                    </p>

                                    {{/if}}

                                </div>

                            </td>


                            {{!-- ═════════════════════════════════════
                            TEMPORADA
                            ══════════════════════════════════════ --}}

                            <td class="px-6 py-5 text-center">

                                {{#if season}}

                                <div class="inline-flex items-center gap-1">

                                    <span class="material-symbols-outlined text-sm text-emerald-700">
                                        calendar_month
                                    </span>

                                    <span class="text-xs font-medium text-on-surface">
                                        {{season}}
                                    </span>

                                </div>

                                {{else}}

                                <span class="text-xs text-on-surface-variant">
                                    No especificada
                                </span>

                                {{/if}}

                            </td>


                            {{!-- ═════════════════════════════════════
                            DÍAS DE COSECHA
                            ══════════════════════════════════════ --}}

                            <td class="px-6 py-5 text-center">

                                {{#if harvest_days}}

                                <div class="inline-flex items-center gap-1">

                                    <span class="material-symbols-outlined text-sm text-amber-600">
                                        schedule
                                    </span>

                                    <span class="text-xs font-medium text-on-surface">
                                        {{harvest_days}} días
                                    </span>

                                </div>

                                {{else}}

                                <span class="text-xs text-on-surface-variant">
                                    No especificado
                                </span>

                                {{/if}}

                            </td>


                            {{!-- ═════════════════════════════════════
                            ESTATUS
                            ══════════════════════════════════════ --}}

                            <td class="px-6 py-5 text-center">

                                {{> private/crop-workflow-badge}}

                            </td>


                            {{!-- ═════════════════════════════════════
                            ACCIONES
                            ══════════════════════════════════════ --}}

                            <td class="px-6 py-5">

                                <div class="flex items-center justify-end gap-2">


                                    <!-- VER -->
                                    <a href="/private/crops/{{id}}" class="inline-flex items-center justify-center
           p-2
           rounded-lg
           hover:bg-emerald-50
           text-on-surface-variant
           hover:text-emerald-700
           transition-colors" title="Ver cultivo">

                                        <span class="material-symbols-outlined text-lg">
                                            visibility
                                        </span>

                                    </a>

                                    {{#if canEditRecord}}
                                    <button type="button"
                                        class="edit-crop-btn p-2 rounded-lg hover:bg-blue-50 text-on-surface-variant hover:text-blue-700  transition-colors"
                                        title="Editar cultivo" data-id="{{id}}">
                                        <span class="material-symbols-outlined text-lg">
                                            edit
                                        </span>

                                    </button>
                                    {{/if}}


                                    {{!-- ELIMINAR --}}
                                    {{#if canDeleteRecord}}
                                    <button type="button" class="delete-crop-btn
                                               p-2
                                               rounded-lg
                                               hover:bg-red-50
                                               text-on-surface-variant
                                               hover:text-red-700
                                               transition-colors" title="Eliminar cultivo" data-id="{{id}}"
                                        data-name="{{name}}">

                                        <span class="material-symbols-outlined text-lg">
                                            delete
                                        </span>

                                    </button>
                                    {{/if}}

                                </div>

                            </td>

                        </tr>

                        {{/each}}


                        {{else}}

                        <tr>

                            <td colspan="7" class="px-8 py-20 text-center">

                                <span class="material-symbols-outlined
                                         text-6xl
                                         text-on-surface-variant/30">

                                    agriculture

                                </span>

                                <p class="mt-4
                                      text-sm
                                      font-bold
                                      text-on-surface-variant">

                                    No hay cultivos registrados

                                </p>

                                <p class="mt-1
                                      text-xs
                                      text-on-surface-variant/70">

                                    Agrega un cultivo para comenzar.

                                </p>

                            </td>

                        </tr>

                        {{/if}}

                    </tbody>

                </table>

            </div>


        </div>


        {{!--  GRID VIEW--}}
        <section id="crops-grid-view" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7">

            {{#if crops}}

            {{#each crops}}

            <article
                class="group bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow ghost-border flex flex-col hover:-translate-y-1 transition-all duration-300">

                <!--  IMAGEN-->
                <div class="relative h-56 overflow-hidden bg-surface-container">

                    <img src="{{#if image_url}}{{image_url}}{{else}}/images/test/default.png{{/if}}" alt="{{name}}"
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        data-fallback-src="/images/test/default.png">

                    <!-- ══════════════════════════════════════════════════
                     ESTADO
                     ══════════════════════════════════════════════════ -->
                    <div class="absolute top-4 left-4">
                        {{> private/crop-workflow-badge}}
                    </div>

                </div>


                <!-- CONTENIDO -->
                <div class="p-6 flex-1 flex flex-col">

                    <!-- CATEGORÍA -->
                    {{#if category}}

                    <span class="text-[10px] font-label font-bold uppercase tracking-widest text-primary mb-2">
                        {{category}}
                    </span>

                    {{/if}}


                    <!-- NOMBRE -->
                    <h3 class="text-xl font-headline font-bold text-on-surface mb-1 leading-tight">
                        {{name}}
                    </h3>


                    <!-- NOMBRE CIENTÍFICO -->
                    {{#if scientific_name}}

                    <p class="text-sm italic text-on-surface-variant mb-4">
                        {{scientific_name}}
                    </p>

                    {{/if}}


                    <!-- INFORMACIÓN-->
                    <div class="space-y-2 mb-6">

                        <!-- FAMILIA -->
                        {{#if family}}

                        <p class="text-sm text-on-surface-variant">

                            <span class="font-bold text-on-surface">
                                Familia:
                            </span>

                            {{family}}

                        </p>

                        {{/if}}


                        <!-- VARIEDAD -->
                        {{#if variety}}

                        <p class="text-sm text-on-surface-variant">

                            <span class="font-bold text-on-surface">
                                Variedad:
                            </span>

                            {{variety}}

                        </p>

                        {{/if}}


                        <!-- TEMPORADA -->
                        {{#if season}}

                        <p class="text-sm text-on-surface-variant">

                            <span class="font-bold text-on-surface">
                                Temporada:
                            </span>

                            {{season}}

                        </p>

                        {{/if}}


                        <!-- DÍAS DE COSECHA -->
                        {{#if harvest_days}}

                        <p class="text-sm text-on-surface-variant">

                            <span class="font-bold text-on-surface">
                                Cosecha:
                            </span>

                            {{harvest_days}} días

                        </p>

                        {{/if}}

                    </div>


                    <!--  ACCIONES CARD-->
                    <div class="mt-auto pt-4 border-t border-surface-container flex justify-between items-center gap-3">

                        <!-- ESTADO -->
                        {{> private/crop-workflow-badge}}


                        <!-- BOTONES -->
                        <div class="flex items-center gap-2">

                            <!-- VER -->
                            <a href="/private/crops/{{id}}" class="inline-flex items-center justify-center
           p-2
           rounded-lg
           hover:bg-emerald-50
           text-on-surface-variant
           hover:text-emerald-700
           transition-colors" title="Ver cultivo">

                                <span class="material-symbols-outlined text-lg">
                                    visibility
                                </span>

                            </a>


                            {{#if canEditRecord}}
                            <button type="button"
                                class="edit-crop-btn inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container text-primary hover:bg-primary-container hover:text-on-primary-container transition-all active:scale-95"
                                title="Editar cultivo" data-id="{{id}}">

                                <span class="material-symbols-outlined text-[18px]">
                                    edit
                                </span>

                            </button>
                            {{/if}}


                            <!-- ELIMINAR -->
                            {{#if canDeleteRecord}}

                            <button type="button"
                                class="delete-crop-btn inline-flex items-center justify-center w-9 h-9 rounded-lg bg-surface-container text-error hover:bg-error-container transition-all active:scale-95"
                                title="Eliminar cultivo" data-id="{{id}}" data-name="{{name}}">

                                <span class="material-symbols-outlined text-sm">
                                    delete
                                </span>

                            </button>

                            {{/if}}

                        </div>

                    </div>

                </div>

            </article>

            {{/each}}

            {{else}}

            <!-- SIN CULTIVOS -->
            <div class="col-span-full flex flex-col items-center justify-center py-16 text-center">

                <div class="w-16 h-16 rounded-2xl bg-surface-container flex items-center justify-center">

                    <span class="material-symbols-outlined text-4xl text-primary/30">
                        agriculture
                    </span>

                </div>

                <p class="mt-4 font-headline font-bold text-on-surface">
                    No hay cultivos registrados
                </p>

                <p class="mt-1 text-sm text-on-surface-variant">
                    No se encontraron registros para mostrar.
                </p>

            </div>

            {{/if}}


            {{#if permissions.canCreate}}
            <button type="button" id="btn-add-crop-card"
                class="group bg-surface-container-lowest rounded-xl overflow-hidden editorial-shadow ghost-border flex flex-col items-center justify-center min-h-90 p-8 cursor-pointer border-2 border-dashed border-primary/20 hover:-translate-y-1 hover:border-primary/40 transition-all duration-300">

                <div class="text-center">

                    <span
                        class="material-symbols-outlined text-4xl text-primary/40 mb-4 group-hover:text-primary transition-colors">
                        add_circle
                    </span>

                    <h3 class="text-lg font-headline font-bold text-on-surface mb-2">
                        ¿Nuevo cultivo?
                    </h3>

                    <p class="text-xs text-on-surface-variant leading-relaxed mb-6">
                        Registra un nuevo cultivo en el catálogo agronómico.
                    </p>

                    <span
                        class="inline-flex items-center gap-2 px-6 py-2 bg-surface-container-high rounded-full text-xs font-bold text-primary uppercase tracking-wider group-hover:bg-primary-container transition-colors">

                        <span class="material-symbols-outlined text-sm">
                            add
                        </span>

                        Añadir cultivo

                    </span>

                </div>

            </button>
            {{/if}}

        </section>
        {{> private/crop-pagination}}
    </div>
</main>

<!-- MODAL: AÑADIR / EDITAR CULTIVO -->
{{#if permissions.canEdit}}
<div id="modal-crop" class="fixed inset-0 z-100 hidden items-center justify-center p-4">

    <!-- FONDO -->
    <div id="modal-crop-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm">
    </div>


    <!-- CONTENEDOR -->
    <div class="relative z-10 w-full max-w-5xl max-h-[92vh] overflow-y-auto bg-white rounded-2xl shadow-2xl">


        <!-- HEADER -->
        <div
            class="flex items-center justify-between px-6 py-5 border-b border-surface-container sticky top-0 bg-white z-20">

            <div>

                <h3 id="modal-crop-title" class="text-xl font-extrabold text-[#0F2E2E]">

                    Nuevo Cultivo

                </h3>

                <p class="text-xs text-on-surface-variant mt-1">

                    Registra toda la información técnica y agronómica del cultivo

                </p>

            </div>


            <button id="modal-crop-close" type="button"
                class="p-2 rounded-lg hover:bg-surface-container-low text-on-surface-variant transition-colors">

                <span class="material-symbols-outlined">
                    close
                </span>

            </button>

        </div>


        <!-- FORMULARIO -->
        <form id="crop-form" method="POST" action="/private/crops/create" enctype="multipart/form-data">


            <div class="p-6 space-y-10">


                <!-- ================================================= -->
                <!-- 1. IDENTIFICACIÓN Y CLASIFICACIÓN -->
                <!-- ================================================= -->

                <section>

                    <div class="flex items-center gap-2 mb-5">

                        <span class="material-symbols-outlined text-primary">
                            category
                        </span>

                        <div>

                            <h4 class="font-bold text-[#0F2E2E]">
                                Identificación y clasificación
                            </h4>

                            <p class="text-xs text-on-surface-variant">
                                Información taxonómica y clasificación del cultivo
                            </p>

                        </div>

                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">


                        <!-- Nombre común -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Nombre común *

                            </label>

                            <input type="text" id="crop-name" name="name" required placeholder="Ej. Maíz Blanco"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30 focus:outline-none focus:ring-2 focus:ring-primary/30">

                        </div>


                        <!-- Nombre científico -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Nombre científico *

                            </label>

                            <input type="text" id="crop-scientific-name" name="scientific_name" required
                                placeholder="Ej. Zea mays"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30 focus:outline-none focus:ring-2 focus:ring-primary/30">

                        </div>


                        <!-- Categoría -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Categoría del cultivo *

                            </label>

                            <select id="crop-category" name="category" required
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30">

                                <option value="">
                                    Seleccionar categoría
                                </option>

                                <option value="Granos y Cereales">
                                    Granos y Cereales
                                </option>

                                <option value="Frutales">
                                    Frutales
                                </option>

                                <option value="Hortalizas">
                                    Hortalizas
                                </option>

                                <option value="Leguminosas">
                                    Leguminosas
                                </option>

                                <option value="Oleaginosas">
                                    Oleaginosas
                                </option>

                                <option value="Tubérculos">
                                    Tubérculos
                                </option>

                                <option value="Forrajeras">
                                    Forrajeras
                                </option>

                                <option value="Ornamentales">
                                    Ornamentales
                                </option>

                                <option value="Industriales">
                                    Industriales
                                </option>

                                <option value="Otro">
                                    Otro
                                </option>

                            </select>

                        </div>


                        <!-- Familia -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Familia botánica

                            </label>

                            <input type="text" id="crop-family" name="family" placeholder="Ej. Poaceae"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30">

                        </div>


                        <!-- Género -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Género

                            </label>

                            <input type="text" id="crop-genus" name="genus" placeholder="Ej. Zea"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30">

                        </div>


                        <!-- Variedad -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Variedad o cultivar

                            </label>

                            <input type="text" id="crop-variety" name="variety" placeholder="Ej. Maíz Blanco Criollo"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30">

                        </div>

                    </div>

                </section>


                <!-- ================================================= -->
                <!-- 2. REGIÓN Y DISTRIBUCIÓN -->
                <!-- ================================================= -->

                <section>

                    <div class="flex items-center gap-2 mb-5">

                        <span class="material-symbols-outlined text-primary">
                            public
                        </span>

                        <div>

                            <h4 class="font-bold text-[#0F2E2E]">
                                Región y distribución
                            </h4>

                            <p class="text-xs text-on-surface-variant">
                                Zonas donde se cultiva y desarrolla la especie
                            </p>

                        </div>

                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">


                        <!-- Región -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Región principal *

                            </label>

                            <select id="crop-region" name="region" required
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30">

                                <option value="">
                                    Seleccionar región
                                </option>

                                <option value="norte">
                                    Norte de México
                                </option>

                                <option value="centro">
                                    Centro de México
                                </option>

                                <option value="occidente">
                                    Occidente de México
                                </option>

                                <option value="sur">
                                    Sur de México
                                </option>

                                <option value="sureste">
                                    Sureste de México
                                </option>

                                <option value="todo-mexico">
                                    Todo México
                                </option>

                                <option value="internacional">
                                    Internacional
                                </option>

                            </select>

                        </div>


                        <!-- Estado -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Estado o zona productora

                            </label>

                            <input type="text" id="crop-state" name="state" placeholder="Ej. Colima, Jalisco, Michoacán"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30">

                        </div>


                        <!-- Altitud mínima -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Altitud mínima (msnm)

                            </label>

                            <input type="number" id="crop-min-altitude" name="min_altitude" min="0" placeholder="Ej. 0"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant/30 bg-surface-container-low/30">

                        </div>


                        <!-- Altitud máxima -->
                        <div>

                            <label class="block text-xs font-bold text-on-surface-variant mb-2">

                                Altitud máxima (msnm)

                            </label>

