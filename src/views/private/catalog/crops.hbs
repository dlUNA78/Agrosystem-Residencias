<!-- Catálogo Privado y Panel de Control Agronómico INIFAP (RBAC + KPIs + Geist Design System) -->
<main class="min-h-screen font-['Geist'] antialiased bg-background text-foreground pb-20">

    <div class="max-w-7xl mx-auto px-4 md:px-10 pt-6 space-y-6">

        <!-- ===================================================== -->
        <!-- ENCABEZADO ADMINISTRATIVO + ACCIONES SEGÚN ROL (RBAC) -->
        <!-- ===================================================== -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-border/80 pb-6">
            <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="px-3 py-1 rounded-full bg-[#e6f0e6] text-[#1b4332] text-[11px] font-mono font-bold tracking-wider uppercase">
                        SISTEMA NACIONAL DE INFORMACIÓN AGRONÓMICA · INIFAP
                    </span>
                    {{#if isAdmin}}
                    <span class="px-2.5 py-0.5 rounded-md bg-purple-100 text-purple-800 text-[10px] font-mono font-bold uppercase">
                        ADMINISTRADOR
                    </span>
                    {{else}}{{#if isInifap}}
                    <span class="px-2.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-mono font-bold uppercase">
                        ESPECIALISTA INIFAP
                    </span>
                    {{else}}
                    <span class="px-2.5 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[10px] font-mono font-bold uppercase">
                        CONSULTA PRIVADA
                    </span>
                    {{/if}}{{/if}}
                </div>
                <h1 class="text-2xl sm:text-4xl font-headline font-black tracking-tight text-[#1b4332] leading-tight">
                    Gestión Técnica de Cultivos Agrícolas
                </h1>
                <p class="max-w-2xl text-xs md:text-sm leading-relaxed text-muted-foreground">
                    Administración de fichas agronómicas, requerimientos edafoclimáticos, vinculación fitosanitaria y dictamen editorial.
                </p>
            </div>

            <!-- Botones de Acción (Protegidos por RBAC) -->
            <div class="flex items-center gap-2.5 shrink-0">
                {{#if permissions.canCreate}}
                <button type="button" id="btn-add-crop"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#1b4332] text-white text-xs font-bold hover:bg-[#2d6a4f] transition-all shadow-md active:scale-95 cursor-pointer">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Nuevo Cultivo</span>
                </button>
                {{/if}}
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- TARJETAS KPIS INTERACTIVAS DE FLUJO EDITORIAL         -->
        <!-- ===================================================== -->
        <div id="crops-kpi-region" class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">

            <!-- KPI 1: Total Cultivos (Acceso rápido a Todos) -->
            <a href="/private/crops"
                class="group bg-card border {{#unless filters.workflow}}border-[#1b4332]/40 ring-1 ring-[#1b4332]/15{{else}}border-border/80 hover:border-[#1b4332]/40{{/unless}} rounded-2xl p-4 sm:p-5 shadow-2xs flex items-center justify-between transition-all">
                <div>
                    <p class="text-[10px] sm:text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Total Catalogados</p>
                    <h3 class="text-2xl sm:text-3xl font-headline font-black text-[#1b4332] mt-1 tabular-nums">{{stats.total}}</h3>
                    <p class="text-[11px] text-muted-foreground mt-1 flex items-center gap-1">
                        <i data-lucide="database" class="w-3.5 h-3.5 text-[#2d6a4f]"></i>
                        <span>Padrón general</span>
                    </p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-[#e6f0e6] text-[#1b4332] flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <i data-lucide="sprout" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </a>

            <!-- KPI 2: Cultivos publicados -->
            <a href="/private/crops?workflow=published"
                class="group bg-card border {{#if (eq filters.workflow 'published')}}border-emerald-500 ring-1 ring-emerald-500/20{{else}}border-border/80 hover:border-emerald-400{{/if}} rounded-2xl p-4 sm:p-5 shadow-2xs flex items-center justify-between transition-all">
                <div>
                    <p class="text-[10px] sm:text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Publicados</p>
                    <h3 class="text-2xl sm:text-3xl font-headline font-black text-emerald-700 mt-1 tabular-nums">{{stats.published}}</h3>
                    <p class="text-[11px] text-emerald-700 mt-1 flex items-center gap-1 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Visibles al público</span>
                    </p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <i data-lucide="globe" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </a>

            <!-- KPI 3: Pendientes de Verificación / Revisión -->
            <a href="/private/crops?workflow=in_review"
                class="group bg-card border {{#if (eq filters.workflow 'in_review')}}border-amber-500 ring-1 ring-amber-500/20{{else}}border-border/80 hover:border-amber-400{{/if}} rounded-2xl p-4 sm:p-5 shadow-2xs flex items-center justify-between transition-all">
                <div>
                    <p class="text-[10px] sm:text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">En Revisión</p>
                    <h3 class="text-2xl sm:text-3xl font-headline font-black text-amber-600 mt-1 tabular-nums">{{stats.inReview}}</h3>
                    <p class="text-[11px] text-amber-700 mt-1 flex items-center gap-1 font-medium">
                        <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                        <span>Evaluación técnica</span>
                    </p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <i data-lucide="file-check" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </a>

            <!-- KPI 4: Con Cambios Solicitados -->
            <a href="/private/crops?workflow=changes_requested"
                class="group bg-card border {{#if (eq filters.workflow 'changes_requested')}}border-orange-500 ring-1 ring-orange-500/20{{else}}border-border/80 hover:border-orange-400{{/if}} rounded-2xl p-4 sm:p-5 shadow-2xs flex items-center justify-between transition-all">
                <div>
                    <p class="text-[10px] sm:text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">Con Cambios</p>
                    <h3 class="text-2xl sm:text-3xl font-headline font-black text-orange-600 mt-1 tabular-nums">{{stats.changesRequested}}</h3>
                    <p class="text-[11px] text-orange-700 mt-1 flex items-center gap-1 font-medium">
                        <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
                        <span>Ajustes pendientes</span>
                    </p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <i data-lucide="file-edit" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </a>

        </div>

        <!-- ===================================================== -->
        <!-- BARRA PEGAJOSA DE FILTROS + TABS RÁPIDOS DE WORKFLOW   -->
        <!-- ===================================================== -->
        <div class="sticky top-16 z-30 -mx-4 md:-mx-10 px-4 md:px-10 py-2.5 sm:py-3 bg-background/95 backdrop-blur-md border-b border-border/80 shadow-2xs space-y-2">
            <form id="crop-filter-form" action="/private/crops" method="GET" class="flex flex-col lg:flex-row lg:items-center justify-between gap-2">
                <input type="hidden" id="filter-workflow" name="workflow" value="{{filters.workflow}}" />

                <!-- Fila Superior: Buscador + Toggle Móvil + Conmutador Vista -->
                <div class="flex items-center gap-2 flex-1">
                    <div class="relative flex-1">
                        <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"></i>
                        <input id="crop-search" name="search" type="search" value="{{filters.search}}" maxlength="120"
                            class="w-full pl-10 pr-10 py-2 bg-card border border-input rounded-xl text-xs text-foreground placeholder:text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/20 focus:border-[#1b4332] transition-all"
                            placeholder="Buscar por nombre, especie científica o categoría..." />
                        <kbd class="hidden sm:inline-flex items-center justify-center px-1.5 py-0.5 text-[10px] font-mono text-muted-foreground bg-muted border border-border rounded-md absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" title="Presiona / para buscar">/</kbd>
                    </div>

                    <!-- Botón Toggle Filtros en Móvil (< lg) -->
                    <button
                        type="button"
                        id="toggle-private-crops-filters-btn"
                        class="lg:hidden h-9 px-2.5 flex items-center gap-1.5 rounded-xl border border-input bg-card text-foreground font-semibold text-xs hover:bg-secondary transition-colors cursor-pointer shrink-0 shadow-2xs"
                        aria-expanded="false"
                        aria-controls="private-crops-collapsible-filters"
                        title="Mostrar u ocultar filtros avanzados"
                    >
                        <span class="material-symbols-outlined text-base text-[#1b4332]">tune</span>
                        <span class="text-xs">Filtros</span>
                        <span id="private-crops-active-filters-count" class="hidden px-1.5 py-0.2 rounded-full bg-[#1b4332] text-white text-[10px] font-mono font-bold leading-none">0</span>
                    </button>

                    <!-- Cambiador de Vista Grilla / Tabla -->
                    <div class="flex items-center bg-card border border-input rounded-xl p-0.5 gap-0.5 shrink-0" role="group" aria-label="Presentación del catálogo">
                        <button type="button" id="view-grid" title="Vista en tarjetas" aria-label="Vista en tarjetas" aria-pressed="true"
                            class="p-1.5 rounded-lg bg-[#1b4332] text-white transition-all cursor-pointer">
                            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
                        </button>
                        <button type="button" id="view-table" title="Vista en tabla" aria-label="Vista en tabla" aria-pressed="false"
                            class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer">
                            <i data-lucide="table-properties" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>

                <!-- Dropdowns y Selectores (Desktop: en línea; Móvil: colapsables) -->
                <div id="private-crops-collapsible-filters" class="hidden lg:flex flex-wrap items-center gap-2 pt-2 lg:pt-0 border-t border-border/50 lg:border-t-0 mt-1 lg:mt-0">
                    {{#each searchFilters}}
                    <div class="relative w-full sm:w-auto min-w-36">
                        <select id="{{id}}" name="{{param}}"
                            class="filter-select appearance-none w-full bg-card border border-input rounded-xl px-3 py-2 pr-8 text-xs font-medium text-foreground focus:outline-hidden focus:border-[#1b4332] transition-all cursor-pointer">
                            <option value="">{{label}} Todos</option>
                            {{#each options}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{text}}</option>
                            {{/each}}
                        </select>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none"></i>
                    </div>
                    {{/each}}

                    <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-[#1b4332] px-4 py-2 text-xs font-bold text-white shadow-2xs transition-colors hover:bg-[#2d6a4f] cursor-pointer">
                        <i data-lucide="search" class="h-3.5 w-3.5"></i>
                        Filtrar
                    </button>

                    <span id="crop-clear-filters-slot">
                        {{#if hasActiveFilters}}
                        <a href="/private/crops" data-async-filter-link class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2 text-xs font-bold text-rose-700 transition-colors hover:bg-rose-100">
                            <i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i>
                            Limpiar
                        </a>
                        {{/if}}
                    </span>
                </div>
            </form>

            <!-- Píldoras Rápidas de Bandeja Editorial -->
            <div id="crops-toolbar-pills" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 pt-1.5 border-t border-border/40 text-xs">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground mr-1 shrink-0">Bandeja:</span>
                <button type="button" data-workflow-pill=""
                    class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#unless filters.workflow}}bg-[#1b4332] text-white border-[#1b4332] font-bold shadow-2xs{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/unless}}">
                    Todos
                </button>
                <button type="button" data-workflow-pill="draft"
                    class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq filters.workflow 'draft')}}bg-[#1b4332] text-white border-[#1b4332] font-bold shadow-2xs{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}">
                    Borradores
                </button>
                <button type="button" data-workflow-pill="changes_requested"
                    class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq filters.workflow 'changes_requested')}}bg-orange-600 text-white border-orange-600 font-bold shadow-2xs{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}">
                    Con cambios
                </button>
                <button type="button" data-workflow-pill="in_review"
                    class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq filters.workflow 'in_review')}}bg-amber-600 text-white border-amber-600 font-bold shadow-2xs{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}">
                    En revisión
                </button>
                <button type="button" data-workflow-pill="verified"
                    class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq filters.workflow 'verified')}}bg-blue-600 text-white border-blue-600 font-bold shadow-2xs{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}">
                    Verificados
                </button>
                <button type="button" data-workflow-pill="published"
                    class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq filters.workflow 'published')}}bg-emerald-700 text-white border-emerald-700 font-bold shadow-2xs{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}">
                    Publicados
                </button>
                <button type="button" data-workflow-pill="archived"
                    class="px-2.5 py-1 rounded-lg border transition-colors shrink-0 cursor-pointer {{#if (eq filters.workflow 'archived')}}bg-zinc-700 text-white border-zinc-700 font-bold shadow-2xs{{else}}bg-card text-muted-foreground border-border hover:text-foreground hover:bg-muted{{/if}}">
                    Archivados
                </button>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- REGIÓN DE RESULTADOS ASÍNCRONA                        -->
        <!-- ===================================================== -->
        <div id="crops-results-region" class="space-y-6">
            <div class="flex flex-col gap-1 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
                <p>
                    Mostrando <strong class="text-foreground">{{pagination.fromItem}}–{{pagination.toItem}}</strong>
                    de <strong class="text-foreground">{{pagination.totalItems}}</strong> cultivos registrados.
                </p>
                {{#if hasActiveFilters}}
                <p class="font-mono text-[10px] uppercase tracking-wider text-[#2d6a4f] font-bold">Vista filtrada activa</p>
                {{/if}}
            </div>
            {{> private/crops/grid}}
            {{> private/crops/table}}
            {{> private/crop-pagination}}
        </div>

    </div>
</main>

{{> private/crops/form-modal}}
{{> private/crops/delete-modal}}

<script type="module" src="/js/private/crops.js"></script>
<script src="/js/shared/image-fallback.js"></script>
