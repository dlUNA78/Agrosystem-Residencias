{{!-- MODAL ELIMINAR CULTIVO--}}

{{#if permissions.canDelete}}
<div id="modal-delete-crop" class="fixed inset-0 z-9999 hidden items-center justify-center p-4">

    {{!-- FONDO OSCURO --}}
    <div id="modal-delete-crop-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm">
    </div>


    {{!-- CONTENIDO DEL MODAL --}}
    <div class="relative w-full max-w-md
                bg-surface-container-lowest
                rounded-2xl
                shadow-2xl
                border border-outline-variant/10
                overflow-hidden">


        {{!-- ENCABEZADO --}}
        <div class="p-6 border-b border-outline-variant/10">

            <div class="flex items-center gap-4">

                <div class="w-12 h-12
                            rounded-full
                            bg-red-50
                            flex
                            items-center
                            justify-center">

                    <span class="material-symbols-outlined
                                 text-2xl
                                 text-red-600">

                        delete_forever

                    </span>

                </div>


                <div>

                    <h3 class="text-lg
                               font-bold
                               text-on-surface">

                        Eliminar cultivo

                    </h3>

                    <p class="text-xs
                              text-on-surface-variant
                              mt-1">

                        Esta acción no se puede deshacer.

                    </p>

                </div>

            </div>

        </div>


        {{!-- MENSAJE --}}
        <div class="p-6">

            <p class="text-sm text-on-surface-variant">

                ¿Estás seguro de que deseas eliminar el cultivo:

                <strong id="delete-crop-name" class="text-on-surface font-bold">

                </strong>

                ?

            </p>

        </div>


        {{!-- ACCIONES --}}
        <div class="px-6 py-4
                    bg-surface-container-low/30
                    border-t
                    border-outline-variant/10
                    flex
                    justify-end
                    gap-3">


            {{!-- CANCELAR --}}
            <button type="button" id="modal-delete-crop-cancel" class="px-5
                       py-2.5
                       rounded-lg
                       text-sm
                       font-bold
                       text-on-surface-variant
                       hover:bg-surface-container-highest
                       transition-colors">

                Cancelar

            </button>


            {{!-- FORMULARIO ELIMINAR --}}
