<!DOCTYPE html>
<html class="light" lang="es">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{{#if pageTitle}}{{pageTitle}} — INIFAP{{else}}Agrosystem | Panel de Administrador{{/if}}</title>
    <!-- Iconos Lucide Locales (/vendor/lucide) + Material Symbols Servidos Localmente -->
    <script src="/vendor/lucide/lucide.min.js"></script>
    <link rel="stylesheet" href="/css/style.css?v=2.5">
    {{#if extraHead}}{{{extraHead}}}{{/if}}
</head>

<body class="bg-background text-on-surface antialiased">
    {{> private/sidebar}}
    {{> private/navbar}}

    <!-- Backdrop overlay para móvil -->
    <div id="sidebar-backdrop"
        class="fixed inset-0 z-40 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
        aria-hidden="true"></div>

    <main id="main-content" class="pt-20 px-4 sm:px-8 pb-12 transition-all duration-300 ease-in-out">
        {{{body}}}
        {{> private/footer}}
    </main>

    <!-- Contextual FAB -->
    <div class="fixed bottom-8 right-8 z-50">
        <button
            class="w-14 h-14 bg-primary text-on-primary rounded-full shadow-2xl flex items-center justify-center hover:scale-110 active:scale-95 transition-all">
            <i data-lucide="terminal" class="w-6 h-6"></i>
        </button>
    </div>

    <script src="/js/main.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
    {{#if extraScripts}}{{{extraScripts}}}{{/if}}
</body>

</html>