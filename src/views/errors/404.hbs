<!-- Vista Institucional 404: Recurso o Ruta No Encontrada · Geist Design System -->
<section class="min-h-[75vh] flex items-center justify-center px-4 py-16 font-['Geist'] antialiased">
  <div class="max-w-xl w-full bg-white rounded-3xl border border-slate-200/90 shadow-sm p-8 sm:p-10 text-center space-y-6 relative overflow-hidden">
    <!-- Barra decorativa institucional superior -->
    <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-[#1b4332] via-[#2d6a4f] to-emerald-500"></div>

    <!-- Icono y Código de Estado -->
    <div class="inline-flex flex-col items-center gap-3">
      <div class="w-16 h-16 rounded-2xl bg-emerald-50 border border-emerald-200/80 text-[#1b4332] flex items-center justify-center shadow-2xs">
        <span class="material-symbols-outlined text-3xl" aria-hidden="true">explore_off</span>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50/80 px-3 py-1 font-['Geist_Mono'] text-[11px] font-bold uppercase tracking-widest text-[#1b4332]">
        Código HTTP 404 · Ruta Inexistente
      </span>
    </div>

    <!-- Mensaje Principal -->
    <div class="space-y-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
        No encontramos la página solicitada
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto">
        {{#if errorMessage}}
          {{errorMessage}}
        {{else}}
          El expediente, ficha técnica o dirección que intentas consultar no existe, fue reubicado o la URL contiene un error de escritura.
        {{/if}}
      </p>
    </div>

    {{#if requestedPath}}
    <div class="rounded-xl bg-slate-50 border border-slate-200/80 px-4 py-2.5 text-left flex items-center justify-between gap-2">
      <span class="text-[10px] font-['Geist_Mono'] font-bold uppercase tracking-wider text-slate-400 shrink-0">Ruta consultada</span>
      <code class="text-xs font-['Geist_Mono'] font-semibold text-slate-700 truncate">{{requestedPath}}</code>
    </div>
    {{/if}}

    <!-- Acciones de Retorno -->
    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-[#1b4332] px-5 py-2.5 text-xs font-bold text-white shadow-xs transition-all hover:bg-[#143326] active:scale-95"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">home</span>
        <span>Ir al Portal Público</span>
      </a>

      {{#if (canAccessPanel user)}}
      <a
        href="/dashboard"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-xs font-bold text-slate-700 transition-all hover:bg-slate-50 hover:border-slate-300"
      >
        <span class="material-symbols-outlined text-base text-[#1b4332]" aria-hidden="true">space_dashboard</span>
        <span>Volver al Panel INIFAP</span>
      </a>
      {{else}}
      <a
        href="/plagues"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-xs font-bold text-slate-700 transition-all hover:bg-slate-50 hover:border-slate-300"
      >
        <span class="material-symbols-outlined text-base text-[#1b4332]" aria-hidden="true">menu_book</span>
        <span>Explorar Catálogos</span>
      </a>
      {{/if}}
    </div>
  </div>
</section>
