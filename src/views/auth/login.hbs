<div class="flex min-h-[calc(100vh-12rem)] items-center justify-center px-4 py-12 font-['Geist',sans-serif] text-[#0a0a0a]">
  <div class="w-full max-w-md rounded-2xl border border-neutral-200/90 bg-white p-7 shadow-xl sm:p-9">
    <!-- Cabecera Institucional INIFAP -->
    <div class="mb-6 flex flex-col items-center text-center">
      <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 p-2.5 ring-1 ring-emerald-200/80 shadow-2xs">
        <img
          src="/images/inifap-Logo.png"
          alt="Logotipo oficial del INIFAP"
          class="h-full w-full object-contain"
        />
      </div>
      <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 font-['Geist_Mono'] text-[10px] font-semibold tracking-wider text-[#1b4332] uppercase ring-1 ring-emerald-200/80">
        Plataforma Fitosanitaria
      </span>
      <h1 class="mt-2 text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
        Iniciar Sesión
      </h1>
      <p class="mt-1 text-xs text-slate-500">
        Ingresa tus credenciales para acceder a la red institucional
      </p>
    </div>

    {{#if error}}
    <div
      role="alert"
      class="mb-5 flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50/80 p-3.5 text-xs text-rose-800"
    >
      <i data-lucide="alert-circle" class="mt-0.5 h-4 w-4 shrink-0 text-rose-600" aria-hidden="true"></i>
      <span class="font-medium leading-relaxed">{{error}}</span>
    </div>
    {{/if}}

    <form action="/auth/login" method="POST" class="space-y-4.5">
      <div>
        <label for="email" class="mb-1.5 block font-['Geist_Mono'] text-[11px] font-semibold text-slate-700 uppercase tracking-wider">
          Correo Institucional o de Productor
        </label>
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
            <i data-lucide="mail" class="h-4 w-4" aria-hidden="true"></i>
          </div>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="usuario@inifap.gob.mx"
            class="w-full rounded-xl border border-neutral-300 bg-neutral-50/50 py-2.5 pr-3.5 pl-10 text-xs text-slate-900 transition-colors placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/15"
          />
        </div>
      </div>

      <div>
        <div class="mb-1.5 flex items-center justify-between">
          <label for="password" class="block font-['Geist_Mono'] text-[11px] font-semibold text-slate-700 uppercase tracking-wider">
            Contraseña
          </label>
        </div>
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
            <i data-lucide="lock" class="h-4 w-4" aria-hidden="true"></i>
          </div>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="w-full rounded-xl border border-neutral-300 bg-neutral-50/50 py-2.5 pr-10 pl-10 text-xs text-slate-900 transition-colors placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/15"
          />
          <button
            type="button"
            id="toggle-password-visibility"
            aria-label="Mostrar u ocultar contraseña"
            title="Mostrar u ocultar contraseña"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 focus:outline-hidden cursor-pointer"
          >
            <i data-lucide="eye" class="h-4 w-4" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <button
        type="submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#1b4332] py-2.5 px-4 text-xs font-semibold text-white shadow-xs transition-all hover:bg-[#143326] active:scale-[0.99] cursor-pointer"
      >
        <span>Ingresar a Agrosystem</span>
        <i data-lucide="arrow-right" class="h-3.5 w-3.5" aria-hidden="true"></i>
      </button>
    </form>

    <div class="mt-6 border-t border-slate-100 pt-5 text-center">
      <p class="text-xs text-slate-500">
        ¿Eres nuevo en la plataforma?
        <a
          href="/register"
          class="font-semibold text-[#1b4332] underline-offset-4 hover:underline"
        >
          Crear una cuenta aquí
        </a>
      </p>
    </div>
  </div>
</div>

<script src="/js/public/login.js"></script>
