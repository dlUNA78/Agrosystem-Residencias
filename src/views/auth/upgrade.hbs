<!-- Vista Institucional de Ascenso a Personal Técnico INIFAP · Geist Design System -->
<div class="flex min-h-[calc(100vh-10rem)] items-center justify-center px-4 py-12 font-['Geist',sans-serif] text-[#0a0a0a]">
  <div class="w-full max-w-xl rounded-2xl border border-neutral-200/90 bg-white p-7 shadow-xl sm:p-9 relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-[#1b4332] via-[#2d6a4f] to-emerald-500"></div>

    <!-- Cabecera Institucional -->
    <div class="mb-6 flex flex-col items-center text-center">
      <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 p-2.5 ring-1 ring-emerald-200/80 shadow-2xs text-[#1b4332]">
        <span class="material-symbols-outlined text-3xl" aria-hidden="true">verified_user</span>
      </div>
      <span class="rounded-full bg-emerald-50 px-3 py-0.5 font-['Geist_Mono'] text-[10px] font-bold tracking-wider text-[#1b4332] uppercase ring-1 ring-emerald-200/80">
        Acreditación Institucional INIFAP
      </span>
      <h1 class="mt-2 text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
        Validación de Personal Técnico e Investigadores
      </h1>
      <p class="mt-1 text-xs text-slate-500 max-w-md leading-relaxed">
        Ingresa el código único de adscripción emitido por la administración de Agrosystem INIFAP para activar tus permisos técnicos en el panel privado.
      </p>
    </div>

    <!-- Tarjeta Informativa del Proceso -->
    <div class="mb-6 rounded-xl border border-emerald-200/70 bg-emerald-50/50 p-4 text-xs text-slate-700 space-y-2">
      <div class="flex items-center gap-2 font-bold text-[#1b4332]">
        <span class="material-symbols-outlined text-base" aria-hidden="true">shield_person</span>
        <span>¿Qué habilita tu acreditación INIFAP?</span>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-[11px] text-slate-600 pl-1">
        <li class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 shrink-0"></span>
          <span>Acceso al Panel Técnico y Dashboard</span>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 shrink-0"></span>
          <span>Edición y revisión de catálogos científicos</span>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 shrink-0"></span>
          <span>Seguimiento de expedientes y lotes</span>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 shrink-0"></span>
          <span>Emisión de avisos y reportes regionales</span>
        </li>
      </ul>
    </div>

    {{#if error}}
    <div
      role="alert"
      class="mb-5 flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50/80 p-3.5 text-xs text-rose-800"
    >
      <span class="material-symbols-outlined text-base text-rose-600 shrink-0" aria-hidden="true">error</span>
      <span class="font-medium leading-relaxed">{{error}}</span>
    </div>
    {{/if}}

    <form action="/auth/inifap-upgrade" method="POST" class="space-y-4">
      <div>
        <div class="mb-1.5 flex items-center justify-between">
          <label for="secret_code" class="block font-['Geist_Mono'] text-[11px] font-semibold text-slate-700 uppercase tracking-wider">
            Código Institucional de Acceso Único *
          </label>
          <span class="font-['Geist_Mono'] text-[10px] text-slate-400">De un solo uso</span>
        </div>
        <input
          type="text"
          id="secret_code"
          name="secret_code"
          required
          autocomplete="off"
          placeholder="AGS-XXXX-XXXX-XXXX-XXXX"
          class="w-full rounded-xl border border-neutral-300 bg-neutral-50/70 px-4 py-3 text-center font-['Geist_Mono'] text-sm font-bold uppercase tracking-widest text-slate-900 transition-colors placeholder:text-slate-400 focus:border-[#1b4332] focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/15"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="job_title" class="mb-1.5 block font-['Geist_Mono'] text-[11px] font-semibold text-slate-700 uppercase tracking-wider">
            Cargo / Puesto Asignado *
          </label>
          <select
            id="job_title"
            name="job_title"
            required
            class="w-full rounded-xl border border-neutral-300 bg-neutral-50/50 px-3.5 py-2.5 text-xs font-medium text-slate-900 transition-colors focus:border-[#1b4332] focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/15"
          >
            <option value="Investigador Titular">Investigador Titular</option>
            <option value="Investigador Fitosanitario">Investigador Fitosanitario</option>
            <option value="Especialista Agrónomo">Especialista Agrónomo</option>
            <option value="Biólogo de Campo">Biólogo de Campo</option>
            <option value="Auditor Técnico">Auditor Técnico</option>
            <option value="Supervisor Regional">Supervisor Regional</option>
          </select>
        </div>

        <div>
          <label for="shift" class="mb-1.5 block font-['Geist_Mono'] text-[11px] font-semibold text-slate-700 uppercase tracking-wider">
            Turno Operativo *
          </label>
          <select
            id="shift"
            name="shift"
            class="w-full rounded-xl border border-neutral-300 bg-neutral-50/50 px-3.5 py-2.5 text-xs font-medium text-slate-900 transition-colors focus:border-[#1b4332] focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-[#1b4332]/15"
          >
            <option value="completo">Tiempo Completo</option>
            <option value="matutino">Matutino (07:00 - 15:00)</option>
            <option value="vespertino">Vespertino (14:00 - 22:00)</option>
            <option value="mixto">Mixto / Rolado</option>
          </select>
        </div>
      </div>

      <button
        type="submit"
        data-loading-text="Validando acreditación..."
        class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#1b4332] py-3 px-4 text-xs font-bold text-white shadow-xs transition-all hover:bg-[#143326] active:scale-[0.99] cursor-pointer"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">verified</span>
        <span>Validar Código y Activar Credencial INIFAP</span>
      </button>
    </form>

    <div class="mt-6 border-t border-slate-100 pt-5 flex items-center justify-between text-xs text-slate-500">
      <a href="/profile" class="inline-flex items-center gap-1 font-semibold text-slate-600 hover:text-[#1b4332]">
        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_back</span>
        <span>Ir a Mi Perfil</span>
      </a>
      <a href="/" class="font-semibold text-[#1b4332] hover:underline">
        Volver al Inicio
      </a>
    </div>
  </div>
</div>
