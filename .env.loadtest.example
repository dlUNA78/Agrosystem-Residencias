# Plantilla sin secretos para el entorno Docker de pruebas de carga.
# Copia este archivo a ".env.loadtest" (ignorado por Git) y reemplaza los valores entre <...>.

DB_NAME=agrosystem_loadtest
DB_USER=agrosystem_load
DB_PASS=<CAMBIAR_PASSWORD_DB>
SESSION_SECRET=<CAMBIAR_SECRETO_SESION_LARGO>

ADMIN_EMAIL=admin@agrosystem.com
ADMIN_PASSWORD=<CAMBIAR_PASSWORD_ADMIN>
FARMER_EMAIL=agricultor@agrosystem.com
FARMER_PASSWORD=<CAMBIAR_PASSWORD_FARMER>

# Puertos expuestos en el host (5433 evita chocar con Postgres local en 5432)
APP_PORT=3000
PG_HOST_PORT=5433

# Cuota de hardware simulada (ajustar según tu entorno de producción)
PG_CPUS=2.0
PG_MEM_LIMIT=1536m
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
APP_CPUS=2.0
APP_MEM_LIMIT=1536m

# Sembrado automático en el primer arranque (false para omitir datos sintéticos)
LOADTEST_AUTO_SEED=true
LOADTEST_FARMS=50000
LOADTEST_CYCLES=50000
LOADTEST_AUDIT=500000
LOADTEST_NOTIFICATIONS=50000
LOADTEST_SESSIONS=100000

# Banderas exclusivas para carga controlada HTTP sin TLS ni bloqueo por 429 (Opción A)
COOKIE_SECURE=false
LOADTEST_MODE=true
DISABLE_RATE_LIMIT=true
