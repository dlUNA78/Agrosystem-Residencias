# Plantilla SIN secretos para el entorno local de demostración (agrosystem_demo).
#
# INSTRUCCIONES:
#   1. Copia este archivo a ".env.demo" en la raíz del repositorio:
#        Copy-Item scripts/demo/.env.demo.example .env.demo
#   2. Reemplaza TODOS los marcadores <CAMBIAR_...> con valores locales de demostración.
#   3. NUNCA commitees ".env.demo" ni los archivos de respaldo ".dump" (ambos están en .gitignore).

# Entorno de ejecución (NO usar production con los scripts de scripts/demo/)
NODE_ENV=development
PORT=3005

# Base de datos dedicada EXCLUSIVAMENTE a la demostración
# Los scripts de scripts/demo/ abortan si DB_NAME no inicia con "agrosystem_demo"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrosystem_demo
DB_USER=<CAMBIAR_USUARIO_POSTGRES>
DB_PASS=<CAMBIAR_PASSWORD_POSTGRES>
DB_DIALECT=postgres

# Secreto de sesión local para la demostración (usa una cadena aleatoria larga de >= 32 caracteres)
SESSION_SECRET=<CAMBIAR_SECRETO_SESION_DEMO>

# Opcional: sobreescribir credenciales demo sembradas por scripts/demo/setupDemoDb.js
# Si se omiten, el script genera credenciales demo deterministas compatibles con validatePasswordPolicy
# y las imprime limpiamente en stdout al finalizar.
# DEMO_ADMIN_PASS=<CAMBIAR_CLAVE_ADMIN_DEMO>
# DEMO_TECNICO_PASS=<CAMBIAR_CLAVE_TECNICO_DEMO>
# DEMO_COORDINADOR_PASS=<CAMBIAR_CLAVE_COORDINADOR_DEMO>
# DEMO_PRODUCTOR_PASS=<CAMBIAR_CLAVE_PRODUCTOR_DEMO>
