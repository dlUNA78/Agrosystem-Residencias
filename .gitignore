# Dependencias
node_modules/

# Archivos de variables de entorno (¡Crítico para la seguridad!)
.env
.env.local

# Archivos de logs (ignora cualquier archivo que termine en .log)
*.log
npm-debug.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Configuraciones de editores de código (IDEs)
.vscode/
.idea/

# Carpetas de compilación o producción
dist/
build/
out/

# Archivos de estilos de tailwind
public/css/style.css

# QA y Reportes de Pruebas
coverage/
.stryker-tmp/
/reports/

# Archivos temporales locales de herramientas y revisiones
tmp/

# Cargas dinámicas de usuarios y temporales de Multer
public/images/uploads/*
!public/images/uploads/.gitkeep
public/images/products/[0-9]*

# Carpetas de pruebas locales
public/images/test/

# Documentos pesados de ofimática (mantener sólo Markdown .md en docs/)
docs/**/*.docx
docs/**/*.pdf
